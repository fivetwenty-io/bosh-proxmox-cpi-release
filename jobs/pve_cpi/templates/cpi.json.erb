<%=
  config = {
    "host"             => p("pve.host"),
    "port"             => p("pve.port"),
    "user"             => p("pve.user"),
    "realm"            => p("pve.realm"),
    "node"             => p("pve.node"),
    "vm_storage"       => p("pve.vm_storage"),
    "disk_storage"     => p("pve.disk_storage"),
    "stemcell_storage" => p("pve.stemcell_storage"),
    "iso_storage"      => p("pve.iso_storage"),
    "network_bridge"         => p("pve.network_bridge"),
    "network_mode"           => p("pve.network_mode"),
    "sdn_zone"               => p("pve.sdn_zone"),
    "sdn_zone_type"          => p("pve.sdn_zone_type"),
    "sdn_auto_manage_zone"   => p("pve.sdn_auto_manage_zone"),
    "verify_ssl"             => p("pve.verify_ssl"),
    "agent_mode"       => p("pve.agent_mode"),
    "vm_disk_format"   => p("pve.vm_disk_format"),
    "log_level"        => p("pve.log_level"),
    "vmid_range_start"              => p("pve.vmid_range_start"),
    "vmid_range_end"                => p("pve.vmid_range_end"),
    "allow_disk_ops_with_snapshots" => p("pve.allow_disk_ops_with_snapshots"),
    "require_snapshot_check_pass"   => p("pve.require_snapshot_check_pass"),
    "hotplug"               => p("pve.hotplug"),
    "numa"                  => p("pve.numa"),
    "reboot_mode"           => p("pve.reboot_mode"),
    "reboot_timeout"        => p("pve.reboot_timeout"),
    "vm_prefix"                 => p("pve.vm_prefix"),
    "create_env_deployment"     => p("pve.create_env_deployment"),
    "fetch_credential_defaults" => p("pve.fetch_credential_defaults", []),
  }

  # Emit pve_ca_cert only when the operator supplies a non-empty value. When
  # absent or empty (the default), the key is omitted so the Go config
  # zero-value ("") is preserved and TLS behavior is unchanged (system trust pool).
  pve_ca_cert = p("pve.ca_cert", "")
  config["pve_ca_cert"] = pve_ca_cert unless pve_ca_cert.to_s.empty?

  # Emit stemcell_staging_dir only when the operator supplies a non-empty value.
  # When absent or empty (the default), the key is omitted so the Go config
  # zero-value ("") is preserved and no behavior change occurs.
  stemcell_staging_dir = p("pve.stemcell_staging_dir", "")
  config["stemcell_staging_dir"] = stemcell_staging_dir unless stemcell_staging_dir.to_s.empty?

  # Emit stemcell-fetch transport timeouts only when the operator sets them.
  # When absent or 0 (the default), the key is omitted so the Go config
  # zero-value (0) reaches ApplyDefaults and the built-in defaults apply
  # (30s/15s/120s/90s). Mirrors the registry_ca_cert / verify_ssl pattern.
  {
    "stemcell_fetch_dial_timeout_sec"            => "pve.stemcell_fetch_dial_timeout_sec",
    "stemcell_fetch_tls_handshake_timeout_sec"   => "pve.stemcell_fetch_tls_handshake_timeout_sec",
    "stemcell_fetch_response_header_timeout_sec" => "pve.stemcell_fetch_response_header_timeout_sec",
    "stemcell_fetch_idle_conn_timeout_sec"       => "pve.stemcell_fetch_idle_conn_timeout_sec",
  }.each do |json_key, prop|
    v = p(prop, 0).to_i
    config[json_key] = v unless v == 0
  end

  # Emit PVE API transport tuning knobs only when the operator sets them.
  # When absent or 0 (the default), the key is omitted so the Go config
  # zero-value (0) reaches NewClient unchanged and the SDK transport default
  # applies (byte-identical to prior releases). Mirrors the stemcell-fetch
  # timeout omit-when-zero pattern.
  {
    "pve_api_dial_timeout_sec"         => "pve.api_dial_timeout_sec",
    "pve_api_tls_handshake_timeout_sec" => "pve.api_tls_handshake_timeout_sec",
    "pve_api_max_idle_conns_per_host"  => "pve.api_max_idle_conns_per_host",
    "pve_api_idle_conn_timeout_sec"    => "pve.api_idle_conn_timeout_sec",
    "pve_api_tcp_keepalive_sec"        => "pve.api_tcp_keepalive_sec",
  }.each do |json_key, prop|
    v = p(prop, 0).to_i
    config[json_key] = v unless v == 0
  end

  # Emit password / api_token only when non-empty. The Go config validator
  # rejects "both set" or "neither set" — this template never strips a value
  # the operator supplied. If both p() calls return non-empty, both keys
  # land in the JSON and Validate() will reject the result with a clear
  # error at CPI start-up rather than silently picking one.
  pve_password  = p("pve.password",  "")
  pve_api_token = p("pve.api_token", "")
  config["password"]  = pve_password  unless pve_password.to_s.empty?
  config["api_token"] = pve_api_token unless pve_api_token.to_s.empty?

  # cloud_provider.properties.agent.mbus is the URL the agent listens on.
  # bosh-init does NOT pass it via the per-call env argument; it lives only
  # in CPI config. Forward it (and the optional agent.blobstore) so create_vm
  # can stamp it into settings.json.
  if_p("agent.mbus") { |v| config["agent_mbus"] = v }
  if_p("agent.blobstore") { |v| config["agent_blobstore"] = v }

  if p("pve.agent_mode") == "registry"
    config["registry_endpoint"]        = p("registry.endpoint")
    config["registry_user"]            = p("registry.user")
    config["registry_password"]        = p("registry.password")
    config["registry_allow_insecure"]  = p("registry.allow_insecure", false)
    config["registry_ca_cert"]         = p("registry.ca_cert", "")
    # Emit registry_allowed_hosts only when the operator supplies a non-empty list.
    # When absent or empty (the default), the key is omitted so the Go config
    # zero-value ([]) is preserved and no behavior change occurs.
    registry_allowed_hosts = p("registry.allowed_hosts", [])
    config["registry_allowed_hosts"] = registry_allowed_hosts unless registry_allowed_hosts.nil? || registry_allowed_hosts.empty?
    # Emit registry_allow_private_ip only when explicitly set to true. When
    # absent or false (the default), the key is omitted so the Go config
    # zero-value (nil *bool → false → guard active) is preserved. This mirrors
    # the registry.ca_cert / registry.allow_insecure omit-when-empty pattern.
    if p("registry.allow_private_ip", false)
      config["registry_allow_private_ip"] = true
    end
  end
  # Emit disk_vmid_range_start only when the operator sets a non-zero value.
  # When absent or 0 (the default), the key is omitted so ApplyDefaults sets
  # the default disk band start (9000).
  v = p("pve.disk_vmid_range_start", 0).to_i
  config["disk_vmid_range_start"] = v unless v == 0

  # Emit disk_vmid_range_end only when the operator sets a non-zero value.
  # When absent or 0 (the default), the key is omitted so ApplyDefaults sets
  # the default disk band end (29999).
  v = p("pve.disk_vmid_range_end", 0).to_i
  config["disk_vmid_range_end"] = v unless v == 0

  # Emit stemcell_template_vmid_range_start only when the operator sets a non-zero
  # value. When absent or 0 (the default), the key is omitted so ApplyDefaults
  # sets the fixed default band start (30000).
  v = p("pve.stemcell_template_vmid_range_start", 0).to_i
  config["stemcell_template_vmid_range_start"] = v unless v == 0

  # Emit stemcell_template_vmid_range_end only when the operator sets a non-zero
  # value. When absent or 0 (the default), the key is omitted so ApplyDefaults
  # sets the fixed default band end (30999).
  v = p("pve.stemcell_template_vmid_range_end", 0).to_i
  config["stemcell_template_vmid_range_end"] = v unless v == 0

  # Emit stemcell_template_pool only when the operator supplies a non-empty value.
  # When absent or empty (the default), the key is omitted and no pool is assigned.
  stemcell_template_pool = p("pve.stemcell_template_pool", "")
  config["stemcell_template_pool"] = stemcell_template_pool unless stemcell_template_pool.to_s.empty?

  # Emit stemcell_template_node only when the operator supplies a non-empty value.
  # When absent or empty (the default), the key is omitted and the CPI falls back
  # to pve.node at call time.
  stemcell_template_node = p("pve.stemcell_template_node", "")
  config["stemcell_template_node"] = stemcell_template_node unless stemcell_template_node.to_s.empty?

  # Emit clone_mode only when the operator supplies a non-empty value. When absent
  # or empty (the default), the key is omitted; ApplyDefaults treats "" as "auto"
  # and selects the correct clone type per storage backend.
  clone_mode = p("pve.clone_mode", "")
  config["clone_mode"] = clone_mode unless clone_mode.to_s.empty?

  # Emit ensure_no_ip_conflicts only when explicitly set to false. The Go config
  # accessor defaults nil *bool -> true (protective); omitting the key preserves
  # that default. Emit only when the operator explicitly disables the guard.
  unless p("pve.ensure_no_ip_conflicts", true)
    config["ensure_no_ip_conflicts"] = false
  end

  # Emit ip_conflict_probe only when set to a non-empty value. The Go config
  # accessor defaults empty string to "off"; omitting the key preserves that
  # default with no behavioral change. Emit only when the operator opts in.
  ip_conflict_probe = p("pve.ip_conflict_probe", "")
  config["ip_conflict_probe"] = ip_conflict_probe unless ip_conflict_probe.to_s.empty?

  # Emit disk_perf_invariant_mode only when set to a non-empty value. The Go
  # config accessor defaults empty string to "enforce"; omitting the key
  # preserves that default. Emit only when the operator overrides it.
  disk_perf_invariant_mode = p("pve.disk_perf_invariant_mode", "")
  config["disk_perf_invariant_mode"] = disk_perf_invariant_mode unless disk_perf_invariant_mode.to_s.empty?

  # Emit cluster_lock_mode only when set to a non-empty value. The Go config
  # accessor defaults empty string to "off"; omitting the key preserves that
  # default with no behavioral change. Emit only when the operator opts in.
  cluster_lock_mode = p("pve.cluster_lock_mode", "")
  config["cluster_lock_mode"] = cluster_lock_mode unless cluster_lock_mode.to_s.empty?

  # Emit cluster_lock_timeout_sec only when set to a non-zero value. The Go
  # config resolves 0 (omitted) to a 60s default.
  cluster_lock_timeout_sec = p("pve.cluster_lock_timeout_sec", 0).to_i
  config["cluster_lock_timeout_sec"] = cluster_lock_timeout_sec unless cluster_lock_timeout_sec == 0

  # Emit antiaffinity_verify only when explicitly true. The Go accessor defaults
  # nil *bool -> false (no behavior change); omitting the key preserves that.
  if p("pve.antiaffinity_verify", false)
    config["antiaffinity_verify"] = true
  end

  # Emit task_poll_adaptive only when the operator opts in. The Go config
  # defaults to fixed-cadence polling when the key is omitted.
  if p("pve.task_poll_adaptive", false)
    config["task_poll_adaptive"] = true
  end

  # Emit redact_logs only when explicitly true. The Go accessor defaults to no
  # payload trace when the key is omitted.
  if p("pve.redact_logs", false)
    config["redact_logs"] = true
  end

  # Emit resize-convergence knobs only when the operator opts in. The Go config
  # defaults (disabled; 120s budget) hold when the keys are omitted.
  if p("pve.resize_wait_for_convergence", false)
    config["resize_wait_for_convergence"] = true
    timeout_sec = p("pve.resize_convergence_timeout_sec", 0).to_i
    config["resize_convergence_timeout_sec"] = timeout_sec if timeout_sec > 0
  end

  # Emit the placement block only when at least one placement property is set.
  # When the block would be empty, omit it entirely so the Go config zero-value
  # (nil *PlacementConfig) is preserved and existing deployments are unaffected.
  placement = {}

  # placement.enabled: emit only when explicitly set to false (protective default
  # is true; omitting the key lets the Go accessor return true naturally).
  placement_enabled = p("pve.placement.enabled", true)
  placement["enabled"] = placement_enabled unless placement_enabled

  # placement.az_map: emit only when the operator supplies a non-empty hash.
  az_map = p("pve.placement.az_map", {})
  placement["az_map"] = az_map unless az_map.nil? || az_map.empty?

  # placement.anti_affinity: nested block, emitted only when spreading is
  # enabled. enabled=true turns on scheduler-soft spreading; use_ha_rules=true
  # additionally maintains PVE HA negative-affinity rules. Both default false.
  # strict is emitted only when anti_affinity.enabled is true because strict has
  # no effect when the outer HA-rules block is absent; suppressing it when the
  # block is absent avoids a stray key that could mislead the Go config reader.
  anti_affinity = {}
  if p("pve.placement.anti_affinity.enabled", false)
    anti_affinity["enabled"] = true
    if p("pve.placement.anti_affinity.use_ha_rules", false)
      anti_affinity["use_ha_rules"] = true
    end
    # Emit strict only when true (default false). Has no effect unless
    # use_ha_rules is also true, but we emit whenever anti_affinity is enabled
    # so the Go config can validate the combination and warn appropriately.
    if p("pve.placement.anti_affinity.strict", false)
      anti_affinity["strict"] = true
    end
  end
  placement["anti_affinity"] = anti_affinity unless anti_affinity.empty?

  # placement.dlb: PVE 9.2+ Dynamic Load Balancer integration sub-block.
  # Emitted only when at least one DLB property deviates from its default so
  # existing deployments that set none of these properties see zero regression
  # (nil *DLBConfig in Go = all accessors return safe OFF defaults).
  #
  # Omit-when-default contract per key:
  #   enabled                default false → emit only when true
  #   az_name                default "dlb" → emit only when operator overrides
  #                                          (includes explicit "" to disable sentinel)
  #   manage_cluster_crs     default false → emit only when true
  #   require_shared_storage default true  → emit only when explicitly false
  dlb = {}
  # dlb.enabled: master override; emit only when true.
  if p("pve.placement.dlb.enabled", false)
    dlb["enabled"] = true
  end
  # dlb.az_name: emit only when the operator sets a value other than the default
  # "dlb". An explicit "" is a legitimate override (disables sentinel) and must
  # be emitted so the Go config honors it; use != "dlb" not .empty? for this.
  dlb_az_name = p("pve.placement.dlb.az_name", "dlb")
  dlb["az_name"] = dlb_az_name unless dlb_az_name == "dlb"
  # dlb.manage_cluster_crs: emit only when true (default false).
  if p("pve.placement.dlb.manage_cluster_crs", false)
    dlb["manage_cluster_crs"] = true
  end
  # dlb.require_shared_storage: emit only when explicitly false (default true).
  # When absent or true the Go config nil *bool accessor returns true, preserving
  # the protective default; emit false only to override it.
  unless p("pve.placement.dlb.require_shared_storage", true)
    dlb["require_shared_storage"] = false
  end
  placement["dlb"] = dlb unless dlb.empty?

  # placement.weights: emit only when at least one weight is overridden.
  weights = {}
  { "mem"         => "pve.placement.weights.mem",
    "storage"     => "pve.placement.weights.storage",
    "cpu"         => "pve.placement.weights.cpu",
    "guest_count" => "pve.placement.weights.guest_count",
  }.each do |json_key, prop|
    v = p(prop, 0.0).to_f
    weights[json_key] = v unless v == 0.0
  end
  placement["weights"] = weights unless weights.empty?

  # placement.exclude_maintenance_nodes: default-ON via Go accessor (nil → true).
  # Emit only when the operator explicitly disables the guard (sets false).
  # Omitting the key lets the accessor return true — behavior-preserving default.
  unless p("pve.placement.exclude_maintenance_nodes", true)
    placement["exclude_maintenance_nodes"] = false
  end

  # placement.maintenance_node_tags: emit only when the operator overrides the
  # default ["maintenance"] with a non-empty list. When unset or empty, the Go
  # accessor supplies ["maintenance"] so the key is omitted here.
  maintenance_node_tags = p("pve.placement.maintenance_node_tags", [])
  placement["maintenance_node_tags"] = maintenance_node_tags unless maintenance_node_tags.nil? || maintenance_node_tags.empty?

  # placement.az_fallback_order: emit only when the operator provides a non-empty
  # list. When unset or empty, Go defaults to no config-level fallback chain.
  az_fallback_order = p("pve.placement.az_fallback_order", [])
  placement["az_fallback_order"] = az_fallback_order unless az_fallback_order.nil? || az_fallback_order.empty?

  # placement.az_shuffle: emit only when true (default false). Omitting preserves
  # deterministic AZ ordering via the Go accessor default.
  if p("pve.placement.az_shuffle", false)
    placement["az_shuffle"] = true
  end

  # placement.pin_az_via_ha_rules: emit only when true (default false). Omitting
  # preserves "no HA pin" via the Go accessor default. pin_az_strict is emitted
  # only alongside an enabled pin (and only when explicitly false, since the Go
  # accessor defaults nil -> true), so an unrelated config stays byte-identical.
  if p("pve.placement.pin_az_via_ha_rules", false)
    placement["pin_az_via_ha_rules"] = true
    unless p("pve.placement.pin_az_strict", true)
      placement["pin_az_strict"] = false
    end
  end

  # placement.fallback_max: emit only when > 0. Zero (default) means the fallback
  # path is disabled — omitting the key preserves the Go nil *int -> 0 -> OFF
  # behavior, byte-identical to prior releases.
  v = p("pve.placement.fallback_max", 0).to_i
  placement["fallback_max"] = v unless v == 0

  # placement.reserve_storage_headroom: emit only when true (default false).
  # Omitting preserves the Go nil *bool -> false -> filter-off path, byte-identical.
  if p("pve.placement.reserve_storage_headroom", false)
    placement["reserve_storage_headroom"] = true
    # placement.storage_headroom_mb: emit only when > 0 (default 0 → 1 GiB floor
    # applied by the Go accessor; omitting the key preserves that behavior).
    headroom_mb = p("pve.placement.storage_headroom_mb", 0).to_i
    placement["storage_headroom_mb"] = headroom_mb unless headroom_mb == 0
  end

  config["placement"] = placement unless placement.empty?

  # Emit vm_firewall only when explicitly true. The Go accessor defaults
  # nil *bool -> false (no behavior change); omitting the key preserves that.
  if p("pve.vm_firewall", false)
    config["vm_firewall"] = true
  end

  # Emit hooks only when the operator activates at least one. Empty (default)
  # means no dispatch middleware and zero per-call overhead.
  hooks = p("pve.hooks", [])
  config["hooks"] = hooks unless hooks.nil? || hooks.empty?

  # Emit stemcell_replicate_local only when true. The Go zero-value (false)
  # means local-storage multi-node replication is off; omitting the key
  # preserves that default — byte-identical to prior releases.
  if p("pve.stemcell_replicate_local", false)
    config["stemcell_replicate_local"] = true
  end

  # Emit stemcell_replication_concurrency only when non-zero. Zero (default)
  # resolves to 1 (serial) in Go; omitting the key preserves that default —
  # byte-identical to prior releases. The Go accessor clamps nil/0 to 1 so
  # there is no need to emit 1 explicitly.
  repl_concurrency = p("pve.stemcell_replication_concurrency", 0).to_i
  config["stemcell_replication_concurrency"] = repl_concurrency unless repl_concurrency == 0

  # Emit replica_adopt_timeout_sec only when non-zero. Zero (default) disables
  # adopt-and-wait on a racing concurrent replica clone; omitting the key
  # preserves that default — byte-identical to prior releases.
  replica_adopt_timeout_sec = p("pve.replica_adopt_timeout_sec", 0).to_i
  config["replica_adopt_timeout_sec"] = replica_adopt_timeout_sec unless replica_adopt_timeout_sec == 0

  # Emit disk_delete_state_guard only when set to a non-empty value. Empty/"off"
  # (default) disables the pre-delete attached-VM lock check; omitting the key
  # keeps delete_disk behaviour byte-identical to prior releases.
  disk_delete_state_guard = p("pve.disk_delete_state_guard", "")
  config["disk_delete_state_guard"] = disk_delete_state_guard unless disk_delete_state_guard.to_s.empty?

  # Emit detached_disk_strategy only when set to a non-empty value. The Go
  # accessor defaults empty string to "free"; omitting the key preserves that
  # default and ensures byte-identical behaviour on existing deployments.
  detached_disk_strategy = p("pve.detached_disk_strategy", "")
  config["detached_disk_strategy"] = detached_disk_strategy unless detached_disk_strategy.to_s.empty?

  # Emit parked_disk_vmid_range_start only when non-zero. Zero (default) means
  # the field is unset; when strategy="parked" ApplyDefaults fills in 90000.
  # Omitting when zero ensures the Go zero-value reaches ApplyDefaults unchanged.
  v = p("pve.parked_disk_vmid_range_start", 0).to_i
  config["parked_disk_vmid_range_start"] = v unless v == 0

  # Emit parked_disk_vmid_range_end only when non-zero. Zero (default) means
  # the field is unset; when strategy="parked" ApplyDefaults fills in 90999.
  # Omitting when zero ensures the Go zero-value reaches ApplyDefaults unchanged.
  v = p("pve.parked_disk_vmid_range_end", 0).to_i
  config["parked_disk_vmid_range_end"] = v unless v == 0

  # Emit the SDN eventual-consistency poll knobs only when retries is non-zero.
  # Zero (default) disables both the create_network convergence poll and the
  # create_vm bridge gate; omitting the keys keeps both byte-identical to prior
  # releases. The timeout companion is emitted only when the gate is active.
  network_resolve_retries = p("pve.network_resolve_retries", 0).to_i
  unless network_resolve_retries == 0
    config["network_resolve_retries"] = network_resolve_retries
    network_resolve_timeout_sec = p("pve.network_resolve_timeout_sec", 0).to_i
    config["network_resolve_timeout_sec"] = network_resolve_timeout_sec unless network_resolve_timeout_sec == 0
  end

  # Emit the ephemeral-disk minimum-size invariant knobs only when the ratio is
  # non-zero. Zero (default) disables the check; omitting the key keeps create_vm
  # byte-identical. The mode companion is emitted only when set non-empty (it has
  # no effect unless the ratio is active).
  ephemeral_disk_min_ratio = p("pve.ephemeral_disk_min_ratio", 0).to_f
  unless ephemeral_disk_min_ratio == 0
    config["ephemeral_disk_min_ratio"] = ephemeral_disk_min_ratio
    ephemeral_disk_min_mode = p("pve.ephemeral_disk_min_mode", "")
    config["ephemeral_disk_min_mode"] = ephemeral_disk_min_mode unless ephemeral_disk_min_mode.to_s.empty?
  end

  # Emit health_check block only when the operator sets at least one sub-field.
  # When entirely absent, the Go nil *HealthCheckConfig means health polling is
  # off — byte-identical to prior releases. Individual sub-fields follow
  # omit-when-default: enabled only when true; timeout_sec/interval_sec only
  # when non-zero (Go accessors supply 300 s / 5 s defaults otherwise).
  health_check = {}
  if p("pve.health_check.enabled", false)
    health_check["enabled"] = true
  end
  hc_timeout = p("pve.health_check.timeout_sec", 0).to_i
  health_check["timeout_sec"] = hc_timeout unless hc_timeout == 0
  hc_interval = p("pve.health_check.interval_sec", 0).to_i
  health_check["interval_sec"] = hc_interval unless hc_interval == 0
  hc_agent_sha = p("pve.health_check.expected_agent_sha256", "")
  health_check["expected_agent_sha256"] = hc_agent_sha unless hc_agent_sha.to_s.empty?
  config["health_check"] = health_check unless health_check.empty?

  # Emit lb_register block only when the operator sets an endpoint. Required
  # when "lb_register" is in hooks; when absent the hook constructs inert.
  lb_register = {}
  lb_endpoint = p("pve.lb_register.endpoint", "")
  lb_register["endpoint"] = lb_endpoint unless lb_endpoint.to_s.empty?
  lb_backend = p("pve.lb_register.backend", "")
  lb_register["backend"] = lb_backend unless lb_backend.to_s.empty?
  lb_port = p("pve.lb_register.port", 0).to_i
  lb_register["port"] = lb_port unless lb_port == 0
  lb_user = p("pve.lb_register.user", "")
  lb_register["user"] = lb_user unless lb_user.to_s.empty?
  lb_password = p("pve.lb_register.password", "")
  lb_register["password"] = lb_password unless lb_password.to_s.empty?
  lb_ca = p("pve.lb_register.ca_cert", "")
  lb_register["ca_cert"] = lb_ca unless lb_ca.to_s.empty?
  if p("pve.lb_register.allow_private_ip", false)
    lb_register["allow_private_ip"] = true
  end
  lb_timeout = p("pve.lb_register.timeout_ms", 0).to_i
  lb_register["timeout_ms"] = lb_timeout unless lb_timeout == 0
  config["lb_register"] = lb_register unless lb_register.empty?

  # Emit external_command block only when the operator sets a command. Required
  # when "external_command" is in hooks; when absent the hook constructs inert.
  external_command = {}
  ec_command = p("pve.external_command.command", "")
  external_command["command"] = ec_command unless ec_command.to_s.empty?
  ec_args = p("pve.external_command.args", [])
  external_command["args"] = ec_args unless ec_args.nil? || ec_args.empty?
  ec_allowlist = p("pve.external_command.allowlist", [])
  external_command["allowlist"] = ec_allowlist unless ec_allowlist.nil? || ec_allowlist.empty?
  ec_env = p("pve.external_command.env_passlist", [])
  external_command["env_passlist"] = ec_env unless ec_env.nil? || ec_env.empty?
  ec_timeout = p("pve.external_command.timeout_ms", 0).to_i
  external_command["timeout_ms"] = ec_timeout unless ec_timeout == 0
  ec_methods = p("pve.external_command.methods", [])
  external_command["methods"] = ec_methods unless ec_methods.nil? || ec_methods.empty?
  config["external_command"] = external_command unless external_command.empty?

  # Emit metrics block only when metrics.enabled is explicitly true. Absent
  # (default false) means the MetricsHook is never registered — byte-identical
  # to prior releases and zero dispatch-path overhead.
  if p("pve.metrics.enabled", false)
    metrics = {}
    metrics["enabled"] = true
    metrics_path = p("pve.metrics.file_path", "")
    metrics["file_path"] = metrics_path unless metrics_path.to_s.empty?
    config["metrics"] = metrics
  end

  # Emit debug block only when a diagnostic mode is turned on. Absent (default)
  # means the Go nil *DebugConfig leaves all diagnostic modes off —
  # byte-identical to prior releases.
  debug = {}
  if p("pve.debug.keep_failed_vms", false)
    debug["keep_failed_vms"] = true
  end
  config["debug"] = debug unless debug.empty?

  # Emit the retry block only when the operator overrides at least one curve.
  # Each sub-policy and field is omit-when-zero so an untouched curve keeps the
  # Go accessor's shipped default (byte-identical to prior releases).
  retry_cfg = {}
  {
    "storage_import" => ["max_attempts", "base_ms", "cap_ms", "jitter_pct"],
    "vmid_alloc"     => ["max_attempts", "base_ms", "cap_ms"],
    "task_poll"      => ["base_ms", "cap_ms", "jitter_pct"],
    "pushback"       => ["base_ms", "cap_ms"],
    "storage_lock"   => ["max_attempts", "base_ms", "cap_ms", "jitter_pct"],
  }.each do |klass, fields|
    policy = {}
    fields.each do |f|
      v = p("pve.retry.#{klass}.#{f}", 0).to_i
      policy[f] = v unless v == 0
    end
    retry_cfg[klass] = policy unless policy.empty?
  end
  config["retry"] = retry_cfg unless retry_cfg.empty?

  # Per-node in-flight cap on mutating operations. Omitted when zero so the
  # default (unlimited) stays byte-identical to prior releases.
  max_inflight = p("pve.max_inflight_per_node", 0).to_i
  config["max_inflight_per_node"] = max_inflight unless max_inflight == 0

  # Emit strict_config_validation only when explicitly enabled. When absent or
  # false (the default) the key is omitted so the Go config zero-value
  # (nil *bool -> off -> warn-only) is preserved, byte-identical to prior
  # releases. When true the CPI fails fast on unknown keys and contradictory
  # cross-field combinations.
  if p("pve.strict_config_validation", false)
    config["strict_config_validation"] = true
  end

  # Emit operation_timeout only when explicitly enabled. The per-class seconds
  # are omit-when-zero so the Go accessors supply the built-in class defaults
  # (1800/900/120/600 s). When the block is absent the envelope is off.
  if p("pve.operation_timeout.enabled", false)
    operation_timeout = { "enabled" => true }
    { "create_sec"  => "pve.operation_timeout.create_sec",
      "delete_sec"  => "pve.operation_timeout.delete_sec",
      "query_sec"   => "pve.operation_timeout.query_sec",
      "default_sec" => "pve.operation_timeout.default_sec",
    }.each do |key, prop|
      v = p(prop, 0).to_i
      operation_timeout[key] = v unless v == 0
    end
    config["operation_timeout"] = operation_timeout
  end

  # Emit vm_types only when the operator defines at least one profile. When
  # absent or empty (the default {}), the key is omitted so the Go config
  # zero-value (nil map) is preserved and behavior is unchanged.
  vm_types = p("pve.vm_types", {})
  config["vm_types"] = vm_types unless vm_types.nil? || vm_types.empty?

  # Emit disk_types only when the operator defines at least one profile. When
  # absent or empty (the default {}), the key is omitted so the Go config
  # zero-value (nil map) is preserved and behavior is unchanged.
  disk_types = p("pve.disk_types", {})
  config["disk_types"] = disk_types unless disk_types.nil? || disk_types.empty?

  # Emit storage_tiers only when the operator defines at least one tier. When
  # absent or empty (the default {}), the key is omitted so the Go config
  # zero-value (nil map) is preserved and behavior is unchanged.
  storage_tiers = p("pve.storage_tiers", {})
  config["storage_tiers"] = storage_tiers unless storage_tiers.nil? || storage_tiers.empty?

  # Emit security_groups only when the operator supplies a non-empty list. When
  # absent or empty (the default []), the key is omitted so the Go config
  # zero-value (nil slice) is preserved and no global firewall groups are applied.
  security_groups = p("pve.security_groups", [])
  config["security_groups"] = security_groups unless security_groups.nil? || security_groups.empty?

  # Emit disk_performance only when the operator sets at least one sub-field.
  # When all sub-fields are unset the block is omitted entirely so the Go config
  # zero-value (nil *DiskPerformanceDefaults) is preserved — byte-identical to
  # prior releases. Each key follows its own omit-when-default contract:
  #   iothread/discard/ssd/virtio_scsi_single  bool  — omit when nil/unset
  #   cache                                    string — omit when empty
  #   mbps_rd/mbps_wr                          float  — omit when 0 or unset
  #   iops_rd/iops_wr                          int    — omit when 0 or unset
  disk_performance = {}

  # Boolean flags: emit only when the operator explicitly sets a value. The Go
  # struct uses *bool so nil (field absent from JSON) means "use Go zero" — here
  # we mirror by omitting when the property is unset in BOSH manifest. No default
  # in spec means p(..., nil) returns nil; if_p fires only when the operator set
  # the property.
  if_p("pve.disk_performance.iothread")           { |v| disk_performance["iothread"]           = v }
  if_p("pve.disk_performance.discard")            { |v| disk_performance["discard"]            = v }
  if_p("pve.disk_performance.ssd")                { |v| disk_performance["ssd"]                = v }
  if_p("pve.disk_performance.virtio_scsi_single") { |v| disk_performance["virtio_scsi_single"] = v }

  # String: emit only when non-empty.
  dp_cache = p("pve.disk_performance.cache", "")
  disk_performance["cache"] = dp_cache unless dp_cache.to_s.empty?

  # Floats: emit only when non-zero (zero means "no cap", same as omitted).
  dp_mbps_rd = p("pve.disk_performance.mbps_rd", 0.0).to_f
  disk_performance["mbps_rd"] = dp_mbps_rd unless dp_mbps_rd == 0.0
  dp_mbps_wr = p("pve.disk_performance.mbps_wr", 0.0).to_f
  disk_performance["mbps_wr"] = dp_mbps_wr unless dp_mbps_wr == 0.0

  # Integers: emit only when non-zero (zero means "no cap", same as omitted).
  dp_iops_rd = p("pve.disk_performance.iops_rd", 0).to_i
  disk_performance["iops_rd"] = dp_iops_rd unless dp_iops_rd == 0
  dp_iops_wr = p("pve.disk_performance.iops_wr", 0).to_i
  disk_performance["iops_wr"] = dp_iops_wr unless dp_iops_wr == 0

  config["disk_performance"] = disk_performance unless disk_performance.empty?

  # Emit stemcell only when the operator sets at least one sub-field.
  # When all sub-fields are unset the block is omitted entirely so the Go config
  # zero-value (nil *StemcellConfig) is preserved — byte-identical to prior
  # releases. Bool fields use if_p (no default in spec → nil when unset).
  # director_id uses p(..., "") with unless-empty guard.
  stemcell = {}
  if_p("pve.stemcell.provenance")    { |v| stemcell["provenance"]    = v }
  sc_dir_id = p("pve.stemcell.director_id", "")
  stemcell["director_id"] = sc_dir_id unless sc_dir_id.to_s.empty?
  if_p("pve.stemcell.prune_orphans") { |v| stemcell["prune_orphans"] = v }
  if_p("pve.stemcell.prune_dry_run") { |v| stemcell["prune_dry_run"] = v }
  config["stemcell"] = stemcell unless stemcell.empty?

  # Emit fast_path_delete only when the operator explicitly opts in. The Go
  # config defaults to synchronous await (false) when the key is absent, so
  # omitting it preserves byte-identical behavior on existing deployments.
  if_p("pve.fast_path_delete") { |v| config["fast_path_delete"] = v }

  # Emit operator_id only when the operator sets a non-empty value. When absent
  # the User-Agent defaults to "BOSH-PVE-CPI/<version>" with no suffix —
  # byte-identical to any prior release that did not configure operator_id.
  if_p("pve.operator_id") { |v| config["operator_id"] = v unless v.to_s.empty? }

  # Emit encrypted only when the operator explicitly opts in. The Go config
  # defaults to nil (no filter applied) when the key is absent, so omitting it
  # preserves byte-identical behavior on existing deployments.
  if_p("pve.encrypted") { |v| config["encrypted"] = v }

  JSON.dump(config)
%>
