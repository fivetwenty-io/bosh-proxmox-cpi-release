#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Manage the cloudfoundry deployment on the bosh-pve director.

Usage:
    ./scripts/cf <command> [args...]

Commands:
    deploy             Run all steps: runtime-config, cloud-config, stemcell, bosh-deploy.
    runtime-config     Upload the DNS runtime-config.
    cloud-config       Upload the cf cloud-config.
    stemcell           Upload the stemcell pinned by cf-deployment (skips if present).
    check-uaa-db       Fail fast if uaa schema is in the Flyway-rename trap.
    unstick-agent      Restart bosh-agent on an instance via PVE qga (bypasses NATS).
    bosh-deploy        Run only the bosh deploy step.
    compile-releases   Compile + pin the source haproxy release against the lab
                       stemcell so fresh-director deploys skip its build.
    teardown           Delete the CF deployment (--force). Skips if director unreachable
                       or deployment not found. Alias: delete-deployment.
    delete-deployment  Alias for teardown.
    api                Point the cf CLI at https://api.<system_domain>.
    login              cf api + cf login -u admin (password from credhub).
    admin-password     Print /ocfp-mgmt/cf/cf_admin_password from credhub.
    help               Show this message.

Extra args after the command are forwarded to the underlying bosh deploy
invocation (only meaningful for `deploy` and `bosh-deploy`).

Assumes:
    - bosh CLI is logged into the 'pve' alias (bosh -e pve env succeeds).
    - ~/w/cloudfoundry/cf-deployment is checked out.
    - ~/w/cloudfoundry/bosh-deployment is checked out (for the dns runtime config).
"""

from __future__ import annotations

import importlib.machinery as _ilm
import importlib.util as _ilu
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _compiled  # noqa: E402
import _lightstemcell  # noqa: E402

REPO_ROOT = Path(__file__).resolve().parent.parent
CF_DEPLOYMENT = Path(os.environ.get("CF_DEPLOYMENT", Path.home() / "w/cloudfoundry/cf-deployment"))
BOSH_DEPLOYMENT = Path(os.environ.get("BOSH_DEPLOYMENT", Path.home() / "w/cloudfoundry/bosh-deployment"))
ENV = os.environ.get("BOSH_ENV", "pve")
DEPLOYMENT = os.environ.get("BOSH_DEPLOYMENT_NAME", "cf")
BOSH_VARS = REPO_ROOT / "manifests" / "bosh" / "vars.yml"
BOSH_CREDS = REPO_ROOT / "manifests" / "bosh" / "creds.yml"

# Compiled-release cache for CF. Only the haproxy release compiles from source
# against the lab stemcell (the rest arrive compiled via cf-deployment's
# use-compiled-releases.yml), so `scripts/cf compile-releases` pins a compiled
# haproxy here and the deploy skips its ~3.5 min build on a fresh director.
COMPILE_DEPLOYMENT_CF = "compile-cf-releases"
COMPILED_OPS_CF = REPO_ROOT / "manifests" / "cf" / "compiled-releases.yml"
COMPILED_DIR_DEFAULT = REPO_ROOT / "compiled_releases"


def banner(title: str) -> None:
    print()
    print(f">>> {title}")
    print()


def run(*cmd: str) -> None:
    subprocess.run(cmd, check=True)


def run_env(extra_env: dict[str, str], *cmd: str) -> None:
    """Run *cmd* with the current process env merged with *extra_env*.

    Used when a subprocess must receive credentials via the environment
    rather than CLI arguments, to avoid leaking sensitive values into the
    process table.
    """
    env = {**os.environ, **extra_env}
    subprocess.run(cmd, check=True, env=env)


def capture(*cmd: str) -> str:
    return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout.strip()


def cmd_runtime_config(_extra: list[str]) -> None:
    banner("DNS runtime-config")
    run(
        "bosh", "-e", ENV, "-n", "update-runtime-config",
        str(BOSH_DEPLOYMENT / "runtime-configs/dns.yml"),
        "--name", "dns",
    )

    banner("PVE guest-agent runtime-config")
    run(
        "bosh", "-e", ENV, "-n", "update-runtime-config",
        "manifests/runtime-configs/pve-guest-agent.yml",
        "--name", "pve-guest-agent",
    )


def _env_cf_cloud_config_ops() -> list[str]:
    """Return -o flags for the active env's CF cloud-config layer.

    BOSH_PVE_ENV selects manifests/envs/<env>/cf-cloud-config.yml when present;
    unset or missing file means no layer applied. Pairs with the director
    network layer applied by scripts/bosh — skipping one re-triggers the
    tailscale LAN route hazard (memory: tailscale-lan-route-hazard).
    """
    env_name = os.environ.get("BOSH_PVE_ENV", "").strip()
    if not env_name:
        return []
    layer = REPO_ROOT / "manifests" / "envs" / env_name / "cf-cloud-config.yml"
    if not layer.exists():
        return []
    return ["-o", str(layer)]


def _env_vars_layer() -> list[str]:
    """Return `-l <env vars.yml>` for the active env, layered LAST so it wins.

    BOSH_PVE_ENV selects manifests/envs/<env>/vars.yml when present. Placed
    after manifests/cf/vars.yml on the command line so the env's network
    overrides (internal_cidr, internal_gw, haproxy_private_ip,
    pve_network_bridge) take precedence over the base/CF defaults — this is
    what moves CF onto the env's isolated network. Pairs with the director
    layer applied by scripts/bosh.
    """
    env_name = os.environ.get("BOSH_PVE_ENV", "").strip()
    if not env_name:
        return []
    layer = REPO_ROOT / "manifests" / "envs" / env_name / "vars.yml"
    if not layer.exists():
        return []
    return ["-l", str(layer)]


def _bosh_var(json_path: str) -> str:
    """Read a var, preferring the active env's vars.yml over the base vars.

    The active env (BOSH_PVE_ENV) may override Director-network vars such as
    internal_ip; resolving them env-first keeps credhub/login pointed at the
    Director's real address when it has been moved onto an isolated network.
    """
    env_name = os.environ.get("BOSH_PVE_ENV", "").strip()
    if env_name:
        layer = REPO_ROOT / "manifests" / "envs" / env_name / "vars.yml"
        if layer.exists():
            res = subprocess.run(
                ["bosh", "int", str(layer), f"--path={json_path}"],
                capture_output=True, text=True,
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout.strip()
    return capture("bosh", "int", str(BOSH_VARS), f"--path={json_path}")


def cmd_cloud_config(_extra: list[str]) -> None:
    banner("Cloud-config")
    run(
        "bosh", "-e", ENV,  "-n","update-cloud-config",
        "manifests/cf/cloud-config.yml",
        *_env_cf_cloud_config_ops(),
        "-l", "manifests/bosh/vars.yml",
        "-l", "manifests/cf/vars.yml",
        *_env_vars_layer(),
    )


STEMCELL_CACHE = REPO_ROOT / "dev_releases" / "stemcell-cache"


def _light_int_opt(json_path: str) -> str:
    """Read one var from manifests/bosh/vars.yml, "" when absent."""
    res = subprocess.run(
        ["bosh", "int", str(BOSH_VARS), f"--path={json_path}"],
        capture_output=True, text=True,
    )
    return res.stdout.strip() if res.returncode == 0 else ""


def stemcell_os_version() -> "tuple[str, str]":
    """(os, version) parsed from manifests/bosh/vars.yml stemcell_url, so the
    CF deployment stemcell pin and the uploaded light record stay in lockstep
    with the heavy source and the compiled-release cache."""
    return _lightstemcell.parse_os_version(_light_int_opt("/stemcell_url"))


def ensure_light_stemcell() -> "_lightstemcell.LightStemcell":
    """Ensure the light stemcell is on PVE and return its descriptor (manifest)."""
    source_url = _light_int_opt("/stemcell_url")
    source_sha1 = _light_int_opt("/stemcell_sha1")
    os_name, version = _lightstemcell.parse_os_version(source_url)
    mode = _light_int_opt("/light_stemcell_mode") or "preuploaded"
    fetch_url = _light_int_opt("/stemcell_fetch_url")
    token = _light_int_opt("/stemcell_fetch_token")
    cpi_cfg = _lightstemcell.pve_cfg_from_bosh_vars(BOSH_VARS)
    print(f"    light stemcell ({mode}): {os_name} {version}")
    return _lightstemcell.ensure_light_stemcell(
        cpi_cfg=cpi_cfg, mode=mode, os_name=os_name, version=version,
        source_url=source_url, source_sha1=source_sha1,
        cache_dir=str(STEMCELL_CACHE),
        image_url=(fetch_url or None), token=(token or None),
        build_create_env_tarball=False,
    )


def cmd_stemcell(_extra: list[str]) -> None:
    banner("Stemcell (light)")
    light = ensure_light_stemcell()
    # --fix re-registers the version if a record already exists; the qcow2
    # upload itself fast-paths on the cached SHA, so re-runs are cheap.
    run("bosh", "-e", ENV, "-n", "upload-stemcell", str(light.manifest_path), "--fix")


def _cf_has_database_vm() -> bool:
    """True when deployment DEPLOYMENT has a `database` instance with a live VM.

    The uaa Flyway probe SSHes into database/0, which only exists once the
    deployment has been deployed at least once. On a fresh director — or
    after teardown, where the deployment record can linger with zero VMs
    (e.g. a deploy that failed at create_vm) — there is no VM to probe and
    no uaa schema to corrupt. In that state `bosh ssh database/0` fails with
    "No instance with a VM ... matched filter", whose detail lives in the
    task result, not the ssh stderr, so string-matching the error is
    unreliable. Probe `bosh vms` (lists only instances that HAVE a VM)
    instead: absent deployment or no database VM → skip the check.
    """
    r = subprocess.run(
        ["bosh", "-e", ENV, "-d", DEPLOYMENT, "--json", "vms"],
        capture_output=True, text=True, check=False,
    )
    if r.returncode != 0:
        return False
    try:
        rows = json.loads(r.stdout)["Tables"][0]["Rows"]
    except (KeyError, IndexError, TypeError, json.JSONDecodeError):
        return False
    return any(
        (row.get("instance") or "").startswith("database/") and row.get("vm_cid")
        for row in rows
    )


def cmd_check_uaa_db(_extra: list[str]) -> None:
    """Fail fast if the uaa Flyway history has a failed migration row.

    UAA's Flyway history table (`schema_version`) records every
    migration with a `success` flag. If a migration is interrupted (JVM
    killed, deploy aborted, OOM) after a DDL statement commits but
    before the row is finalized, MySQL keeps the schema change (DDL
    auto-commits in MySQL) while Flyway records `success=0`. The next
    UAA boot retries that migration and the DDL fails with "Duplicate
    column" / "Table already exists", looping forever.

    Because the loop sits inside bpm restarts, the BOSH agent's
    get_state RPC starves and the deploy surfaces a generic
    `Timed out sending 'get_state' to instance: uaa/...` error that
    gives no clue about Flyway. This check trips early with a
    remediation hint.
    """
    banner("uaa DB pre-deploy check")
    if not _cf_has_database_vm():
        # Fresh deploy (or a deployment record left with zero VMs): no
        # database/0 to probe and no uaa schema to corrupt. Skip cleanly.
        print("    skipped (no database VM present yet)")
        return
    probe = (
        "set -e; "
        "cnf=/var/vcap/jobs/pxc-mysql/config/mylogin.cnf; "
        "if [ ! -f $cnf ]; then echo SKIP_NO_PXC; exit 0; fi; "
        "mysql=$(find /var/vcap/data/packages -path '*percona-xtradb-cluster*/bin/mysql' "
        "| sort | tail -1); "
        "if [ -z \"$mysql\" ]; then echo SKIP_NO_MYSQL_BIN; exit 0; fi; "
        "q='SELECT COUNT(*) FROM schema_version WHERE success=0'; "
        "out=$(sudo $mysql --defaults-file=$cnf uaa -BNe \"$q\" 2>&1) || { echo \"$out\" | grep -q 'Unknown database' "
        "&& { echo OK_DB_MISSING; exit 0; }; echo \"$out\" | grep -q \"doesn.t exist\" "
        "&& { echo OK_FRESH; exit 0; }; echo PROBE_ERROR: $out; exit 0; }; "
        "echo FAILED_ROWS=$out"
    )
    result = subprocess.run(
        ["bosh", "-e", ENV, "-d", DEPLOYMENT, "ssh", "database/0", "-c", probe, "-r"],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0:
        stderr_snippet = (result.stderr or "").strip()
        # On a fresh director the deployment does not yet exist; there is no
        # database/0 to probe and no UAA schema to corrupt. Treat that as a
        # clean precondition rather than a check failure.
        if "doesn't exist" in stderr_snippet or "doesn’t exist" in stderr_snippet:
            print("    skipped (cf deployment not yet present)")
            return
        raise RuntimeError(
            f"bosh ssh to database/0 failed (rc={result.returncode}).\n"
            f"stderr: {stderr_snippet[-500:]}"
        )
    out = (result.stdout or "") + (result.stderr or "")
    if any(tok in out for tok in ("OK_DB_MISSING", "OK_FRESH", "SKIP_NO_PXC", "SKIP_NO_MYSQL_BIN")):
        print("    skipped (uaa schema or pxc not yet provisioned)")
        return
    if "PROBE_ERROR" in out:
        raise RuntimeError(
            f"uaa DB probe returned PROBE_ERROR — bosh ssh succeeded but the remote "
            f"script reported a non-recoverable error.\n"
            f"Output: {out.strip().splitlines()[-1][:500]}"
        )
    match = re.search(r"FAILED_ROWS=(\d+)", out)
    if not match:
        raise RuntimeError(
            f"uaa DB probe output could not be parsed; cannot confirm schema health.\n"
            f"Raw output (last 500 chars): {out[-500:]}"
        )
    failed = int(match.group(1))
    if failed > 0:
        sys.exit(
            f"\n  uaa Flyway history has {failed} migration row(s) with success=0.\n"
            "  A partial DDL has already been applied to the schema; the next UAA\n"
            "  boot will retry the migration, hit a duplicate-object error and\n"
            "  crashloop until the agent's get_state RPC times out.\n\n"
            "  Remediation (uaa rebuilds its own seed data on next boot):\n"
            f"    bosh -e {ENV} -d {DEPLOYMENT} ssh database/0 -c \"sudo $(find /var/vcap/data/packages \\\n"
            "        -path '*percona-xtradb-cluster*/bin/mysql' | sort | tail -1) \\\n"
            "        --defaults-file=/var/vcap/jobs/pxc-mysql/config/mylogin.cnf \\\n"
            "        -e 'DROP DATABASE uaa; CREATE DATABASE uaa CHARACTER SET utf8mb4 \\\n"
            "        COLLATE utf8mb4_unicode_ci; GRANT ALL PRIVILEGES ON uaa.* TO uaa@\\\"%\\\"; \\\n"
            "        FLUSH PRIVILEGES;'\"\n"
            f"    bosh -e {ENV} -d {DEPLOYMENT} recreate uaa\n"
        )
    print("    OK")


def _qga_ping(
    ssh_opts: list[str],
    pve_host: str,
    vmid: int,
    max_wait_s: int,
) -> tuple[bool, str]:
    """Probe whether qemu-guest-agent on `vmid` is responsive via PVE host.

    Polls `qm guest cmd <vmid> ping` until QGA replies or max_wait_s
    seconds elapse. The detached install in the `pve-guest-agent`
    runtime-config addon can take a few seconds after the VM reaches
    multi-user.target before QGA is reachable, so a short wait avoids
    spurious failures during the install window.

    Returns (True, "") on success; (False, last_stderr_or_stdout) on
    timeout so the caller can include the underlying PVE error in its
    diagnostic message.
    """
    deadline = time.monotonic() + max_wait_s
    last = ""
    while True:
        r = subprocess.run(
            ["ssh", *ssh_opts, f"root@{pve_host}",
             "qm", "guest", "cmd", str(vmid), "ping"],
            capture_output=True, text=True, check=False, timeout=15,
        )
        last = ((r.stdout or "") + (r.stderr or "")).strip()
        if r.returncode == 0:
            return True, ""
        if time.monotonic() >= deadline:
            return False, last
        time.sleep(2)


def _coerce_vmid(raw_cid: str) -> int:
    """Parse a PVE VMID string to a positive integer.

    Raises ValueError with a specific message when the value is not a
    valid integer, preventing injection of arbitrary strings into
    downstream subprocess arguments.
    """
    try:
        vmid = int(raw_cid)
    except (ValueError, TypeError):
        raise ValueError(
            f"PVE VMID must be an integer; got {raw_cid!r}. "
            "Check that 'bosh vms --column=vm_cid' returned a numeric VMID."
        )
    if vmid <= 0:
        raise ValueError(
            f"PVE VMID must be a positive integer; got {vmid!r}."
        )
    return vmid


def cmd_unstick_agent(extra: list[str]) -> None:
    """Force-restart the BOSH agent on an instance via PVE qemu-guest-agent.

    The director's RPC channel (NATS mbus) into a long-lived agent can
    wedge after a sustained crashloop on the VM — the agent keeps
    sending heartbeats but stops replying to `get_state` / `run_script`
    inside the 45s budget, and every subsequent deploy fails with
    `Timed out sending '<action>' to instance: <inst>` even after the
    underlying workload is healthy.

    `bosh ssh` itself goes through the same wedged channel so it is
    not a recovery tool here. We bypass BOSH entirely: look up the PVE
    VMID from `bosh vms`, ssh into the PVE host, and use
    `qm guest exec <vmid>` to issue `systemctl restart bosh-agent`
    directly inside the VM.

    Usage: ./scripts/cf unstick-agent <instance>
        instance: bosh-style identifier ("uaa/0", "diego-cell/<uuid>")

    SSH host-key checking:
        By default, SSH validates the PVE host key against ~/.ssh/known_hosts.
        Set SCRIPTS_CF_SSH_UNSAFE=1 to disable host-key checking (for
        first-boot or test environments where the host key is not yet trusted).
        WARNING: SCRIPTS_CF_SSH_UNSAFE=1 exposes the connection to MITM attacks.
        Never use in production.

    QGA availability:
        The BOSH Noble stemcell ships neither cloud-init nor
        qemu-guest-agent. The `pve-guest-agent` runtime-config addon
        installs QGA via a detached apt run on first boot — which runs
        AFTER bosh-agent reaches NATS. If bosh-agent itself wedges before
        that point, QGA is never installed and `qm guest exec` has no
        in-guest channel to recover the agent.

        unstick-agent probes QGA via `qm guest cmd <vmid> ping` before
        attempting the restart and waits up to SCRIPTS_CF_QGA_WAIT
        seconds (default 30) for the install window to settle. On
        timeout it exits with an actionable diagnostic rather than the
        raw guest-exec failure.
    """
    if not extra:
        sys.exit("usage: scripts/cf unstick-agent <instance>")
    target = extra[0]
    banner(f"unstick-agent {target}")

    raw = capture(
        "bosh", "-e", ENV, "-d", DEPLOYMENT, "vms",
        "--column=instance", "--column=vm_cid",
    )
    raw_cid = None
    for line in raw.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        inst, vm_cid = parts[0], parts[1]
        if inst == target:
            raw_cid = vm_cid
            break
        job, sep, ref = inst.partition("/")
        if sep and (target == job or target == f"{job}/{ref}"):
            raw_cid = vm_cid
            break
        try:
            idx = int(target.split("/", 1)[1])
        except (ValueError, IndexError):
            idx = None
        if idx is not None and target.split("/", 1)[0] == job:
            raw_cid = vm_cid
            break
    if not raw_cid:
        sys.exit(f"no VM cid found for instance {target!r} in deployment {DEPLOYMENT}")

    # Coerce to int before any use — rejects injection strings like "123; rm -rf /"
    # and ensures the VMID is safe to pass as a discrete argv element.
    try:
        vmid = _coerce_vmid(raw_cid)
    except ValueError as exc:
        sys.exit(f"invalid VM cid for instance {target!r}: {exc}")

    print(f"    instance {target} -> PVE vmid {vmid}")

    pve_host = capture("bosh", "int", str(BOSH_VARS), "--path=/pve_host")
    print(f"    pve host: {pve_host}")

    # Build SSH options. StrictHostKeyChecking is enabled by default so the
    # user's known_hosts is consulted and a bogus host key is rejected.
    # Operators who need to bypass the check for first-time host-key acceptance
    # must set SCRIPTS_CF_SSH_UNSAFE=1 explicitly.
    ssh_opts: list[str] = ["-o", "BatchMode=yes"]
    if os.environ.get("SCRIPTS_CF_SSH_UNSAFE") == "1":
        print(
            "    WARNING: SCRIPTS_CF_SSH_UNSAFE=1 — SSH host-key checking is disabled. "
            "Do not use in production."
        )
        ssh_opts += ["-o", "StrictHostKeyChecking=no"]

    try:
        qga_wait_s = int(os.environ.get("SCRIPTS_CF_QGA_WAIT", "30"))
    except ValueError:
        qga_wait_s = 30
    print(f"    probing qemu-guest-agent (up to {qga_wait_s}s)...")
    qga_ok, qga_diag = _qga_ping(ssh_opts, pve_host, vmid, qga_wait_s)
    if not qga_ok:
        sys.exit(
            f"qemu-guest-agent on vmid {vmid} did not respond within {qga_wait_s}s.\n"
            f"Last `qm guest cmd <vmid> ping` output:\n  {qga_diag or '(no output)'}\n\n"
            "The BOSH Noble stemcell does not pre-install qemu-guest-agent;\n"
            "the `pve-guest-agent` runtime-config addon installs it via a\n"
            "detached apt run on first boot, AFTER bosh-agent reaches NATS.\n"
            "When bosh-agent never reaches NATS (the wedge this command\n"
            "unsticks), the install never runs and there is no in-guest\n"
            "recovery channel.\n\n"
            "Options:\n"
            f"  - Increase the wait: SCRIPTS_CF_QGA_WAIT=120 ./scripts/cf unstick-agent {target}\n"
            f"  - Recreate the VM:    bosh -d {DEPLOYMENT} recreate {target}\n"
            "  - Install qemu-guest-agent by hand via the PVE VM console.\n"
            "  - Check the addon's install log on the VM (once reachable):\n"
            "      /var/vcap/sys/log/pve-guest-agent/install.log"
        )
    print("    qemu-guest-agent responsive")

    probe = (
        "set -e; "
        "systemctl restart bosh-agent && "
        "sleep 3 && "
        "systemctl is-active bosh-agent"
    )
    print("    restarting bosh-agent via qemu-guest-agent...")
    # argv list prevents shell injection — vmid is an int, pve_host is a plain
    # hostname string (no shell expansion). shlex.quote wraps the probe so the
    # remote shell receives it as a single argument.
    result = subprocess.run(
        [
            "ssh",
            *ssh_opts,
            f"root@{pve_host}",
            "qm", "guest", "exec", str(vmid), "--timeout", "20",
            "--", "/bin/sh", "-c", probe,
        ],
        capture_output=True, text=True, check=False,
    )
    out = (result.stdout or "") + (result.stderr or "")
    if result.returncode != 0 or '"exitcode" : 0' not in out:
        sys.exit(f"qm guest exec failed (rc={result.returncode}):\n{out}")
    if "active" not in out:
        sys.exit(f"agent did not report active:\n{out}")
    print("    bosh-agent active")


def _list_instances_json() -> "list[dict] | None":
    """Return instance rows for DEPLOYMENT, or None when it is absent/unqueryable.

    None means "do not wait" — either the deployment does not exist yet (fresh
    deploy creates VMs) or the director could not be queried this instant.

    Uses `bosh vms` (not `instances`) because only `vms` includes vm_cid, which
    the reboot-based recovery needs to map an unresponsive agent to its VMID.
    """
    result = subprocess.run(
        ["bosh", "-e", ENV, "-d", DEPLOYMENT, "vms", "--json"],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)["Tables"][0]["Rows"]
    except (ValueError, KeyError, IndexError):
        return None


def _unresponsive_instances(rows: "list[dict]") -> "list[tuple[str, str]]":
    """Return (instance, vm_cid) for every instance whose agent is unresponsive."""
    return [
        (r.get("instance", "?"), str(r.get("vm_cid", "")).strip())
        for r in rows
        if "unresponsive" in (r.get("process_state") or "").lower()
    ]


def wait_agents_responsive(timeout_s: int, settle_reads: int = 2, poll_s: int = 15) -> bool:
    """Block until every agent in DEPLOYMENT answers the director, or *timeout_s*.

    cf-deployment's "Preparing deployment" phase issues get_state to every
    instance and aborts the whole deploy if any single one times out (45s). On
    this lab the director<->agent NATS RPCs are intermittently lost while a new
    or changed agent is (re)authorized onto NATS (see
    manifests/bosh/nats-tuning.yml header), so an agent can show "unresponsive
    agent" transiently. The agent's NATS client reconnects on its own within a
    few seconds, so this preflight is PASSIVE: it only waits for a run of
    consecutive all-responsive reads and lets transient churn self-heal.

    It deliberately does NOT reset/restart unresponsive agents. An earlier
    version issued `qm reset` on any agent that looked unresponsive; because the
    churn is transient and self-healing, that reset (≈90s of real downtime)
    fought the recovery and made the deploy flap — resetting agents that would
    have answered on their own. Recovery is left to the agent's own reconnect
    and to the retry loop in cmd_bosh_deploy.

    Returns True when the deployment is absent (nothing to wait for) or all
    agents are responsive; False on timeout.
    """
    banner("agent-stable preflight")
    deadline = time.time() + timeout_s
    clean_streak = 0
    while time.time() < deadline:
        rows = _list_instances_json()
        if rows is None:
            print("    deployment not present (or director busy); skipping wait")
            return True
        bad = _unresponsive_instances(rows)
        if not bad:
            clean_streak += 1
            print(f"    all agents responsive ({clean_streak}/{settle_reads})")
            if clean_streak >= settle_reads:
                return True
        else:
            clean_streak = 0
            names = ", ".join(i for i, _ in bad)
            print(f"    unresponsive (waiting for self-heal): {names}")
        time.sleep(poll_s)
    print(f"    timed out after {timeout_s}s waiting for responsive agents")
    return False


def _pve_ssh_opts() -> list[str]:
    """SSH options for reaching the PVE host.

    StrictHostKeyChecking stays on by default (the PVE host key is validated
    against ~/.ssh/known_hosts). Set SCRIPTS_CF_SSH_UNSAFE=1 to bypass it for
    first-boot/test environments — this exposes the connection to MITM, never
    use it in production.
    """
    opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
    if os.environ.get("SCRIPTS_CF_SSH_UNSAFE") == "1":
        opts += ["-o", "StrictHostKeyChecking=no"]
    return opts


def _pve_host() -> "str | None":
    """Resolve the PVE host from manifests/bosh/vars.yml, or None on failure."""
    try:
        return capture("bosh", "int", str(BOSH_VARS), "--path=/pve_host")
    except subprocess.CalledProcessError:
        return None


def _pve_reset_vmid(ssh_opts: list[str], pve_host: str, vmid: int) -> "tuple[bool, str]":
    """Hard-reset a VM via the PVE host (`qm reset`).

    Recovers a black-holed bosh-agent: the guest OS stays healthy (sshd up,
    disk fine) but the agent stopped servicing NATS RPC after its mbus
    connection broke (the NATS server logs the close as a TCP "Read Error") and
    never re-subscribed its RPC inbox. A reset restarts the agent, which
    reconnects and re-subscribes cleanly, so the deploy's retry converges.
    `qm reset` (hard) is used rather than `qm reboot`
    (graceful ACPI) because a graceful shutdown can stall trying to stop the
    wedged bosh-agent/monit; the guest filesystem is journaled, so a hard reset
    is safe here.
    """
    r = subprocess.run(
        ["ssh", *ssh_opts, f"root@{pve_host}", "qm", "reset", str(vmid)],
        capture_output=True, text=True, check=False, timeout=30,
    )
    return r.returncode == 0, ((r.stdout or "") + (r.stderr or "")).strip()


def _vm_cid_for_instance(inst: str) -> "str | None":
    """Return the PVE VMID (vm_cid) for a bosh instance ('job/uuid'), or None."""
    rows = _list_instances_json()
    if not rows:
        return None
    for r in rows:
        if r.get("instance") == inst:
            cid = str(r.get("vm_cid", "")).strip()
            return cid or None
    return None


def _make_agent_recovery() -> "callable | None":
    """Build a recovery callback that hard-resets the VM of a wedged agent.

    During a cf deploy an agent's NATS mbus connection can break (the NATS
    server logs the close as a TCP "Read Error"); the agent reconnects at TCP
    but never re-subscribes its RPC inbox, so the director's get_task/get_state
    times out and the instance update fails. That agent never self-heals — only
    an agent restart recovers it. The watchdog pump
    calls this callback the instant the director prints such a timeout for an
    instance; it maps the instance to its VMID and `qm reset`s exactly that VM,
    so the next deploy attempt finds a healthy, re-subscribed agent.

    Returns None (recovery disabled) when SCRIPTS_CF_AGENT_REBOOT=0 or the PVE
    host cannot be resolved. A per-instance cooldown
    (SCRIPTS_CF_REBOOT_COOLDOWN, default 180s) collapses a burst of repeated
    timeout lines into at most one reset per window so a still-booting VM is not
    reset again before its agent has had a chance to come back.
    """
    if os.environ.get("SCRIPTS_CF_AGENT_REBOOT", "1") == "0":
        return None
    pve_host = _pve_host()
    if not pve_host:
        print("    [watcher] PVE host unresolved; agent-reboot recovery disabled")
        return None
    ssh_opts = _pve_ssh_opts()
    cooldown_s = int(os.environ.get("SCRIPTS_CF_REBOOT_COOLDOWN", "180") or "180")
    last_reset: "dict[str, float]" = {}
    lock = threading.Lock()

    def recover(inst: str) -> None:
        now = time.monotonic()
        with lock:
            if now - last_reset.get(inst, float("-inf")) < cooldown_s:
                return
            last_reset[inst] = now
        cid = _vm_cid_for_instance(inst)
        if not cid:
            print(f"    [watcher] {inst}: no vm_cid found; cannot reset")
            return
        try:
            vmid = _coerce_vmid(cid)
        except ValueError as exc:
            print(f"    [watcher] {inst}: {exc}")
            return
        print(
            f"    [watcher] {inst} agent RPC timed out — hard-resetting vmid {vmid} "
            "to recover the wedged agent"
        )
        ok, out = _pve_reset_vmid(ssh_opts, pve_host, vmid)
        print(f"    [watcher] {inst}: qm reset " + ("issued" if ok else f"FAILED: {out[:200]}"))

    return recover


def _run_deploy_with_watchdog(deploy_cmd: list[str], stall_s: int, recover_cb=None) -> int:
    """Run a bosh deploy, cancelling its task if progress stalls.

    BOSH has no deploy-level timeout. When an agent's mbus connection breaks and
    it never re-subscribes its RPC inbox (the NATS server logs the close as a TCP
    "Read Error"; mechanism still under investigation), a long-running pre-stop /
    drain get_task poll to that agent can wedge: the reply is lost, the
    director's poll never recovers, and the deploy task hangs indefinitely while
    holding the deployment lock (observed at 9h). The hung task never errors, so
    the retry loop below — which only fires on a non-zero exit — can never
    recover from it.

    `bosh deploy` streams staged progress to stdout continuously, so a hang
    shows up as stdout going silent. This watchdog times the gap between output
    lines; once it exceeds stall_s it parses the running task id from the stream
    and `bosh cancel-task`s it. Cancelling makes `bosh deploy` exit non-zero and
    releases the lock, so the existing recover-and-retry loop converges instead
    of blocking forever. stall_s must exceed the longest legitimately-silent
    step (UAA boot, package install); 900s is well clear of those on this lab
    (compiled releases, so no compilation).
    """
    proc = subprocess.Popen(
        deploy_cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, bufsize=1,
    )
    state = {"last": time.monotonic(), "task_id": None, "cancelled": False}
    task_re = re.compile(r"Task (\d+)")
    # The director prints this verbatim when an agent RPC times out (the wedge
    # signature). Capturing the instance lets recover_cb hard-reset exactly that
    # VM so the retry finds a healthy, re-subscribed agent.
    timeout_re = re.compile(r"Timed out sending '[^']+' to instance: '([^']+)'")

    def pump() -> None:
        # proc.stdout is line-buffered; this blocks per line and updates the
        # liveness timestamp, so silence (a hang) is detectable by the watcher.
        assert proc.stdout is not None
        for line in proc.stdout:
            state["last"] = time.monotonic()
            match = task_re.search(line)
            if match:
                state["task_id"] = match.group(1)
            if recover_cb is not None:
                tmatch = timeout_re.search(line)
                if tmatch:
                    # Reset the wedged VM off the pump thread so output keeps
                    # flowing while qm reset runs over SSH.
                    threading.Thread(
                        target=recover_cb, args=(tmatch.group(1),), daemon=True
                    ).start()
            sys.stdout.write(line)
            sys.stdout.flush()

    pump_thread = threading.Thread(target=pump, daemon=True)
    pump_thread.start()

    while proc.poll() is None:
        time.sleep(5)
        if state["cancelled"] or time.monotonic() - state["last"] <= stall_s:
            continue
        state["cancelled"] = True
        tid = state["task_id"]
        print(
            f"\n>>> deploy stalled: no progress for {stall_s}s; "
            f"cancelling task {tid or '(unknown)'} to release the lock and retry"
        )
        if tid:
            subprocess.run(
                ["bosh", "-e", ENV, "-n", "cancel-task", tid], check=False,
            )
        else:
            # No task id seen yet (stall before the task started); kill the
            # client so the loop can retry.
            proc.terminate()

    pump_thread.join(timeout=10)
    rc = proc.wait()
    # A stall-cancel can still let bosh exit 0 in a race; force non-zero so the
    # caller treats it as a failed attempt and retries.
    if state["cancelled"] and rc == 0:
        return 1
    return rc


def cmd_bosh_deploy(extra: list[str]) -> None:
    banner("Deploy")
    # The deployment stemcell is pinned to the standardized ubuntu-noble version
    # via ops-light-stemcell.yml. cf-deployment's use-compiled-releases.yml must
    # provide compiled releases for this exact version (or be dropped so BOSH
    # compiles from source) — otherwise the deploy fails with no compiled package.
    print(f"    stemcell pinned: ubuntu-noble {stemcell_os_version()[1]} "
          "(compiled releases must match this version)")
    # Preflight: converge the agent baseline before the get_state-heavy
    # "Preparing deployment" phase. SCRIPTS_CF_AGENT_WAIT seconds (0 disables).
    preflight_s = int(os.environ.get("SCRIPTS_CF_AGENT_WAIT", "600") or "600")
    if preflight_s > 0:
        wait_agents_responsive(preflight_s)
    deploy_cmd = [
        "bosh", "-e", ENV, "-n", "-d", DEPLOYMENT, "deploy",
        str(CF_DEPLOYMENT / "cf-deployment.yml"),
        "-o", str(CF_DEPLOYMENT / "operations/use-compiled-releases.yml"),
        "-o", str(CF_DEPLOYMENT / "operations/use-haproxy.yml"),
        # Pin the compiled haproxy release (built by `cf compile-releases`) so a
        # fresh-director deploy skips its ~3.5 min source build. Layered right
        # after use-haproxy.yml (which adds the source release) so the compiled
        # url wins; a missing/stale cache yields [] and falls back to source.
        *compiled_ops_layer(),
        # cf-deployment stock ops file: removes policy-server-asg-syncer
        # from the api instance group. The job had been flapping every
        # ~90s (HTTP retries against CC during ccdb churn) which made
        # the api VM look unhealthy to HM and triggered recreate loops.
        # The lab has no use for dynamic ASG sync.
        "-o", str(CF_DEPLOYMENT / "operations/disable-dynamic-asgs.yml"),
        "-o", "manifests/cf/ops-serialize-deploy.yml",
        "-o", "manifests/cf/ops-resize-cf.yml",
        # Lab-local NATS-storm remediation. See header comments in each
        # ops file for the rationale and rollback path.
        "-o", "manifests/cf/gorouter-tuning.yml",
        "-o", "manifests/cf/route-registrar-tuning.yml",
        # Canary updates deadlock when haproxy cannot resolve DNS for
        # not-yet-updated routers. Lab tolerates full-rollout signal;
        # the rolling-deploy safety net is not needed here.
        "-o", "manifests/cf/no-canaries.yml",
        # Lift the per-IG serial:true barriers on the stateless route tier and
        # let diego-cell's two instances update in one wave. Layered after
        # ops-serialize-deploy.yml/no-canaries.yml so the per-group overrides win.
        "-o", "manifests/cf/ops-deserialize-igs.yml",
        # Pin the deployment stemcell to the standardized ubuntu-noble light
        # stemcell uploaded by cmd_stemcell (matched by os+version).
        "-o", "manifests/cf/ops-light-stemcell.yml",
        "-l", "manifests/bosh/vars.yml",
        "-l", "manifests/cf/vars.yml",
        "-v", f"stemcell_version={stemcell_os_version()[1]}",
        *_env_vars_layer(),
        *extra,
    ]

    # Retry loop. Director<->agent "unresponsive agent" / get_state timeouts
    # (see manifests/bosh/nats-tuning.yml header) typically self-resolve within
    # 30-60s, but BOSH's "Preparing deployment" phase does not retry on its
    # own. A `bosh cloud-check --auto` pass between attempts recovers the
    # affected agent so the next try proceeds. A large foundation's prepare
    # phase needs every agent responsive in one window, and a different agent
    # can flap each attempt, so the default is several attempts. Tune via
    # SCRIPTS_CF_DEPLOY_ATTEMPTS; a persistent (non-flap) failure still
    # surfaces after the cap.
    max_attempts = max(1, int(os.environ.get("SCRIPTS_CF_DEPLOY_ATTEMPTS", "8") or "8"))
    # Watchdog stall threshold: if the deploy emits no progress for this long the
    # task is cancelled so a wedged pre-stop/drain poll cannot hang forever
    # holding the lock. 0 disables the watchdog (plain blocking run).
    stall_s = int(os.environ.get("SCRIPTS_CF_DEPLOY_STALL_S", "900") or "900")
    # Concurrent recovery: hard-reset any VM whose agent black-holes mid-deploy
    # (its NATS mbus connection breaks — the server logs a TCP "Read Error" — and
    # it never re-subscribes its RPC inbox; a wedge that never self-heals). Runs
    # via the watchdog's output pump, so
    # it is active whenever the watchdog is (stall_s > 0). SCRIPTS_CF_AGENT_REBOOT=0
    # disables it.
    recover_cb = _make_agent_recovery()
    if recover_cb is not None and stall_s <= 0:
        print(
            "    [watcher] note: agent-reboot recovery rides the stall watchdog; "
            "set SCRIPTS_CF_DEPLOY_STALL_S>0 to enable it"
        )
    for attempt in range(1, max_attempts + 1):
        if stall_s > 0:
            rc = _run_deploy_with_watchdog(deploy_cmd, stall_s, recover_cb)
        else:
            rc = subprocess.run(deploy_cmd, check=False).returncode
        if rc == 0:
            return
        if attempt == max_attempts:
            sys.exit(rc)
        print(
            f"\n>>> deploy attempt {attempt}/{max_attempts} failed "
            f"(rc={rc}); waiting for agents to settle and retrying"
        )
        # Transient "unresponsive agent" churn self-heals as the agent's NATS
        # client reconnects; wait passively for a stable all-responsive baseline
        # before the next attempt rather than resetting VMs (which fought the
        # self-heal and caused the deploy to flap).
        wait_agents_responsive(min(preflight_s, 300) if preflight_s else 300)
        print(">>> sleeping 30s before retry")
        time.sleep(30)


def system_domain() -> str:
    return capture("bosh", "int", "manifests/cf/vars.yml", "--path=/system_domain")


def credhub_env() -> dict[str, str]:
    if not BOSH_CREDS.exists():
        sys.exit(f"creds file missing: {BOSH_CREDS} — run 'scripts/bosh create-env' first")
    director_ip = _bosh_var("/internal_ip")
    credhub_ca = capture("bosh", "int", str(BOSH_CREDS), "--path=/credhub_tls/ca")
    uaa_ca = capture("bosh", "int", str(BOSH_CREDS), "--path=/uaa_ssl/ca")
    env = os.environ.copy()
    env["CREDHUB_SERVER"] = f"https://{director_ip}:8844"
    env["CREDHUB_CLIENT"] = "credhub-admin"
    env["CREDHUB_SECRET"] = capture("bosh", "int", str(BOSH_CREDS), "--path=/credhub_admin_client_secret")
    env["CREDHUB_CA_CERT"] = credhub_ca + "\n" + uaa_ca
    return env


def admin_password() -> str:
    return subprocess.run(
        ["credhub", "get", "-n", "/ocfp-mgmt/cf/cf_admin_password", "-q"],
        check=True, capture_output=True, text=True, env=credhub_env(),
    ).stdout.strip()


def cmd_admin_password(_extra: list[str]) -> None:
    print(admin_password())


def cmd_api(_extra: list[str]) -> None:
    banner("cf api")
    run("cf", "api", f"https://api.{system_domain()}", "--skip-ssl-validation")


def cmd_login(_extra: list[str]) -> None:
    banner("cf login")
    domain = system_domain()
    pw = admin_password()
    run("cf", "api", f"https://api.{domain}", "--skip-ssl-validation")
    # Pass the admin password via CF_PASSWORD so it never appears in the
    # process table or shell history.  The CF CLI reads CF_PASSWORD when
    # -p is absent, so no -p flag is supplied here.
    run_env(
        {"CF_PASSWORD": pw},
        "cf", "login",
        "-a", f"https://api.{domain}",
        "-u", "admin",
        "--skip-ssl-validation",
    )


def cmd_teardown(_extra: list[str]) -> None:
    """Delete the CF deployment from the director.

    Checks for the deployment's presence first so the command is safe to
    run when the director is unreachable or the deployment does not exist.
    Both conditions are treated as already-done and exit 0.

    The bosh delete-deployment --force flag handles partially deleted or
    inconsistent deployment state.
    """
    banner(f"Teardown deployment '{DEPLOYMENT}'")

    result = subprocess.run(
        ["bosh", "-e", ENV, "deployments", "--json"],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0:
        print(f"    director unreachable (bosh deployments rc={result.returncode}); skipping teardown")
        return

    try:
        data = json.loads(result.stdout)
        rows = data["Tables"][0]["Rows"]
        names = [row.get("name", "") for row in rows]
    except (json.JSONDecodeError, KeyError, IndexError, TypeError):
        print("    could not parse deployments list; skipping teardown")
        return

    if DEPLOYMENT not in names:
        print(f"    deployment '{DEPLOYMENT}' not found; skipping teardown")
        return

    print(f"    deleting deployment '{DEPLOYMENT}' with --force ...")
    run("bosh", "-e", ENV, "-n", "-d", DEPLOYMENT, "delete-deployment", "--force")
    print(f"    deployment '{DEPLOYMENT}' deleted")


def _load_bosh_module():
    """Load scripts/bosh as a Python module for COMMANDS-map dispatch.

    scripts/bosh has no .py extension, so we use SourceFileLoader.
    The loaded module exposes its COMMANDS dict and main() function,
    allowing scripts/cf to delegate operations through the same dispatch
    path rather than embedding raw bosh CLI subprocess calls.
    """
    bosh_path = str(Path(__file__).resolve().parent / "bosh")
    loader = _ilm.SourceFileLoader("bosh_script", bosh_path)
    spec = _ilu.spec_from_loader("bosh_script", loader, origin=bosh_path)
    mod = _ilu.module_from_spec(spec)
    mod.__file__ = bosh_path
    loader.exec_module(mod)
    return mod


def cmd_update_resurrection(extra: list[str]) -> None:
    """Enable or disable BOSH resurrection for the director.

    Routes through the scripts/bosh COMMANDS map so that all director
    environment setup (BOSH_ENVIRONMENT, BOSH_CLIENT, BOSH_CA_CERT) is
    handled consistently by scripts/bosh rather than duplicated here.

    Usage:
        ./scripts/cf update-resurrection on   # enable resurrection
        ./scripts/cf update-resurrection off  # disable resurrection
        ./scripts/cf update-resurrection      # passthrough with no args

    Args in extra are forwarded verbatim to `bosh update-resurrection`.
    The command exits non-zero when the bosh CLI returns a non-zero
    exit code, propagating the failure to the caller.
    """
    bosh_mod = _load_bosh_module()
    rc = bosh_mod.main(["update-resurrection", *extra])
    if rc != 0:
        sys.exit(rc)


def _set_resurrection(state: str) -> None:
    """Toggle director-wide resurrection through scripts/bosh dispatch.

    State must be 'on' or 'off'. Errors are logged but do not raise:
    the deploy itself is the load-bearing operation, and a transient
    failure to toggle resurrection should not abort it.
    """
    if state not in ("on", "off"):
        raise ValueError(f"resurrection state must be 'on' or 'off', got {state!r}")
    try:
        bosh_mod = _load_bosh_module()
        rc = bosh_mod.main(["update-resurrection", state])
        if rc != 0:
            print(f"    WARNING: update-resurrection {state} returned rc={rc}")
    except Exception as exc:  # pragma: no cover - best-effort
        print(f"    WARNING: update-resurrection {state} raised: {exc}")


def _haproxy_release() -> "tuple[str, str, str, str]":
    """(name, version, url, sha1) of the source haproxy release.

    haproxy is added to the deployment by cf-deployment's
    operations/use-haproxy.yml and is the only release that compiles from source
    against the lab stemcell. `bosh int` resolves the stanza offline (no director
    needed) so compile-releases can build its compile deployment from it.
    """
    base = str(CF_DEPLOYMENT / "cf-deployment.yml")
    ophap = str(CF_DEPLOYMENT / "operations/use-haproxy.yml")

    def field(p: str) -> str:
        return capture("bosh", "int", base, "-o", ophap, f"--path=/releases/name=haproxy/{p}")

    return ("haproxy", field("version"), field("url"), field("sha1"))


def _export_compiled_cf(
    name: str, version: str, os_name: str, sc_version: str,
    cfg: "_compiled.StoreConfig", denv: dict, bosh_mod,
) -> "_compiled.CompiledRelease":
    """export-release one CF release from the compile deployment, store its
    tarball, and return a CompiledRelease. Reuses the bosh module's store/sha
    helpers so file:// and S3 storage behave identically across both pipelines.
    """
    with tempfile.TemporaryDirectory(prefix="compiled-cf-") as tmpd:
        run_env(
            denv, "bosh", "-e", ENV, "-n", "-d", COMPILE_DEPLOYMENT_CF,
            "export-release", f"{name}/{version}", f"{os_name}/{sc_version}", f"--dir={tmpd}",
        )
        tars = sorted(Path(tmpd).glob("*.tgz"))
        if not tars:
            sys.exit(f"compile-releases: export-release {name}/{version} produced no tarball")
        if len(tars) > 1:
            print(f"    warning: {len(tars)} tarballs for {name}; using {tars[-1].name}", file=sys.stderr)
        src = str(tars[-1])
        basename = _compiled.compiled_basename(name, version, os_name, sc_version)
        sha = "sha256:" + bosh_mod._sha256_file(src)
        url = bosh_mod._store_put(cfg, src, basename)
        print(f"    exported {name}/{version} -> {basename}")
        return _compiled.CompiledRelease(name=name, version=version, url=url, sha1=sha)


def cmd_compile_releases(_extra: list[str]) -> None:
    """Compile + pin the CF source releases (haproxy) against the lab stemcell.

    Mirrors `scripts/bosh compile-releases`: ensure the stemcell is on the
    director, upload the source haproxy release, deploy a no-VM compilation
    deployment, export-release the compiled tarball into the configured store
    (file:// by default, S3-compatible when COMPILED_RELEASES_STORE=s3), and
    write manifests/cf/compiled-releases.yml. `cf deploy` then layers that ops
    file after use-haproxy.yml so a fresh-director deploy skips the haproxy
    build (~3.5 min). Storage is configured with the same COMPILED_RELEASES_*
    env as the bosh pipeline; see docs/compiled-releases.md.
    """
    banner("Compile CF releases (haproxy)")
    bosh_mod = _load_bosh_module()
    denv = bosh_mod.director_env()
    os_name, sc_version = stemcell_os_version()
    cfg = _compiled.store_config_from_env(os.environ, str(COMPILED_DIR_DEFAULT))
    print(f"    store: {cfg.kind}   stemcell: {os_name}/{sc_version}")

    # 1. Ensure the stemcell is on the director (upload the light record if not).
    if not bosh_mod._stemcell_present(denv, os_name, sc_version):
        cmd_stemcell([])
    if not bosh_mod._stemcell_present(denv, os_name, sc_version):
        sys.exit(f"compile-releases: stemcell {os_name}/{sc_version} not on director")

    # 2. Upload the source haproxy release.
    name, version, url, sha1 = _haproxy_release()
    print(f"    uploading source release {name}/{version}")
    run_env(denv, "bosh", "-e", ENV, "-n", "upload-release", "--sha1", sha1, url)
    if not bosh_mod._release_present(denv, name, version):
        sys.exit(f"compile-releases: {name}/{version} not on director after upload; check `bosh releases`")

    # 3. Deploy a no-VM compilation deployment referencing haproxy + stemcell.
    manifest = (
        f"name: {COMPILE_DEPLOYMENT_CF}\n"
        "releases:\n"
        f"- name: {name}\n  version: \"{version}\"\n"
        "stemcells:\n"
        f"- alias: default\n  os: {os_name}\n  version: \"{sc_version}\"\n"
        "instance_groups: []\n"
        "update:\n"
        "  canaries: 0\n"
        "  max_in_flight: 1\n"
        "  canary_watch_time: 1000-60000\n"
        "  update_watch_time: 1000-60000\n"
        "  serial: false\n"
    )
    mf = tempfile.NamedTemporaryFile("w", suffix=".yml", delete=False)
    try:
        mf.write(manifest)
        mf.close()
        run_env(denv, "bosh", "-e", ENV, "-n", "-d", COMPILE_DEPLOYMENT_CF, "deploy", mf.name)
        # 4. Export each target (compiles on the director, or reuses its
        #    compiled-package cache when a live deploy already built it).
        compiled = [_export_compiled_cf(name, version, os_name, sc_version, cfg, denv, bosh_mod)]
    finally:
        os.unlink(mf.name)
        subprocess.run(
            ["bosh", "-e", ENV, "-n", "-d", COMPILE_DEPLOYMENT_CF, "delete-deployment", "--force"],
            env=denv, check=False,
        )

    # 5. Write the generated ops file (pins compiled url + sha, stemcell marker).
    ops = _compiled.compiled_releases_ops(compiled, stemcell=f"{os_name}/{sc_version}")
    COMPILED_OPS_CF.write_text(ops)
    print(f"    wrote {COMPILED_OPS_CF.relative_to(REPO_ROOT)}")
    for cr in compiled:
        print(f"      {cr.name}/{cr.version} -> {cr.url}")


def compiled_ops_layer() -> list[str]:
    """['-o', compiled-releases.yml] when a valid cache matches the stemcell, else [].

    Mirrors scripts/bosh: disabled by COMPILE_RELEASES_DISABLE, and refuses a
    missing file, a stemcell-marker mismatch, or a file:// tarball that has gone
    missing — any of which falls back to compiling haproxy from source rather
    than deploying a cache that cannot match.
    """
    if os.environ.get("COMPILE_RELEASES_DISABLE", "").strip():
        return []
    if not COMPILED_OPS_CF.exists():
        return []
    text = COMPILED_OPS_CF.read_text()
    want = "{}/{}".format(*stemcell_os_version())
    marker = _compiled.stemcell_from_ops(text)
    if marker != want:
        print(f"    compile: ignoring {COMPILED_OPS_CF.name} (stemcell {marker} != {want})")
        return []
    for p in _compiled.local_paths_from_ops(text):
        if not Path(p).exists():
            print(f"    compile: ignoring {COMPILED_OPS_CF.name} (missing tarball {p})")
            return []
    print(f"    compile: using compiled haproxy ({want}) from {COMPILED_OPS_CF.name}")
    return ["-o", str(COMPILED_OPS_CF)]


def cmd_deploy(extra: list[str]) -> None:
    """Full CF deploy with resurrection gated off across the run.

    HM's resurrector is already disabled lab-wide by
    `manifests/bosh/hm-tuning.yml`, but the director-side
    `update-resurrection` flag is a per-deployment toggle that survives
    director restarts and is what `bosh recreate` and the scan-and-fix
    plugin honour. Wrapping the deploy with off/on guarantees the
    deploy itself, plus any auxiliary recreates it triggers, run with
    no resurrection interference, and restores the operator-friendly
    default on success or failure.

    If the script is killed with SIGKILL the finally block does not run
    and resurrection stays off. Operators should check
    `bosh resurrection` at start of any subsequent deploy. The
    integration harness asserts on this at start-of-run.
    """
    timings: list[tuple[str, float]] = []

    def step(label: str, fn) -> None:
        t0 = time.monotonic()
        try:
            fn()
        finally:
            timings.append((label, time.monotonic() - t0))

    _set_resurrection("off")
    deploy_t0 = time.monotonic()
    try:
        step("runtime-config", lambda: cmd_runtime_config([]))
        step("cloud-config", lambda: cmd_cloud_config([]))
        step("stemcell", lambda: cmd_stemcell([]))
        step("check-uaa-db", lambda: cmd_check_uaa_db([]))
        step("bosh-deploy", lambda: cmd_bosh_deploy(extra))
    finally:
        _set_resurrection("on")
        total = time.monotonic() - deploy_t0
        banner("Deploy step timings")
        for label, secs in timings:
            print(f"    {label:14s} {secs:7.1f}s  ({int(secs)//60}m{int(secs) % 60:02d}s)")
        print(f"    {'TOTAL':14s} {total:7.1f}s  ({int(total)//60}m{int(total) % 60:02d}s)")


COMMANDS = {
    "deploy": cmd_deploy,
    "runtime-config": cmd_runtime_config,
    "cloud-config": cmd_cloud_config,
    "stemcell": cmd_stemcell,
    "check-uaa-db": cmd_check_uaa_db,
    "unstick-agent": cmd_unstick_agent,
    "bosh-deploy": cmd_bosh_deploy,
    "compile-releases": cmd_compile_releases,
    "teardown": cmd_teardown,
    "delete-deployment": cmd_teardown,
    "api": cmd_api,
    "login": cmd_login,
    "admin-password": cmd_admin_password,
    "update-resurrection": cmd_update_resurrection,
}


def usage(stream=sys.stdout) -> None:
    print(__doc__, file=stream)


def main(argv: list[str]) -> None:
    # Line-buffer stdout even when redirected to a file/pipe (default there is
    # block buffering). Without this, the watchdog's recover_cb [watcher] lines
    # and the retry banners — emitted by print() between the explicitly-flushed
    # bosh passthrough lines — sit unflushed until the buffer fills or the
    # process exits, so a live `tail -f` of a redirected deploy log shows the
    # raw bosh stream but never the recovery actions taken against it.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, ValueError):
        pass

    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return

    command, extra = argv[0], argv[1:]
    handler = COMMANDS.get(command)
    if handler is None:
        print(f"unknown command: {command}", file=sys.stderr)
        usage(sys.stderr)
        sys.exit(2)

    os.chdir(REPO_ROOT)
    handler(extra)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
