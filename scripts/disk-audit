#!/usr/bin/env python3
"""Operator audit tool for BOSH persistent disks managed by the PVE CPI.

Finds every persistent disk volume that the CPI manages across every PVE node
and classifies each one. We count a volume as ours when its name carries a VMID
in the configured disk band, when a drive line in a guest's config carries its
bpd- serial, when a sentinel in a guest's description names its full volid, or
when it sits on a bus slot of a parker VM. The CPI renames a stable-ID disk to
the VMID of its guest or parker, so the band alone misses renamed disks.
Storages that PVE lists as disabled or inactive are skipped, and disks on a
skipped storage are not in the report.

Each volume gets one of these classifications:

  attached     — volume is attached to a real (non-parker) VM
  parked       — volume is held by a parker VM (bosh-parker tag + parker VMID range);
                 provenance columns are pulled from the <!--BOSH:{...}--> sentinel
                 in the parker VM description
  free-floating — volume exists in storage but no VM holds it (potential orphan).
                  A volume that only a sentinel note named is marked as such,
                  because a sentinel can go stale, and should be checked with
                  `bosh disks --orphaned` before anyone deletes it
  unknown       — volume found in storage content but VMID cannot be determined
                  from the volid pattern

Exit codes:
  0 — no free-floating disks (clean)
  1 — one or more free-floating disks found (CI gate trigger)
  2 — usage error or fatal transport failure

Warnings are printed to stderr when:
  - parked disks exist but detached_disk_strategy is set to "free" (they stay
    recognized and drain on their next attach_disk or delete_disk; no new
    detaches will park)
  - empty parker VMs are found (teardown candidates)
  - a parker carries an unusedN reference to a live volume (a sweep that did
    not complete; the parker must NOT be destroyed until it is cleared)
  - a parker's config did not come back, so its contents are unknown
  - a VM sits in a parker pool and carries no bosh-parker tag, so it is a
    workload VM the CPI never moves out on its own, and an operator has to
    move it by hand. A pool counts as a parker pool when a parker VM belongs
    to it, and --parker-pool names one that holds no parker yet.
  - one bpd- serial appears on two different volumes, which a clone of a BOSH
    VM can cause
  - a volume is named by more than one guest's config, on an active slot or
    an unused entry. Earlier releases could leave a disk this way, and
    destroying the guest that owns the volume by name deletes it while the
    other guest still uses it. The report also warns when it could not read
    every guest, because then a second reference could be missing.

Config file format (JSON, subset of the CPI config):

  {
    "host": "pve.example.com",          required
    "port": 8006,                        optional, default 8006
    "user": "root@pam",                  required
    "api_token": "root@pam!tok=SECRET",  required if no password
    "password": "SECRET",                required if no api_token
    "realm": "pam",                      optional, default "pam"
    "node": "pve1",                      optional; limits scope to one node
    "verify_ssl": false,                 optional, default false
    "disk_vmid_range_start": 9000,       optional, default 9000
    "disk_vmid_range_end": 29999,        optional, default 29999
    "parked_disk_vmid_range_start": 90000, optional, default 90000
    "parked_disk_vmid_range_end": 90999,   optional, default 90999
    "detached_disk_strategy": "parked"   optional, default "" (→ "parked")
  }
"""

from __future__ import annotations

import argparse
import json
import re
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request
from typing import Any

# ---------------------------------------------------------------------------
# Defaults mirroring CPI ApplyDefaults / pve package constants
# ---------------------------------------------------------------------------

DEFAULT_PORT = 8006
DEFAULT_REALM = "pam"
DEFAULT_DISK_VMID_START = 9000
DEFAULT_DISK_VMID_END = 29999
DEFAULT_PARKER_VMID_START = 90000
DEFAULT_PARKER_VMID_END = 90999

# volid pattern: <storage>:vm-<vmid>-disk-<n> or <storage>:vm-<vmid>-cloudinit
# We care about vm-<vmid>-disk-<n> volumes where vmid is in the disk band.
_DISK_VOLID_RE = re.compile(r"^[^:]+:vm-(\d+)-disk-\d+$")

# Sentinel pattern — same as parker.go parkerSentinelPattern
_SENTINEL_RE = re.compile(r"<!--BOSH:(.*?)-->", re.DOTALL)

PARKER_TAG = "bosh-parker"


# ---------------------------------------------------------------------------
# Config loading
# ---------------------------------------------------------------------------

class AuditConfig:
    """Resolved audit configuration with validated fields and effective defaults."""

    def __init__(self, raw: dict[str, Any]) -> None:
        host = str(raw.get("host", "") or "").strip()
        if not host:
            _die("config: 'host' is required")
        self.host = host
        self.port = int(raw.get("port", DEFAULT_PORT) or DEFAULT_PORT)
        user = str(raw.get("user", "") or "").strip()
        if not user:
            _die("config: 'user' is required")
        self.user = user
        self.realm = str(raw.get("realm", DEFAULT_REALM) or DEFAULT_REALM).strip()
        self.api_token = str(raw.get("api_token", "") or "").strip()
        self.password = str(raw.get("password", "") or "").strip()
        if not self.api_token and not self.password:
            _die("config: one of 'api_token' or 'password' is required")
        self.verify_ssl = bool(raw.get("verify_ssl", False))
        # Optional node scope; empty = all nodes
        self.node = str(raw.get("node", "") or "").strip()

        # Disk band
        self.disk_vmid_start = int(raw.get("disk_vmid_range_start", DEFAULT_DISK_VMID_START) or DEFAULT_DISK_VMID_START)
        self.disk_vmid_end = int(raw.get("disk_vmid_range_end", DEFAULT_DISK_VMID_END) or DEFAULT_DISK_VMID_END)
        if self.disk_vmid_start >= self.disk_vmid_end:
            _die(
                f"config: disk_vmid_range_start ({self.disk_vmid_start}) must be "
                f"less than disk_vmid_range_end ({self.disk_vmid_end})"
            )

        # Parker band
        self.parker_vmid_start = int(
            raw.get("parked_disk_vmid_range_start", DEFAULT_PARKER_VMID_START) or DEFAULT_PARKER_VMID_START
        )
        self.parker_vmid_end = int(
            raw.get("parked_disk_vmid_range_end", DEFAULT_PARKER_VMID_END) or DEFAULT_PARKER_VMID_END
        )
        if self.parker_vmid_start >= self.parker_vmid_end:
            _die(
                f"config: parked_disk_vmid_range_start ({self.parker_vmid_start}) must be "
                f"less than parked_disk_vmid_range_end ({self.parker_vmid_end})"
            )

        # Empty resolves to "parked", matching the CPI's own default.
        self.detached_disk_strategy = (
            str(raw.get("detached_disk_strategy", "") or "").strip().lower() or "parked"
        )

    def username_with_realm(self) -> str:
        if "@" in self.user:
            return self.user
        return f"{self.user}@{self.realm}"


def load_config(path: str) -> AuditConfig:
    """Load and validate the JSON config file."""
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except FileNotFoundError:
        _die(f"config file not found: {path}")
    except PermissionError as exc:
        _die(f"cannot read config file {path}: {exc}")
    except json.JSONDecodeError as exc:
        _die(f"config file {path} is not valid JSON: {exc}")
    if not isinstance(raw, dict):
        _die(f"config file {path} must contain a JSON object")
    return AuditConfig(raw)


# ---------------------------------------------------------------------------
# PVE REST API client
# ---------------------------------------------------------------------------

class PVEClient:
    """Minimal read-only PVE REST API client. Auth: token or password-ticket."""

    def __init__(self, cfg: AuditConfig) -> None:
        self._cfg = cfg
        self._base = f"https://{cfg.host}:{cfg.port}/api2/json"
        if cfg.verify_ssl:
            self._ssl = ssl.create_default_context()
        else:
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            self._ssl = ctx
        self._ticket: str = ""  # lazy — populated on first password-auth GET

    def _ensure_ticket(self) -> None:
        if self._cfg.api_token or self._ticket:
            return
        body = urllib.parse.urlencode(
            {"username": self._cfg.username_with_realm(), "password": self._cfg.password}
        ).encode("utf-8")
        req = urllib.request.Request(
            f"{self._base}/access/ticket", data=body, method="POST"
        )
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
        try:
            with urllib.request.urlopen(req, context=self._ssl, timeout=30) as resp:
                payload = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            _die(f"PVE ticket auth failed: HTTP {exc.code} {exc.reason}")
        except (urllib.error.URLError, OSError) as exc:
            _die(f"PVE ticket auth failed: {exc}")
        ticket = (payload.get("data") or {}).get("ticket")
        if not ticket:
            _die("PVE ticket auth returned no ticket")
        self._ticket = ticket

    def _auth_headers(self) -> dict[str, str]:
        self._ensure_ticket()
        if self._cfg.api_token:
            return {"Authorization": f"PVEAPIToken={self._cfg.api_token}"}
        return {"Cookie": f"PVEAuthCookie={self._ticket}"}

    def get(self, path: str, *, allow_missing: bool = False) -> Any:
        """GET /api2/json<path>, return parsed 'data' field.

        Inputs:
          path           — must start with '/'; caller-controlled
          allow_missing  — return None on HTTP 404/501 instead of dying

        Failure modes:
          HTTP error     — _die() unless allow_missing and 404/501
          network error  — _die()
          bad JSON       — _die()
        """
        headers = self._auth_headers()
        req = urllib.request.Request(f"{self._base}{path}", headers=headers, method="GET")
        try:
            with urllib.request.urlopen(req, context=self._ssl, timeout=30) as resp:
                payload = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            if allow_missing and exc.code in (404, 501):
                return None
            _die(f"GET {path} failed: HTTP {exc.code} {exc.reason}")
        except (urllib.error.URLError, OSError) as exc:
            _die(f"GET {path} failed: {exc}")
        except json.JSONDecodeError as exc:
            _die(f"GET {path}: invalid JSON response: {exc}")
        return payload.get("data")

    def get_soft(self, path: str) -> "tuple[Any, str]":
        """GET /api2/json<path> without ending the audit on failure.

        Returns (data, "") on success and (None, reason) on any HTTP, network,
        or JSON failure, for reads whose failure the report can describe
        rather than die on.
        """
        headers = self._auth_headers()
        req = urllib.request.Request(f"{self._base}{path}", headers=headers, method="GET")
        try:
            with urllib.request.urlopen(req, context=self._ssl, timeout=30) as resp:
                payload = json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            return None, f"HTTP {exc.code} {exc.reason}"
        except (urllib.error.URLError, OSError) as exc:
            return None, str(exc)
        except json.JSONDecodeError as exc:
            return None, f"invalid JSON response: {exc}"
        if not isinstance(payload, dict):
            return None, "unexpected response shape"
        return payload.get("data"), ""

    def vms_permissions(self) -> "tuple[dict[str, Any] | None, str]":
        """Return this principal's effective privileges on /vms.

        GET /access/permissions?path=/vms answers with a map from path to
        privileges. Returns (privileges, "") on success, which may be empty,
        and (None, reason) when the read failed.
        """
        data, err = self.get_soft("/access/permissions?path=%2Fvms")
        if err:
            return None, err
        if not isinstance(data, dict):
            return {}, ""
        privs = data.get("/vms")
        return (privs if isinstance(privs, dict) else {}), ""

    def vm_views_soft(self, node: str, vmid: int) -> "tuple[dict[str, Any], dict[str, Any]] | None":
        """Return a qemu VM's (current, applied) config views, or None when the read failed.

        Reads GET /qemu/{vmid}/pending, which carries both views in one call.
        Unlike vm_views, an HTTP error other than 404 or 501, a network error,
        or bad JSON does not end the audit. The double-reference report lists
        such a guest as unreadable instead, because a guest on a down node is
        exactly what an audit of a degraded cluster runs into.
        """
        path = f"/nodes/{urllib.parse.quote(node)}/qemu/{vmid}/pending"
        data, err = self.get_soft(path)
        if err:
            return None
        return parse_pending_views(data)

    def list_nodes(self) -> list[str]:
        """Return all online node names visible to the authenticated principal."""
        data = self.get("/nodes")
        nodes: list[str] = []
        if not isinstance(data, list):
            return nodes
        for entry in data:
            if not isinstance(entry, dict):
                continue
            name = str(entry.get("node", "")).strip()
            status = str(entry.get("status", "")).strip()
            if name and status == "online":
                nodes.append(name)
        return nodes

    def cluster_resources_vms(self) -> list[dict[str, Any]]:
        """Return all VM resources from /cluster/resources?type=vm."""
        data = self.get("/cluster/resources?type=vm")
        if not isinstance(data, list):
            return []
        return [e for e in data if isinstance(e, dict)]

    def storage_content(self, node: str, storage: str) -> list[dict[str, Any]]:
        """Return content list for node/storage (content=images).

        Returns [] when the storage is inaccessible (404/501/error) rather than
        aborting — some storages may not be mounted on every node.
        """
        path = (
            f"/nodes/{urllib.parse.quote(node)}/storage/"
            f"{urllib.parse.quote(storage)}/content?content=images"
        )
        data = self.get(path, allow_missing=True)
        if not isinstance(data, list):
            return []
        return [e for e in data if isinstance(e, dict)]

    def node_storages(self, node: str) -> list[dict[str, Any]]:
        """Return storage entries visible on node."""
        data = self.get(f"/nodes/{urllib.parse.quote(node)}/storage", allow_missing=True)
        if not isinstance(data, list):
            return []
        return [e for e in data if isinstance(e, dict)]

    def vm_views(self, node: str, vmid: int) -> "tuple[dict[str, Any], dict[str, Any]] | None":
        """Return a qemu VM's (current, applied) config views, or None if not found.

        The current view is what the running guest has now. The applied view is
        the config with pending changes applied, which is what the config
        endpoint returns. A drive whose delete is pending is in the first view
        only, and the running guest still has it plugged in.
        """
        path = f"/nodes/{urllib.parse.quote(node)}/qemu/{vmid}/pending"
        data = self.get(path, allow_missing=True)
        if data is None:
            return None
        if not isinstance(data, list):
            _die(f"GET {path}: expected a list of config rows, got {type(data).__name__}")
        for row in data:
            if not isinstance(row, dict) or not isinstance(row.get("key"), str) or not row["key"]:
                _die(f"GET {path}: malformed config row {row!r}")
        return parse_pending_views(data)


def _pending_scalar(value: Any) -> "str | None":
    """Render one JSON scalar of a pending row as the config map's values read."""
    if value is None or isinstance(value, (dict, list)):
        return None
    if isinstance(value, bool):
        return "1" if value else "0"
    return str(value)


def parse_pending_views(data: Any) -> "tuple[dict[str, Any], dict[str, Any]] | None":
    """Split the rows of GET /qemu/{vmid}/pending into (current, applied) config dicts.

    Mirrors ReadQemuViews in internal/pve/qemu_views.go. Each row carries a
    key, its current value, an optional pending value, and a delete flag. The
    current view takes every row's value. The applied view takes the pending
    value over the current one and leaves out a key whose delete is pending.
    Returns None when the response is not a list, which reads as an unreadable
    or missing guest.
    """
    if not isinstance(data, list):
        return None
    current: dict[str, Any] = {}
    applied: dict[str, Any] = {}
    for row in data:
        if not isinstance(row, dict):
            continue
        key = row.get("key")
        if not isinstance(key, str) or not key:
            continue
        value = _pending_scalar(row.get("value"))
        pending = _pending_scalar(row.get("pending"))
        flag = _pending_scalar(row.get("delete"))
        if value is not None:
            current[key] = value
        if flag not in (None, "", "0"):
            continue
        if pending is not None:
            applied[key] = pending
        elif value is not None:
            applied[key] = value
    return current, applied


def merge_views(views: "tuple[dict[str, Any], dict[str, Any]]") -> dict[str, Any]:
    """Fold both views into one config dict that names a key when either view does.

    The applied value wins for a key both views have. A key whose delete is
    pending keeps its current value, because the running guest still holds it.
    """
    current, applied = views
    merged = dict(current)
    merged.update(applied)
    return merged


def views_bus_values(views: "tuple[dict[str, Any], dict[str, Any]]") -> list[str]:
    """Return every distinct raw bus-slot value either view holds, in a stable order."""
    seen: list[str] = []
    for cfg in views:
        for key in sorted(cfg):
            val = cfg[key]
            if _BUS_KEY_RE.match(key) and isinstance(val, str) and val and val not in seen:
                seen.append(val)
    return seen


# ---------------------------------------------------------------------------
# Sentinel / provenance parsing
# ---------------------------------------------------------------------------

def parse_parker_sentinel(description: str) -> dict[str, Any]:
    """Extract the bosh_parked_disks map from a parker VM description.

    Returns {} on missing or corrupt sentinel. Tolerates other BOSH keys
    coexisting in the sentinel (set_disk_metadata uses bosh_disk_metadata).

    Inputs:
      description — raw VM description string from the PVE API

    Failure modes:
      no sentinel present       — return {}
      sentinel JSON corrupt     — return {} (best-effort; don't abort audit)
      bosh_parked_disks missing — return {}
    """
    if not description:
        return {}
    m = _SENTINEL_RE.search(description)
    if not m:
        return {}
    try:
        top = json.loads(m.group(1))
    except (json.JSONDecodeError, ValueError):
        return {}
    if not isinstance(top, dict):
        return {}
    disks = top.get("bosh_parked_disks")
    if not isinstance(disks, dict):
        return {}
    return disks


# Disk identity the CPI gives a persistent disk, independent of the VMID in
# the volume's name. DiskStableIDPrefix in internal/pve/disk_stable_id.go.
STABLE_ID_PREFIX = "bpd-"

# The sentinel carriers that name volumes. bosh_parked_disks and
# bosh_disk_allocations map a volid, or a bpd- token, to an entry object whose
# "volid" field names the volume. bosh_attached_disks maps a bare volid, or a
# bpd- token, to the Director's disk CID, so its entries name a volume only
# through the key.
_SENTINEL_VOLUME_CARRIERS = ("bosh_parked_disks", "bosh_attached_disks", "bosh_disk_allocations")


def stable_id_from_drive_opt_str(opt_str: str) -> str:
    """Return the bpd- serial on a drive option string, or "" when it has none.

    Ports StableIDFromDriveOptStr in internal/pve/disk_stable_id.go exactly.
    The string is "<volid>,serial=bpd-...,size=...". The first serial option
    decides: a serial without the bpd- prefix is an operator or guest-tooling
    serial and not a CPI identity, and the scan stops there.
    """
    rest = opt_str
    while True:
        comma = rest.find(",")
        if comma < 0:
            return ""
        rest = rest[comma + 1:]
        if rest.startswith("serial="):
            v = rest[len("serial="):]
            end = v.find(",")
            if end >= 0:
                v = v[:end]
            return v if v.startswith(STABLE_ID_PREFIX) else ""


def parse_sentinel_volume_names(description: str, config: "dict[str, Any] | None" = None) -> set[str]:
    """Return the full volids a VM description's sentinel names.

    Reads bosh_parked_disks, bosh_attached_disks, and bosh_disk_allocations. The
    CPI writes a sentinel entry under a bpd- token or under a full
    "storage:vm-N-disk-M" volid, and its "volid" field must carry the storage
    prefix, so a name without a colon is not one the CPI wrote and we ignore it.
    A bpd- token names no volume by itself, because the drive that carries the
    token already counts through its serial. When config is given, a
    bosh_parked_disks entry that carries a "slot" also names the volume on that
    slot, because a transfer that crashed before its finalize write leaves the
    entry naming the pre-move volid. A missing or corrupt sentinel gives an
    empty set, the same best-effort stance parse_parker_sentinel takes.
    """
    full: set[str] = set()
    if not description:
        return full
    m = _SENTINEL_RE.search(description)
    if not m:
        return full
    try:
        top = json.loads(m.group(1))
    except (json.JSONDecodeError, ValueError):
        return full
    if not isinstance(top, dict):
        return full

    def add(name: Any) -> None:
        if not isinstance(name, str):
            return
        name = name.strip()
        if name and ":" in name and not name.startswith(STABLE_ID_PREFIX):
            full.add(name)

    slots = _parse_bus_disks(config) if config else {}
    for carrier in _SENTINEL_VOLUME_CARRIERS:
        entries = top.get(carrier)
        if not isinstance(entries, dict):
            continue
        for key, entry in entries.items():
            add(key)
            if not isinstance(entry, dict):
                continue
            add(entry.get("volid"))
            slot = entry.get("slot")
            if carrier == "bosh_parked_disks" and isinstance(slot, str) and slot in slots:
                add(_bus_disk_volid_from_slot(slots[slot]).strip())
    return full


def _is_zero_flag(value: Any) -> bool:
    """True when a PVE flag field reads as zero, whether it came as 0, "0", or false."""
    if value is None:
        return False
    if isinstance(value, str):
        value = value.strip()
        return value == "0"
    if isinstance(value, bool):
        return not value
    if isinstance(value, (int, float)):
        return value == 0
    return False


def storage_skip_reason(entry: dict[str, Any]) -> str:
    """Say why a storage listing entry cannot be read, or "" when it can.

    PVE answers HTTP 500 to a content read on a disabled storage, so we skip
    a storage whose listing marks it enabled=0 or active=0. A missing field
    counts as enabled and active. An enabled storage that is not active may
    hold our disks, so we word that reason as partial coverage.
    """
    if _is_zero_flag(entry.get("enabled")):
        return "storage is disabled (enabled=0)"
    if _is_zero_flag(entry.get("active")):
        return "storage is enabled but not active (active=0), so coverage of it is partial"
    return ""


# ---------------------------------------------------------------------------
# Volid helpers
# ---------------------------------------------------------------------------

def disk_vmid_from_volid(volid: str) -> "int | None":
    """Extract the synthetic VMID embedded in a disk volid.

    Pattern: <storage>:vm-<vmid>-disk-<n>
    Returns None when the volid does not match (not a disk volume or
    unrecognised format).

    Inputs:
      volid — raw PVE volid string

    Failure modes:
      non-matching pattern — return None (caller classifies as 'unknown')
    """
    m = _DISK_VOLID_RE.match(volid)
    if not m:
        return None
    try:
        return int(m.group(1))
    except ValueError:
        return None


# Tag separators, mirroring splitTagString in internal/pve/parker.go: PVE writes
# semicolons, but a hand-edited tag field can carry commas or spaces. A splitter
# narrower than the CPI's finds no parkers at all, which silences the parked
# classification, the empty-parker warning, and the unusedN warning together --
# on the one tool an operator consults before a destructive qm destroy.
_TAG_SEP_RE = re.compile(r"[;, ]+")


def _tags_contain_parker(tags: str) -> bool:
    """True when the tag string includes 'bosh-parker' (case-insensitive).

    Separators are ';', ',', and ' ', matching splitTagString /
    tagContainsParker in internal/pve/parker.go.
    """
    for t in _TAG_SEP_RE.split(tags):
        if t.strip().lower() == PARKER_TAG:
            return True
    return False


# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

class DiskRecord:
    """Classification record for one persistent disk volume."""

    __slots__ = (
        "volid",
        "storage",
        "node",
        "size_bytes",
        "classification",
        "holder_vmid",
        "holder_node",
        "holder_name",
        # provenance from parker sentinel (parked only)
        "disk_cid",
        "source_vm_cid",
        "parked_at",
        "parked_node",
        "director_id",
        # how the audit found the volume: "band", "serial", "parker", "sentinel"
        "discovered_by",
        # Set on a free-floating volume that only a sentinel note named: the
        # VM whose sentinel pointed at it, and the unusedN slot of a guest that
        # still names it, when one does.
        "sentinel_only",
        "sentinel_vmid",
        "sentinel_name",
        "holder_slot",
    )

    def __init__(self, volid: str, storage: str, node: str, size_bytes: int) -> None:
        self.volid = volid
        self.storage = storage
        self.node = node
        self.size_bytes = size_bytes
        self.classification = "unknown"
        self.holder_vmid: "int | None" = None
        self.holder_node: str = ""
        self.holder_name: str = ""
        # provenance
        self.disk_cid: str = ""
        self.source_vm_cid: str = ""
        self.parked_at: str = ""
        self.parked_node: str = ""
        self.director_id: str = ""
        self.discovered_by: list[str] = ["band"]
        self.sentinel_only = False
        self.sentinel_vmid: "int | None" = None
        self.sentinel_name: str = ""
        self.holder_slot: str = ""

    def to_dict(self) -> dict[str, Any]:
        d: dict[str, Any] = {
            "volid": self.volid,
            "storage": self.storage,
            "node": self.node,
            "size_bytes": self.size_bytes,
            "classification": self.classification,
        }
        if self.holder_vmid is not None:
            d["holder_vmid"] = self.holder_vmid
        if self.holder_node:
            d["holder_node"] = self.holder_node
        if self.holder_name:
            d["holder_name"] = self.holder_name
        if self.disk_cid:
            d["disk_cid"] = self.disk_cid
        if self.source_vm_cid:
            d["source_vm_cid"] = self.source_vm_cid
        if self.parked_at:
            d["parked_at"] = self.parked_at
        if self.parked_node:
            d["parked_node"] = self.parked_node
        if self.director_id:
            d["director_id"] = self.director_id
        if self.holder_slot:
            d["holder_slot"] = self.holder_slot
            d["held_by_unused_entry"] = True
        d["discovered_by"] = list(self.discovered_by)
        if self.sentinel_only:
            d["found_only_by_sentinel"] = True
            if self.sentinel_vmid is not None:
                d["sentinel_vmid"] = self.sentinel_vmid
            if self.sentinel_name:
                d["sentinel_name"] = self.sentinel_name
        return d


class ParkerRecord:
    """Inventory record for one parker VM."""

    __slots__ = (
        "vmid", "node", "name", "pool", "disk_count", "unused_count",
        "config_read", "slot_capacity", "empty",
    )

    def __init__(
        self,
        vmid: int,
        node: str,
        name: str,
        disk_count: int,
        pool: str = "",
        unused_count: int = 0,
        config_read: bool = True,
    ) -> None:
        self.vmid = vmid
        self.node = node
        self.name = name
        # The resource pool the cluster index reports for this VM, or the
        # empty string when the parker sits in no pool. We read it from the
        # cluster-resources row rather than a per-pool lookup, because this
        # report describes the cluster as it stands rather than confirming
        # work that finished moments ago.
        self.pool = pool
        self.disk_count = disk_count
        # unusedN keys are references too: `qm destroy --purge` walks them and
        # frees the volume behind each one.  A parker holding only unusedN
        # entries still holds a live persistent disk, so it is not empty and
        # must never be offered as a teardown candidate.
        self.unused_count = unused_count
        # False when the config read failed.  An unread config proves nothing
        # about what the parker holds, so it is never called empty.
        self.config_read = config_read
        self.slot_capacity = 31  # scsi0..scsi30
        self.empty = config_read and disk_count == 0 and unused_count == 0

    def to_dict(self) -> dict[str, Any]:
        return {
            "vmid": self.vmid,
            "node": self.node,
            "name": self.name,
            "pool": self.pool,
            "disk_count": self.disk_count,
            "unused_count": self.unused_count,
            "config_read": self.config_read,
            "slot_capacity": self.slot_capacity,
            "empty": self.empty,
        }


class PoolIntruderRecord:
    """Inventory record for a workload VM that sits in a parker pool.

    The CPI refuses to create a VM in the parker pool, and the pool reconciler
    warns and skips when a persisted template renders that name. Nothing in the
    CPI puts a VM here, and nothing in the CPI takes it back out. A VM we
    record here was put in the pool by a release older than those guards, and
    an operator has to move it out by hand.
    """

    __slots__ = ("vmid", "node", "name", "pool")

    def __init__(self, vmid: int, node: str, name: str, pool: str) -> None:
        self.vmid = vmid
        self.node = node
        self.name = name
        self.pool = pool


# ---------------------------------------------------------------------------
# Inventory collection
# ---------------------------------------------------------------------------

# Mirrors qemu.ParseDisks in the SDK: bus families that can hold persistent
# disk volumes. Pattern: ^(scsi|virtio|ide|sata)\d+$
# Ranges: scsi 0-30 (parker uses scsi0..30), virtio 0-15, ide 0-3, sata 0-5.
# efidisk0 and tpmstate0 carry boot firmware, not BOSH persistent disks, and
# their volids never embed a disk-band VMID — they are safely skipped.
# unusedN entries are deliberately NOT bus keys: FindVMByDiskVolid in disk.go
# only calls qemu.ParseDisks (bus keys) when searching for a disk holder, so a
# disk referenced only by an unusedN key reads as free-floating in the disk
# inventory, which is what the classifier wants.
#
# The parker inventory needs the opposite answer.  `qm destroy --purge` walks
# the unusedN entries too, so a parker carrying one still references a live
# volume and must never be reported as an empty teardown candidate.  That is
# what _UNUSED_KEY_RE is for; see _count_unused_refs.
_BUS_KEY_RE = re.compile(r"^(scsi|virtio|ide|sata)\d+$")
_UNUSED_KEY_RE = re.compile(r"^unused\d+$")


def _parse_bus_disks(config: dict[str, Any]) -> dict[str, str]:
    """Return {slot: raw_value} for all active bus disk keys in a VM config.

    Mirrors qemu.ParseDisks in the SDK (bus pattern scsi|virtio|ide|sata + digits).
    Raw values are kept intact (may be 'volid,opt=val,...') for volid matching.

    Inputs:
      config — raw qemu VM config dict from the PVE API

    Failure modes:
      non-dict config    — treated as empty by caller (a failed read gives None)
      missing bus keys   — simply absent from output; not an error
    """
    out: dict[str, str] = {}
    for key, val in config.items():
        if _BUS_KEY_RE.match(key) and isinstance(val, str) and val:
            out[key] = val
    return out


def _bus_disk_volid_from_slot(raw_value: str) -> str:
    """Extract the bare volid from a PVE disk slot value.

    PVE stores disk values as '<volid>[,option=value,...]'. The volid is the
    prefix before the first comma. Returns the full string when no comma present.

    Mirrors the option-string stripping in DiskOptStrContainsVolid / FindDiskIDByVolID.
    """
    comma = raw_value.find(",")
    if comma >= 0:
        return raw_value[:comma]
    return raw_value


def _count_bus_disks(config: dict[str, Any]) -> int:
    """Count occupied bus disk slots in a qemu VM config dict."""
    return len(_parse_bus_disks(config))


def _count_unused_refs(config: dict[str, Any]) -> int:
    """Count unusedN volume references in a qemu VM config dict.

    PVE demotes a detached volume to an unusedN key rather than dropping it.
    The CPI sweeps those keys inside the protection window, but a sweep that
    could not complete leaves one behind, invisible to every bus-slot probe.

    Inputs:
      config — raw qemu VM config dict from the PVE API

    Failure modes:
      non-dict config — treated as empty by caller (a failed read gives None)
    """
    return sum(
        1 for key, val in config.items()
        if _UNUSED_KEY_RE.match(key) and isinstance(val, str) and val
    )


def parse_parker_pool_args(values: "list[str] | None") -> list[str]:
    """Turn the raw --parker-pool values into a clean, ordered list of names.

    The flag may be repeated and each value may itself be a comma-separated
    list, so we accept both spellings and fold them into one list. We drop the
    blanks, and we keep a name given twice only once.

    Inputs:
      values - the argparse accumulator, or None when the flag was never given
    """
    names: list[str] = []
    for value in values or []:
        for part in str(value).split(","):
            part = part.strip()
            if part and part not in names:
                names.append(part)
    return names


def parker_pool_names(parker_records: list[ParkerRecord], extra_pools: "list[str] | None" = None) -> set[str]:
    """Decide which resource pools we treat as parker pools.

    By default a pool counts as a parker pool when at least one parker VM
    belongs to it, which the cluster index tells us without asking the operator
    for anything. That derivation says nothing about a parker pool standing
    empty, so we add every name the operator passed on --parker-pool as well.

    Inputs:
      parker_records - the parker inventory, whose pool field comes from the
                       cluster index
      extra_pools    - pool names the operator named explicitly, or None
    """
    names = {pr.pool for pr in parker_records if pr.pool}
    for pool in extra_pools or []:
        if pool:
            names.add(pool)
    return names


def find_pool_intruders(
    vm_map: dict[int, dict[str, str]],
    parker_pools: set[str],
) -> list[PoolIntruderRecord]:
    """Find every VM that sits in a parker pool without carrying the parker tag.

    We recognize a parker by its bosh-parker tag, so a VM in one of these
    pools that carries no such tag is a workload VM that landed there by a
    name collision. We key on the tag alone rather than on the parker VMID
    band, because an untagged VM inside the band would still be something for
    an operator to look at.

    Inputs:
      vm_map       - vmid -> {node, name, tags, pool} from the cluster index
      parker_pools - the pools parker_pool_names resolved

    Returns:
      the intruders, ordered by VMID
    """
    intruders: list[PoolIntruderRecord] = []
    if not parker_pools:
        return intruders
    for vmid_int in sorted(vm_map):
        info = vm_map[vmid_int]
        pool = str(info.get("pool", "") or "")
        if pool not in parker_pools:
            continue
        if _tags_contain_parker(str(info.get("tags", "") or "")):
            continue
        intruders.append(PoolIntruderRecord(
            vmid=vmid_int,
            node=str(info.get("node", "") or ""),
            name=str(info.get("name", "") or ""),
            pool=pool,
        ))
    return intruders


# ---------------------------------------------------------------------------
# Volumes that more than one guest names
# ---------------------------------------------------------------------------

# PVE decides which VM owns a volume from the volume's name alone: the last
# path segment starts vm-<vmid>- or base-<vmid>-. That holds on every storage
# type, including a linked clone, whose name carries its base volume's path
# in front ("base-100-disk-0/vm-101-disk-0" belongs to VM 101).
_OWNER_NAME_RE = re.compile(r"^(?:vm|base)-(\d+)-")

# The volid of a drive the double-reference report counts carries a storage
# prefix. Anything else on a bus key is a passthrough path or a placeholder.
_STORAGE_VOLID_RE = re.compile(r"^[^:/\s]+:\S+$")


def volume_owner_vmid(volid: str) -> "int | None":
    """Return the VMID that owns volid by name, or None when the name encodes none.

    Inputs:
      volid - a PVE volid, <storage>:<name>

    Failure modes:
      no vm-N- or base-N- prefix on the last path segment - return None
    """
    name = volid.split(":", 1)[1] if ":" in volid else volid
    last = name.rsplit("/", 1)[-1]
    m = _OWNER_NAME_RE.match(last)
    if not m:
        return None
    try:
        return int(m.group(1))
    except ValueError:
        return None


def _referenced_volids(config: dict[str, Any]) -> "list[tuple[str, str, str]]":
    """Return (slot, kind, volid) for every volume a guest config names.

    Covers the bus slots _BUS_KEY_RE matches and every unusedN entry. A cdrom
    drive is left out, and that includes the cloud-init drive, which sits on a
    bus key such as ide2 as "<storage>:vm-<vmid>-cloudinit,media=cdrom". The
    "none" placeholder and a passthrough path are left out too. efidisk and
    tpmstate live on keys of their own, which this never reads. Kind is
    "active" for a bus slot and "unused" for an unusedN entry.
    """
    out: list[tuple[str, str, str]] = []
    for key in sorted(config):
        val = config[key]
        if not isinstance(val, str) or not val:
            continue
        if _BUS_KEY_RE.match(key):
            kind = "active"
        elif _UNUSED_KEY_RE.match(key):
            kind = "unused"
        else:
            continue
        options = val.split(",")[1:]
        if any(opt.strip().lower() == "media=cdrom" for opt in options):
            continue
        volid = _bus_disk_volid_from_slot(val).strip()
        if not _STORAGE_VOLID_RE.match(volid):
            continue
        out.append((key, kind, volid))
    return out


class MultiRefRecord:
    """One volume that more than one guest config names."""

    __slots__ = ("volid", "owner_vmid", "owner_present", "owner_holds", "references")

    def __init__(self, volid: str, owner_vmid: "int | None", owner_present: bool, references: list[dict[str, Any]]) -> None:
        self.volid = volid
        self.owner_vmid = owner_vmid
        # True when a guest with the owning VMID exists in the cluster index.
        self.owner_present = owner_present
        self.references = references
        self.owner_holds = any(ref["owns"] for ref in references)

    def to_dict(self) -> dict[str, Any]:
        return {
            "volid": self.volid,
            "owner_vmid": self.owner_vmid,
            "owner_present": self.owner_present,
            "owner_holds_reference": self.owner_holds,
            "references": [dict(ref) for ref in self.references],
        }


class MultiRefReport:
    """The double-reference findings together with how much of the cluster they cover.

    visibility is "full" when the principal can audit every guest, "limited"
    when it lacks VM.Audit on /vms and so sees only part of the cluster, and
    "unknown" when its permissions could not be read. unreadable_vmids lists
    the QEMU guests whose configs did not come back. A report is complete only
    when visibility is "full" and unreadable_vmids is empty.
    """

    __slots__ = ("records", "unreadable_vmids", "visibility", "visibility_error")

    def __init__(
        self,
        records: "list[MultiRefRecord]",
        unreadable_vmids: "list[int]",
        visibility: str = "full",
        visibility_error: str = "",
    ) -> None:
        self.records = records
        self.unreadable_vmids = unreadable_vmids
        self.visibility = visibility
        self.visibility_error = visibility_error

    @property
    def complete(self) -> bool:
        return self.visibility == "full" and not self.unreadable_vmids


def find_multiply_referenced(
    vm_map: dict[int, dict[str, str]],
    configs: "dict[int, dict[str, Any] | None]",
    parker_band: "tuple[int, int]",
) -> "tuple[list[MultiRefRecord], list[int]]":
    """Find every volume that two or more guests name, active slot or unused entry.

    Only QEMU guests count. A row whose type is not qemu is skipped before its
    config is looked at, because the config read for a container goes through
    the qemu endpoint and comes back empty, which would otherwise read as an
    unreadable guest. A row without a type is treated as qemu.

    One guest naming the same volume twice is not a finding. PVE refuses to
    free a volume that its own VM's config still names (try_deallocate_drive,
    qemu-server QemuServer.pm:4905-4907), so a second reference on the same VM
    cannot lose the volume.

    Inputs:
      vm_map      - vmid -> {node, name, tags, pool, type} from the cluster index
      configs     - vmid -> config dict, or None when the read failed
      parker_band - (start, end) of the parker VMID band

    Returns:
      (records ordered by volid, VMIDs of QEMU guests whose config is None)
    """
    by_volid: dict[str, list[dict[str, Any]]] = {}
    unreadable: list[int] = []
    for vmid_int in sorted(vm_map):
        info = vm_map[vmid_int]
        if (info.get("type") or "qemu") != "qemu":
            continue
        config = configs.get(vmid_int)
        if config is None:
            unreadable.append(vmid_int)
            continue
        parker = (
            parker_band[0] <= vmid_int <= parker_band[1]
            and _tags_contain_parker(str(info.get("tags", "") or ""))
        )
        for slot, kind, volid in _referenced_volids(config):
            by_volid.setdefault(volid, []).append({
                "vmid": vmid_int,
                "node": str(info.get("node", "") or ""),
                "name": str(info.get("name", "") or ""),
                "slot": slot,
                "kind": kind,
                "parker": parker,
            })

    records: list[MultiRefRecord] = []
    for volid in sorted(by_volid):
        refs = by_volid[volid]
        if len({ref["vmid"] for ref in refs}) < 2:
            continue
        owner = volume_owner_vmid(volid)
        for ref in refs:
            ref["owns"] = owner is not None and ref["vmid"] == owner
        records.append(MultiRefRecord(volid, owner, owner is not None and owner in vm_map, refs))
    return records, unreadable


def double_reference_visibility(client: Any) -> "tuple[str, str]":
    """Say how much of the cluster the principal can see for this report.

    A token scoped to a pool sees only the guests it can audit, so the cluster
    index leaves the rest out and a second holder outside its view would make
    the report read clean. Returns ("full", "") when the principal holds
    VM.Audit on /vms, ("limited", "") when it does not, and ("unknown", reason)
    when the permissions read failed.
    """
    privs, err = client.vms_permissions()
    if privs is None:
        return "unknown", err or "permissions read failed"
    if privs.get("VM.Audit"):
        return "full", ""
    return "limited", ""


def collect_inventory(
    client: PVEClient,
    cfg: AuditConfig,
    extra_parker_pools: "list[str] | None" = None,
) -> "tuple[list[DiskRecord], list[ParkerRecord], list[PoolIntruderRecord], MultiRefReport, list[tuple[str, str, str]]]":
    """Collect the full disk and parker inventory from PVE.

    Algorithm:
      1. List all cluster VM resources to build vmid -> {node, name, tags, pool}.
      2. Determine which nodes to scan (all online, or cfg.node if set).
      3. For each node, list storages and skip any marked enabled=0 or
         active=0, printing a SKIPPED line for each and remembering it for the
         report. Enumerate image content of the rest, deduplicating across
         nodes (shared storage).
      4. Read every QEMU guest's config in both of PVE's views, through the
         pending endpoint, so a drive whose delete is only pending still
         counts as held. A soft read that fails falls back to a hard read,
         which ends the audit, so an unreadable guest never turns a held
         volume into a false orphan. From the configs, index the volumes whose
         drive line carries a bpd- serial, the volumes a sentinel names, and
         the volumes on a bus slot of a parker VM. We count a volume as ours
         when its embedded VMID falls in the disk band, or it carries a bpd-
         serial, or a sentinel names its full volid, or a parker holds it on
         a bus slot. Then build a holder map: volid -> (holder_vmid,
         holder_node, holder_name, holder_tags) by scanning the
         scsi|virtio|ide|sata bus slots of each guest for matching volids.
         This mirrors FindVMByDiskVolid in disk.go. The holder is found by
         scanning configs, never by comparing the VMID in the volume's name,
         because the CPI renames a stable-ID disk to the VMID of whichever
         guest or parker holds it. O(#VMs) config fetches; acceptable for an
         operator audit tool.
      5. Classify each disk volume using the holder map:
           - holder VMID in parker band AND bosh-parker tag -> parked
             (fetch parker sentinel for provenance; config already cached)
           - holder found, not a parker -> attached
           - no holder in any VM config -> free-floating
         A free-floating volume that only a sentinel named is marked, with
         the VM whose sentinel pointed at it.
      6. Enumerate parker VMs independently (catches empty parkers whose
         disk_count is 0 and therefore never appear as disk holders).
         Count unusedN references alongside bus slots: a parker holding one
         still references a live volume, so it is not a teardown candidate.
      7. Work out which pools hold parkers, add any the operator named, and
         report every VM in one of them that carries no bosh-parker tag.
      8. Read every QEMU guest's config, reusing the cache, and report each
         volume that more than one guest names, along with the guests whose
         configs did not come back and how much of the cluster the
         principal can see.

    Inputs:
      client             - authenticated PVE API client
      cfg                - resolved audit config
      extra_parker_pools - pool names the operator passed on --parker-pool,
                           which count as parker pools even when no parker
                           currently belongs to them

    Returns:
      (disk_records, parker_records, pool_intruders, multi_ref_report,
       skipped_storages), where skipped_storages lists the
      (node, storage, reason) of every storage we did not read
    """
    # ---- Step 1: cluster VM map ----
    vm_map: dict[int, dict[str, str]] = {}
    for entry in client.cluster_resources_vms():
        vmid_raw = entry.get("vmid")
        if vmid_raw is None:
            continue
        try:
            vmid_int = int(vmid_raw)
        except (TypeError, ValueError):
            continue
        vm_map[vmid_int] = {
            "node": str(entry.get("node", "") or ""),
            "name": str(entry.get("name", "") or ""),
            "tags": str(entry.get("tags", "") or ""),
            "pool": str(entry.get("pool", "") or ""),
            "type": str(entry.get("type", "") or ""),
        }

    # ---- Step 2: node list ----
    if cfg.node:
        nodes = [cfg.node]
    else:
        nodes = client.list_nodes()
        if not nodes:
            _warn("no online nodes found; inventory may be empty")

    # ---- Step 3: storage content scan ----
    # all_volumes: volid -> (storage_name, first_seen_node, size_bytes), in
    # first-seen order; shared storage shows the same volid on every node.
    all_volumes: dict[str, tuple[str, str, int]] = {}
    skipped_storages: list[tuple[str, str, str]] = []

    for node in nodes:
        storages = client.node_storages(node)
        for st in storages:
            storage_name = str(st.get("storage", "") or "").strip()
            if not storage_name:
                continue
            content_types = str(st.get("content", "") or "")
            if "images" not in [p.strip() for p in content_types.split(",")]:
                continue  # skip storages that can't hold disk images
            # PVE answers a content read on a disabled storage with HTTP 500,
            # which get() treats as a failure. The listing already says the
            # storage is off, so we skip it here instead and carry the skip
            # into the report, because the disks on it are not in the report.
            skip_reason = storage_skip_reason(st)
            if skip_reason:
                skipped_storages.append((node, storage_name, skip_reason))
                print(f"SKIPPED: node {node} storage {storage_name}: {skip_reason}", file=sys.stderr)
                continue
            for item in client.storage_content(node, storage_name):
                volid = str(item.get("volid", "") or "").strip()
                if not volid or volid in all_volumes:
                    continue
                size_bytes = 0
                try:
                    size_bytes = int(item.get("size", 0) or 0)
                except (TypeError, ValueError):
                    pass
                all_volumes[volid] = (storage_name, node, size_bytes)

    def _in_band(volid: str) -> bool:
        embedded = disk_vmid_from_volid(volid)
        return embedded is not None and cfg.disk_vmid_start <= embedded <= cfg.disk_vmid_end

    # ---- Step 4: read guest configs, find our disks, build the holder map ----
    # Mirrors FindVMByDiskVolid in disk.go: scan each VM's scsi|virtio|ide|sata
    # bus slots for the target volid. The holder is a VM identified only by
    # scanning configs, never by VMID equality with the volume's name.
    # O(#VMs) config fetches; acceptable for an operator audit tool.
    #
    # The same configs tell us which volumes are ours. A stable-ID disk keeps
    # its bpd- serial on the drive line, and the CPI renames the volume to the
    # holder's VMID on attach and to the parker's VMID on detach, so the VMID
    # in a name says nothing reliable. A sentinel in any VM's description can
    # name a volume too, and every bus slot of a parker holds one of ours.
    #
    # Each guest is read in both views. A drive whose delete is only pending is
    # still plugged into the running guest, so a key counts as held when either
    # view names it.
    #
    # vm_config_cache: vmid -> merged config dict (or None on fetch failure),
    # reused in step 5 for provenance, step 6 for parker counts, and step 8.
    # vm_bus_cache: vmid -> raw bus-slot values from both views.
    vm_config_cache: dict[int, "dict[str, Any] | None"] = {}
    vm_bus_cache: dict[int, list[str]] = {}
    vm_current_serials: dict[int, dict[str, str]] = {}  # vmid -> token -> volid in the current view
    serial_volids: dict[str, str] = {}       # volid -> bpd- serial on its drive line
    serial_holders: dict[str, dict[str, set[tuple[int, str]]]] = {}  # token -> volid -> {(vmid, name)}
    sentinel_refs: dict[str, tuple[int, str]] = {}  # full volid a sentinel names -> first (vmid, name)
    parker_volids: set[str] = set()          # volids on a bus slot of a parker VM
    unread_guests = 0

    def _read_guest(vmid: int, node: str, hard_only: bool = False) -> None:
        views = None if hard_only else client.vm_views_soft(node, vmid)
        if views is None:
            # An unread guest could hold a volume we would then call free-floating,
            # and a parker we cannot read hides its parked disks. The hard read
            # ends the audit on a real failure, so neither goes unnoticed.
            views = client.vm_views(node, vmid)
        if views is None:
            vm_config_cache[vmid] = None
            vm_bus_cache.pop(vmid, None)
            return
        vm_config_cache[vmid] = merge_views(views)
        vm_bus_cache[vmid] = views_bus_values(views)
        current_serials: dict[str, str] = {}
        for raw in views_bus_values((views[0], {})):
            token = stable_id_from_drive_opt_str(raw)
            if token:
                current_serials.setdefault(token, _bus_disk_volid_from_slot(raw))
        vm_current_serials[vmid] = current_serials

    if all_volumes:
        # Nothing to discover without image volumes, and step 8 reads the
        # configs softly in that case.
        for vmid_int, info in vm_map.items():
            vm_node = info["node"]
            if (info.get("type") or "qemu") != "qemu" or not vm_node:
                continue
            _read_guest(vmid_int, vm_node)
            config = vm_config_cache[vmid_int]
            if config is None:
                unread_guests += 1
                continue
            is_parker = (
                cfg.parker_vmid_start <= vmid_int <= cfg.parker_vmid_end
                and _tags_contain_parker(info["tags"])
            )
            for raw_val in vm_bus_cache[vmid_int]:
                slot_volid = _bus_disk_volid_from_slot(raw_val)
                serial = stable_id_from_drive_opt_str(raw_val)
                if serial:
                    serial_volids.setdefault(slot_volid, serial)
                    current_volid = vm_current_serials.get(vmid_int, {}).get(serial)
                    # A volid only the pending view names, for a token the
                    # current view gave to another volid, is the same disk
                    # mid-change and not a second holder.
                    if current_volid is None or current_volid == slot_volid:
                        serial_holders.setdefault(serial, {}).setdefault(slot_volid, set()).add(
                            (vmid_int, info["name"])
                        )
                if is_parker:
                    parker_volids.add(slot_volid)
            for named in parse_sentinel_volume_names(str(config.get("description", "") or ""), config):
                sentinel_refs.setdefault(named, (vmid_int, info["name"]))
        if unread_guests:
            _warn(
                f"{unread_guests} guest config(s) could not be read; a renamed "
                "disk held only by such a guest may be missing from this report."
            )
        # qm clone copies drive options, so a clone of a BOSH VM carries the
        # original's serial on its own volumes. One token on two volumes is
        # not a stable identity, and we say so rather than count both quietly.
        for token in sorted(serial_holders):
            volids = serial_holders[token]
            if len(volids) < 2:
                continue
            parts = []
            for volid in sorted(volids):
                holders = ", ".join(f"VM {v} ({n or 'unnamed'})" for v, n in sorted(volids[volid]))
                parts.append(f"{volid} (held by {holders})")
            _warn(
                f"serial {token} appears on {len(volids)} different volumes: {'; '.join(parts)}. "
                "A clone of a BOSH VM copies the serial, so we cannot tell which volume the CPI means."
            )

    # raw_disks: list of (volid, storage_name, first_seen_node, size_bytes, signals)
    raw_disks: list[tuple[str, str, str, int, list[str]]] = []
    for volid, (storage_name, first_node, size_bytes) in all_volumes.items():
        signals: list[str] = []
        if _in_band(volid):
            signals.append("band")
        if volid in serial_volids:
            signals.append("serial")
        if volid in parker_volids:
            signals.append("parker")
        if volid in sentinel_refs:
            signals.append("sentinel")
        if signals:
            raw_disks.append((volid, storage_name, first_node, size_bytes, signals))

    # holder_map: volid -> {"vmid": int, "node": str, "name": str, "tags": str}
    target_volids = {v for (v, _, _, _, _) in raw_disks}
    holder_map: dict[str, dict[str, Any]] = {}
    for vmid_int, info in vm_map.items():
        for raw_val in vm_bus_cache.get(vmid_int, []):
            slot_volid = _bus_disk_volid_from_slot(raw_val)
            if slot_volid in target_volids and slot_volid not in holder_map:
                holder_map[slot_volid] = {
                    "vmid": vmid_int,
                    "node": info["node"],
                    "name": info["name"],
                    "tags": info["tags"],
                }

    # unused_holders: the first guest that names a target volid on an unusedN
    # entry. A volume found only by a sentinel and held this way is not unheld.
    unused_holders: dict[str, tuple[int, str, str, str]] = {}
    for vmid_int, info in vm_map.items():
        config = vm_config_cache.get(vmid_int)
        if config is None:
            continue
        for slot, kind, ref_volid in _referenced_volids(config):
            if kind == "unused" and ref_volid in target_volids and ref_volid not in unused_holders:
                unused_holders[ref_volid] = (vmid_int, info["node"], info["name"], slot)

    # ---- Step 5: classify each disk ----
    # provenance cache: parker vmid -> {full_volid: prov_dict}
    parker_provenance_cache: dict[int, dict[str, Any]] = {}

    disk_records: list[DiskRecord] = []

    for (volid, storage, node, size_bytes, signals) in raw_disks:
        rec = DiskRecord(volid, storage, node, size_bytes)
        rec.discovered_by = signals

        holder = holder_map.get(volid)
        if holder is None:
            rec.classification = "free-floating"
            unused = unused_holders.get(volid)
            if unused is not None:
                rec.holder_vmid, rec.holder_node, rec.holder_name, rec.holder_slot = unused
            if signals == ["sentinel"]:
                # Only a sentinel note named this volume, and sentinels go
                # stale, so it is not a plain orphan.
                rec.sentinel_only = True
                rec.sentinel_vmid, rec.sentinel_name = sentinel_refs[volid]
            disk_records.append(rec)
            continue

        holder_vmid = holder["vmid"]
        holder_node = holder["node"]
        holder_name = holder["name"]
        holder_tags = holder["tags"]
        rec.holder_vmid = holder_vmid
        rec.holder_node = holder_node
        rec.holder_name = holder_name

        in_parker_range = cfg.parker_vmid_start <= holder_vmid <= cfg.parker_vmid_end
        has_parker_tag = _tags_contain_parker(holder_tags)

        if in_parker_range and has_parker_tag:
            rec.classification = "parked"
            # Provenance from the parker VM description sentinel.
            # Config already in vm_config_cache from step 4.
            if holder_vmid not in parker_provenance_cache:
                pconfig = vm_config_cache.get(holder_vmid)
                if pconfig is not None:
                    desc = str(pconfig.get("description", "") or "")
                    parker_provenance_cache[holder_vmid] = parse_parker_sentinel(desc)
                else:
                    parker_provenance_cache[holder_vmid] = {}
            prov_map = parker_provenance_cache.get(holder_vmid, {})
            # Two keying generations coexist in the sentinel map (parker.go):
            # legacy entries are keyed by the full "storage:vm-N-disk-n" volid
            # (the storage prefix preserved — the same form the PVE
            # storage-content API returns, so we look up by the whole volid); stable-ID
            # entries are keyed by the disk's bpd- token and name the volid
            # the parker currently holds the volume under in their "volid"
            # field. Match either.
            prov = prov_map.get(volid) or {}
            if not prov:
                for entry in prov_map.values():
                    if isinstance(entry, dict) and entry.get("volid") == volid:
                        prov = entry
                        break
            if isinstance(prov, dict):
                rec.disk_cid = str(prov.get("disk_cid", "") or "")
                rec.source_vm_cid = str(prov.get("source_vm_cid", "") or "")
                rec.parked_at = str(prov.get("parked_at", "") or "")
                rec.parked_node = str(prov.get("node", "") or "")
                rec.director_id = str(prov.get("director_id", "") or "")
        else:
            rec.classification = "attached"

        disk_records.append(rec)

    # ---- Step 6: parker VM inventory (including empty ones) ----
    parker_records: list[ParkerRecord] = []

    for vmid_int, info in vm_map.items():
        if not (cfg.parker_vmid_start <= vmid_int <= cfg.parker_vmid_end):
            continue
        # Tags come from the cluster-resources row. An empty field is treated as
        # "not a parker" here, where delete_vm.go falls back to the VM config for
        # the same input -- it has to, since it is about to purge. This is an
        # audit: reporting no parkers is visible in its output, and every warning
        # it emits is advisory. A PVE that does not populate the field will show
        # zero parkers here while the CPI still recognizes them.
        if not _tags_contain_parker(info["tags"]):
            continue
        vm_node = info["node"]
        # Reuse the cached config from step 4. A parker whose step-4 read
        # failed, or that step 4 never read, gets a hard read here, so an
        # unreadable parker ends the audit rather than reading as empty.
        pconfig = vm_config_cache.get(vmid_int)
        if pconfig is None:
            _read_guest(vmid_int, vm_node, hard_only=True)
            pconfig = vm_config_cache[vmid_int]
        disk_count = _count_bus_disks(pconfig) if pconfig is not None else 0
        unused_count = _count_unused_refs(pconfig) if pconfig is not None else 0
        parker_records.append(ParkerRecord(
            vmid=vmid_int,
            node=vm_node,
            name=info["name"],
            pool=info["pool"],
            disk_count=disk_count,
            unused_count=unused_count,
            config_read=pconfig is not None,
        ))

    parker_records.sort(key=lambda r: r.vmid)

    # ---- Step 7: workload VMs sitting in a parker pool ----
    pool_intruders = find_pool_intruders(vm_map, parker_pool_names(parker_records, extra_parker_pools))

    # ---- Step 8: volumes that more than one guest names ----
    # Every QEMU guest is read, cluster-wide, whatever cfg.node says, because
    # the second reference can sit on any node. Step 4 already filled the
    # cache when there were volumes to match; otherwise we read the configs
    # here. Containers are skipped before the cache is consulted.
    # These reads are soft: a guest whose config does not come back is listed
    # as unreadable rather than ending the audit.
    for vmid_int, info in vm_map.items():
        if (info.get("type") or "qemu") != "qemu" or vmid_int in vm_config_cache:
            continue
        if not info["node"]:
            vm_config_cache[vmid_int] = None
            continue
        views = client.vm_views_soft(info["node"], vmid_int)
        vm_config_cache[vmid_int] = merge_views(views) if views is not None else None
    multi_records, unreadable = find_multiply_referenced(
        vm_map, vm_config_cache, (cfg.parker_vmid_start, cfg.parker_vmid_end),
    )
    visibility, visibility_error = double_reference_visibility(client)
    multi_ref = MultiRefReport(multi_records, unreadable, visibility, visibility_error)

    return disk_records, parker_records, pool_intruders, multi_ref, skipped_storages


# ---------------------------------------------------------------------------
# Output formatters
# ---------------------------------------------------------------------------

_SIZE_UNITS = [
    (1 << 40, "TiB"),
    (1 << 30, "GiB"),
    (1 << 20, "MiB"),
    (1 << 10, "KiB"),
]


def _human_size(size_bytes: int) -> str:
    if size_bytes <= 0:
        return "—"
    for threshold, unit in _SIZE_UNITS:
        if size_bytes >= threshold:
            val = size_bytes / threshold
            return f"{val:.1f} {unit}"
    return f"{size_bytes} B"


def _trunc(s: str, n: int) -> str:
    """Truncate string to n chars, appending '…' when truncated."""
    if len(s) <= n:
        return s
    return s[:n - 1] + "…"


def print_human_report(
    disk_records: list[DiskRecord],
    parker_records: list[ParkerRecord],
    cfg: AuditConfig,
    multi_ref: "MultiRefReport | None" = None,
    skipped: "list[tuple[str, str, str]] | None" = None,
) -> None:
    """Print a human-readable table report to stdout."""
    counts: dict[str, int] = {"attached": 0, "parked": 0, "free-floating": 0, "unknown": 0}
    for rec in disk_records:
        counts[rec.classification] = counts.get(rec.classification, 0) + 1

    total = len(disk_records)
    print("\nBOSH Persistent Disk Audit")
    print(f"  Host:  {cfg.host}:{cfg.port}")
    print(f"  Disk band:   [{cfg.disk_vmid_start}, {cfg.disk_vmid_end}]")
    print(f"  Parker band: [{cfg.parker_vmid_start}, {cfg.parker_vmid_end}]")
    if cfg.node:
        print(f"  Scope: node={cfg.node}")
    if skipped:
        print("  Skipped storages (disks on a skipped storage are not in this report):")
        for sk_node, sk_storage, sk_reason in skipped:
            print(f"    node {sk_node} storage {sk_storage}: {sk_reason}")
    print(f"  Total disk volumes: {total}")
    print(f"    attached:      {counts['attached']}")
    print(f"    parked:        {counts['parked']}")
    print(f"    free-floating: {counts['free-floating']}")
    print(f"    unknown:       {counts['unknown']}")
    if multi_ref is not None:
        print(f"  Volumes named by more than one guest: {len(multi_ref.records)}")
        if not multi_ref.complete:
            print(f"    coverage: {_multi_ref_coverage_text(multi_ref)}")
    print()

    # Attached
    attached = [r for r in disk_records if r.classification == "attached"]
    if attached:
        print("ATTACHED DISKS")
        print(f"  {'VOLID':<45} {'SIZE':>10}  {'HOLDER VMID':>11}  {'HOLDER NAME':<30}")
        print(f"  {'-'*45} {'-'*10}  {'-'*11}  {'-'*30}")
        for r in sorted(attached, key=lambda x: x.volid):
            holder = str(r.holder_vmid) if r.holder_vmid is not None else "—"
            print(f"  {_trunc(r.volid, 45):<45} {_human_size(r.size_bytes):>10}  {holder:>11}  {_trunc(r.holder_name, 30):<30}")
        print()

    # Parked
    parked = [r for r in disk_records if r.classification == "parked"]
    if parked:
        print("PARKED DISKS")
        print(
            f"  {'VOLID':<45} {'SIZE':>10}  {'PARKER':>7}  "
            f"{'DISK_CID':<32}  {'SRC_VM_CID':<20}  {'PARKED_AT':<20}  {'DIR_ID':<12}"
        )
        print(
            f"  {'-'*45} {'-'*10}  {'-'*7}  "
            f"{'-'*32}  {'-'*20}  {'-'*20}  {'-'*12}"
        )
        for r in sorted(parked, key=lambda x: x.volid):
            parker_id = str(r.holder_vmid) if r.holder_vmid is not None else "—"
            print(
                f"  {_trunc(r.volid, 45):<45} {_human_size(r.size_bytes):>10}  {parker_id:>7}  "
                f"{_trunc(r.disk_cid, 32):<32}  {_trunc(r.source_vm_cid, 20):<20}  "
                f"{_trunc(r.parked_at, 20):<20}  {_trunc(r.director_id, 12):<12}"
            )
        print()

    # Free-floating
    floating = [r for r in disk_records if r.classification == "free-floating"]
    if floating:
        print("FREE-FLOATING DISKS  [WARNING: potential orphans]")
        print(f"  {'VOLID':<55} {'SIZE':>10}  {'STORAGE':<20}  {'NODE':<15}")
        print(f"  {'-'*55} {'-'*10}  {'-'*20}  {'-'*15}")
        for r in sorted(floating, key=lambda x: x.volid):
            print(f"  {_trunc(r.volid, 55):<55} {_human_size(r.size_bytes):>10}  {r.storage:<20}  {r.node:<15}")
            if r.holder_slot:
                print(
                    f"    DO NOT DELETE: VM {r.holder_vmid} ({r.holder_name or 'unnamed'}) "
                    f"still names it on {r.holder_slot}, so PVE references it"
                )
            if r.sentinel_only:
                who = f"VM {r.sentinel_vmid}" if r.sentinel_vmid is not None else "a VM"
                if r.sentinel_name:
                    who += f" ({r.sentinel_name})"
                print(
                    f"    found only by a sentinel note on {who}; verify with "
                    "`bosh disks --orphaned` before deleting"
                )
        print()

    # Volumes more than one guest names
    if multi_ref is not None and multi_ref.records:
        print("MULTIPLY REFERENCED VOLUMES  [WARNING: more than one guest names these]")
        for mr in multi_ref.records:
            print(f"  {mr.volid}")
            note = _multi_ref_owner_note(mr)
            if note:
                print(f"    {note}")
            for ref in mr.references:
                print(f"    {_multi_ref_reference_text(ref)}")
        print()

    # Unknown
    unknowns = [r for r in disk_records if r.classification == "unknown"]
    if unknowns:
        print("UNKNOWN VOLUMES  [could not determine holder]")
        for r in sorted(unknowns, key=lambda x: x.volid):
            print(f"  {r.volid}")
        print()

    # Parker summary
    if parker_records:
        print("PARKER VMs")
        print(
            f"  {'VMID':>7}  {'NODE':<15}  {'NAME':<30}  {'POOL':<20}  {'DISKS':>5}/{31}  "
            f"{'UNUSED':>6}  {'EMPTY':>5}"
        )
        print(f"  {'-'*7}  {'-'*15}  {'-'*30}  {'-'*20}  {'-'*8}  {'-'*6}  {'-'*5}")
        for pr in parker_records:
            empty_flag = "YES" if pr.empty else ("?" if not pr.config_read else "")
            print(
                f"  {pr.vmid:>7}  {pr.node:<15}  {_trunc(pr.name, 30):<30}  "
                f"{_trunc(pr.pool, 20):<20}  "
                f"{pr.disk_count:>5}/{31}  {pr.unused_count:>6}  {empty_flag:>5}"
            )
        print()
    else:
        print("PARKER VMs: none found")
        print()


def print_json_report(
    disk_records: list[DiskRecord],
    parker_records: list[ParkerRecord],
    cfg: AuditConfig,
    multi_ref: "MultiRefReport | None" = None,
    skipped: "list[tuple[str, str, str]] | None" = None,
) -> None:
    """Print a JSON report to stdout."""
    out = {
        "host": cfg.host,
        "port": cfg.port,
        "disk_band": [cfg.disk_vmid_start, cfg.disk_vmid_end],
        "parker_band": [cfg.parker_vmid_start, cfg.parker_vmid_end],
        "summary": {
            "total": len(disk_records),
            "attached": sum(1 for r in disk_records if r.classification == "attached"),
            "parked": sum(1 for r in disk_records if r.classification == "parked"),
            "free_floating": sum(1 for r in disk_records if r.classification == "free-floating"),
            "unknown": sum(1 for r in disk_records if r.classification == "unknown"),
        },
        "disks": [r.to_dict() for r in sorted(disk_records, key=lambda x: x.volid)],
        "parkers": [pr.to_dict() for pr in parker_records],
    }
    if skipped is not None:
        out["skipped_storages"] = [
            {"node": n, "storage": st, "reason": reason} for n, st, reason in skipped
        ]
    if multi_ref is not None:
        out["summary"]["multiply_referenced"] = len(multi_ref.records)
        out["multiply_referenced"] = [mr.to_dict() for mr in multi_ref.records]
        out["multiply_referenced_unreadable_vmids"] = list(multi_ref.unreadable_vmids)
        out["multiply_referenced_visibility"] = multi_ref.visibility
        out["multiply_referenced_complete"] = multi_ref.complete
    print(json.dumps(out, indent=2))


def _multi_ref_reference_text(ref: dict[str, Any]) -> str:
    """One reference, as the report and the warning both print it."""
    marks = []
    if ref.get("owns"):
        marks.append("owns by name")
    if ref.get("parker"):
        marks.append("parker")
    suffix = f" [{', '.join(marks)}]" if marks else ""
    name = ref.get("name") or "unnamed"
    return f"VM {ref['vmid']} ({name}) on {ref.get('node') or '?'} {ref['slot']}{suffix}"


def _multi_ref_owner_note(mr: MultiRefRecord) -> str:
    """Say who owns the volume by name when that matters for what not to do."""
    if mr.owner_vmid is None:
        return "no VM owns this volume by name"
    if mr.owner_holds:
        return ""
    if mr.owner_present:
        return (
            f"VM {mr.owner_vmid} owns this volume by name and holds none of these references; "
            "destroying it with destroy-unreferenced-disks deletes the volume"
        )
    return f"VM {mr.owner_vmid} would own this volume by name, and no such VM is in the cluster index"


def _multi_ref_coverage_text(multi_ref: MultiRefReport) -> str:
    """Say why the double-reference report may be incomplete."""
    parts = []
    if multi_ref.visibility == "limited":
        parts.append("limited (this token lacks VM.Audit on /vms)")
    elif multi_ref.visibility == "unknown":
        parts.append("unknown (the permissions read failed)")
    if multi_ref.unreadable_vmids:
        parts.append(f"{len(multi_ref.unreadable_vmids)} guest config(s) unreadable")
    return "; ".join(parts)


_MULTI_REF_DOCS = (
    'see "Auditing parked disks with scripts/disk-audit" in docs/operations.md '
    "of bosh-proxmox-cpi-release"
)


# ---------------------------------------------------------------------------
# Warnings
# ---------------------------------------------------------------------------

def emit_warnings(
    disk_records: list[DiskRecord],
    parker_records: list[ParkerRecord],
    pool_intruders: list[PoolIntruderRecord],
    cfg: AuditConfig,
    multi_ref: "MultiRefReport | None" = None,
) -> None:
    """Emit advisory warnings to stderr."""
    parked_count = sum(1 for r in disk_records if r.classification == "parked")

    # Note when parked disks exist but the operator has opted out of parking.
    # The parker band resolves under "free" too, so these disks still drain:
    # each is unparked on its next attach_disk or delete_disk.
    strategy = cfg.detached_disk_strategy
    if parked_count > 0 and strategy != "parked":
        _warn(
            f"{parked_count} parked disk(s) found but detached_disk_strategy="
            f"{strategy!r}. They stay recognized (the parker band resolves "
            "under every strategy) and each unparks on its next attach_disk "
            "or delete_disk; no new detaches will park."
        )

    # Warn about empty parkers (teardown candidates).  A parker is a teardown
    # candidate only when its config was read and holds neither a bus disk nor
    # an unusedN reference: `qm destroy --purge` frees the volume behind an
    # unusedN entry just as readily as one in a bus slot.
    empty_parkers = [pr for pr in parker_records if pr.empty]
    for pr in empty_parkers:
        _warn(
            f"parker VM {pr.vmid} ({pr.name}, pool {pr.pool or 'none'}) on node {pr.node} is empty "
            "(0 disks) — teardown candidate: "
            f"qm set {pr.vmid} --protection 0 && qm destroy {pr.vmid} --purge"
        )

    # Warn about stranded unusedN references: a sweep that did not complete
    # inside the protection window.  These hold live persistent disks.
    for pr in parker_records:
        if pr.unused_count > 0:
            _warn(
                f"parker VM {pr.vmid} ({pr.name}, pool {pr.pool or 'none'}) on node {pr.node} carries "
                f"{pr.unused_count} unusedN reference(s) to a live volume; "
                "do NOT destroy it. Clear each with: "
                f"qm set {pr.vmid} --protection 0 && "
                f"qm unlink {pr.vmid} --idlist <unusedN> && "
                f"qm set {pr.vmid} --protection 1"
            )

    # Warn about parkers whose config did not come back. PVEClient.get exits the
    # audit on a transport fault, so in practice this is the parker that vanished
    # between the cluster listing and the config read (HTTP 404/501). Its
    # contents are unknown either way, so it is not reported as empty.
    for pr in parker_records:
        if not pr.config_read:
            _warn(
                f"parker VM {pr.vmid} ({pr.name}, pool {pr.pool or 'none'}) on node {pr.node} config was "
                "not returned (vanished during the scan, HTTP 404/501); its "
                "contents are unknown and it is not reported as empty"
            )

    # Warn about workload VMs sitting in a parker pool. The CPI refuses to
    # create one there and its pool reconciler warns and skips rather than
    # moving it, so the warning stays until an operator moves the VM by hand
    # and points the template or profile that rendered the name somewhere else.
    for ir in pool_intruders:
        _warn(
            f"VM {ir.vmid} ({ir.name or 'unnamed'}, pool {ir.pool}) on node {ir.node} sits in a parker "
            "pool and carries no bosh-parker tag. The CPI never moves it out, so move it into the "
            "workload pool it belongs in with: "
            f"pvesh set /pools/<workload-pool> --vms {ir.vmid} --allow-move 1"
        )

    if multi_ref is None:
        return

    # Warn about every volume more than one guest names. No fix command: the
    # right repair depends on how the volume got there, and the docs section
    # says how to tell which guest really holds the disk.
    for mr in multi_ref.records:
        refs = "; ".join(_multi_ref_reference_text(ref) for ref in mr.references)
        note = _multi_ref_owner_note(mr)
        if mr.owner_vmid is not None and mr.owner_holds:
            hazard = (
                f"destroying VM {mr.owner_vmid}, or removing its unused entry, deletes the volume "
                "while another guest still names it"
            )
        else:
            hazard = note
        _warn(
            f"volume {mr.volid} is named by {len({r['vmid'] for r in mr.references})} guests: {refs}. "
            f"Leave every reference in place until we know which guest really holds the disk; "
            f"{hazard}; {_MULTI_REF_DOCS}"
        )

    if multi_ref.unreadable_vmids:
        vmids = ", ".join(str(v) for v in multi_ref.unreadable_vmids)
        _warn(
            f"the configs of {len(multi_ref.unreadable_vmids)} QEMU guest(s) did not come back "
            f"({vmids}), so the report of volumes named by more than one guest may be incomplete"
        )
    if multi_ref.visibility == "limited":
        _warn(
            "this token lacks VM.Audit on /vms, so the report of volumes named by more than one guest "
            "covers only the guests this token can see; a second guest outside its view would not show up"
        )
    elif multi_ref.visibility == "unknown":
        _warn(
            f"could not read this token's permissions on /vms ({multi_ref.visibility_error}), so the "
            "coverage of the report of volumes named by more than one guest is unknown"
        )


# ---------------------------------------------------------------------------
# Utilities
# ---------------------------------------------------------------------------

def _warn(msg: str) -> None:
    print(f"WARN: {msg}", file=sys.stderr)


def _die(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(2)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main(argv: "list[str] | None" = None) -> int:
    parser = argparse.ArgumentParser(
        prog="disk-audit",
        description="Audit BOSH persistent disk volumes managed by the PVE CPI.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--config",
        required=True,
        metavar="PATH",
        help="Path to a CPI-config-style JSON file (host/user/api_token or password + optional ranges).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        default=False,
        help="Emit machine-readable JSON to stdout instead of a human table.",
    )
    parser.add_argument(
        "--parker-pool",
        action="append",
        default=None,
        metavar="NAME",
        help=(
            "Treat NAME as a parker pool when looking for workload VMs that do not belong in one. "
            "Repeat the flag or give a comma-separated list. A pool that already holds a parker "
            "needs no flag."
        ),
    )
    args = parser.parse_args(argv)

    cfg = load_config(args.config)
    extra_parker_pools = parse_parker_pool_args(args.parker_pool)

    try:
        client = PVEClient(cfg)
        disk_records, parker_records, pool_intruders, multi_ref, skipped = collect_inventory(
            client, cfg, extra_parker_pools
        )
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001
        _die(f"inventory collection failed: {exc}")

    emit_warnings(disk_records, parker_records, pool_intruders, cfg, multi_ref)

    if args.json:
        print_json_report(disk_records, parker_records, cfg, multi_ref, skipped)
    else:
        print_human_report(disk_records, parker_records, cfg, multi_ref, skipped)

    free_floating = [r for r in disk_records if r.classification == "free-floating"]
    if free_floating:
        held = [r for r in free_floating if r.holder_slot]
        note = ""
        if held:
            note = ", " + ", ".join(
                f"{r.volid} still named by VM {r.holder_vmid}" for r in sorted(held, key=lambda x: x.volid)
            )
        print(
            f"EXIT 1: {len(free_floating)} free-floating disk(s) found{note}.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
