#!/bin/bash
set -euo pipefail

# Resolve paths relative to this script so the wrapper works for both
# director VM installs (/var/vcap/...) and `bosh create-env` host installs
# (~/.bosh/installations/<id>/...).
JOB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGES_DIR="$(cd "${JOB_DIR}/../../packages" && pwd)"

BIN="${PACKAGES_DIR}/pve_cpi/bin/cpi"

if [ ! -x "${BIN}" ]; then
  printf '{"result":null,"error":{"type":"Bosh::Clouds::CloudError","message":"pve_cpi binary not found or not executable: %s — verify package compilation succeeded","ok_to_retry":false},"log":""}\n' "${BIN}" >&1
  exit 1
fi

cd "${JOB_DIR}" || exit 1

exec "${BIN}" --config "${JOB_DIR}/config/cpi.json"
