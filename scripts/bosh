#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Wrapper around the bosh CLI for the bosh-pve-cpi-release repo.

Subcommands:
    create-env | deploy    bosh create-env for the pve director
    teardown | delete-env  bosh delete-env for the pve director (idempotent:
                           no-op when state.json is absent or empty)
    alias-env              alias the director as 'pve' using creds.yml CA
    login                  bosh -e pve login
    env                    bosh env (against pve)
    ucc | upload-cloud-config
                           upload manifests/bosh/cloud-config.yml
    runtime-config         upload manifests/runtime-configs/pve-guest-agent.yml
                           (named runtime-config "pve-guest-agent")
    upload-stemcell        upload $STEMCELL_PATH to the director (needed before
                           emptyvm; idempotent for an already-present version)
    emptyvm                deploy manifests/bosh/emptyvm.yml
    credhub <args>         passthrough → credhub <args> with the director's
                           credhub URL, admin client, and CA pre-exported
    help                   show this help
    <anything else>        passthrough → bosh -e pve <args>

Env (auto-exported for non-create-env subcommands when creds.yml exists):
    BOSH_ENVIRONMENT=pve
    BOSH_CLIENT=admin
    BOSH_CLIENT_SECRET=<creds.yml:/admin_password>
    BOSH_CA_CERT=<creds.yml:/director_ssl/ca>

Credhub env (for credhub):
    CREDHUB_SERVER=https://<internal_ip>:8844
    CREDHUB_CLIENT=credhub-admin
    CREDHUB_SECRET=<creds.yml:/credhub_admin_client_secret>
    CREDHUB_CA_CERT=<creds.yml:/credhub_tls/ca + /uaa_ssl/ca>
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
BOSH_DEPLOYMENT_DIR = Path(os.environ.get("BOSH_DEPLOYMENT_DIR", Path.home() / "w/cloudfoundry/bosh-deployment"))
MANIFESTS = REPO_ROOT / "manifests"
BOSH_DIR = MANIFESTS / "bosh"
VARS = BOSH_DIR / "vars.yml"
CREDS = BOSH_DIR / "creds.yml"
STATE = BOSH_DIR / "state.json"
CPI_OPS = BOSH_DIR / "cpi.yml"
OS_CONF_OPS = BOSH_DIR / "os-conf.yml"
NATS_TUNING_OPS = BOSH_DIR / "nats-tuning.yml"
HM_TUNING_OPS = BOSH_DIR / "hm-tuning.yml"
CLOUD_CONFIG = BOSH_DIR / "cloud-config.yml"
EMPTYVM = BOSH_DIR / "emptyvm.yml"
PVE_GUEST_AGENT_RC = MANIFESTS / "runtime-configs" / "pve-guest-agent.yml"

USAGE = __doc__ or ""


def bosh_int(path: Path, json_path: str) -> str:
    return subprocess.run(
        ["bosh", "int", str(path), "--path", json_path],
        check=True, capture_output=True, text=True,
    ).stdout.rstrip("\n")


def run(*cmd: str, env: dict[str, str] | None = None) -> int:
    return subprocess.run(list(cmd), env=env, cwd=REPO_ROOT).returncode


def director_env() -> dict[str, str]:
    if not CREDS.exists():
        sys.exit(f"creds file missing: {CREDS} — run 'scripts/bosh create-env' first")
    env = os.environ.copy()
    env["BOSH_ENVIRONMENT"] = "pve"
    env["BOSH_CLIENT"] = "admin"
    env["BOSH_CLIENT_SECRET"] = bosh_int(CREDS, "/admin_password")
    env["BOSH_CA_CERT"] = bosh_int(CREDS, "/director_ssl/ca")
    return env


def credhub_env() -> dict[str, str]:
    if not CREDS.exists():
        sys.exit(f"creds file missing: {CREDS} — run 'scripts/bosh create-env' first")
    director_ip = bosh_int(VARS, "/internal_ip")
    credhub_ca = bosh_int(CREDS, "/credhub_tls/ca")
    uaa_ca = bosh_int(CREDS, "/uaa_ssl/ca")
    env = os.environ.copy()
    env["CREDHUB_SERVER"] = f"https://{director_ip}:8844"
    env["CREDHUB_CLIENT"] = "credhub-admin"
    env["CREDHUB_SECRET"] = bosh_int(CREDS, "/credhub_admin_client_secret")
    env["CREDHUB_CA_CERT"] = credhub_ca + "\n" + uaa_ca
    return env


def cmd_create_env(args: list[str]) -> int:
    return run(
        "bosh", "create-env",
        str(BOSH_DEPLOYMENT_DIR / "bosh.yml"),
        "-n",
        "-o", str(CPI_OPS),
        "-o", str(BOSH_DEPLOYMENT_DIR / "uaa.yml"),
        "-o", str(BOSH_DEPLOYMENT_DIR / "credhub.yml"),
        "-o", str(OS_CONF_OPS),
        "-o", str(NATS_TUNING_OPS),
        "-o", str(HM_TUNING_OPS),
        "-l", str(VARS),
        "-v", "director_name=ocfp-mgmt",
        f"--state={STATE}",
        f"--vars-store={CREDS}",
        *args,
    )


def _state_is_empty() -> bool:
    """Return True when state.json is absent or holds no BOSH state.

    Parses the file as JSON and checks for a top-level `bosh:` or
    `deployments` key, which are the fields BOSH writes once a
    create-env run has produced real state.  An empty object `{}`, a
    parse error (file corrupted / truncated), or an absent file all
    resolve to True so that downstream callers default to "do the work"
    rather than silently skip teardown.

    Conservative on JSON decode error: treats malformed content as
    non-empty is WRONG for teardown safety — we want "do the work"
    which means returning True (state looks empty, run delete-env).
    Actually: returning True means "skip teardown" in cmd_teardown, so
    corrupted state should return False (non-empty) to avoid skipping
    a real teardown.  Corrupted state file → operator must inspect.
    """
    if not STATE.exists():
        return True
    raw = STATE.read_text(encoding="utf-8").strip()
    if not raw or raw == "{}":
        return True
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        # Malformed state file — treat as non-empty (conservative): do
        # not skip teardown; let bosh delete-env fail loudly so the
        # operator can inspect and clean up manually.
        return False
    if not isinstance(data, dict):
        return False
    # BOSH state.json contains a "bosh" key once create-env succeeds.
    # Older state formats may use a "deployments" key.
    return "bosh" not in data and "deployments" not in data


def cmd_teardown(args: list[str]) -> int:
    if _state_is_empty():
        print(f"teardown: state file absent or empty ({STATE}), nothing to delete")
        return 0
    rc = run(
        "bosh", "delete-env",
        str(BOSH_DEPLOYMENT_DIR / "bosh.yml"),
        "-n",
        "-o", str(CPI_OPS),
        "-o", str(BOSH_DEPLOYMENT_DIR / "uaa.yml"),
        "-o", str(BOSH_DEPLOYMENT_DIR / "credhub.yml"),
        "-o", str(OS_CONF_OPS),
        "-o", str(NATS_TUNING_OPS),
        "-o", str(HM_TUNING_OPS),
        "-l", str(VARS),
        "-v", "director_name=ocfp-mgmt",
        f"--state={STATE}",
        f"--vars-store={CREDS}",
        *args,
    )
    if rc != 0:
        print(f"teardown: bosh delete-env exited {rc}", file=sys.stderr)
    return rc


def cmd_alias_env(args: list[str]) -> int:
    if not CREDS.exists():
        sys.exit(f"creds.yml missing at {CREDS} — run 'scripts/bosh create-env' first")
    director_ip = bosh_int(VARS, "/internal_ip")
    ca = bosh_int(CREDS, "/director_ssl/ca")
    proc = subprocess.run(
        ["bosh", "alias-env", "pve", "-e", director_ip, "--ca-cert", ca, *args],
        cwd=REPO_ROOT,
    )
    return proc.returncode


def cmd_login(args: list[str]) -> int:
    return run("bosh", "-e", "pve", "login", *args, env=director_env())


def cmd_env(args: list[str]) -> int:
    return run("bosh", "env", *args, env=director_env())


def cmd_ucc(args: list[str]) -> int:
    return run(
        "bosh", "-e", "pve", "-n", "update-cloud-config",
        str(CLOUD_CONFIG),
        "-l", str(VARS),
        *args,
        env=director_env(),
    )


def cmd_runtime_config(args: list[str]) -> int:
    return run(
        "bosh", "-e", "pve", "-n", "update-runtime-config",
        str(PVE_GUEST_AGENT_RC),
        "--name", "pve-guest-agent",
        *args,
        env=director_env(),
    )


def cmd_emptyvm(args: list[str]) -> int:
    return run(
        "bosh", "-e", "pve", "-n", "-d", "emptyvm", "deploy",
        str(EMPTYVM),
        "-l", str(VARS),
        *args,
        env=director_env(),
    )


def cmd_upload_stemcell(args: list[str]) -> int:
    stemcell = os.environ.get("STEMCELL_PATH", "").strip()
    if not stemcell:
        print("upload-stemcell: STEMCELL_PATH env var not set", file=sys.stderr)
        return 1
    # Idempotent: re-uploading an already-present stemcell version is a no-op.
    return run(
        "bosh", "-e", "pve", "-n", "upload-stemcell", stemcell, *args, env=director_env()
    )


def cmd_credhub(args: list[str]) -> int:
    return run("credhub", *args, env=credhub_env())


def cmd_help(args: list[str]) -> int:
    print(USAGE)
    return 0


def cmd_passthrough(args: list[str]) -> int:
    return run("bosh", "-e", "pve", *args, env=director_env())


COMMANDS = {
    "create-env": cmd_create_env,
    "deploy": cmd_create_env,
    "teardown": cmd_teardown,
    "delete-env": cmd_teardown,
    "alias-env": cmd_alias_env,
    "login": cmd_login,
    "env": cmd_env,
    "ucc": cmd_ucc,
    "upload-cloud-config": cmd_ucc,
    "runtime-config": cmd_runtime_config,
    "upload-stemcell": cmd_upload_stemcell,
    "emptyvm": cmd_emptyvm,
    "credhub": cmd_credhub,
    "help": cmd_help,
    "-h": cmd_help,
    "--help": cmd_help,
}


def main(argv: list[str]) -> int:
    if not argv:
        return cmd_help([])
    sub, *rest = argv
    handler = COMMANDS.get(sub)
    if handler is None:
        return cmd_passthrough(argv)
    return handler(rest)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
