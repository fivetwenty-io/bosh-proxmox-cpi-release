#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["requests"]
# ///
"""Manage the cloudfoundry deployment on the bosh-pve director.

Usage:
    ./scripts/cf <command> [args...]

Commands:
    deploy             Run all steps: runtime-config, cloud-config, stemcell, bosh-deploy.
    runtime-config     Upload the DNS runtime-config.
    cloud-config       Upload the cf cloud-config.
    stemcell           Upload the stemcell pinned by cf-deployment (skips if present).
    check-uaa-db       Fail fast if uaa schema is in the Flyway-rename trap.
    bosh-deploy        Run only the bosh deploy step.
    api                Point the cf CLI at https://api.<system_domain>.
    login              cf api + cf login -u admin (password from credhub).
    admin-password     Print /ocfp-mgmt/cf/cf_admin_password from credhub.
    help               Show this message.

Extra args after the command are forwarded to the underlying bosh deploy
invocation (only meaningful for `deploy` and `bosh-deploy`).

Assumes:
    - bosh CLI is logged into the 'pve' alias (bosh -e pve env succeeds).
    - ~/w/cloudfoundry/cf-deployment is checked out.
    - ~/w/cloudfoundry/bosh-deployment is checked out (for the dns runtime config).
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

import requests

REPO_ROOT = Path(__file__).resolve().parent.parent
CF_DEPLOYMENT = Path(os.environ.get("CF_DEPLOYMENT", Path.home() / "w/cloudfoundry/cf-deployment"))
BOSH_DEPLOYMENT = Path(os.environ.get("BOSH_DEPLOYMENT", Path.home() / "w/cloudfoundry/bosh-deployment"))
ENV = os.environ.get("BOSH_ENV", "pve")
DEPLOYMENT = os.environ.get("BOSH_DEPLOYMENT_NAME", "cf")
BOSH_VARS = REPO_ROOT / "manifests" / "bosh" / "vars.yml"
BOSH_CREDS = REPO_ROOT / "manifests" / "bosh" / "creds.yml"


def banner(title: str) -> None:
    print()
    print(f">>> {title}")
    print()


def run(*cmd: str) -> None:
    subprocess.run(cmd, check=True)


def capture(*cmd: str) -> str:
    return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout.strip()


def stemcell_sha1(name: str, version: str) -> str:
    resp = requests.get(f"https://bosh.io/api/v1/stemcells/{name}", timeout=30)
    resp.raise_for_status()
    match = next((s for s in resp.json() if s.get("version") == version), None)
    sha1 = (match or {}).get("regular", {}).get("sha1")
    if not sha1:
        sys.exit(f"sha1 not found for {version}")
    return sha1


def cmd_runtime_config(_extra: list[str]) -> None:
    banner("DNS runtime-config")
    run(
        "bosh", "-e", ENV, "-n", "update-runtime-config",
        str(BOSH_DEPLOYMENT / "runtime-configs/dns.yml"),
        "--name", "dns",
    )

    banner("PVE guest-agent runtime-config")
    run(
        "bosh", "-e", ENV, "-n", "update-runtime-config",
        "manifests/runtime-configs/pve-guest-agent.yml",
        "--name", "pve-guest-agent",
    )


def cmd_cloud_config(_extra: list[str]) -> None:
    banner("Cloud-config")
    run(
        "bosh", "-e", ENV,  "-n","update-cloud-config",
        "manifests/cf/cloud-config.yml",
        "-l", "manifests/bosh/vars.yml",
        "-l", "manifests/cf/vars.yml",
    )


def cmd_stemcell(_extra: list[str]) -> None:
    banner("Stemcell")
    manifest = str(CF_DEPLOYMENT / "cf-deployment.yml")
    os_name = capture("bosh", "int", manifest, "--path=/stemcells/alias=default/os")
    version = capture("bosh", "int", manifest, "--path=/stemcells/alias=default/version")
    name = f"bosh-openstack-kvm-{os_name}"
    print(f"    stemcell: {name} v{version}")

    existing = subprocess.run(
        ["bosh", "-e", ENV, "stemcells", "--json"],
        capture_output=True, text=True, check=False,
    ).stdout
    if name in existing and version in existing:
        print("    already uploaded; skipping")
        return

    url = f"https://bosh.io/d/stemcells/{name}?v={version}"
    sha1 = stemcell_sha1(name, version)
    print(f"    sha1: {sha1}")
    print()
    run("bosh", "-e", ENV, "-n", "upload-stemcell", "--sha1", sha1, url)


def cmd_check_uaa_db(_extra: list[str]) -> None:
    """Fail fast if the uaa Flyway history has a failed migration row.

    UAA's Flyway history table (`schema_version`) records every
    migration with a `success` flag. If a migration is interrupted (JVM
    killed, deploy aborted, OOM) after a DDL statement commits but
    before the row is finalized, MySQL keeps the schema change (DDL
    auto-commits in MySQL) while Flyway records `success=0`. The next
    UAA boot retries that migration and the DDL fails with "Duplicate
    column" / "Table already exists", looping forever.

    Because the loop sits inside bpm restarts, the BOSH agent's
    get_state RPC starves and the deploy surfaces a generic
    `Timed out sending 'get_state' to instance: uaa/...` error that
    gives no clue about Flyway. This check trips early with a
    remediation hint.
    """
    banner("uaa DB pre-deploy check")
    probe = (
        "set -e; "
        "cnf=/var/vcap/jobs/pxc-mysql/config/mylogin.cnf; "
        "if [ ! -f $cnf ]; then echo SKIP_NO_PXC; exit 0; fi; "
        "mysql=$(find /var/vcap/data/packages -path '*percona-xtradb-cluster*/bin/mysql' "
        "| sort | tail -1); "
        "if [ -z \"$mysql\" ]; then echo SKIP_NO_MYSQL_BIN; exit 0; fi; "
        "q='SELECT COUNT(*) FROM schema_version WHERE success=0'; "
        "out=$(sudo $mysql --defaults-file=$cnf uaa -BNe \"$q\" 2>&1) || { echo \"$out\" | grep -q 'Unknown database' "
        "&& { echo OK_DB_MISSING; exit 0; }; echo \"$out\" | grep -q \"doesn.t exist\" "
        "&& { echo OK_FRESH; exit 0; }; echo PROBE_ERROR: $out; exit 0; }; "
        "echo FAILED_ROWS=$out"
    )
    result = subprocess.run(
        ["bosh", "-e", ENV, "-d", DEPLOYMENT, "ssh", "database/0", "-c", probe, "-r"],
        capture_output=True, text=True, check=False,
    )
    out = (result.stdout or "") + (result.stderr or "")
    if any(tok in out for tok in ("OK_DB_MISSING", "OK_FRESH", "SKIP_NO_PXC", "SKIP_NO_MYSQL_BIN")):
        print("    skipped (uaa schema or pxc not yet provisioned)")
        return
    if "PROBE_ERROR" in out:
        print(f"    warn: probe inconclusive — {out.strip().splitlines()[-1][:200]}")
        return
    match = re.search(r"FAILED_ROWS=(\d+)", out)
    if not match:
        print(f"    warn: unable to parse probe output: {out[-200:]}")
        return
    failed = int(match.group(1))
    if failed > 0:
        sys.exit(
            f"\n  uaa Flyway history has {failed} migration row(s) with success=0.\n"
            "  A partial DDL has already been applied to the schema; the next UAA\n"
            "  boot will retry the migration, hit a duplicate-object error and\n"
            "  crashloop until the agent's get_state RPC times out.\n\n"
            "  Remediation (uaa rebuilds its own seed data on next boot):\n"
            f"    bosh -e {ENV} -d {DEPLOYMENT} ssh database/0 -c \"sudo $(find /var/vcap/data/packages \\\n"
            "        -path '*percona-xtradb-cluster*/bin/mysql' | sort | tail -1) \\\n"
            "        --defaults-file=/var/vcap/jobs/pxc-mysql/config/mylogin.cnf \\\n"
            "        -e 'DROP DATABASE uaa; CREATE DATABASE uaa CHARACTER SET utf8mb4 \\\n"
            "        COLLATE utf8mb4_unicode_ci; GRANT ALL PRIVILEGES ON uaa.* TO uaa@\\\"%\\\"; \\\n"
            "        FLUSH PRIVILEGES;'\"\n"
            f"    bosh -e {ENV} -d {DEPLOYMENT} recreate uaa\n"
        )
    print("    OK")


def cmd_bosh_deploy(extra: list[str]) -> None:
    banner("Deploy")
    run(
        "bosh", "-e", ENV, "-n", "-d", DEPLOYMENT, "deploy",
        str(CF_DEPLOYMENT / "cf-deployment.yml"),
        "-o", str(CF_DEPLOYMENT / "operations/use-compiled-releases.yml"),
        "-o", str(CF_DEPLOYMENT / "operations/use-haproxy.yml"),
        "-o", "manifests/cf/ops-serialize-deploy.yml",
        "-o", "manifests/cf/ops-resize-cf.yml",
        "-l", "manifests/bosh/vars.yml",
        "-l", "manifests/cf/vars.yml",
        *extra,
    )


def system_domain() -> str:
    return capture("bosh", "int", "manifests/cf/vars.yml", "--path=/system_domain")


def credhub_env() -> dict[str, str]:
    if not BOSH_CREDS.exists():
        sys.exit(f"creds file missing: {BOSH_CREDS} — run 'scripts/bosh create-env' first")
    director_ip = capture("bosh", "int", str(BOSH_VARS), "--path=/internal_ip")
    credhub_ca = capture("bosh", "int", str(BOSH_CREDS), "--path=/credhub_tls/ca")
    uaa_ca = capture("bosh", "int", str(BOSH_CREDS), "--path=/uaa_ssl/ca")
    env = os.environ.copy()
    env["CREDHUB_SERVER"] = f"https://{director_ip}:8844"
    env["CREDHUB_CLIENT"] = "credhub-admin"
    env["CREDHUB_SECRET"] = capture("bosh", "int", str(BOSH_CREDS), "--path=/credhub_admin_client_secret")
    env["CREDHUB_CA_CERT"] = credhub_ca + "\n" + uaa_ca
    return env


def admin_password() -> str:
    return subprocess.run(
        ["credhub", "get", "-n", "/ocfp-mgmt/cf/cf_admin_password", "-q"],
        check=True, capture_output=True, text=True, env=credhub_env(),
    ).stdout.strip()


def cmd_admin_password(_extra: list[str]) -> None:
    print(admin_password())


def cmd_api(_extra: list[str]) -> None:
    banner("cf api")
    run("cf", "api", f"https://api.{system_domain()}", "--skip-ssl-validation")


def cmd_login(_extra: list[str]) -> None:
    banner("cf login")
    domain = system_domain()
    pw = admin_password()
    run("cf", "api", f"https://api.{domain}", "--skip-ssl-validation")
    run(
        "cf", "login",
        "-a", f"https://api.{domain}",
        "-u", "admin",
        "-p", pw,
        "--skip-ssl-validation",
    )


def cmd_deploy(extra: list[str]) -> None:
    cmd_runtime_config([])
    cmd_cloud_config([])
    cmd_stemcell([])
    cmd_check_uaa_db([])
    cmd_bosh_deploy(extra)


COMMANDS = {
    "deploy": cmd_deploy,
    "runtime-config": cmd_runtime_config,
    "cloud-config": cmd_cloud_config,
    "stemcell": cmd_stemcell,
    "check-uaa-db": cmd_check_uaa_db,
    "bosh-deploy": cmd_bosh_deploy,
    "api": cmd_api,
    "login": cmd_login,
    "admin-password": cmd_admin_password,
}


def usage(stream=sys.stdout) -> None:
    print(__doc__, file=stream)


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return

    command, extra = argv[0], argv[1:]
    handler = COMMANDS.get(command)
    if handler is None:
        print(f"unknown command: {command}", file=sys.stderr)
        usage(sys.stderr)
        sys.exit(2)

    os.chdir(REPO_ROOT)
    handler(extra)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
