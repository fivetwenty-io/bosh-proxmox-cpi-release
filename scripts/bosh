#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Wrapper around the bosh CLI for the bosh-pve-cpi-release repo.

Subcommands:
    create-env | deploy    bosh create-env for the pve director
    teardown | delete-env  bosh delete-env for the pve director (idempotent:
                           no-op when state.json is absent or empty)
    alias-env              alias the director as 'pve' using creds.yml CA
    login                  bosh -e pve login
    env                    bosh env (against pve)
    ucc | upload-cloud-config
                           upload manifests/bosh/cloud-config.yml
    runtime-config         upload manifests/runtime-configs/pve-guest-agent.yml
                           (named runtime-config "pve-guest-agent")
    upload-stemcell        upload $STEMCELL_PATH to the director (needed before
                           emptyvm; idempotent for an already-present version)
    emptyvm                deploy manifests/bosh/emptyvm.yml
    net-up | network-up    create the active env's isolated SDN test network
                           (zone + vnet + subnet, idempotent) on the PVE host.
                           Requires BOSH_PVE_ENV (e.g. cpitest). Run before
                           create-env so the Director attaches to the vnet.
    net-down | network-down
                           tear the SDN subnet/vnet/zone back down (idempotent).
    net-status | network-status
                           show the SDN zone/vnet/subnet + node bridge state.
    credhub <args>         passthrough → credhub <args> with the director's
                           credhub URL, admin client, and CA pre-exported
    compile-releases       compile bosh + bosh-pve-cpi once against the active
                           stemcell (no-VM compilation deployment + export-
                           release), store the tarballs (file:// default or S3),
                           and pin them so later create-envs skip compilation.
                           Storage via COMPILED_RELEASES_STORE; see
                           docs/compiled-releases.md.
    help                   show this help
    <anything else>        passthrough → bosh -e pve <args>

Env selection (isolated networks):
    BOSH_PVE_ENV=<name>    layer manifests/envs/<name>/{network.yml,vars.yml}
                           onto create-env/teardown, moving the Director onto
                           that env's network. Pairs with `scripts/cf` which
                           layers the matching cf-cloud-config.yml + vars.yml.
                           Ships with `cpitest` (isolated 172.x SDN vnet).

Env (auto-exported for non-create-env subcommands when creds.yml exists):
    BOSH_ENVIRONMENT=pve
    BOSH_CLIENT=admin
    BOSH_CLIENT_SECRET=<creds.yml:/admin_password>
    BOSH_CA_CERT=<creds.yml:/director_ssl/ca>

Credhub env (for credhub):
    CREDHUB_SERVER=https://<internal_ip>:8844
    CREDHUB_CLIENT=credhub-admin
    CREDHUB_SECRET=<creds.yml:/credhub_admin_client_secret>
    CREDHUB_CA_CERT=<creds.yml:/credhub_tls/ca + /uaa_ssl/ca>
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Host firewall text manipulation + compiled-release helpers (pure Python).
sys.path.insert(0, str(Path(__file__).resolve().parent))
import _hostfw
import _compiled
import _lightstemcell
import _artifacts

REPO_ROOT = Path(__file__).resolve().parent.parent
BOSH_DEPLOYMENT_DIR = Path(os.environ.get("BOSH_DEPLOYMENT_DIR", Path.home() / "w/cloudfoundry/bosh-deployment"))
MANIFESTS = REPO_ROOT / "manifests"
BOSH_DIR = MANIFESTS / "bosh"
VARS = BOSH_DIR / "vars.yml"
CREDS = BOSH_DIR / "creds.yml"
STATE = BOSH_DIR / "state.json"
# Pins the cloudfoundry/bosh release version (282.1.13) regardless of the
# local bosh-deployment checkout's default. See manifests/bosh/bosh-release.yml.
BOSH_RELEASE_OPS = BOSH_DIR / "bosh-release.yml"
CPI_OPS = BOSH_DIR / "cpi.yml"
OS_CONF_OPS = BOSH_DIR / "os-conf.yml"
NATS_TUNING_OPS = BOSH_DIR / "nats-tuning.yml"
HM_TUNING_OPS = BOSH_DIR / "hm-tuning.yml"
DIRECTOR_TUNING_OPS = BOSH_DIR / "director-tuning.yml"
# Reliable key-based SSH access to the director (os-conf user_add; no apt).
# The director VM is created with the PVE QGA channel disabled, so
# `qm guest exec` is unavailable — SSH via the jumpbox user is the only
# dependable shell.  jumpbox_ssh already lives in creds.yml (vars-store).
JUMPBOX_OPS = BOSH_DEPLOYMENT_DIR / "jumpbox-user.yml"
CLOUD_CONFIG = BOSH_DIR / "cloud-config.yml"
EMPTYVM = BOSH_DIR / "emptyvm.yml"
PVE_GUEST_AGENT_RC = MANIFESTS / "runtime-configs" / "pve-guest-agent.yml"
ENVS_DIR = MANIFESTS / "envs"
DEV_RELEASES_DIR = REPO_ROOT / "dev_releases" / "bosh-pve-cpi"
# Compiled-release pipeline (scripts/bosh compile-releases): generated ops file
# pinning compiled tarballs, and the default local store directory. Both are
# gitignored — the ops file is environment-specific and the tarballs are large.
COMPILED_OPS = BOSH_DIR / "compiled-releases.yml"
COMPILED_DIR_DEFAULT = REPO_ROOT / "compiled_releases"


def cpi_release_path() -> str:
    """Resolve the CPI release tarball path for create-env/delete-env.

    PVE_CPI_RELEASE_PATH wins when set (Concourse points it at an artifact
    input). Otherwise pick the newest *.tgz under dev_releases/bosh-pve-cpi/
    by mtime — the location scripts/create-release writes to.
    """
    override = os.environ.get("PVE_CPI_RELEASE_PATH", "").strip()
    if override:
        return override
    if not DEV_RELEASES_DIR.is_dir():
        sys.exit(
            f"cpi release tarball not found: set PVE_CPI_RELEASE_PATH or run "
            f"`./scripts/create-release dev` to populate {DEV_RELEASES_DIR}"
        )
    tarballs = sorted(
        DEV_RELEASES_DIR.glob("*.tgz"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if not tarballs:
        sys.exit(
            f"no *.tgz under {DEV_RELEASES_DIR}; run `./scripts/create-release dev` "
            f"or set PVE_CPI_RELEASE_PATH"
        )
    return str(tarballs[0])


def active_env() -> str:
    """Active env-bundle name, defaulting to 'cpitest' when unset.

    cpitest is the validated isolated-SDN env (172.31.0.0/24); making it the
    default keeps a bare `./scripts/bosh create-env` (no BOSH_PVE_ENV) off the
    shared LAN, where the duplicate-IP hazard lives. The destructive net-*
    commands still require an explicit env (see _sdn_params).
    """
    return os.environ.get("BOSH_PVE_ENV", "").strip() or "cpitest"


def env_network_ops() -> list[str]:
    """Return -o flags for the active env's director network layer.

    BOSH_PVE_ENV selects manifests/envs/<env>/network.yml when present;
    defaults to cpitest. Missing file means no layer applied.
    """
    env_name = active_env()
    if not env_name:
        return []
    layer = ENVS_DIR / env_name / "network.yml"
    if not layer.exists():
        return []
    return ["-o", str(layer)]


def env_vars_file() -> "Path | None":
    """Return manifests/envs/<BOSH_PVE_ENV>/vars.yml when it exists.

    This file carries env-specific overrides (network range, gateway,
    bridge, Director IP, SDN parameters). It is layered AFTER
    manifests/bosh/vars.yml so its keys win, which is how an env moves the
    Director onto an isolated network without editing the base vars.
    """
    env_name = active_env()
    if not env_name:
        return None
    f = ENVS_DIR / env_name / "vars.yml"
    return f if f.exists() else None


def env_vars_layer() -> list[str]:
    """Return the `-l <env vars.yml>` flag pair, or [] when absent."""
    f = env_vars_file()
    return ["-l", str(f)] if f else []


def env_cc_reserved_ops() -> list[str]:
    """Return -o for the active env's cloud-config reserved override.

    Applied ONLY by update-cloud-config (cmd_ucc), never by create-env: it
    widens the bosh cloud-config's default-network reserved band so a VM placed
    on that cloud-config (emptyvm in particular) avoids the low infra slots the
    env keeps for the gateway, Director, and artifacts VM. Without it the base
    bosh cloud-config reserves only the gateway + Director, so emptyvm grabs
    .2 — an address conventionally kept for routing, and a low slot a fresh
    create-env Director (empty IPAM) can re-hand to a new VM while a prior
    deployment still holds it (duplicate IP -> agent NATS flap). Optional:
    absent file means no override (base envs unchanged).
    """
    env_name = active_env()
    if not env_name:
        return []
    layer = ENVS_DIR / env_name / "cc-reserved.yml"
    return ["-o", str(layer)] if layer.exists() else []


USAGE = __doc__ or ""


def bosh_int(path: Path, json_path: str) -> str:
    return subprocess.run(
        ["bosh", "int", str(path), "--path", json_path],
        check=True, capture_output=True, text=True,
    ).stdout.rstrip("\n")


def run(*cmd: str, env: dict[str, str] | None = None) -> int:
    return subprocess.run(list(cmd), env=env, cwd=REPO_ROOT).returncode


def internal_ip() -> str:
    """Director IP, honoring the active BOSH_PVE_ENV vars layer.

    manifests/bosh/vars.yml carries the base internal_ip; an env bundle's
    vars.yml (manifests/envs/<env>/vars.yml) overrides it. These are plain
    data docs, not templates, so they cannot be merged with `bosh int -l` —
    read the env file's key directly and fall back to the base. Use this
    everywhere the Director address is needed (alias-env, credhub) so they
    target the env's network rather than the base one.
    """
    f = env_vars_file()
    if f:
        try:
            return bosh_int(f, "/internal_ip")
        except subprocess.CalledProcessError:
            pass
    return bosh_int(VARS, "/internal_ip")


def director_env() -> dict[str, str]:
    if not CREDS.exists():
        sys.exit(f"creds file missing: {CREDS} — run 'scripts/bosh create-env' first")
    env = os.environ.copy()
    env["BOSH_ENVIRONMENT"] = "pve"
    env["BOSH_CLIENT"] = "admin"
    env["BOSH_CLIENT_SECRET"] = bosh_int(CREDS, "/admin_password")
    env["BOSH_CA_CERT"] = bosh_int(CREDS, "/director_ssl/ca")
    return env


def credhub_env() -> dict[str, str]:
    if not CREDS.exists():
        sys.exit(f"creds file missing: {CREDS} — run 'scripts/bosh create-env' first")
    director_ip = internal_ip()
    credhub_ca = bosh_int(CREDS, "/credhub_tls/ca")
    uaa_ca = bosh_int(CREDS, "/uaa_ssl/ca")
    env = os.environ.copy()
    env["CREDHUB_SERVER"] = f"https://{director_ip}:8844"
    env["CREDHUB_CLIENT"] = "credhub-admin"
    env["CREDHUB_SECRET"] = bosh_int(CREDS, "/credhub_admin_client_secret")
    env["CREDHUB_CA_CERT"] = credhub_ca + "\n" + uaa_ca
    return env


STEMCELL_CACHE = REPO_ROOT / "dev_releases" / "stemcell-cache"


def _ensure_light_stemcell(*, build_tarball: bool) -> "_lightstemcell.LightStemcell":
    """Ensure the light stemcell is available on PVE and return its descriptor.

    Used by both create-env (the Director boots from a locally-built light
    tarball whose stemcell.MF carries the light cloud_properties) and
    upload-stemcell (registers the same light tarball with a running Director).
    Both pass build_tarball=True; `bosh upload-stemcell` needs the gzipped
    tarball, not the rendered .yml manifest. The qcow2 is derived once
    from vars.yml stemcell_url — preuploaded uploads it to PVE storage, fetch
    leaves the CPI to stream it. vars.yml stemcell_url/sha1 are left untouched so
    compile-releases keeps parsing the heavy source version.
    """
    source_url = bosh_int(VARS, "/stemcell_url")
    source_sha1 = bosh_int(VARS, "/stemcell_sha1")
    os_name, version = _lightstemcell.parse_os_version(source_url)
    mode = (_bosh_int_opt(VARS, "/light_stemcell_mode") or "preuploaded").strip()
    fetch_url = (_bosh_int_opt(VARS, "/stemcell_fetch_url") or "").strip()
    token = (_bosh_int_opt(VARS, "/stemcell_fetch_token") or "").strip()
    cpi_cfg = _lightstemcell.pve_cfg_from_bosh_vars(VARS)
    print(f"==> light stemcell ({mode}): ensuring {os_name} {version} is available on PVE")
    return _lightstemcell.ensure_light_stemcell(
        cpi_cfg=cpi_cfg,
        mode=mode,
        os_name=os_name,
        version=version,
        source_url=source_url,
        source_sha1=source_sha1,
        cache_dir=str(STEMCELL_CACHE),
        image_url=(fetch_url or None),
        token=(token or None),
        build_create_env_tarball=build_tarball,
    )


def _light_stemcell_create_env_vars() -> list[str]:
    """`-v` overrides pointing create-env at the locally-built light tarball."""
    light = _ensure_light_stemcell(build_tarball=True)
    return [
        "-v", f"stemcell_url=file://{light.create_env_tarball}",
        "-v", f"stemcell_sha1={light.create_env_tarball_sha1}",
    ]


def cmd_create_env(args: list[str]) -> int:
    release = cpi_release_path()
    light_vars = _light_stemcell_create_env_vars()
    return run(
        "bosh", "create-env",
        str(BOSH_DEPLOYMENT_DIR / "bosh.yml"),
        "-n",
        "-o", str(BOSH_RELEASE_OPS),
        "-o", str(CPI_OPS),
        *compiled_ops_layer(),
        "-o", str(BOSH_DEPLOYMENT_DIR / "uaa.yml"),
        "-o", str(BOSH_DEPLOYMENT_DIR / "credhub.yml"),
        "-o", str(OS_CONF_OPS),
        "-o", str(NATS_TUNING_OPS),
        "-o", str(HM_TUNING_OPS),
        "-o", str(DIRECTOR_TUNING_OPS),
        "-o", str(JUMPBOX_OPS),
        *env_network_ops(),
        "-l", str(VARS),
        *env_vars_layer(),
        "-v", "director_name=ocfp-mgmt",
        "-v", f"pve_cpi_release_path={release}",
        # Light-stemcell overrides win over vars.yml stemcell_url/sha1 so the
        # Director boots from the light tarball (see _ensure_director_light_stemcell).
        *light_vars,
        f"--state={STATE}",
        f"--vars-store={CREDS}",
        *args,
    )


def _state_is_empty() -> bool:
    """Return True when state.json is absent or records no live director.

    bosh-init / `bosh create-env` writes the director VM identity at the
    top level of state.json as `current_vm_cid` (plus `director_id`,
    `disks`, `stemcells`).  A non-empty `current_vm_cid` is the canonical
    signal that a director VM exists and must be torn down.  An empty
    object `{}`, an absent file, or a state with no `current_vm_cid`
    resolve to True (nothing to delete).

    On JSON decode error the state file is malformed: return False
    (non-empty) so cmd_teardown does NOT skip — it runs delete-env, which
    fails loudly and prompts the operator to inspect rather than silently
    leaving a real director VM orphaned.
    """
    if not STATE.exists():
        return True
    raw = STATE.read_text(encoding="utf-8").strip()
    if not raw or raw == "{}":
        return True
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        # Malformed state file — treat as non-empty (conservative): do
        # not skip teardown; let bosh delete-env fail loudly so the
        # operator can inspect and clean up manually.
        return False
    if not isinstance(data, dict):
        return False
    # A deployed director records its VM cid in `current_vm_cid`.
    # Tolerate older/alternate formats that nested under `bosh` or
    # tracked `deployments`.
    if data.get("current_vm_cid"):
        return False
    return "bosh" not in data and "deployments" not in data


def _delete_all_deployments() -> None:
    """Best-effort: delete every deployment on the Director before delete-env.

    `bosh delete-env` removes ONLY the Director VM. Any deployment's VMs
    (notably emptyvm) outlive it as orphans on PVE. Because a later create-env
    builds a fresh Director with empty IPAM, that Director can re-hand an
    orphan's address to a new VM, producing a duplicate-IP / NATS flap (the new
    VM's agent shows 'unresponsive' while ARP resolves the shared IP to the
    orphan). Deleting the deployments here, while the Director still exists,
    guarantees their VMs are removed first.

    Best-effort by design: if the Director is unreachable (already torn down,
    creds gone) we log and fall through to delete-env, which handles the
    Director VM itself.
    """
    try:
        proc = subprocess.run(
            ["bosh", "-e", "pve", "deployments", "--column=name", "--json"],
            cwd=REPO_ROOT, env=director_env(),
            capture_output=True, text=True, timeout=60,
        )
    except (subprocess.SubprocessError, OSError) as exc:
        print(f"teardown: could not reach Director to list deployments ({exc}); "
              "proceeding to delete-env", file=sys.stderr)
        return
    if proc.returncode != 0:
        print("teardown: Director not reachable for deployment cleanup; "
              "proceeding to delete-env", file=sys.stderr)
        return
    try:
        rows = json.loads(proc.stdout)["Tables"][0]["Rows"]
        names = [r.get("name", "").strip() for r in rows if r.get("name", "").strip()]
    except (json.JSONDecodeError, KeyError, IndexError, TypeError):
        names = []
    for name in names:
        print(f"teardown: deleting deployment '{name}' before delete-env")
        run("bosh", "-e", "pve", "-n", "-d", name, "delete-deployment", "--force",
            env=director_env())


def cmd_teardown(args: list[str]) -> int:
    if _state_is_empty():
        print(f"teardown: state file absent or empty ({STATE}), nothing to delete")
        return 0
    # Remove all deployments (their VMs) before delete-env strands them as
    # orphans on the SDN — see _delete_all_deployments for the duplicate-IP
    # failure this prevents.
    _delete_all_deployments()
    release = cpi_release_path()
    rc = run(
        "bosh", "delete-env",
        str(BOSH_DEPLOYMENT_DIR / "bosh.yml"),
        "-n",
        "-o", str(BOSH_RELEASE_OPS),
        "-o", str(CPI_OPS),
        *compiled_ops_layer(),
        "-o", str(BOSH_DEPLOYMENT_DIR / "uaa.yml"),
        "-o", str(BOSH_DEPLOYMENT_DIR / "credhub.yml"),
        "-o", str(OS_CONF_OPS),
        "-o", str(NATS_TUNING_OPS),
        "-o", str(HM_TUNING_OPS),
        "-o", str(DIRECTOR_TUNING_OPS),
        "-o", str(JUMPBOX_OPS),
        *env_network_ops(),
        "-l", str(VARS),
        *env_vars_layer(),
        "-v", "director_name=ocfp-mgmt",
        "-v", f"pve_cpi_release_path={release}",
        f"--state={STATE}",
        f"--vars-store={CREDS}",
        *args,
    )
    if rc != 0:
        print(f"teardown: bosh delete-env exited {rc}", file=sys.stderr)
    return rc


def cmd_alias_env(args: list[str]) -> int:
    if not CREDS.exists():
        sys.exit(f"creds.yml missing at {CREDS} — run 'scripts/bosh create-env' first")
    director_ip = internal_ip()
    ca = bosh_int(CREDS, "/director_ssl/ca")
    proc = subprocess.run(
        ["bosh", "alias-env", "pve", "-e", director_ip, "--ca-cert", ca, *args],
        cwd=REPO_ROOT,
    )
    return proc.returncode


def cmd_login(args: list[str]) -> int:
    return run("bosh", "-e", "pve", "login", *args, env=director_env())


def cmd_env(args: list[str]) -> int:
    return run("bosh", "env", *args, env=director_env())


def cmd_ucc(args: list[str]) -> int:
    # Layer the active env (BOSH_PVE_ENV) exactly as create-env does, so the
    # cloud-config's default network resolves to the env's subnet + bridge.
    # Without this, deployed VMs (emptyvm, anything before `cf cloud-config`
    # replaces it) inherit manifests/bosh/vars.yml's base network while the
    # Director sits on the env network — e.g. on cpitest the VM lands on vmbr1/
    # 192.168.1.x but NATS is on cpitest0/172.31.0.10, so the agent can never
    # reach mbus and the deploy fails with "Timed out pinging VM ... agent".
    return run(
        "bosh", "-e", "pve", "-n", "update-cloud-config",
        str(CLOUD_CONFIG),
        *env_network_ops(),
        *env_cc_reserved_ops(),
        "-l", str(VARS),
        *env_vars_layer(),
        *args,
        env=director_env(),
    )


def cmd_runtime_config(args: list[str]) -> int:
    return run(
        "bosh", "-e", "pve", "-n", "update-runtime-config",
        str(PVE_GUEST_AGENT_RC),
        "--name", "pve-guest-agent",
        *args,
        env=director_env(),
    )


def _emptyvm_is_wedged() -> bool:
    """True when a prior emptyvm instance exists with an unresponsive agent.

    create-env reattaches the Director's persistent disk, so its DB survives
    across runs. If a previous emptyvm VM was deleted out-of-band on PVE (a
    stray teardown, a manual cleanup) the Director still holds the deployment
    record pointing at the now-gone VM. A redeploy then blocks ~45s in
    'Preparing deployment' sending get_state to the dead agent before failing
    with "Timed out sending 'get_state'". Detect that wedged state so the deploy
    can force-delete the stale record first. Any error (no such deployment,
    Director unreachable, unparseable output) returns False — nothing to heal.
    """
    res = subprocess.run(
        ["bosh", "-e", "pve", "-d", "emptyvm", "instances", "--json"],
        cwd=REPO_ROOT, env=director_env(), capture_output=True, text=True,
    )
    if res.returncode != 0:
        return False
    try:
        data = json.loads(res.stdout)
    except json.JSONDecodeError:
        return False
    for tbl in data.get("Tables") or []:
        for row in tbl.get("Rows") or []:
            if "unresponsive" in (row.get("process_state") or "").lower():
                return True
    return False


def cmd_emptyvm(args: list[str]) -> int:
    # Self-heal a stale Director record before deploying: a prior emptyvm whose
    # VM was deleted on PVE leaves an unresponsive-agent instance that wedges the
    # redeploy for 45s then fails. emptyvm is a jobless, persistent-disk-free
    # smoke deployment, so force-deleting the stale record discards nothing.
    if _emptyvm_is_wedged():
        print(
            "emptyvm: prior instance has an unresponsive agent (stale Director "
            "record for a VM no longer on PVE); force-deleting before redeploy"
        )
        run(
            "bosh", "-e", "pve", "-n", "-d", "emptyvm",
            "delete-deployment", "--force",
            env=director_env(),
        )
    return run(
        "bosh", "-e", "pve", "-n", "-d", "emptyvm", "deploy",
        str(EMPTYVM),
        "-l", str(VARS),
        *args,
        env=director_env(),
    )


def cmd_upload_stemcell(args: list[str]) -> int:
    # Light stemcell: ensure the qcow2 is on PVE storage (preuploaded) or
    # reachable (fetch), build the light stemcell tarball, and register it with
    # the Director. `bosh upload-stemcell` requires a gzipped tarball (stemcell.MF
    # + placeholder image), NOT a bare manifest — handing it the rendered .yml
    # fails with "Retrieving stemcell info: gzip: invalid header". The same light
    # tarball serves both create-env (bosh-init) and this director-side
    # registration: the CPI's IsLight() short-circuit means the placeholder image
    # is never read, and cloud_properties.image_id/image_url drives
    # create_stemcell. STEMCELL_PATH is no longer consumed — the light source is
    # vars.yml stemcell_url. Idempotent: --fix re-registers an existing version;
    # the qcow2 upload fast-paths on the cached SHA.
    light = _ensure_light_stemcell(build_tarball=True)
    return run(
        "bosh", "-e", "pve", "-n", "upload-stemcell", str(light.create_env_tarball),
        "--fix", *args, env=director_env(),
    )


def cmd_credhub(args: list[str]) -> int:
    return run("credhub", *args, env=credhub_env())


# ---------------------------------------------------------------------------
# SDN test-network lifecycle (net-up / net-down / net-status)
#
# Creates an isolated, CPI-owned network as a PVE SDN "simple" zone + vnet +
# subnet, so the Director and deployment do not share an L2 segment with
# unmanaged devices. That sharing is the root cause of the duplicate-IP / ARP
# ambiguity agent flapping documented in docs/troubleshooting.md. Parameters
# come from the active env's vars.yml (BOSH_PVE_ENV); see
# manifests/envs/cpitest/. Idempotent: safe to re-run.
# ---------------------------------------------------------------------------

def _bosh_int_opt(path: Path, json_path: str) -> "str | None":
    """Return a single var from a YAML file via `bosh int`, or None if absent."""
    res = subprocess.run(
        ["bosh", "int", str(path), "--path", json_path],
        capture_output=True, text=True,
    )
    if res.returncode != 0:
        return None
    return res.stdout.rstrip("\n")


def _sdn_params() -> dict[str, str]:
    """Resolve SDN parameters from the active env's vars.yml + base vars.

    Exits with guidance when BOSH_PVE_ENV is unset, its vars.yml is missing,
    or any required cpitest_sdn_* key is absent.
    """
    env_name = os.environ.get("BOSH_PVE_ENV", "").strip()
    if not env_name:
        sys.exit(
            "net-*: BOSH_PVE_ENV is not set. Point it at an env bundle that "
            "defines the SDN network, e.g.\n"
            "    BOSH_PVE_ENV=cpitest ./scripts/bosh net-up\n"
            "See manifests/envs/cpitest/."
        )
    vfile = ENVS_DIR / env_name / "vars.yml"
    if not vfile.exists():
        sys.exit(f"net-*: env vars file missing: {vfile}")

    def need(key: str) -> str:
        val = _bosh_int_opt(vfile, f"/{key}")
        if val is None or not val.strip():
            sys.exit(f"net-*: {key} not set in {vfile}")
        return val.strip()

    pve_host = _bosh_int_opt(VARS, "/pve_host")
    if not pve_host:
        sys.exit(f"net-*: pve_host not set in {VARS}")

    # Node name for the host firewall path (/etc/pve/nodes/<node>/host.fw);
    # an env bundle may override it, else fall back to the base vars.
    node = _bosh_int_opt(vfile, "/pve_node") or _bosh_int_opt(VARS, "/pve_node")
    if not node or not node.strip():
        sys.exit(f"net-*: pve_node not set in {vfile} or {VARS}")

    snat_raw = need("cpitest_sdn_snat").lower()
    snat = "1" if snat_raw in ("1", "true", "yes", "on") else "0"

    return {
        "pve_host": pve_host,
        "node": node.strip(),
        "zone": need("cpitest_sdn_zone"),
        "zone_type": need("cpitest_sdn_zone_type"),
        "vnet": need("cpitest_sdn_vnet"),
        "subnet": need("cpitest_sdn_subnet"),
        "gateway": need("cpitest_sdn_gateway"),
        "snat": snat,
    }


def _pve_ssh(pve_host: str, remote_script: str) -> int:
    """Run a bash script on the PVE host as root over SSH, streaming output.

    StrictHostKeyChecking is left to the operator's ssh config; set
    SCRIPTS_PVE_SSH_INSECURE=1 to auto-accept an unknown host key (lab use).
    """
    ssh_opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
    if os.environ.get("SCRIPTS_PVE_SSH_INSECURE", "").strip() in ("1", "true", "yes"):
        ssh_opts += ["-o", "StrictHostKeyChecking=accept-new"]
    return subprocess.run(
        ["ssh", *ssh_opts, f"root@{pve_host}", "bash", "-s"],
        input=remote_script, text=True,
    ).returncode


def _q(value: str) -> str:
    """Shell-quote a value for safe interpolation into the remote script."""
    return shlex.quote(value)


def _pve_ssh_capture(pve_host: str, remote_script: str) -> "subprocess.CompletedProcess[str]":
    """Run a bash script on the PVE host and return the CompletedProcess.

    Like _pve_ssh but captures stdout so the caller can read it.
    stderr is left streaming to the terminal.
    """
    ssh_opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
    if os.environ.get("SCRIPTS_PVE_SSH_INSECURE", "").strip() in ("1", "true", "yes"):
        ssh_opts += ["-o", "StrictHostKeyChecking=accept-new"]
    return subprocess.run(
        ["ssh", *ssh_opts, f"root@{pve_host}", "bash", "-s"],
        input=remote_script, text=True, capture_output=True,
    )


def _hostfw_path(node: str) -> str:
    return f"/etc/pve/nodes/{node}/host.fw"


def _net_up_update_firewall(pve_host: str, node: str, subnet: str) -> int:
    """Read host.fw from the PVE host, update it in Python, write it back.

    Avoids all awk/grep escaping hazards by doing the text manipulation
    locally via _hostfw, then writing the result back over SSH.  Returns
    0 on success, 1 on any SSH error.
    """
    hostfw = _hostfw_path(node)

    # Read the current file content (empty string when file is absent).
    read_proc = _pve_ssh_capture(
        pve_host,
        f"cat {shlex.quote(hostfw)} 2>/dev/null || true",
    )
    if read_proc.returncode != 0:
        print(
            f"firewall: ERROR reading {hostfw} (ssh rc={read_proc.returncode})",
            file=sys.stderr,
        )
        return 1

    existing = read_proc.stdout

    if _hostfw.has_rule_block(existing, subnet):
        print(f"firewall: API rule for {subnet} present")
        return 0

    updated = _hostfw.add_rule_block(existing, subnet)

    # Write back via tee (stdin → file); tee exits 0 on success.
    write_proc = subprocess.run(
        ["ssh",
         "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
         *(
             ["-o", "StrictHostKeyChecking=accept-new"]
             if os.environ.get("SCRIPTS_PVE_SSH_INSECURE", "").strip() in ("1", "true", "yes")
             else []
         ),
         f"root@{pve_host}",
         f"tee {shlex.quote(hostfw)} > /dev/null",
         ],
        input=updated, text=True,
    )
    if write_proc.returncode != 0:
        print(
            f"firewall: ERROR writing {hostfw} (ssh rc={write_proc.returncode})",
            file=sys.stderr,
        )
        return 1

    print(f"firewall: API rule added for {subnet}")
    return 0


def cmd_net_up(_args: list[str]) -> int:
    p = _sdn_params()
    print(
        f">>> net-up: ensuring SDN zone={p['zone']} ({p['zone_type']}) "
        f"vnet={p['vnet']} subnet={p['subnet']} gw={p['gateway']} snat={p['snat']} "
        f"on {p['pve_host']}\n",
        flush=True,
    )

    # SDN zone / vnet / subnet — clean single-line pvesh calls, no escaping hazard.
    sdn_script = f"""set -euo pipefail
ZONE={_q(p['zone'])}; ZTYPE={_q(p['zone_type'])}; VNET={_q(p['vnet'])}
SUBNET={_q(p['subnet'])}; GW={_q(p['gateway'])}; SNAT={_q(p['snat'])}
NET=${{SUBNET%/*}}
if pvesh get /cluster/sdn/zones/"$ZONE" >/dev/null 2>&1; then
  echo "zone $ZONE: exists"
else
  pvesh create /cluster/sdn/zones --type "$ZTYPE" --zone "$ZONE"
  echo "zone $ZONE: created ($ZTYPE)"
fi
if pvesh get /cluster/sdn/vnets/"$VNET" >/dev/null 2>&1; then
  echo "vnet $VNET: exists"
else
  pvesh create /cluster/sdn/vnets --vnet "$VNET" --zone "$ZONE"
  echo "vnet $VNET: created (zone $ZONE)"
fi
if pvesh get /cluster/sdn/vnets/"$VNET"/subnets --output-format json 2>/dev/null | grep -q "$NET"; then
  echo "subnet $SUBNET: exists"
else
  pvesh create /cluster/sdn/vnets/"$VNET"/subnets --type subnet --subnet "$SUBNET" --gateway "$GW" --snat "$SNAT"
  echo "subnet $SUBNET: created (gw $GW snat=$SNAT)"
fi
pvesh set /cluster/sdn
echo "sdn: applied (vnet $VNET is now a bridge on the node)"
"""
    rc = _pve_ssh(p["pve_host"], sdn_script)
    if rc != 0:
        return rc

    # Host firewall: permit the isolated subnet to reach the PVE API (8006).
    # The file is read locally, edited by _hostfw (pure Python, no awk), then
    # written back.  This eliminates the awk f-string escaping hazard entirely.
    rc = _net_up_update_firewall(p["pve_host"], p["node"], p["subnet"])
    if rc != 0:
        return rc

    # Reload pve-firewall so the new rules take effect.
    reload_script = (
        "pve-firewall compile >/dev/null 2>&1 && "
        "pve-firewall restart >/dev/null 2>&1 || true\n"
        "echo 'firewall: reloaded'\n"
    )
    return _pve_ssh(p["pve_host"], reload_script)


def _net_down_update_firewall(pve_host: str, node: str, subnet: str) -> int:
    """Read host.fw from the PVE host, remove cpitest rules in Python, write back.

    Returns 0 on success (including when rules are already absent), 1 on SSH error.
    """
    hostfw = _hostfw_path(node)

    read_proc = _pve_ssh_capture(
        pve_host,
        f"cat {shlex.quote(hostfw)} 2>/dev/null || true",
    )
    if read_proc.returncode != 0:
        print(
            f"firewall: ERROR reading {hostfw} (ssh rc={read_proc.returncode})",
            file=sys.stderr,
        )
        return 1

    existing = read_proc.stdout

    if not _hostfw.has_rule_block(existing, subnet):
        print(f"firewall: no rules for {subnet}")
        return 0

    updated = _hostfw.remove_rule_block(existing, subnet)

    write_proc = subprocess.run(
        ["ssh",
         "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
         *(
             ["-o", "StrictHostKeyChecking=accept-new"]
             if os.environ.get("SCRIPTS_PVE_SSH_INSECURE", "").strip() in ("1", "true", "yes")
             else []
         ),
         f"root@{pve_host}",
         f"tee {shlex.quote(hostfw)} > /dev/null",
         ],
        input=updated, text=True,
    )
    if write_proc.returncode != 0:
        print(
            f"firewall: ERROR writing {hostfw} (ssh rc={write_proc.returncode})",
            file=sys.stderr,
        )
        return 1

    print(f"firewall: rules for {subnet} removed")
    return 0


def cmd_net_down(_args: list[str]) -> int:
    p = _sdn_params()
    print(
        f">>> net-down: removing SDN subnet/vnet/zone for vnet={p['vnet']} "
        f"zone={p['zone']} on {p['pve_host']}\n",
        flush=True,
    )

    # Host firewall: remove cpitest rules locally via _hostfw, then write back.
    # Reload only when rules were actually present (the helper reports truthfully).
    fw_rc = _net_down_update_firewall(p["pve_host"], p["node"], p["subnet"])
    if fw_rc != 0:
        return fw_rc

    # Only reload if rules were actually removed (output message indicates which).
    # We always attempt a reload anyway; pve-firewall compile is safe on a clean file.
    reload_script = (
        "pve-firewall compile >/dev/null 2>&1 && "
        "pve-firewall restart >/dev/null 2>&1 || true\n"
    )
    _pve_ssh(p["pve_host"], reload_script)

    # Best-effort (no `set -e`): each delete is idempotent and tolerates
    # already-absent objects. The subnet id is read back from the API rather
    # than reconstructed, since PVE derives it as "<zone>-<net>-<prefix>".
    sdn_script = f"""set -uo pipefail
ZONE={_q(p['zone'])}; VNET={_q(p['vnet'])}; SUBNET={_q(p['subnet'])}
SUBID=$(pvesh get /cluster/sdn/vnets/"$VNET"/subnets --output-format json 2>/dev/null \
  | sed -n 's/.*"subnet"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' | head -1)
if [ -n "${{SUBID:-}}" ]; then
  pvesh delete /cluster/sdn/vnets/"$VNET"/subnets/"$SUBID" 2>/dev/null \
    && echo "subnet $SUBID: deleted" || echo "subnet $SUBID: delete skipped"
else
  echo "subnet: none"
fi
if pvesh get /cluster/sdn/vnets/"$VNET" >/dev/null 2>&1; then
  pvesh delete /cluster/sdn/vnets/"$VNET" && echo "vnet $VNET: deleted" || echo "vnet $VNET: delete skipped"
else
  echo "vnet $VNET: absent"
fi
if pvesh get /cluster/sdn/zones/"$ZONE" >/dev/null 2>&1; then
  pvesh delete /cluster/sdn/zones/"$ZONE" && echo "zone $ZONE: deleted" \
    || echo "zone $ZONE: delete skipped (still referenced?)"
else
  echo "zone $ZONE: absent"
fi
pvesh set /cluster/sdn
echo "sdn: applied"
"""
    return _pve_ssh(p["pve_host"], sdn_script)


def cmd_net_status(_args: list[str]) -> int:
    p = _sdn_params()

    # SDN object status — pvesh queries, no text manipulation needed.
    sdn_script = f"""set -uo pipefail
ZONE={_q(p['zone'])}; VNET={_q(p['vnet'])}; SUBNET={_q(p['subnet'])}
echo "== zone $ZONE =="
pvesh get /cluster/sdn/zones/"$ZONE" 2>/dev/null || echo "absent"
echo "== vnet $VNET =="
pvesh get /cluster/sdn/vnets/"$VNET" 2>/dev/null || echo "absent"
echo "== subnets =="
pvesh get /cluster/sdn/vnets/"$VNET"/subnets 2>/dev/null || echo "absent"
echo "== bridge on node =="
ip -br link show "$VNET" 2>/dev/null || echo "bridge $VNET not present (run net-up + apply)"
"""
    rc = _pve_ssh(p["pve_host"], sdn_script)
    if rc != 0:
        return rc

    # Host firewall: read the file content and parse it locally.
    hostfw = _hostfw_path(p["node"])
    read_proc = _pve_ssh_capture(
        p["pve_host"],
        f"cat {shlex.quote(hostfw)} 2>/dev/null || true",
    )
    if read_proc.returncode != 0:
        print(
            f"firewall: ERROR reading {hostfw} (ssh rc={read_proc.returncode})",
            file=sys.stderr,
        )
        return 1

    print(f"== host firewall (API access for {p['subnet']}) ==")
    if _hostfw.has_rule_block(read_proc.stdout, p["subnet"]):
        # Display the matching lines directly for operator visibility.
        for line in read_proc.stdout.splitlines():
            if p["subnet"] in line and "# cpitest SDN ->" in line:
                print(line)
    else:
        print(f"no host.fw rule for {p['subnet']} (run net-up)")
    return 0


def cmd_help(args: list[str]) -> int:
    print(USAGE)
    return 0


def cmd_passthrough(args: list[str]) -> int:
    return run("bosh", "-e", "pve", *args, env=director_env())


# ---------------------------------------------------------------------------
# Compiled-release pipeline (compile-releases)
#
# create-env compiles the bosh + bosh-pve-cpi packages on the director VM every
# run (~18 min: director-ruby, postgres, the cloud CLIs, the CPI go build).
# Upstream publishes no compiled bosh release for noble, and the bosh release is
# not a deployable deployment, so it cannot be export-released directly. This
# pipeline compiles those releases ONCE against the active stemcell using a
# no-VM "compilation deployment" on the already-running director, exports the
# compiled tarballs to a configurable store, and pins them via a generated ops
# file so subsequent create-envs skip compilation. See docs/compiled-releases.md.
# ---------------------------------------------------------------------------
COMPILE_DEPLOYMENT = "compile-pve-cpi-releases"


def _stemcell_os_version() -> "tuple[str, str]":
    """Parse (os, version) from vars.yml /stemcell_url.

    e.g. https://bosh.io/d/stemcells/bosh-openstack-kvm-ubuntu-noble?v=1.383
         -> ("ubuntu-noble", "1.383")
    """
    url = bosh_int(VARS, "/stemcell_url")
    os_m = re.search(r"(ubuntu-[a-z0-9]+)", url)
    ver_m = re.search(r"[?&]v=([0-9][0-9.]*)", url)
    if not os_m or not ver_m:
        sys.exit(f"compile-releases: cannot parse os/version from stemcell_url={url!r}")
    return os_m.group(1), ver_m.group(1)


def _sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _cpi_release_version(path: str) -> str:
    """Version of the local bosh-pve-cpi dev release.

    Read from release.MF inside the tarball (the source of truth export-release
    must match); fall back to the create-release filename convention
    (bosh-pve-cpi-<version>.tgz) if the tarball cannot be read.
    """
    import tarfile

    try:
        with tarfile.open(path, "r:gz") as tf:
            mf = next((n for n in tf.getnames() if n.endswith("release.MF")), None)
            if mf:
                member = tf.extractfile(mf)
                if member is not None:
                    data = member.read().decode("utf-8", "replace")
                    m = re.search(r"^version:\s*['\"]?([^'\"\n]+)", data, re.M)
                    if m:
                        return m.group(1).strip()
    except (tarfile.TarError, OSError):
        pass
    stem = Path(path).name
    stem = stem[:-4] if stem.endswith(".tgz") else stem
    prefix = "bosh-pve-cpi-"
    return stem[len(prefix):] if stem.startswith(prefix) else stem


def _store_put(cfg: "_compiled.StoreConfig", local_path: str, basename: str) -> str:
    """Place a compiled tarball into the store; return the url create-env fetches.

    file: copy into the local store directory. s3: upload via the `aws` CLI
    (--endpoint-url for S3-compatible stores); the object must be readable by
    whoever later runs create-env.
    """
    if cfg.kind == "file":
        dst_dir = os.path.abspath(os.path.expanduser(cfg.directory))
        os.makedirs(dst_dir, exist_ok=True)
        shutil.copy2(local_path, os.path.join(dst_dir, basename))
        return cfg.reference(basename)
    if cfg.kind == "s3":
        if shutil.which("aws") is None:
            sys.exit("compile-releases: COMPILED_RELEASES_STORE=s3 requires the 'aws' CLI on PATH")
        key = _compiled.s3_object_key(cfg.s3_prefix, basename)
        s3uri = f"s3://{cfg.s3_bucket}/{key}"
        envc = os.environ.copy()
        if cfg.s3_access_key:
            envc["AWS_ACCESS_KEY_ID"] = cfg.s3_access_key
        if cfg.s3_secret_key:
            envc["AWS_SECRET_ACCESS_KEY"] = cfg.s3_secret_key
        if cfg.s3_region:
            envc["AWS_DEFAULT_REGION"] = cfg.s3_region
        # Force path-style addressing so the object lands where the path-style
        # https reference (s3_https_url) later fetches it. The aws CLI otherwise
        # defaults to virtual-host (<bucket>.<endpoint>), which would not match
        # the <endpoint>/<bucket>/<key> url create-env uses.
        envc["AWS_S3_ADDRESSING_STYLE"] = "path"
        rc = subprocess.run(
            ["aws", "s3", "cp", "--endpoint-url", cfg.s3_endpoint, local_path, s3uri],
            env=envc,
        ).returncode
        if rc != 0:
            sys.exit(f"compile-releases: aws s3 cp -> {s3uri} failed (rc={rc})")
        return cfg.reference(basename)
    sys.exit(f"compile-releases: unknown store kind {cfg.kind!r}")


def _export_compiled(
    name: str, version: str, os_name: str, sc_version: str, cfg: "_compiled.StoreConfig"
) -> "_compiled.CompiledRelease":
    """export-release one release, store its tarball, return a CompiledRelease."""
    with tempfile.TemporaryDirectory(prefix="compiled-") as tmpd:
        rc = run(
            "bosh", "-e", "pve", "-d", COMPILE_DEPLOYMENT, "export-release",
            f"{name}/{version}", f"{os_name}/{sc_version}", f"--dir={tmpd}",
            env=director_env(),
        )
        if rc != 0:
            sys.exit(f"compile-releases: export-release {name}/{version} failed (rc={rc})")
        tars = sorted(Path(tmpd).glob("*.tgz"))
        if not tars:
            sys.exit(f"compile-releases: export-release {name}/{version} produced no tarball")
        if len(tars) > 1:
            print(
                f"    warning: {len(tars)} tarballs for {name}; using {tars[-1].name}",
                file=sys.stderr,
            )
        src = str(tars[-1])
        basename = _compiled.compiled_basename(name, version, os_name, sc_version)
        sha = "sha256:" + _sha256_file(src)
        url = _store_put(cfg, src, basename)
        print(f"    exported {name}/{version} -> {basename}")
        return _compiled.CompiledRelease(name=name, version=version, url=url, sha1=sha)


def _director_rows(denv: dict[str, str], what: str) -> list[dict]:
    """Rows of `bosh <what> --json` (stemcells/releases), or [] on any failure."""
    out = subprocess.run(
        ["bosh", "-e", "pve", what, "--json"], env=denv, capture_output=True, text=True
    ).stdout
    try:
        return json.loads(out)["Tables"][0]["Rows"]
    except (KeyError, IndexError, TypeError, json.JSONDecodeError):
        return []


def _stemcell_present(denv: dict[str, str], os_name: str, sc_version: str) -> bool:
    """Exact os+version match against `bosh stemcells --json` (not a substring)."""
    for r in _director_rows(denv, "stemcells"):
        if (r.get("os") or "") == os_name and (r.get("version") or "").rstrip("*") == sc_version:
            return True
    return False


def _release_present(denv: dict[str, str], name: str, version: str) -> bool:
    """True when `bosh releases --json` lists name/version exactly.

    bosh groups a release's versions into rows where only the first carries the
    name; later version rows leave name blank. Track the current name as we scan.
    """
    current = ""
    for r in _director_rows(denv, "releases"):
        current = (r.get("name") or "").strip() or current
        if current == name and (r.get("version") or "").rstrip("*") == version:
            return True
    return False


def _bosh_release_pin() -> "tuple[str, str, str]":
    """(version, url, sha1) of the 'bosh' release op in bosh-release.yml, by name.

    Selected by matching value/name == 'bosh' rather than a fixed array index, so
    reordering or adding ops to bosh-release.yml cannot silently pin the wrong
    release.
    """
    i = 0
    while True:
        if _bosh_int_opt(BOSH_RELEASE_OPS, f"/{i}/type") is None:
            sys.exit("compile-releases: no 'bosh' release op found in bosh-release.yml")
        if _bosh_int_opt(BOSH_RELEASE_OPS, f"/{i}/value/name") == "bosh":
            return (
                bosh_int(BOSH_RELEASE_OPS, f"/{i}/value/version"),
                bosh_int(BOSH_RELEASE_OPS, f"/{i}/value/url"),
                bosh_int(BOSH_RELEASE_OPS, f"/{i}/value/sha1"),
            )
        i += 1


def cmd_compile_releases(args: list[str]) -> int:
    """Compile the heavy create-env releases once and pin the compiled tarballs.

    Compiles bosh + bosh-pve-cpi against the active stemcell via a no-VM
    compilation deployment on the running director, exports the compiled
    tarballs to the configured store (file:// default, or S3-compatible), and
    writes manifests/bosh/compiled-releases.yml so later create-envs skip
    compilation. Requires a reachable director (run after create-env + alias-env).

    Storage via COMPILED_RELEASES_STORE=file|s3 — see docs/compiled-releases.md.
    """
    if not CREDS.exists():
        sys.exit("compile-releases: creds.yml missing — run create-env + alias-env first")
    os_name, sc_version = _stemcell_os_version()
    sc_url = bosh_int(VARS, "/stemcell_url")
    sc_sha = bosh_int(VARS, "/stemcell_sha1")
    # When the active env's artifacts VM (RustFS) is online and the operator has
    # not set an explicit COMPILED_RELEASES_* override, store the compiled
    # tarballs in its pve-cpi-bosh bucket; otherwise fall back to the env default
    # (file:// or an explicit S3 store). Absent VM -> unchanged behavior.
    artifacts_cfg = _artifacts.compiled_store_override(os.environ, "pve-cpi-bosh")
    cfg = artifacts_cfg or _compiled.store_config_from_env(os.environ, str(COMPILED_DIR_DEFAULT))
    denv = director_env()

    dest = cfg.directory if cfg.kind == "file" else f"{cfg.s3_endpoint}/{cfg.s3_bucket}"
    src = "artifacts-vm" if artifacts_cfg else "env"
    print(f">>> compile-releases: stemcell {os_name}/{sc_version}, store={cfg.kind} ({dest}) [{src}]")

    # 1. Ensure the target stemcell is on the director (exact os+version match).
    if _stemcell_present(denv, os_name, sc_version):
        print(f"    stemcell {os_name}/{sc_version} present")
    else:
        print(f"    uploading stemcell {os_name}/{sc_version}")
        if run("bosh", "-e", "pve", "-n", "upload-stemcell", "--sha1", sc_sha, sc_url, env=denv) != 0:
            sys.exit("compile-releases: stemcell upload failed")

    # 2. Upload the source release(s) to compile.
    #
    # Only the bosh release is pinned compiled: it runs solely on the Linux
    # director VM. The bosh-pve-cpi release is NOT compiled by default — create-env
    # runs the CPI binary on the LOCAL host (cloud_provider driver), so a
    # Linux-compiled CPI cannot execute on a non-Linux workstation ("cannot execute
    # binary file"). It is left to compile locally for the create-env host's OS.
    # Set COMPILE_RELEASES_WITH_CPI=1 only when create-env runs on the same
    # OS/arch as the compilation stemcell (e.g. a Linux CI host).
    include_cpi = os.environ.get("COMPILE_RELEASES_WITH_CPI", "").strip().lower() in ("1", "true", "yes")
    bosh_ver, bosh_url, bosh_sha = _bosh_release_pin()
    targets = [("bosh", bosh_ver)]
    print(f"    uploading source release bosh/{bosh_ver}")
    if run("bosh", "-e", "pve", "-n", "upload-release", "--sha1", bosh_sha, bosh_url, env=denv) != 0:
        sys.exit("compile-releases: upload bosh release failed")
    # Verify the version we will export-release actually registered on the director;
    # a mismatch would otherwise surface as a confusing "release not found".
    if not _release_present(denv, "bosh", bosh_ver):
        sys.exit(f"compile-releases: bosh/{bosh_ver} not on director after upload; check `bosh releases`")
    if include_cpi:
        cpi_path = cpi_release_path()
        cpi_ver = _cpi_release_version(cpi_path)
        print(f"    uploading source release bosh-pve-cpi/{cpi_ver} (COMPILE_RELEASES_WITH_CPI)")
        if run("bosh", "-e", "pve", "-n", "upload-release", cpi_path, env=denv) != 0:
            sys.exit("compile-releases: upload bosh-pve-cpi release failed")
        if not _release_present(denv, "bosh-pve-cpi", cpi_ver):
            sys.exit(
                f"compile-releases: bosh-pve-cpi/{cpi_ver} not on director after upload "
                f"(release.MF version may differ); check `bosh releases`"
            )
        targets.append(("bosh-pve-cpi", cpi_ver))

    # 3. Deploy the no-VM compilation deployment (empty instance_groups).
    rel_lines = "".join(f"- name: {n}\n  version: \"{v}\"\n" for n, v in targets)
    manifest = (
        f"name: {COMPILE_DEPLOYMENT}\n"
        "releases:\n"
        f"{rel_lines}"
        "stemcells:\n"
        f"- alias: default\n  os: {os_name}\n  version: \"{sc_version}\"\n"
        "instance_groups: []\n"
        "update:\n"
        "  canaries: 1\n  max_in_flight: 1\n"
        "  canary_watch_time: 1000-30000\n  update_watch_time: 1000-30000\n  serial: false\n"
    )
    mf = tempfile.NamedTemporaryFile("w", suffix=".yml", delete=False)
    try:
        mf.write(manifest)
        mf.close()
        if run("bosh", "-e", "pve", "-n", "-d", COMPILE_DEPLOYMENT, "deploy", mf.name, env=denv) != 0:
            sys.exit("compile-releases: compilation deploy failed")
        # 4. Export each target (compiles on the director's compilation VMs).
        compiled = [_export_compiled(n, v, os_name, sc_version, cfg) for n, v in targets]
    finally:
        os.unlink(mf.name)
        run("bosh", "-e", "pve", "-n", "-d", COMPILE_DEPLOYMENT, "delete-deployment", "--force", env=denv)

    # 5. Write the create-env ops file pinning the compiled tarballs.
    ops = _compiled.compiled_releases_ops(compiled, stemcell=f"{os_name}/{sc_version}")
    COMPILED_OPS.write_text(ops, encoding="utf-8")
    print(f">>> compile-releases: wrote {COMPILED_OPS} ({len(compiled)} releases)")
    print("    create-env now uses the compiled tarballs (COMPILE_RELEASES_DISABLE=1 forces source)")
    return 0


def compiled_ops_layer() -> list[str]:
    """Return ['-o', compiled-releases.yml] when a matching compiled cache exists.

    Skipped when COMPILE_RELEASES_DISABLE is set, the ops file is absent, or it
    targets a different stemcell than vars.yml (a stale cache must not be applied
    — the compiled packages would not match and create-env would fail). Layered
    after the source release ops so its compiled url+sha win.
    """
    if os.environ.get("COMPILE_RELEASES_DISABLE", "").strip().lower() in ("1", "true", "yes"):
        return []
    if not COMPILED_OPS.exists():
        return []
    text = COMPILED_OPS.read_text(encoding="utf-8")
    target = _compiled.stemcell_from_ops(text)
    # No marker → cannot prove the cache matches; refuse rather than risk pinning
    # tarballs for an unknown stemcell (would fail with a confusing sha error).
    if target is None:
        print(
            f"compile: {COMPILED_OPS.name} has no stemcell marker; ignoring "
            "(re-run compile-releases)",
            file=sys.stderr,
        )
        return []
    os_name, sc_version = _stemcell_os_version()
    active = f"{os_name}/{sc_version}"
    if target != active:
        print(
            f"compile: {COMPILED_OPS.name} targets {target} but stemcell is {active}; "
            "compiling from source",
            file=sys.stderr,
        )
        return []
    # A file:// ref pointing at a deleted tarball would fail not just create-env
    # but delete-env (stranding the director VM). If any local tarball is gone,
    # fall back to source — the source release urls are always reachable.
    missing = [p for p in _compiled.local_paths_from_ops(text) if not os.path.exists(p)]
    if missing:
        print(
            f"compile: compiled tarball(s) missing ({', '.join(missing)}); compiling from source",
            file=sys.stderr,
        )
        return []
    print(f"compile: using compiled releases ({active}) from {COMPILED_OPS.name}")
    return ["-o", str(COMPILED_OPS)]


COMMANDS = {
    "create-env": cmd_create_env,
    "deploy": cmd_create_env,
    "teardown": cmd_teardown,
    "delete-env": cmd_teardown,
    "alias-env": cmd_alias_env,
    "login": cmd_login,
    "env": cmd_env,
    "ucc": cmd_ucc,
    "upload-cloud-config": cmd_ucc,
    "runtime-config": cmd_runtime_config,
    "upload-stemcell": cmd_upload_stemcell,
    "emptyvm": cmd_emptyvm,
    "net-up": cmd_net_up,
    "network-up": cmd_net_up,
    "net-down": cmd_net_down,
    "network-down": cmd_net_down,
    "net-status": cmd_net_status,
    "network-status": cmd_net_status,
    "credhub": cmd_credhub,
    "compile-releases": cmd_compile_releases,
    "help": cmd_help,
    "-h": cmd_help,
    "--help": cmd_help,
}


def main(argv: list[str]) -> int:
    if not argv:
        return cmd_help([])
    sub, *rest = argv
    handler = COMMANDS.get(sub)
    if handler is None:
        return cmd_passthrough(argv)
    return handler(rest)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
