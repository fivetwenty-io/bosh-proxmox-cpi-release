---
name: pve_cpi

description: "PVE BOSH Cloud Provider Interface"

templates:
  cpi.erb: bin/cpi
  cpi.json.erb: config/cpi.json

packages:
  - pve_cpi

properties:
  pve.host:
    description: "PVE host"
  pve.port:
    description: "PVE API port"
    default: 8006
  pve.user:
    description: "PVE username"
  pve.password:
    description: |
      PVE password (mutually exclusive with api_token). Must be credhub-managed
      in production: reference via `((pve_password))` against a credhub variable
      typed `password`. Empty string when api_token is used instead.
    default: ""
  pve.api_token:
    description: |
      PVE API token (mutually exclusive with password). Format:
      <user>!<token-id>=<uuid>. Must be credhub-managed in production: reference
      via `((pve_api_token))` against a credhub variable typed `password`. Empty
      string when password is used instead.
    default: ""
  pve.realm:
    description: "Authentication realm"
    default: "pam"
  pve.node:
    description: "Default PVE node"
  pve.vm_storage:
    description: "Storage pool for VMs"
  pve.disk_storage:
    description: "Storage pool for persistent disks"
  pve.stemcell_storage:
    description: |
      Storage pool for stemcell qcow2 images. PVE only allows uploads to
      file-based storages (dir, nfs, cifs, glusterfs, cephfs); block-based
      storages (lvm, lvmthin, zfspool, rbd) cannot accept qcow2 uploads and
      are rejected at create_stemcell time. Must also be shared across all
      cluster nodes when the cluster has more than one node. Defaults to
      vm_storage if unset; in that case vm_storage must satisfy the same
      constraints.
    default: ""
  pve.iso_storage:
    description: |
      Storage pool (dir/nfs/cifs with `iso` content enabled) used to hold the
      per-VM ConfigDrive ISO. Block storages (lvm/lvmthin/zfspool) cannot
      hold ISO files.
    default: "local"
  pve.network_bridge:
    description: "Default network bridge"
    default: "vmbr0"
  pve.network_mode:
    description: |
      Selects create_network/delete_network behavior.
      "sdn" — PVE SDN vnet lifecycle (cluster SDN must be enabled).
      "bridge" — Linux bridge lifecycle via the nodes API.
      "auto" — use SDN when cloud_properties.zone or pve.sdn_zone is set;
               fall back to bridge otherwise.
    default: "auto"
  pve.sdn_zone:
    description: |
      Default PVE SDN zone name for vnet creation. Used when
      cloud_properties.zone is absent. When empty and network_mode requires
      SDN, the zone must be supplied per-call in cloud_properties.
    default: ""
  pve.sdn_zone_type:
    description: |
      PVE zone type the CPI uses when it creates a zone (requires
      sdn_auto_manage_zone: true). One of: simple, vlan, qinq, vxlan, evpn.
      "simple" is appropriate for single-node labs; multi-node overlays
      require vxlan or evpn.
    default: "simple"
  pve.sdn_auto_manage_zone:
    description: |
      When true, create_network creates the SDN zone (type sdn_zone_type)
      if it does not already exist, and delete_network deletes the zone when
      ALL three conditions hold: (1) sdn_auto_manage_zone is true, (2) the
      zone name does not equal pve.sdn_zone (the operator-pinned zone is never
      auto-deleted), and (3) the zone has zero remaining vnets after the vnet
      delete. Default false — operator manages zones; CPI manages only vnets.
    default: false
  pve.verify_ssl:
    description: "Verify TLS certificate"
    default: true
  pve.ca_cert:
    description: |
      Optional. PEM-encoded CA certificate bundle for verifying the Proxmox VE
      API TLS certificate. When empty (default), the system trust pool is used
      unmodified — behavior is byte-identical to prior releases. When set, the
      PEM is parsed and the resulting cert pool replaces the system pool for PVE
      API HTTPS verification. Ignored when verify_ssl is false. Symmetric to
      registry.ca_cert.
    default: ""
  pve.agent_mode:
    description: "Agent bootstrap mode: cloudinit, registry, noagent"
    default: "cloudinit"
  pve.vm_disk_format:
    description: "Disk format: qcow2, raw, vmdk"
    default: "qcow2"
  pve.log_level:
    description: "Log level"
    default: "info"
  pve.hotplug:
    description: |
      PVE hotplug flags applied to every new VM. Comma-separated list of
      "network,disk,cpu,memory,usb,cloudinit"; "0" disables hotplug entirely.
      Defaults to "network,disk,cpu,memory" so CPU + RAM can be resized live
      via `qm set` without rebooting. Per-VM override via
      cloud_properties.hotplug for stemcells that misbehave on memory hot-add.
    default: "network,disk,cpu,memory"
  pve.numa:
    description: |
      Enable NUMA (numa=1) on every new VM. PVE requires this at create time
      for memory hotplug to allocate DIMM slots; without it, memory hot-add
      silently no-ops. Set false to disable globally; per-VM override via
      cloud_properties.numa.
    default: true
  pve.reboot_mode:
    description: |
      reboot_vm behavior. "soft" (default) performs a graceful ACPI reboot
      (shutdown + auto-start) and falls back to a hard reset if the guest
      does not shut down within reboot_timeout seconds. "hard" performs an
      immediate hard reset (power cycle). One of soft|hard.
    default: "soft"
  pve.reboot_timeout:
    description: |
      Seconds the soft reboot waits for graceful ACPI shutdown before
      falling back to a hard reset. Range 1-3600. Ignored when
      reboot_mode is "hard".
    default: 60
  pve.vmid_range_start:
    description: |
      Starting VMID for VM allocation. VMs are allocated in the range
      [vmid_range_start, vmid_range_end]; default vmid_range_start is 100.
      Persistent disks use synthetic VMIDs 9000-9999 (unchanged).
    default: 100
  pve.vmid_range_end:
    description: |
      Inclusive upper bound of the VMID range for VM allocation. VMs allocated in
      [vmid_range_start, vmid_range_end]. Default 5999. Must be > vmid_range_start
      and <= 9999. Persistent disks use synthetic VMIDs 9000-9999 (unaffected).
    default: 5999
  pve.allow_disk_ops_with_snapshots:
    description: |
      When true, bypasses the snapshot pre-flight guard in attach_disk, detach_disk,
      and resize_disk. Use only for emergency disk recovery; snapshot state will be
      inconsistent after the operation. Default false (guard active).
    default: false
  pve.require_snapshot_check_pass:
    description: |
      When true, a disk operation aborts if the snapshot pre-flight check itself
      fails (cannot reach PVE to list snapshots). Default false: on check failure
      the CPI logs a warning and proceeds (fail-open).
    default: false
  pve.vm_prefix:
    description: |
      Optional prefix prepended to every CPI-provisioned VM's PVE name.
      When set (e.g. "cpi") VM names take the form
      "<prefix>-<deployment>-<job>-<index>", so deployments sharing a PVE
      cluster can be filtered by prefix in the PVE UI. When empty the
      prefix is omitted and the name is "<deployment>-<job>-<index>".
    default: ""
  pve.create_env_deployment:
    description: |
      Synthetic deployment name used for VMs created by `bosh create-env`.
      bosh-init does not pass a deployment in env, so a stable placeholder
      is required for the "<deployment>" segment of the VM name. Defaults
      to "create-env" so the director comes online as
      "<prefix>-create-env-<job>-0".
    default: "create-env"
  agent.mbus:
    description: |
      URL the BOSH agent should bind/listen on inside the VM (the same value
      `cloud_provider.properties.agent.mbus` carries in bosh-deployment).
      Required for create-env: bosh-init does not pass it via the per-call
      env argument, only via CPI config.
    default: ""
  agent.blobstore:
    description: "Optional default blobstore for settings.json (agent.blobstore in bosh.yml)"
    default: {}
  registry.endpoint:
    description: "BOSH registry endpoint (required if agent_mode=registry)"
    default: ""
  registry.user:
    description: "Registry user"
    default: ""
  registry.password:
    description: "Registry password"
    default: ""
  registry.allow_insecure:
    description: |
      When true, permits a plaintext http:// registry endpoint. Default false:
      Validate rejects any non-https scheme so registry credentials never travel
      in cleartext. Set to true only for lab/test deployments; production
      deployments must use https with verified certificates.
    default: false
  registry.ca_cert:
    description: |
      Optional PEM-encoded CA certificate (or chain) appended to the host's
      system trust pool when verifying the registry's TLS certificate. Use when
      the registry presents a certificate signed by a private CA the host trust
      store does not already include. Empty means use the system pool unmodified.
    default: ""
  pve.stemcell_staging_dir:
    description: |
      Optional. When set, restricts stemcell file reads/writes to this directory
      using Go 1.24+ os.Root scoping. Defense-in-depth; if unset, behavior is
      unchanged from prior releases. Paths supplied by the BOSH director must
      reside under this directory when set. Must be an absolute path to an
      existing directory on the CPI host.
    default: ""
  registry.allowed_hosts:
    description: |
      Optional. If non-empty, restricts the registry HTTP client to only
      contact hosts matching one of these patterns. Each entry is either an
      exact host (e.g. "registry.example.com") or a wildcard prefix
      (e.g. "*.example.com"). Defense-in-depth against SSRF via host mutation.
      Empty (default) disables host-allow-list filtering; the configuredHost
      invariant and disabled redirects still apply regardless.
    default: []
  pve.fetch_credential_defaults:
    description: |
      Ordered list of URL-prefix to auth-payload mappings used by the CPI when
      fetching a light stemcell whose cloud_properties.image_url is set without
      per-stemcell image_url_auth. The entry whose url_prefix is the longest
      matching prefix of the request URL wins.
      Each entry requires two fields: url_prefix (string) and auth (object with
      a required type field). Supported auth.type values: basic, bearer, s3, oci,
      blobstore. When unset, light-stemcell fetches without per-stemcell
      credentials are unauthenticated.
    default: []
    example:
    - url_prefix: "https://artifactory.corp/"
      auth:
        type: "basic"
        username: "robot"
        password: "s3cr3t"
    - url_prefix: "s3://stemcells-mirror/"
      auth:
        type: "s3"
        access_key_id: "AKIA..."
        secret_access_key: "..."
        endpoint: "https://s3.lab.local"
