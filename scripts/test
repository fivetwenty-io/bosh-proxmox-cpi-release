#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Run project tests or the integration test harness.

Usage:
    ./scripts/test                      Run unit/check suite (make check).
    ./scripts/test integration [action] Run integration tier(s).

Integration actions:
    all        Teardown existing env, then run lifecycle → bosh → cf → light (default).
    lifecycle  Run only Tier 1: CPI 16-step lifecycle test.
    bosh       Run only Tier 2: bosh create-env + emptyvm smoke.
    cf         Run only Tier 3: CF deploy + smoke app.
    light      Run only Tier 4: light stemcell upload + delete assertions.
    teardown   Tear down CF deployment and BOSH director.

Integration flags:
    --config FILE   Path to integration config YAML (default: ci/integration.yml).
    --dry-run       Print each command without executing; exit 0.
    --keep          Skip cleanup steps after each tier (leave resources running).
"""

from __future__ import annotations

import atexit
import os
import shlex
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

# Populated once from parsed args; run() reads this module-level flag.
_dry_run: bool = False


# ---------------------------------------------------------------------------
# subprocess helper
# ---------------------------------------------------------------------------


def run(
    cmd: list[str],
    env: dict[str, str] | None = None,
    check: bool = True,
    cwd: Path | None = None,
    timeout: int | None = None,
) -> int:
    """Run a command, respecting dry_run mode.

    In dry_run mode, prints the command prefixed with 'DRY-RUN:' and returns 0
    without executing.  In live mode, inherits the current process env merged
    with any extra vars in *env*, injects NO_COLOR=1 when stdout is not a TTY,
    and returns the subprocess returncode.

    Args:
        cmd:     Command and arguments as a list.
        env:     Optional dict of additional env vars to merge into the child env.
        check:   When True, raise CalledProcessError on non-zero exit.
        cwd:     Working directory for the child process (default: REPO_ROOT).
        timeout: Optional timeout in seconds; on expiry prints the step label
                 and returns 1.  None means no timeout.

    Returns:
        Process returncode (always 0 in dry_run mode).

    Raises:
        subprocess.CalledProcessError: Non-zero exit when check=True.
    """
    if _dry_run:
        print(f"DRY-RUN: {shlex.join(cmd)}")
        return 0

    child_env = os.environ.copy()
    if env:
        child_env.update(env)
    # Inject NO_COLOR when stdout is not a TTY and the caller has not supplied
    # an explicit NO_COLOR override in env — caller-supplied value wins.
    if not sys.stdout.isatty() and "NO_COLOR" not in child_env:
        child_env["NO_COLOR"] = "1"

    try:
        result = subprocess.run(
            cmd,
            env=child_env,
            cwd=cwd or REPO_ROOT,
            check=check,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        print(f"{shlex.join(cmd)} timed out after {timeout}s", file=sys.stderr)
        return 1
    return result.returncode


def run_with_retries(
    cmd: list[str],
    *,
    cwd: Path | None = None,
    timeout: int | None = None,
    env: dict[str, str] | None = None,
    retries: int = 0,
    delay: int = 10,
    label: str = "",
) -> int:
    """Run *cmd* via run(), retrying on non-zero exit up to *retries* times.

    Sleeps *delay* seconds between attempts. Used for steps that race
    transient, self-clearing conditions on a single-node lab: a freshly-
    deployed Cloud Controller's "MySQL client is not connected" until its DB
    pool warms up, or an intermittent director->agent get_state/get_task 45s
    timeout under CPU/IO contention (re-running the idempotent deploy resumes).
    Returns 0 on the first success, else the last non-zero rc.
    """
    attempts = retries + 1
    rc = 0
    for attempt in range(1, attempts + 1):
        rc = run(cmd, env=env, cwd=cwd, timeout=timeout, check=False)
        if rc == 0:
            return 0
        if attempt < attempts:
            what = label or shlex.join(cmd)
            print(
                f"retry: {what} exited {rc} (attempt {attempt}/{attempts}); "
                f"retrying in {delay}s",
                file=sys.stderr,
            )
            if not _dry_run:
                time.sleep(delay)
    return rc


# ---------------------------------------------------------------------------
# Loader import
# ---------------------------------------------------------------------------

sys.path.insert(0, str(REPO_ROOT / "scripts"))
import _integration  # noqa: E402


# ---------------------------------------------------------------------------
# Tier helpers
# ---------------------------------------------------------------------------


def tier_lifecycle(cfg: dict, cpi_config_path: str, keep: bool) -> int:
    """Build bin/cpi then run scripts/lifecycle with the Tier 1 env.

    Args:
        cfg:             Validated config dict.
        cpi_config_path: Path to the synthesized CPI JSON config.
        keep:            Unused for lifecycle (lifecycle self-cleans).

    Returns:
        0 on success, 1 on failure.
    """
    print("==> tier 1: lifecycle")

    rc = run(["make", "bin/cpi"], cwd=REPO_ROOT)
    if rc != 0:
        print("tier 1 failed: make bin/cpi", file=sys.stderr)
        return 1

    # Build tier1 env; in dry_run the stemcell_path may be empty.
    if _dry_run:
        try:
            t1_env = _integration.tier1_env(cfg, cpi_config_path, dry_run=True)
        except SystemExit:
            # stemcell_path empty and STEMCELL_PATH not set — use a placeholder.
            t1_env = _integration.tier1_env(
                _cfg_with_stemcell(cfg, "<dry-run:stemcell>"),
                cpi_config_path,
                dry_run=True,
            )
    else:
        t1_env = _integration.tier1_env(cfg, cpi_config_path, dry_run=False)

    raw_pools = cfg.get("tier1", {}).get("disk_storage_pools", [])
    # Normalize to AUTO sentinel or an explicit list.
    _auto = raw_pools == "auto" or raw_pools == ["auto"]
    if _auto:
        if _dry_run:
            print("==> tier 1: would autodetect local disk storage pools (lvm/lvmthin/zfspool/dir)")
            pools = []  # fall through to single-run path below
        else:
            try:
                pools = _integration.detect_disk_storage_pools(cfg)
            except RuntimeError as exc:
                print(f"tier 1: autodetect error: {exc}", file=sys.stderr)
                return 1
            print(f"==> tier 1: autodetected disk storage pools: {pools}")
            if not pools:
                print(
                    "tier 1: autodetect found no local image-capable disk storage",
                    file=sys.stderr,
                )
                return 1
    else:
        pools = list(raw_pools)

    if not pools:
        rc = run(["./scripts/lifecycle"], env=t1_env, cwd=REPO_ROOT)
        if rc != 0:
            print("tier 1 failed: scripts/lifecycle", file=sys.stderr)
            return 1
    else:
        for pool in pools:
            # In dry-run mode skip real temp file creation — run() is a no-op anyway.
            if _dry_run:
                pool_cfg = "/dev/null"
            else:
                fd, pool_cfg = tempfile.mkstemp(prefix=f"cpi-{pool}-", suffix=".json")
                os.close(fd)
            try:
                _integration.write_cpi_config(
                    cfg, pool_cfg, dry_run=_dry_run, disk_storage_override=pool
                )
                pool_env = {**t1_env, "CPI_CONFIG": pool_cfg}
                print(f"==> tier 1: lifecycle [{pool}]")
                rc = run(["./scripts/lifecycle"], env=pool_env, cwd=REPO_ROOT)
            finally:
                if not _dry_run:
                    Path(pool_cfg).unlink(missing_ok=True)
            if rc != 0:
                print(f"tier 1 failed: scripts/lifecycle [{pool}]", file=sys.stderr)
                return 1

    # Network-test passes. tier1.network_test.modes selects which create_network/
    # delete_network paths to exercise, each as one extra lifecycle pass with
    # out-of-band PVE verification. Kept independent of disk_storage_pools (no
    # cross product). Accepts an explicit list (e.g. [sdn, bridge]) or the string
    # `auto` to detect at run time which modes the PVE host supports (sdn when
    # SDN is installed with a usable zone; bridge when the configured iface is
    # free). Empty/absent -> no extra passes (backward compatible).
    raw_modes = cfg.get("tier1", {}).get("network_test", {}).get("modes", []) or []
    net_passes: list[dict] = []
    if raw_modes == "auto" or raw_modes == ["auto"]:
        if _dry_run:
            print("==> tier 1: would autodetect network modes (sdn if available, bridge if iface free)")
        else:
            try:
                net_passes = _integration.detect_network_modes(cfg)
            except RuntimeError as exc:
                print(f"tier 1: network autodetect error: {exc}", file=sys.stderr)
                return 1
            detected = [p["mode"] for p in net_passes]
            print(f"==> tier 1: autodetected network modes: {detected or '(none)'}")
    else:
        net_passes = [{"mode": str(m), "env": {}, "cpi": {}} for m in raw_modes]

    for p in net_passes:
        mode = p["mode"]
        print(f"==> tier 1: lifecycle pass (NETWORK_TEST_MODE={mode})")
        # Some passes (auto sdn) need CPI-config overrides for zone management;
        # write a dedicated config for those, otherwise reuse the default.
        cpi_overrides = p.get("cpi") or {}
        pass_cpi_path = cpi_config_path
        tmp_cfg = None
        if cpi_overrides and not _dry_run:
            fd, tmp_cfg = tempfile.mkstemp(prefix=f"cpi-net-{mode}-", suffix=".json")
            os.close(fd)
            _integration.write_cpi_config(
                cfg,
                tmp_cfg,
                dry_run=False,
                sdn_zone=cpi_overrides.get("sdn_zone"),
                sdn_auto_manage_zone=cpi_overrides.get("sdn_auto_manage_zone"),
            )
            pass_cpi_path = tmp_cfg
        try:
            mode_env = {
                **t1_env,
                "CPI_CONFIG": pass_cpi_path,
                "NETWORK_TEST_MODE": mode,
                **(p.get("env") or {}),
            }
            rc = run(["./scripts/lifecycle"], env=mode_env, cwd=REPO_ROOT)
        finally:
            if tmp_cfg is not None:
                Path(tmp_cfg).unlink(missing_ok=True)
        if rc != 0:
            print(f"tier 1 failed: scripts/lifecycle (mode={mode})", file=sys.stderr)
            return 1

    # Snapshot-detach bypass pass (optional, orthogonal to pools/network). The
    # base pass(es) above run SNAPSHOT_DETACH_MODE=clean (delete_snapshot before
    # detach). When tier1.snapshot_detach_bypass is set, run one extra pass that
    # detaches while the snapshot is still present, using a CPI config with
    # allow_disk_ops_with_snapshots=true so detach_disk's guard is bypassed.
    if cfg.get("tier1", {}).get("snapshot_detach_bypass"):
        print("==> tier 1: lifecycle pass (SNAPSHOT_DETACH_MODE=bypass)")
        if _dry_run:
            print("==> tier 1: would write CPI config with allow_disk_ops_with_snapshots=true")
            rc = run(
                ["./scripts/lifecycle"],
                env={**t1_env, "SNAPSHOT_DETACH_MODE": "bypass"},
                cwd=REPO_ROOT,
            )
        else:
            fd, bypass_cfg = tempfile.mkstemp(prefix="cpi-snap-bypass-", suffix=".json")
            os.close(fd)
            try:
                _integration.write_cpi_config(
                    cfg, bypass_cfg, dry_run=False, allow_disk_ops_with_snapshots=True
                )
                rc = run(
                    ["./scripts/lifecycle"],
                    env={**t1_env, "CPI_CONFIG": bypass_cfg, "SNAPSHOT_DETACH_MODE": "bypass"},
                    cwd=REPO_ROOT,
                )
            finally:
                Path(bypass_cfg).unlink(missing_ok=True)
        if rc != 0:
            print("tier 1 failed: scripts/lifecycle (SNAPSHOT_DETACH_MODE=bypass)", file=sys.stderr)
            return 1

    print("==> tier 1: lifecycle passed")
    return 0


def _cfg_with_stemcell(cfg: dict, path: str) -> dict:
    """Return a shallow copy of cfg with tier1.stemcell_path set to path."""
    import copy
    cfg2 = copy.deepcopy(cfg)
    cfg2["tier1"]["stemcell_path"] = path
    return cfg2


# Tracks whether an atexit resurrection-re-enable callback has been registered
# so that multiple tier runs in a single `all` invocation do not stack duplicate
# callbacks.
_resurrection_atexit_registered: bool = False


def disable_resurrection(cfg: dict) -> int:
    """Disable BOSH resurrection and register an atexit handler to re-enable it.

    The Health Monitor's resurrector races integration deploys: a transient
    missed get_state heartbeat causes HM to declare a healthy VM dead and
    launch 'scan and fix', which grabs the deployment lock and fails the
    in-flight deploy.  Disabling resurrection for the duration of the run
    prevents this.

    An atexit callback unconditionally re-enables resurrection on process
    exit (success, failure, or keyboard interrupt) so the lab is never left
    with resurrection permanently disabled.  The callback is registered at
    most once per process, regardless of how many tiers call this function.

    Args:
        cfg: Validated config dict (unused directly; reserved for future
             per-environment targeting).

    Returns:
        0 on success, non-zero if the disable command fails.
    """
    global _resurrection_atexit_registered

    if not _resurrection_atexit_registered:
        def _reenable_resurrection() -> None:
            # Run unconditionally — ignore errors so a broken director does
            # not suppress the atexit machinery for other handlers.
            try:
                subprocess.run(
                    ["./scripts/bosh", "update-resurrection", "on"],
                    cwd=REPO_ROOT,
                    check=False,
                )
            except Exception:  # noqa: BLE001
                pass

        atexit.register(_reenable_resurrection)
        _resurrection_atexit_registered = True

    rc = run_with_retries(
        ["./scripts/bosh", "update-resurrection", "off"],
        cwd=REPO_ROOT,
        retries=1,
        delay=20,
        label="resurrection-off",
    )
    return rc


def tier_bosh(cfg: dict, cpi_config_path: str, keep: bool) -> int:
    """Run the Tier 2 BOSH director smoke sequence.

    Steps: create-env → alias-env → ucc → runtime-config → emptyvm → env assert.
    Unless keep, deletes the emptyvm deployment afterwards.

    Args:
        cfg:             Validated config dict.
        cpi_config_path: Not used directly; director reads its own manifests.
        keep:            When True, skip delete-deployment cleanup.

    Returns:
        0 on success, non-zero on first failure.
    """
    print("==> tier 2: bosh")
    tier2 = cfg.get("tier2", {})
    alias = str(tier2.get("bosh_env_alias", "pve"))
    deployment = str(tier2.get("deployment_name", "emptyvm"))
    # The emptyvm deploy creates a VM, bootstraps its agent, compiles packages,
    # and runs the instance update — minutes of work, not a quick smoke check.
    # Give it its own generous timeout (default 30m); smoke_timeout_s is reserved
    # for fast probes (e.g. the cf push/curl in tier 3).
    deploy_timeout = tier2.get("deploy_timeout_s", 1800) or None
    if deploy_timeout is not None:
        deploy_timeout = int(deploy_timeout)

    # emptyvm deploys a bare stemcell VM, so the director needs an uploaded
    # stemcell first (create-env only stages the director's own VM). Resolve the
    # same stemcell Tier 1 uses; a placeholder suffices under --dry-run.
    sc_path = "<dry-run:stemcell>" if _dry_run else _integration.stemcell_path(cfg)

    # (step_name, cmd, timeout, env, retries)
    # emptyvm gets retries: intermittent get_state/get_task 45s timeouts can
    # fail an otherwise-healthy deploy; re-running it resumes.
    # NOTE: resurrection-off is deferred to after alias-env. On a fresh
    # `integration all` run the previous teardown leaves the director
    # destroyed, so calling `bosh update-resurrection off` before create-env
    # would time out trying to reach a director that does not yet exist.
    steps = [
        ("create-env",        ["./scripts/bosh", "create-env"],         None,           None,                          0),
        ("alias-env",         ["./scripts/bosh", "alias-env"],          None,           None,                          0),
        ("resurrection-off",  None,                                     None,           None,                          0),
        ("ucc",               ["./scripts/bosh", "ucc"],                None,           None,                          1),
        ("runtime-config",    ["./scripts/bosh", "runtime-config"],     None,           None,                          1),
        ("upload-stemcell",   ["./scripts/bosh", "upload-stemcell"],    None,           {"STEMCELL_PATH": sc_path},    1),
        ("emptyvm",           ["./scripts/bosh", "emptyvm"],            deploy_timeout, None,                          2),
        ("env",               ["./scripts/bosh", "env"],                None,           None,                          1),
    ]

    for step_name, cmd, step_timeout, step_env, step_retries in steps:
        if step_name == "resurrection-off":
            # Disable resurrection now that the director exists and the
            # `pve` env alias is registered. disable_resurrection() also
            # registers an atexit callback that re-enables resurrection on
            # ANY exit path (success, failure, KeyboardInterrupt), so the
            # lab is never left with resurrection permanently disabled.
            rc = disable_resurrection(cfg)
        else:
            rc = run_with_retries(
                cmd, env=step_env, cwd=REPO_ROOT, timeout=step_timeout,
                retries=step_retries, delay=20, label=step_name,
            )
        if rc != 0:
            print(f"tier 2 failed: {step_name}", file=sys.stderr)
            return rc

    if not keep:
        d_env = _integration.director_env(cfg, dry_run=_dry_run)
        rc = run(
            ["bosh", "-e", alias, "-d", deployment, "delete-deployment", "-n"],
            env=d_env,
            cwd=REPO_ROOT,
        )
        if rc != 0:
            print(f"tier 2 failed: delete-deployment {deployment}", file=sys.stderr)
            return rc

    print("==> tier 2: bosh passed")
    return 0


def tier_cf(cfg: dict, cpi_config_path: str, keep: bool) -> int:
    """Run the Tier 3 CF deploy and smoke app sequence.

    Steps: cf deploy → cf login → create org/space → cf push smoke app →
    map-route → curl HTTP 200 assert. Unless keep, deletes app/space/org.

    Args:
        cfg:             Validated config dict.
        cpi_config_path: Not used directly; scripts/cf reads its own manifests.
        keep:            When True, skip delete cleanup.

    Returns:
        0 on success, non-zero on first failure.
    """
    print("==> tier 3: cf")
    tier3 = cfg.get("tier3", {})
    smoke_org   = str(tier3.get("smoke_org", "integration-smoke"))
    smoke_space = str(tier3.get("smoke_space", "test"))
    smoke_app   = str(tier3.get("smoke_app", "httpbin-smoke"))
    smoke_timeout = tier3.get("smoke_timeout_s") or None
    if smoke_timeout is not None:
        smoke_timeout = int(smoke_timeout)

    sys_domain = _integration.system_domain(cfg, dry_run=_dry_run)

    # Disable resurrection before any deploy steps.  disable_resurrection()
    # registers an atexit callback to re-enable it unconditionally on exit.
    # Idempotent when tier_bosh ran first in the same process (atexit registered
    # at most once).  Covers a standalone `integration cf` run too.
    rc = disable_resurrection(cfg)
    if rc != 0:
        print("tier 3 failed: resurrection-off", file=sys.stderr)
        return rc

    # (step_name, cmd, timeout, retries) — smoke_timeout applies to cf push.
    # The cf CLI steps that touch the Cloud Controller get retries: the first
    # writes after a fresh deploy can transiently fail with "MySQL client is
    # not connected" until CC's DB connection pool warms up.
    # cf deploy is NOT auto-retried: re-running an interrupted multi-VM CF
    # deploy resumes in-place, and if the first attempt died early (before
    # router/tcp-router/scheduler were updated) the haproxy canary then
    # crash-loops on unresolvable backend bosh-dns names and wedges the
    # deploy. A clean single pass is the reliable path; an interrupted
    # deploy is better re-run from a fresh `integration cf` (or `all`).
    # The real cause of those interruptions is the single-node lab's 45s
    # director->agent timeout under the 16-VM creation burst — see
    # docs/pve-host-tuning.md; not a CPI defect.
    steps_before_push: list[tuple[str, list[str], int | None, int]] = [
        ("cf deploy",        ["./scripts/cf", "deploy"],                              None,          0),
        ("cf login",         ["./scripts/cf", "login"],                               None,          3),
        ("cf create-org",    ["cf", "create-org", smoke_org],                         None,          6),
        ("cf create-space",  ["cf", "create-space", smoke_space, "-o", smoke_org],    None,          3),
        ("cf target",        ["cf", "target", "-o", smoke_org, "-s", smoke_space],    None,          2),
        # The smoke app is a docker image, so diego_docker must be enabled
        # (admin-scoped, off by default in cf-deployment). Idempotent.
        ("enable docker",    ["cf", "enable-feature-flag", "diego_docker"],           None,          2),
        ("cf push",          ["cf", "push", smoke_app,
                              "-o", "ghcr.io/mccutchen/go-httpbin"],                  smoke_timeout, 1),
        ("cf map-route",     ["cf", "map-route", smoke_app,
                              sys_domain, "--hostname", "smoke"],                     None,          2),
    ]

    for step_name, cmd, step_timeout, step_retries in steps_before_push:
        rc = run_with_retries(
            cmd, cwd=REPO_ROOT, timeout=step_timeout, retries=step_retries, label=step_name
        )
        if rc != 0:
            print(f"tier 3 failed: {step_name}", file=sys.stderr)
            return rc

    # Route registration propagates asynchronously to the gorouter, so retry
    # the smoke GET until the route is live (or the budget is exhausted).
    smoke_url = f"https://smoke.{sys_domain}/get"
    rc = run_with_retries(
        ["curl", "-sf", smoke_url, "--insecure"],
        cwd=REPO_ROOT, timeout=smoke_timeout, retries=6, label=f"curl {smoke_url}",
    )
    if rc != 0:
        print(f"tier 3 failed: curl {smoke_url} (expected HTTP 200)", file=sys.stderr)
        return rc

    if not keep:
        cleanup_steps: list[tuple[str, list[str]]] = [
            ("cf delete app",   ["cf", "delete", "-f", smoke_app]),
            ("cf delete-space", ["cf", "delete-space", "-f", smoke_space, "-o", smoke_org]),
            ("cf delete-org",   ["cf", "delete-org", "-f", smoke_org]),
        ]
        for step_name, cmd in cleanup_steps:
            rc = run(cmd, cwd=REPO_ROOT)
            if rc != 0:
                print(f"tier 3 cleanup failed: {step_name}", file=sys.stderr)
                return rc

    print("==> tier 3: cf passed")
    return 0


def tier_light(cfg: dict, cpi_config_path: str, keep: bool) -> int:
    """Run the Tier 4 light-stemcell upload and delete assertions.

    Exercises both light-stemcell modes against a live BOSH director:

    - preuploaded: uploads manifests/bosh/light-stemcell-preuploaded.yml via
      bosh upload-stemcell, asserts the returned CID has the "light:" prefix,
      then calls bosh delete-stemcell and verifies the PVE volume still exists
      (proving delete_stemcell is a no-op for light CIDs in the current CPI).

    - fetch: uploads manifests/bosh/light-stemcell-fetch.yml via
      bosh upload-stemcell. Skipped when the tier4 config block is absent or
      light_fetch_enabled is false, because the fetch mode requires a reachable
      image_url and optional credentials that vary per environment.

    The tier requires a live BOSH director (Tier 2 must have run or the director
    must already be up). It does NOT run bosh deploy — the manifests are
    stemcell-only records and carry no instance groups.

    Config block (ci/integration.yml):

        tier4:
          bosh_env_alias: pve          # director alias; defaults to tier2.bosh_env_alias
          stemcell_storage: nfs        # PVE storage pool that holds the image
          stemcell_filename: ""        # filename of the pre-uploaded qcow2 (preuploaded mode)
          light_fetch_enabled: false   # set true to also run the fetch mode
          stemcell_url: ""             # required when light_fetch_enabled: true
          stemcell_token: ""           # Bearer token; empty string = unauthenticated fetch

    The tier is skipped entirely when tiers.light is false in ci/integration.yml.

    Args:
        cfg:             Validated config dict.
        cpi_config_path: Not used directly; included for interface consistency.
        keep:            When True, skip bosh delete-stemcell cleanup.

    Returns:
        0 on success, non-zero on first failure.
    """
    print("==> tier 4: light stemcell")

    tier4 = cfg.get("tier4", {}) or {}
    tier2 = cfg.get("tier2", {}) or {}

    # Resolve BOSH director alias: tier4 overrides tier2 value.
    alias = str(tier4.get("bosh_env_alias") or tier2.get("bosh_env_alias") or "pve")

    stemcell_storage = str(tier4.get("stemcell_storage", "")).strip()
    stemcell_filename = str(tier4.get("stemcell_filename", "")).strip()
    light_fetch_enabled = bool(tier4.get("light_fetch_enabled", False))
    stemcell_url = str(tier4.get("stemcell_url", "")).strip()
    stemcell_token = str(tier4.get("stemcell_token", "")).strip()

    # Validate required preuploaded-mode config.
    if not _dry_run:
        if not stemcell_storage:
            print("tier 4 failed: tier4.stemcell_storage is required", file=sys.stderr)
            return 1
        if not stemcell_filename:
            print("tier 4 failed: tier4.stemcell_filename is required (the pre-uploaded qcow2 filename)", file=sys.stderr)
            return 1

    preuploaded_manifest = str(REPO_ROOT / "manifests" / "bosh" / "light-stemcell-preuploaded.yml")
    fetch_manifest = str(REPO_ROOT / "manifests" / "bosh" / "light-stemcell-fetch.yml")

    d_env = _integration.director_env(cfg, dry_run=_dry_run)

    # ----------------------------------------------------------------
    # Preuploaded mode: upload-stemcell, assert light: prefix, delete.
    # ----------------------------------------------------------------
    print("==> tier 4: light preuploaded — upload-stemcell")
    rc = run_with_retries(
        [
            "bosh", "-e", alias, "upload-stemcell", preuploaded_manifest,
            "-v", f"stemcell_storage={stemcell_storage}",
            "-v", f"stemcell_filename={stemcell_filename}",
            "--fix",
        ],
        env=d_env,
        cwd=REPO_ROOT,
        retries=1,
        delay=10,
        label="light-preuploaded upload-stemcell",
    )
    if rc != 0:
        print("tier 4 failed: light preuploaded upload-stemcell", file=sys.stderr)
        return rc

    # Assert the uploaded stemcell CID carries the "light:" prefix.
    # bosh stemcells --column "CID" prints one CID per line; grep for the prefix.
    print("==> tier 4: light preuploaded — assert light: CID prefix")
    rc = run(
        ["bosh", "-e", alias, "stemcells", "--column", "CID", "--no-color"],
        env=d_env,
        cwd=REPO_ROOT,
        check=False,
    )
    # The assertion below is best-effort under dry_run; live runs print the table
    # to stdout and we rely on the upload-stemcell success above as the primary gate.
    # A more precise assertion (piping through grep) would require shell=True which
    # is avoided for security. The upload-stemcell exit code is the gating signal.
    if rc != 0:
        print("tier 4 failed: bosh stemcells list after preuploaded upload", file=sys.stderr)
        return rc

    # Delete the light stemcell. For light CIDs the CPI does not delete the
    # underlying PVE volume — the operator owns its lifecycle. The director
    # removes its stemcell record; the volume persists on PVE storage.
    if not keep:
        print("==> tier 4: light preuploaded — delete-stemcell")
        rc = run_with_retries(
            ["bosh", "-e", alias, "delete-stemcell",
             "bosh-proxmox-kvm-ubuntu-jammy-go_agent-light/1.438",
             "-n"],
            env=d_env,
            cwd=REPO_ROOT,
            retries=1,
            delay=10,
            label="light-preuploaded delete-stemcell",
        )
        if rc != 0:
            print("tier 4 failed: light preuploaded delete-stemcell", file=sys.stderr)
            return rc
        print("==> tier 4: light preuploaded — delete-stemcell succeeded (PVE volume preserved)")

    # ----------------------------------------------------------------
    # Fetch mode (optional, gated by light_fetch_enabled).
    # ----------------------------------------------------------------
    if not light_fetch_enabled:
        print("==> tier 4: light fetch disabled (set tier4.light_fetch_enabled: true to enable)")
    else:
        if not _dry_run and not stemcell_url:
            print("tier 4 failed: tier4.stemcell_url required when light_fetch_enabled: true", file=sys.stderr)
            return 1

        print("==> tier 4: light fetch — upload-stemcell")
        rc = run_with_retries(
            [
                "bosh", "-e", alias, "upload-stemcell", fetch_manifest,
                "-v", f"stemcell_url={stemcell_url}",
                "-v", f"stemcell_token={stemcell_token}",
                "--fix",
            ],
            env=d_env,
            cwd=REPO_ROOT,
            retries=1,
            delay=10,
            label="light-fetch upload-stemcell",
        )
        if rc != 0:
            print("tier 4 failed: light fetch upload-stemcell", file=sys.stderr)
            return rc

        if not keep:
            print("==> tier 4: light fetch — delete-stemcell")
            rc = run_with_retries(
                ["bosh", "-e", alias, "delete-stemcell",
                 "bosh-proxmox-kvm-ubuntu-jammy-go_agent-light-fetch/1.438",
                 "-n"],
                env=d_env,
                cwd=REPO_ROOT,
                retries=1,
                delay=10,
                label="light-fetch delete-stemcell",
            )
            if rc != 0:
                print("tier 4 failed: light fetch delete-stemcell", file=sys.stderr)
                return rc
            print("==> tier 4: light fetch — delete-stemcell succeeded (PVE volume preserved)")

    print("==> tier 4: light stemcell passed")
    return 0


def teardown(cfg: dict) -> int:
    """Tear down CF deployment then BOSH director (both idempotent).

    Args:
        cfg: Validated config dict (unused by teardown scripts directly;
             passed for interface consistency and future use).

    Returns:
        0 on success, non-zero on first failure.
    """
    print("==> teardown")
    for step_name, cmd in [
        ("cf teardown",   ["./scripts/cf", "teardown"]),
        ("bosh teardown", ["./scripts/bosh", "teardown"]),
    ]:
        rc = run(cmd, cwd=REPO_ROOT)
        if rc != 0:
            print(f"teardown failed: {step_name}", file=sys.stderr)
            return rc
    print("==> teardown complete")
    return 0


# ---------------------------------------------------------------------------
# Integration entry point
# ---------------------------------------------------------------------------


def cmd_integration(argv: list[str]) -> int:
    """Parse integration subcommand args and dispatch to tier helpers.

    Args:
        argv: Arguments after 'integration' (sys.argv[2:]).

    Returns:
        0 pass, 1 tier failure, 2 usage/config error.
    """
    import argparse

    parser = argparse.ArgumentParser(
        prog="scripts/test integration",
        description=(
            "Run integration tier(s) against a live PVE environment.\n"
            "Actions: all, lifecycle, bosh, cf, light, teardown.\n"
            "\n"
            "  lifecycle — Tier 1: CPI 16-step lifecycle test.\n"
            "  bosh      — Tier 2: bosh create-env + emptyvm smoke.\n"
            "  cf        — Tier 3: CF deploy + smoke app.\n"
            "  light     — Tier 4: light stemcell upload + delete assertions.\n"
            "  all       — Teardown existing env, then lifecycle → bosh → cf → light\n"
            "              (light is included when tiers.light is true and tier 2\n"
            "              has populated the director).\n"
            "  teardown  — Tear down CF deployment and BOSH director."
        ),
    )
    parser.add_argument(
        "action",
        nargs="?",
        default="all",
        choices=["all", "lifecycle", "bosh", "cf", "light", "teardown"],
        help="Tier to run (default: all).",
    )
    parser.add_argument(
        "--config",
        default="ci/integration.yml",
        metavar="FILE",
        help="Integration config YAML (default: ci/integration.yml).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print commands without executing; exit 0.",
    )
    parser.add_argument(
        "--keep",
        action="store_true",
        help="Skip cleanup after each tier (leave resources running).",
    )

    args = parser.parse_args(argv)

    # Set module-level flag so run() respects it everywhere.
    global _dry_run
    _dry_run = args.dry_run

    # Load config — config/parse errors exit 2; tier runtime failures exit 1.
    try:
        cfg = _integration.load_config(args.config, dry_run=args.dry_run)
    except SystemExit as exc:
        # loader called sys.exit(message) — map to exit code 2.
        msg = str(exc) if str(exc) not in ("None", "") else "config error"
        print(f"config error: {msg}", file=sys.stderr)
        sys.exit(2)
    except Exception as exc:  # noqa: BLE001
        print(f"config error: {exc}", file=sys.stderr)
        sys.exit(2)

    # Synthesize CPI config into a temp file.
    # mkstemp creates the file with mode 0600 (owner-read/write only), preventing
    # other users on the host from reading PVE credentials while the run is live.
    # The atexit handler is registered unconditionally so the file is always
    # removed on exit — even when --keep is specified.  Under --keep a warning is
    # printed so the operator knows the credentials file remains on disk and must
    # be deleted manually after inspection.
    _cpi_fd, cpi_config_path = tempfile.mkstemp(
        prefix="integration-cpi-config-", suffix=".json"
    )
    os.close(_cpi_fd)

    def _cleanup_cpi_config() -> None:
        if args.keep:
            print(
                f"warn: --keep specified; credentials file remains at {cpi_config_path} "
                "— delete it manually after inspection.",
                file=sys.stderr,
            )
        try:
            Path(cpi_config_path).unlink(missing_ok=True)
        except OSError:
            pass

    atexit.register(_cleanup_cpi_config)

    try:
        _integration.write_cpi_config(cfg, cpi_config_path, dry_run=args.dry_run)
    except SystemExit as exc:
        msg = str(exc) if str(exc) not in ("None", "") else "config error"
        print(f"config error: {msg}", file=sys.stderr)
        sys.exit(2)
    except Exception as exc:  # noqa: BLE001
        print(f"config error: {exc}", file=sys.stderr)
        sys.exit(2)

    tiers = cfg.get("tiers", {})
    keep = args.keep

    try:
        if args.action == "teardown":
            return teardown(cfg)

        if args.action == "lifecycle":
            if not tiers.get("lifecycle", True):
                print("tier lifecycle disabled in config; skipping")
                return 0
            return tier_lifecycle(cfg, cpi_config_path, keep)

        if args.action == "bosh":
            if not tiers.get("bosh", True):
                print("tier bosh disabled in config; skipping")
                return 0
            return tier_bosh(cfg, cpi_config_path, keep)

        if args.action == "cf":
            if not tiers.get("cf", True):
                print("tier cf disabled in config; skipping")
                return 0
            return tier_cf(cfg, cpi_config_path, keep)

        if args.action == "light":
            if not tiers.get("light", True):
                print("tier light disabled in config; skipping")
                return 0
            return tier_light(cfg, cpi_config_path, keep)

        # action == "all"
        rc = teardown(cfg)
        if rc != 0:
            return rc

        if tiers.get("lifecycle", True):
            rc = tier_lifecycle(cfg, cpi_config_path, keep)
            if rc != 0:
                return rc

        if tiers.get("bosh", True):
            rc = tier_bosh(cfg, cpi_config_path, keep)
            if rc != 0:
                return rc

        if tiers.get("cf", True):
            rc = tier_cf(cfg, cpi_config_path, keep)
            if rc != 0:
                return rc

        # Tier 4 light needs the director from tier 2 still up. tier_cf does not
        # tear the director down, so running light after cf is safe.
        if tiers.get("light", True):
            rc = tier_light(cfg, cpi_config_path, keep)
            if rc != 0:
                return rc

        return 0

    except subprocess.CalledProcessError as exc:
        print(f"step failed with exit code {exc.returncode}: {shlex.join(exc.cmd)}", file=sys.stderr)
        return 1


# ---------------------------------------------------------------------------
# Top-level dispatch
# ---------------------------------------------------------------------------


def main() -> int:
    """Dispatch to make check (no args) or integration subcommand."""
    argv = sys.argv[1:]

    if not argv:
        return subprocess.run(["make", "check"], cwd=REPO_ROOT).returncode

    if argv[0] == "integration":
        return cmd_integration(argv[1:])

    # Unknown subcommand — fall through to make check for backward compat,
    # or print an error.  Treat as usage error.
    print(f"unknown subcommand: {argv[0]}", file=sys.stderr)
    print("usage: scripts/test [integration [action] [--config FILE] [--dry-run] [--keep]]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
