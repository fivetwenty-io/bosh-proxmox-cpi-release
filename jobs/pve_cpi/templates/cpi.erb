#!/bin/bash
set -euo pipefail

# Resolve paths relative to this script so the wrapper works for both
# director VM installs (/var/vcap/...) and `bosh create-env` host installs
# (~/.bosh/installations/<id>/...). BOSH create-env supplies its package
# location explicitly, including when --package-dir relocates the cache.
JOB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Compute the installation parent lexically. Appending /../.. to a job
# symlink would make the kernel resolve those parents inside data/jobs.
INSTALL_DIR="$(dirname "$(dirname "${JOB_DIR}")")"
# A caller that resolves symlinks before running us, such as sudo-rs, hands us
# the job's real directory, data/jobs/<job>/<hash>, one level deeper than the
# jobs/<job> link that names it.
case "${JOB_DIR}" in
  */data/jobs/*/*) INSTALL_DIR="${JOB_DIR%/data/jobs/*}" ;;
esac
PACKAGES_DIR="${BOSH_PACKAGES_DIR:-${INSTALL_DIR}/packages}"

BIN="${PACKAGES_DIR}/pve_cpi/bin/cpi"

if [ ! -x "${BIN}" ]; then
  printf '{"result":null,"error":{"type":"Bosh::Clouds::CloudError","message":"pve_cpi binary not found or not executable: %s — verify package compilation succeeded","ok_to_retry":false},"log":""}\n' "${BIN}" >&1
  exit 1
fi

cd "${JOB_DIR}" || exit 1

# An operator who runs bin/cpi --version gets the release version that the job
# config records, which the binary alone can't know. Every other invocation
# ignores its arguments, as BOSH passes none.
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
  exec "${BIN}" --version --config "${JOB_DIR}/config/cpi.json"
fi

exec "${BIN}" --config "${JOB_DIR}/config/cpi.json"
