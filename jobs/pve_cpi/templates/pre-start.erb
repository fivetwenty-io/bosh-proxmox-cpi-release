#!/bin/bash
set -euo pipefail

JOB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALL_DIR="$(dirname "$(dirname "${JOB_DIR}")")"
# A caller that resolves symlinks hands us data/jobs/<job>/<hash>, one level
# deeper than the jobs/<job> link that names it.
case "${JOB_DIR}" in
  */data/jobs/*/*) INSTALL_DIR="${JOB_DIR%/data/jobs/*}" ;;
esac
PACKAGES_DIR="${INSTALL_DIR}/packages"
exec "${PACKAGES_DIR}/pve_cpi/bin/cpi" provision-journal --config "${JOB_DIR}/config/cpi.json" --owner vcap
