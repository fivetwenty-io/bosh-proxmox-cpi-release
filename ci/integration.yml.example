# ci/integration.yml.example
#
# Non-secret integration test configuration for the BOSH PVE CPI release.
#
# Usage:
#   cp ci/integration.yml.example ci/integration.yml
#   # ci/integration.yml is gitignored — never commit it
#   # Edit ci/integration.yml with site-specific non-secret values
#
# Secrets are resolved at runtime via `bosh int` from:
#   manifests/bosh/vars.yml   — PVE host, user, node, storage names, network bridge
#   manifests/bosh/creds.yml  — BOSH admin_password, director_ssl.ca (generated by create-env)
#   manifests/cf/vars.yml     — system_domain
#
# NEVER put passwords, API tokens, certificates, or other secrets in this file.

# Which test tiers to run.
tiers:
  lifecycle: true   # Tier 1: CPI 16-step + 4 sub-steps lifecycle via scripts/lifecycle
  bosh:      true   # Tier 2: bosh create-env + cloud/runtime-config + emptyvm smoke
  cf:        true   # Tier 3: CF deploy + smoke app push + HTTP 200 assert
  light:     true   # Tier 4: light stemcell upload + delete assertions (run explicitly: integration light)

# Paths to secret manifest files (relative to repo root, all gitignored).
bosh_vars:  manifests/bosh/vars.yml   # PVE connection + sizing knobs
bosh_creds: manifests/bosh/creds.yml  # generated by bosh create-env
cf_vars:    manifests/cf/vars.yml     # CF-specific vars including system_domain

# Env bundle selector. When set, scripts/bosh layers
# manifests/envs/<env>/network.yml at create-env/delete-env and scripts/cf
# layers manifests/envs/<env>/cf-cloud-config.yml at update-cloud-config.
# Leave unset for the base 192.168.1.0/24 layout used by tier 1.
# Honored by reading BOSH_PVE_ENV from the process env; the harness exports
# it from this key.
env_name: ""                          # e.g. "lab" to layer manifests/envs/lab

# CPI release tarball path. When unset, scripts/bosh picks the newest tarball
# under dev_releases/bosh-pve-cpi/*.tgz; set when pointing at a release built
# outside the repo (Concourse artifact path). Honored as PVE_CPI_RELEASE_PATH.
cpi_release_path: ""

# Tier 1: CPI lifecycle test — isolated VMID range and network parameters.
tier1:
  vmid_range_start: 900            # First VMID reserved for integration tests
  vmid_range_end:   999            # Last VMID reserved — passed to the CPI, which validates start < end
  # The CPI requires the VM, persistent-disk, and stemcell-template VMID
  # ranges to be pairwise disjoint. If the lab's free band overlaps a CPI
  # default (disks [9000,29999], templates [30000,30999]), move those bands
  # too; absent keys keep the CPI defaults.
  # disk_vmid_range_start: 20200
  # disk_vmid_range_end:   20299
  # stemcell_template_vmid_range_start: 20300
  # stemcell_template_vmid_range_end:   20399
  network_ip:       192.168.1.250  # Static IP assigned to the test VM
  network_range:    192.168.1.0/24 # Subnet containing the test VM
  network_gateway:  192.168.1.1    # Default gateway for the test VM
  network_bridge:   vmbr0          # Proxmox bridge to attach the test VM
  network_dns:      [1.1.1.1]      # DNS resolvers passed to the test VM
  vm_cores:         1              # vCPUs for the test VM
  vm_memory_mib:    1024           # RAM for the test VM (MiB)
  disk_size_mib:    1024           # Persistent disk size (MiB)
  stemcell_path:    ""             # Absolute path to stemcell; or set STEMCELL_PATH env var

  # Snapshot/detach ordering (optional). The base lifecycle pass runs the clean
  # order: delete_snapshot before detach_disk (PVE refuses to detach a disk a
  # snapshot still references, so detach_disk's guard never fires). When true,
  # Tier 1 runs one extra pass (orthogonal to disk_storage_pools / network modes)
  # that detaches while the snapshot is present, using a CPI config with
  # allow_disk_ops_with_snapshots=true to exercise detach_disk's documented
  # guard-bypass path and the resulting unused-slot cleanup through delete_vm.
  # Default (absent/false) runs only the clean order.
  snapshot_detach_bypass: false

  # Multi-storage matrix (optional). When disk_storage_pools is non-empty, Tier 1
  # runs scripts/lifecycle once per pool, exercising all disk CPI methods against
  # each storage type. Each run is independently gated — a pool failure halts the
  # matrix. Default (empty list) runs lifecycle once using the pve_disk_storage pool
  # from bosh_vars, preserving the existing single-pool behavior.
  #
  # Set to the string `auto` to detect available local disk storage pools at run
  # time by querying the PVE host API. The harness keeps pools of type lvm,
  # lvmthin, zfspool, or dir that advertise images content and are not disabled.
  # Autodetect requires valid PVE credentials in bosh_vars (pve_api_token or
  # pve_password). In --dry-run mode, autodetect is skipped and a single lifecycle
  # run is performed.
  #
  # Required PVE storage pools for the full local matrix:
  #   lvm pool:     pvesm add lvm <name> --vgname <vg>
  #   lvmthin pool: pvesm add lvmthin <name> --vgname <vg> --thinpool <tp>
  #   zfspool:      pvesm add zfspool <name> --pool <zfs-dataset>
  #   dir pool:     pvesm add dir <name> --path <path>
  #                 (the 'local' pool is typically pre-existing)
  #
  # Example with all 4 local types (adjust pool names to match your PVE host):
  #   disk_storage_pools:
  #     - local-lvm
  #     - local-lvm-thin
  #     - local-zfs
  #     - local
  #
  # Example using autodetect:
  #   disk_storage_pools: auto
  disk_storage_pools: []

  # Network-handler matrix (optional). Exercises create_network / delete_network
  # — the BOSH CPI managed-network methods — against live PVE, with out-of-band
  # verification (scripts/_pve_verify.py confirms real cluster state, not just the
  # CPI's return values). When modes is non-empty, Tier 1 runs scripts/lifecycle
  # one extra pass per mode (independent of disk_storage_pools). Default (empty)
  # skips network testing entirely.
  #
  #   sdn        — create an SDN vnet (+ subnet) and attach the test VM to it.
  #                Needs an SDN-capable cluster. 'zone' must already exist unless
  #                the CPI config sets sdn_auto_manage_zone (then the zone is
  #                auto-created — with zone_type empty, as the CPI default vxlan).
  #                'range' should be an isolated CIDR that does not collide with
  #                the LAN; the test VM gets 'ip' within it (no external
  #                connectivity required for the lifecycle assertions).
  #   sdn-simple — the sdn pass with an explicit simple-zone opt-in
  #                (zone_type: simple), exercising the node-local zone path.
  #   bridge     — create a Linux bridge via the nodes API and attach the VM to
  #                it. CAUTION: this mutates node networking — use an UNUSED
  #                iface name.
  #
  # Set modes to the string `auto` to detect at run time which modes the PVE
  # host supports and run those (requires valid PVE credentials in bosh_vars):
  #   - sdn is selected when SDN is installed AND a usable zone is resolvable
  #     (the configured 'zone' exists -> reused and pinned; no 'zone' but zones
  #     exist -> first one adopted and pinned; configured 'zone' absent -> created
  #     and torn down via sdn_auto_manage_zone, once as the vxlan default and
  #     once as the sdn-simple opt-in — a host without vxlan support classifies
  #     the vxlan pass as SKIP). The sdn.vnet/range/gateway/ip values below must
  #     still be set for sdn to be runnable.
  #   - bridge is selected when bridge.iface is configured and not already present
  #     on the node (so the harness can cleanly create then delete it).
  # In --dry-run mode autodetect is skipped (no network passes are previewed).
  #
  # Examples:
  #   modes: [sdn, sdn-simple, bridge]
  #   modes: auto
  network_test:
    modes: []                   # [] = skip. Any mix of [sdn, sdn-simple, bridge], or auto
    sdn:
      zone:      ""             # pre-existing zone, or any name if sdn_auto_manage_zone
      zone_type: ""             # auto-create type; empty -> CPI default (vxlan)
      vnet:      itvnet         # 1-8 chars [a-z0-9]
      range:     10.250.0.0/24  # isolated test subnet (must not collide with LAN)
      gateway:   10.250.0.1     # gateway for the SDN subnet
      ip:        10.250.0.10    # test VM IP within range
    bridge:
      iface:     vmbr9          # UNUSED bridge iface to create then delete

  # Replicate the stemcell template to every cluster node (optional). Required
  # when the cluster has more than one node and stemcell_storage is node-local;
  # absent keeps the CPI default (false).
  # stemcell_replicate_local: true

  # Parked detached-disk strategy (optional). scripts/lifecycle drives a
  # detached disk through both pve.detached_disk_strategy settings and verifies
  # the resulting parker VM against the cluster. It runs by default, so this
  # block is only needed to turn it off or to move the parker VMID band away
  # from guests the lab already has there.
  #
  # The pass leaves its parker VM behind on purpose: a parker is durable
  # infrastructure that outlives any single disk, and later runs reuse it.
  # Removing one by hand needs the protection flag cleared first:
  #   qm set <parker-vmid> --protection 0 && qm destroy <parker-vmid> --purge
  parked_disk:
    enabled:     true           # false skips the pass entirely
    # Uncomment to move the parker band. These set the band in the generated
    # CPI config AND the band the pass verifies against, so the two cannot
    # disagree; a PARKER_RANGE_* env var that contradicts the CPI config aborts
    # the pass, because looking for parkers outside the band the CPI parks into
    # reads a real parker as an ordinary VM.
    # range_start: 91000
    # range_end:   91999

# Tier 2: BOSH director smoke test.
tier2:
  bosh_env_alias:  pve         # Alias registered via bosh alias-env
  deployment_name: emptyvm     # Name of the smoke deployment
  deploy_timeout_s: 1800       # Seconds to wait for the emptyvm deploy (VM
                               # create + agent bootstrap + update); default 1800

# Tier 3: CF deploy and smoke app test.
tier3:
  deployment_name: cf                # BOSH deployment name for CF
  smoke_org:       integration-smoke # CF org created for the smoke test
  smoke_space:     test              # CF space created for the smoke test
  smoke_app:       httpbin-smoke     # CF app name pushed for the smoke test
  smoke_timeout_s: 900               # Seconds to wait for CF deploy + app push

# BOSH Acceptance Tests (scripts/bats): network shape handed to the BATS
# cloud config. Requires the tier 2 director to be up (scripts/e2e bootstrap).
# cidr, gateway, and bridge default to the active env bundle's values
# (internal_cidr, internal_gw, pve_network_bridge), so only the address bands
# need declaring here. All four uncommented keys below are required; the bands
# must lie inside the env's internal_cidr, keep clear of the Director and any
# other reserved slots, and static_ip/second_static_ip must be two distinct
# addresses inside the static band. Example values match the cpitest env
# (172.31.0.0/24, Director .10, infra reserved below .20 and from .200 up).
bats:
  network_cidr:    ""             # Defaults to the env bundle's internal_cidr
  network_gateway: ""             # Defaults to the env bundle's internal_gw
  network_bridge:  ""             # Defaults to the env bundle's pve_network_bridge
  network_reserved:               # Addresses BATS VMs must never take
  - 172.31.0.1-172.31.0.19
  - 172.31.0.200-172.31.0.254
  network_static:                 # Static band BATS assigns addresses from
  - 172.31.0.190-172.31.0.199
  static_ip:        172.31.0.190  # Primary static IP (inside the static band)
  second_static_ip: 172.31.0.191  # Redeploy target; same band, different address
  # Dual stack (optional). Setting network_cidr_ipv6 adds a second manual
  # network named `ipv6` to bat.yml and lets `./scripts/bats run --only ipv6`
  # deploy a job on both networks. The other four ipv6 keys are then
  # required. Both networks get the same nic_group, so the director places
  # them on one interface and the CPI writes a single dual-stack ipconfig
  # entry. The bridge is shared with the IPv4 network. Keep the static band
  # small: the director enumerates every address in it, while reserved bands
  # collapse to CIDRs. That pass is opt-in, not part of a default run: the
  # agent writes one systemd-networkd file per static interface
  # configuration, so a second static address on a shared NIC overwrites the
  # first and the VM never reaches the Director. See docs/certification/bats.md.
  network_cidr_ipv6:    ""        # e.g. fd36:afd4:2c42:1::/64; empty = IPv4 only
  network_gateway_ipv6: ""        # e.g. fd36:afd4:2c42:1::1
  network_reserved_ipv6: []       # e.g. [fd36:afd4:2c42:1::-fd36:afd4:2c42:1::48:18f]
  network_static_ipv6:   []       # e.g. [fd36:afd4:2c42:1::48:190-fd36:afd4:2c42:1::48:19f]
  static_ip_ipv6:       ""        # e.g. fd36:afd4:2c42:1::48:190
  nic_group:        1             # Shared by both networks. Numeric: the
                                  # director coerces nic_group with to_i, so a
                                  # name would collapse to 0
  cpi_id:           ""            # cpi-config entry name for the BATS AZ;
                                  # REQUIRED when the director has a cpi-config
                                  # applied (e.g. pve-az1), empty otherwise
  vm_cores:      2                # Sizing for the BATS `default` vm_type
  vm_memory_mib: 2048
  vm_disk_mib:   8192
  exclude_tags:  []               # Extra rspec tag exclusions on top of the
                                  # built-in PVE set (see docs/certification/bats.md)
  rspec_timeout_s: 14400          # Wall-clock ceiling for the rspec run

# BOSH Director Upgrade Test (scripts/certify).
# Run with: make certify-upgrade  /  ./scripts/certify upgrade --env <env>
#
# DESTRUCTIVE: the run takes over this repo's Director slot. It deploys a
# Director on the previous CPI release, deploys the upstream certification
# release under it, upgrades the Director in place onto the new CPI release,
# recreates the deployment, and tears everything down. See
# docs/certification/upgrade.md.
certification:
  deployment_name: certification  # BOSH deployment name (default: certification)
  release_name:    certification  # BOSH release name (default: certification)
  az:              z1             # Cloud-config AZ the deployment lands in
  network_name:    default        # Cloud-config network name
  disk_type:       default        # Cloud-config disk_type for the persistent disk
  network_bridge:  ""             # Defaults to the env bundle's pve_network_bridge
  cpi_id:          ""             # cpi-config entry name for the AZ;
                                  # REQUIRED when the director has a cpi-config
                                  # applied (e.g. pve-az1), empty otherwise
  vm_cores:      2                # Sizing for the `certification` vm_type
  vm_memory_mib: 2048
  vm_disk_mib:   8192
  old_cpi_version: ""             # Empty = N-1 of the published GitHub releases
  new_cpi_version: ""             # Empty = N, the latest published release
  timeout_s: 7200                 # Wall-clock ceiling for the whole run

# Tier 4: Light stemcell upload + delete assertions.
# Run with: ./scripts/test integration light
#
# Exercises both light-stemcell modes against a live BOSH director.
# Tier 2 (bosh create-env) must have run first, or the director must already
# be up. This tier does NOT run bosh deploy — manifests are stemcell-only.
#
# Preuploaded mode always runs; fetch mode requires light_fetch_enabled: true
# plus a reachable stemcell_url.
tier4:
  bosh_env_alias:       ""      # Director alias; defaults to tier2.bosh_env_alias when empty
  stemcell_storage:     ""      # PVE storage pool holding the pre-uploaded qcow2
                                # (e.g. "nfs-stemcells", "ceph-fs", "local")
  stemcell_filename:    ""      # Filename of the pre-uploaded qcow2, no path prefix
                                # (e.g. "ubuntu-jammy-1.438.qcow2")
  light_fetch_enabled:  false   # Set true to also run the CPI-assisted fetch mode
  stemcell_url:         ""      # Remote qcow2 URL; required when light_fetch_enabled: true
  stemcell_token:       ""      # Bearer token for authenticated fetch; empty = no auth
