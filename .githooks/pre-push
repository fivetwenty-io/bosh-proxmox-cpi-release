#!/bin/sh
# Pre-push gate: run `make ci`, which runs the CI workflows' checks inside the
# workflows' own digest-pinned golang image under Docker. That covers the
# linear-history and AI-attribution checks over the commits being pushed, the
# `make check` gate, and the security scans when the push changes Go source,
# go.mod, go.sum, vendor/, package.json, package-lock.json, any Dockerfile,
# .github/workflows/security.yml, or the root Makefile. A push that passes here should pass CI.
# Docker has to be running, and the hook fails with a message when it is not.
#
# Git feeds this hook one "<local ref> <local sha> <remote ref> <remote sha>"
# line per ref being pushed; we hand the shas to `make ci` as CI_RANGES.
# Install with `make hooks`. Bypass once with SKIP_CHECKS=1 git push
# (or git push --no-verify). Force the security scans with CI_SECURITY=1.

if [ -n "$SKIP_CHECKS" ]; then
    echo "pre-push: SKIP_CHECKS set, skipping make ci" >&2
    exit 0
fi

head_sha=$(git rev-parse HEAD 2>/dev/null)
zero=0000000000000000000000000000000000000000
ranges=
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    # A branch or tag deletion pushes no commits, so it needs neither Docker
    # nor the gate.
    [ "$local_sha" = "$zero" ] && continue
    # Compare commits, not raw shas, so an annotated tag of HEAD does not warn.
    local_commit=$(git rev-parse --verify --quiet "$local_sha^{commit}" 2>/dev/null)
    # A ref whose commit origin/main, or the remote sha, already reaches pushes
    # nothing new, so it needs no Docker.
    if [ -n "$local_commit" ]; then
        if git merge-base --is-ancestor "$local_commit" origin/main 2>/dev/null; then
            continue
        fi
        if [ "$remote_sha" != "$zero" ] && git merge-base --is-ancestor "$local_commit" "$remote_sha" 2>/dev/null; then
            continue
        fi
    fi
    if [ -n "$head_sha" ] && [ "$local_commit" != "$head_sha" ]; then
        echo "pre-push: warning: pushing $local_sha but HEAD is $head_sha; make ci tests the checked-out tree, not the pushed ref." >&2
    fi
    ranges="${ranges}${remote_sha} ${local_sha}
"
done

if [ -z "$ranges" ]; then
    exit 0
fi

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    echo "pre-push: Docker is not running, and make ci needs it to run CI's checks in CI's image." >&2
    echo "pre-push: start Docker and push again, or bypass with SKIP_CHECKS=1 git push." >&2
    exit 1
fi

echo "pre-push: running make ci (SKIP_CHECKS=1 git push to bypass)" >&2
CI_RANGES=$ranges
export CI_RANGES
exec make ci
