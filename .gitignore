# Go build artifacts
bin/
*.test
*.out
coverage.html
coverage.xml
src/pve_cpi/coverage.out
src/pve_cpi/coverage.html

# Editor
.DS_Store
*.swp
*.bak
*.log
*~
.ruby-lsp/

# Local
.envrc
.env

# bosh create-env workflow
manifests/vars.yml
manifests/state.json
manifests/creds.yml

# BOSH CPI deployment secrets — explicit paths for defense-in-depth
# Bare-filename patterns above already catch these; explicit entries prevent
# rename/move from accidentally unmasking them.
manifests/bosh/vars.yml
manifests/bosh/creds.yml

# BOSH release artifacts
blobs/
dev_releases/
.dev_builds/
.final_builds/
bosh-pve-cpi-*.tgz
tmp/
creds.yml
creds.yml.*
vars.yml
state.json
state.json.*

# Compiled-release pipeline (scripts/bosh compile-releases): large tarballs and
# the environment-specific generated ops file pinning them.
compiled_releases/
manifests/bosh/compiled-releases.yml
manifests/cf/compiled-releases.yml

# Artifacts VM (scripts/artifacts): runtime state carries the generated RustFS
# secret key, and the dedicated SSH keypair is host-local. The git-tracked,
# secret-free overrides live in manifests/envs/<env>/artifacts.yml.
manifests/envs/*/artifacts-state.json
manifests/envs/*/artifacts_ssh
manifests/envs/*/artifacts_ssh.pub

# Integration test generated config (secrets resolved at runtime)
ci/integration.yml
ci/params.yml
ci/cpi-config.json
/src/pve_cpi/cpi

# e2e runner results (timing, results.json, junit.xml)
.e2e-results/

# auto-managed upstream checkouts (bosh-deployment, cf-deployment)
.deps/

# Slidev presentation build artifacts
docs/presentations/**/dist/
docs/presentations/**/node_modules/
docs/presentations/**/*.pdf
docs/presentations/**/.slidev/
bun.lock

# Architecture HTML build (generated from docs/architecture/*.md)
docs/architecture/index.html
docs/architecture/node_modules/
node_modules

# Locally built operator CLI (go build ./cmd/pve-cid)
src/pve_cpi/pve-cid
