# ci/integration.yml.example
#
# Non-secret integration test configuration for the BOSH PVE CPI release.
#
# Usage:
#   cp ci/integration.yml.example ci/integration.yml
#   # ci/integration.yml is gitignored — never commit it
#   # Edit ci/integration.yml with site-specific non-secret values
#
# Secrets are resolved at runtime via `bosh int` from:
#   manifests/bosh/vars.yml   — PVE host, user, node, storage names, network bridge
#   manifests/bosh/creds.yml  — BOSH admin_password, director_ssl.ca (generated by create-env)
#   manifests/cf/vars.yml     — system_domain
#
# NEVER put passwords, API tokens, certificates, or other secrets in this file.

# Which test tiers to run.
tiers:
  lifecycle: true   # Tier 1: CPI 16-step + 4 sub-steps lifecycle via scripts/lifecycle
  bosh:      true   # Tier 2: bosh create-env + cloud/runtime-config + emptyvm smoke
  cf:        true   # Tier 3: CF deploy + smoke app push + HTTP 200 assert

# Paths to secret manifest files (relative to repo root, all gitignored).
bosh_vars:  manifests/bosh/vars.yml   # PVE connection + sizing knobs
bosh_creds: manifests/bosh/creds.yml  # generated by bosh create-env
cf_vars:    manifests/cf/vars.yml     # CF-specific vars including system_domain

# Tier 1: CPI lifecycle test — isolated VMID range and network parameters.
tier1:
  vmid_range_start: 900            # First VMID reserved for integration tests
  vmid_range_end:   999            # Reserved/informational — range enforcement uses vmid_range_start only
  network_ip:       192.168.1.250  # Static IP assigned to the test VM
  network_range:    192.168.1.0/24 # Subnet containing the test VM
  network_gateway:  192.168.1.1    # Default gateway for the test VM
  network_bridge:   vmbr0          # Proxmox bridge to attach the test VM
  network_dns:      [1.1.1.1]      # DNS resolvers passed to the test VM
  vm_cores:         1              # vCPUs for the test VM
  vm_memory_mib:    1024           # RAM for the test VM (MiB)
  disk_size_mib:    1024           # Persistent disk size (MiB)
  stemcell_path:    ""             # Absolute path to stemcell; or set STEMCELL_PATH env var

  # Snapshot/detach ordering (optional). The base lifecycle pass runs the clean
  # order: delete_snapshot before detach_disk (PVE refuses to detach a disk a
  # snapshot still references, so detach_disk's guard never fires). When true,
  # Tier 1 runs one extra pass (orthogonal to disk_storage_pools / network modes)
  # that detaches while the snapshot is present, using a CPI config with
  # allow_disk_ops_with_snapshots=true to exercise detach_disk's documented
  # guard-bypass path and the resulting unused-slot cleanup through delete_vm.
  # Default (absent/false) runs only the clean order.
  snapshot_detach_bypass: false

  # Multi-storage matrix (optional). When disk_storage_pools is non-empty, Tier 1
  # runs scripts/lifecycle once per pool, exercising all disk CPI methods against
  # each storage type. Each run is independently gated — a pool failure halts the
  # matrix. Default (empty list) runs lifecycle once using the pve_disk_storage pool
  # from bosh_vars, preserving the existing single-pool behavior.
  #
  # Set to the string `auto` to detect available local disk storage pools at run
  # time by querying the PVE host API. The harness keeps pools of type lvm,
  # lvmthin, zfspool, or dir that advertise images content and are not disabled.
  # Autodetect requires valid PVE credentials in bosh_vars (pve_api_token or
  # pve_password). In --dry-run mode, autodetect is skipped and a single lifecycle
  # run is performed.
  #
  # Required PVE storage pools for the full local matrix:
  #   lvm pool:     pvesm add lvm <name> --vgname <vg>
  #   lvmthin pool: pvesm add lvmthin <name> --vgname <vg> --thinpool <tp>
  #   zfspool:      pvesm add zfspool <name> --pool <zfs-dataset>
  #   dir pool:     pvesm add dir <name> --path <path>
  #                 (the 'local' pool is typically pre-existing)
  #
  # Example with all 4 local types (adjust pool names to match your PVE host):
  #   disk_storage_pools:
  #     - local-lvm
  #     - local-lvm-thin
  #     - local-zfs
  #     - local
  #
  # Example using autodetect:
  #   disk_storage_pools: auto
  disk_storage_pools: []

  # Network-handler matrix (optional). Exercises create_network / delete_network
  # — the BOSH CPI managed-network methods — against live PVE, with out-of-band
  # verification (scripts/_pve_verify.py confirms real cluster state, not just the
  # CPI's return values). When modes is non-empty, Tier 1 runs scripts/lifecycle
  # one extra pass per mode (independent of disk_storage_pools). Default (empty)
  # skips network testing entirely.
  #
  #   sdn    — create an SDN vnet (+ subnet) and attach the test VM to it. Needs
  #            an SDN-capable cluster. 'zone' must already exist unless the CPI
  #            config sets sdn_auto_manage_zone (then the zone is auto-created).
  #            'range' should be an isolated CIDR that does not collide with the
  #            LAN; the test VM gets 'ip' within it (no external connectivity
  #            required for the lifecycle assertions).
  #   bridge — create a Linux bridge via the nodes API and attach the VM to it.
  #            CAUTION: this mutates node networking — use an UNUSED iface name.
  #
  # Set modes to the string `auto` to detect at run time which modes the PVE
  # host supports and run those (requires valid PVE credentials in bosh_vars):
  #   - sdn is selected when SDN is installed AND a usable zone is resolvable
  #     (the configured 'zone' exists -> reused and pinned; no 'zone' but zones
  #     exist -> first one adopted and pinned; configured 'zone' absent -> created
  #     and torn down via sdn_auto_manage_zone). The sdn.vnet/range/gateway/ip
  #     values below must still be set for sdn to be runnable.
  #   - bridge is selected when bridge.iface is configured and not already present
  #     on the node (so the harness can cleanly create then delete it).
  # In --dry-run mode autodetect is skipped (no network passes are previewed).
  #
  # Examples:
  #   modes: [sdn, bridge]
  #   modes: auto
  network_test:
    modes: []                   # [] = skip. [sdn], [bridge], [sdn, bridge], or auto
    sdn:
      zone:      ""             # pre-existing zone, or any name if sdn_auto_manage_zone
      zone_type: simple         # used only when the zone is auto-created
      vnet:      itvnet         # 1-8 chars [a-z0-9]
      range:     10.250.0.0/24  # isolated test subnet (must not collide with LAN)
      gateway:   10.250.0.1     # gateway for the SDN subnet
      ip:        10.250.0.10    # test VM IP within range
    bridge:
      iface:     vmbr9          # UNUSED bridge iface to create then delete

# Tier 2: BOSH director smoke test.
tier2:
  bosh_env_alias:  pve         # Alias registered via bosh alias-env
  deployment_name: emptyvm     # Name of the smoke deployment
  smoke_timeout_s: 300         # Seconds to wait for emptyvm deploy to complete

# Tier 3: CF deploy and smoke app test.
tier3:
  deployment_name: cf                # BOSH deployment name for CF
  smoke_org:       integration-smoke # CF org created for the smoke test
  smoke_space:     test              # CF space created for the smoke test
  smoke_app:       httpbin-smoke     # CF app name pushed for the smoke test
  smoke_timeout_s: 900               # Seconds to wait for CF deploy + app push
