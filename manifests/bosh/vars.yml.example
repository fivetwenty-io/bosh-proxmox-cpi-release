---
# Copy to vars.yml and fill in. Do not commit vars.yml (contains secrets).

# --- PVE target -----------------------------------------------------------
pve_host:            pve.example.com
pve_port:            8006
pve_user:            root@pam
pve_password:        REPLACE_ME
# Optional: API token alternative to password auth. Provide exactly one of
# pve_password or pve_api_token; leave the other empty string.
# Format: <user>!<token-id>=<uuid>  e.g. root@pam!bosh-cpi=8b452463-0990-409a-9b24-3920cb778ef3
pve_api_token:       ""
pve_node:            pve1
pve_vm_storage:      local-lvm
pve_disk_storage:    local-lvm
pve_stemcell_storage: local
# Set true on multi-node clusters whose vm_storage is node-local (the
# stemcell cache template's disk lives on vm_storage; clones need it
# present on the target node). Single-node or shared vm_storage: false.
pve_stemcell_replicate_local: false
# Storage pool (dir/nfs/cifs with iso content enabled) for per-VM cloud-init ISOs.
# Block storages (lvm/lvmthin/zfspool) cannot hold ISO files; use "local" or a
# dedicated NFS/CIFS ISO store. Must match a storage visible on all cluster nodes.
pve_iso_storage:     local
pve_network_bridge:  vmbr0
pve_verify_ssl:      true

# --- VM naming ------------------------------------------------------------
# Prefix prepended to every CPI-provisioned VM's PVE name. With prefix "cpi"
# names take the form "cpi-<deployment>-<job>-<index>" (e.g. "cpi-cf-api-0").
# Leave empty to omit the prefix; deployment + job + index are always included.
pve_vm_prefix:       cpi
# Synthetic deployment name used in VM names for `bosh create-env` directors
# (bosh-init does not pass a deployment in env). Defaults to "create-env".
pve_create_env_deployment: create-env

# --- Director VM sizing ---------------------------------------------------
director_cpu:    2
director_memory: 4096
director_disk:   32768

# --- Director network -----------------------------------------------------
internal_cidr: 192.168.1.0/24
internal_gw:   192.168.1.1
internal_ip:   192.168.1.10

# --- Release + stemcell ---------------------------------------------------
# pve_cpi_release_path and pve_cpi_release_name are supplied by scripts/bosh
# at deploy time via -v (the name is read from the tarball's release.MF:
# bosh-proxmox-cpi for current builds, bosh-pve-cpi for published tarballs
# through v0.4.0).
# Discovery order:
#   1. PVE_CPI_RELEASE_PATH env var (set by Concourse to the artifact input
#      path; set locally to point at a custom build);
#   2. else the newest tarball under dev_releases/bosh-proxmox-cpi/*.tgz by mtime
#      (what `scripts/create-release dev` produces).
# Override at deploy time when you want a specific build:
#   PVE_CPI_RELEASE_PATH=/abs/path/to/bosh-proxmox-cpi-VERSION.tgz \
#     ./scripts/bosh create-env

# Ubuntu jammy openstack-kvm stemcell (works on PVE qemu/kvm).
# Get latest from https://bosh.io/stemcells/bosh-openstack-kvm-ubuntu-jammy-go_agent
stemcell_url:  https://bosh.io/d/stemcells/bosh-openstack-kvm-ubuntu-jammy-go_agent?v=1.999
stemcell_sha1: REPLACE_WITH_PUBLISHED_SHA1

# --- Light stemcell -------------------------------------------------------
# All deployment paths (create-env, cf, e2e) use a light stemcell. The qcow2 is
# derived once from stemcell_url above (download -> extract -> normalize ->
# upload to PVE storage), then referenced by volid (preuploaded) or fetched by
# the CPI at create_stemcell time (fetch). OS + version stay identical to
# stemcell_url, so the compiled-release cache keyed to that stemcell stays valid.
#   preuploaded — scripts place the qcow2 on PVE storage; no per-stemcell fetch.
#   fetch       — the CPI streams the qcow2 from stemcell_fetch_url on demand.
light_stemcell_mode:  preuploaded   # preuploaded | fetch
stemcell_fetch_url:   ""            # fetch mode only: remote qcow2 URL
stemcell_fetch_token: ""            # fetch mode only: optional bearer token

# --- Director identity ----------------------------------------------------
director_name: bosh-pve

# --- Newly wired properties ----------------------------------------------
# These keys map 1:1 to job spec defaults; override only when you need to
# deviate from the spec-declared default. Each comment lists the spec default.

# Network mode for create_network / delete_network handlers.
# One of: auto | sdn | bridge. Spec default: auto.
pve_network_mode:               auto

# Default PVE SDN zone for vnet creation when cloud_properties.zone is absent.
# Spec default: "" (per-call zone required when network_mode resolves to sdn).
pve_sdn_zone:                   ""

# SDN zone type used when the CPI auto-creates a zone.
# One of: simple | vlan | qinq | vxlan | evpn. Spec default: simple.
pve_sdn_zone_type:              simple

# When true the CPI manages zone create/delete lifecycle in addition to vnets.
# Spec default: false (operator owns zones; CPI owns only vnets).
pve_sdn_auto_manage_zone:       false

# VMID allocation window for create_vm. Persistent disks always use 9000-9999.
# Spec defaults: 100 / 5999.
pve_vmid_range_start:           100
pve_vmid_range_end:             5999

# Snapshot pre-flight guards on attach_disk / detach_disk / resize_disk.
# Spec defaults: both false (guard active, fail-open on probe failure).
pve_allow_disk_ops_with_snapshots: false
pve_require_snapshot_check_pass:   false

# Hotplug flags applied to every new VM. Comma-separated subset of
# network,disk,cpu,memory,usb,cloudinit (or "0" to disable). Spec default:
# "network,disk,cpu,memory".
pve_hotplug:                    "network,disk,cpu,memory"

# Enable NUMA at VM create time. Required for live memory hot-add.
# Spec default: true.
pve_numa:                       true

# reboot_vm behavior. One of: soft | hard. Spec default: soft.
pve_reboot_mode:                soft

# Seconds soft reboot waits for graceful ACPI shutdown before hard reset.
# Range 1-3600. Spec default: 60.
pve_reboot_timeout:             60

# Agent transport. The NATS URL is computed from ((internal_ip)) inside
# cpi.yml at manifest-render time, so no agent_mbus var is needed here.
# Only the (typically empty) blobstore overrides surface as a var.
pve_agent_blobstore:            {}
