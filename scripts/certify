# cleanup-refs bounds. The step timeout in certification.yml must cover
# REFS_WORST_CASE_S: one liveness probe, one `make bin/cpi`, a prune for each
# of REFS_MAX_DIRECTORS recorded Directors, and a `bosh clean-up --all` that
# runs twice because it retries once. With the values below that is
# 300 + 900 + 4*900 + 2*1800 = 8400 s, which is 140 minutes.
REFS_CLEANUP_TIMEOUT_S = 1800
REFS_PRUNE_TIMEOUT_S = 900
REFS_BUILD_TIMEOUT_S = 900
REFS_MAX_DIRECTORS = 4
REFS_WORST_CASE_S = (
    SHORT_TIMEOUT_S + REFS_BUILD_TIMEOUT_S + REFS_MAX_DIRECTORS * REFS_PRUNE_TIMEOUT_S
    + 2 * REFS_CLEANUP_TIMEOUT_S
)

BOSH_IO_RELEASE = "https://bosh.io/d/github.com/cloudfoundry/bosh?v={version}"


# --------------------------------------------------------------------------- #
# Small helpers
# --------------------------------------------------------------------------- #

def prune_refusal_reason(lines: "list[str]") -> str:
    """Return the reason from the last `refused: ` line a prune printed, or "".

    `cpi stemcell-refs prune --apply` prints the reason it refused on one
    stderr line that starts with `refused: `, after the plan. The step's
    output tail holds the combined stdout and stderr, so the last such line
    is the one the refusal wrote. Any other failure, such as a timeout or a
    failed PVE call, leaves no such line and returns "".
    """
    for line in reversed(lines):
        text = line.strip()
        if text.startswith("refused: "):
            return " ".join(text[len("refused: "):].split())
    return ""


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


# --------------------------------------------------------------------------- #
# Config
# --------------------------------------------------------------------------- #

# The default version matrix is N and N-1 of the published GitHub releases,
# resolved at run time. Pinning literals here would rot the moment a release
# is cut; "the last two releases" is the matrix operators actually upgrade
# along, and it stays true without anyone editing this file.
_VERSION_RE = re.compile(r"^v?\d+\.\d+\.\d+$")


def gh_release_versions(limit: int = 20) -> list[str]:
    """Published X.Y.Z release versions, newest first.

    Reads the repo's GitHub releases rather than local git tags: a tag with no
    published release has no downloadable tarball, so it is not a version this
    test can upgrade from or to.
    """
    if shutil.which("gh") is None:
        raise RuntimeError("gh is not on PATH; cannot resolve the release matrix")
    proc = subprocess.run(
        ["gh", "release", "list", "--limit", str(limit), "--json", "tagName,isDraft"],
        cwd=str(REPO_ROOT), capture_output=True, text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(f"gh release list failed:\n{proc.stderr.strip()}")
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"gh release list returned unparseable JSON: {exc}") from exc

    versions: list[tuple[tuple[int, int, int], str]] = []
    for row in rows:
        if row.get("isDraft"):
            continue
        tag = str(row.get("tagName", "")).strip()
        if not _VERSION_RE.match(tag):
            continue
        version = tag.lstrip("v")
        major, minor, patch = (int(part) for part in version.split("."))
        versions.append(((major, minor, patch), version))
    versions.sort(reverse=True)
    return [v for _, v in versions]


def resolve_version_matrix(old_spec: str, new_spec: str) -> "tuple[str, str, bool]":
    """Fill unset CPI legs from the published releases: new = N, old = N-1.

    Returns (old, new, auto_resolved). An explicit flag or config value on
    either side is left alone, so a run can pin one leg and let the other
    follow the releases.
    """
    if old_spec and new_spec:
        return old_spec, new_spec, False
    versions = gh_release_versions()
    if len(versions) < 2:
        raise RuntimeError(
            "fewer than two published releases; pass --old-cpi and --new-cpi "
            f"explicitly (found: {', '.join(versions) or 'none'})"
        )
    return (old_spec or versions[1]), (new_spec or versions[0]), True


_AZ_ENTRY_KEYS = frozenset({"az", "cpi_id", "network", "bridge", "storage"})
_NETWORK_KEYS = frozenset({"cidr", "gateway", "reserved"})
# A bridge name or a storage ID: it starts with a letter, so `bosh -v` can
# never read it as a number, and it holds nothing a shell or YAML would act on.
_NAME_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_.-]*$")


def certification_azs(section: dict, primary_az: str, primary_cpi_id: str) -> list[dict]:
    """Resolve `certification.azs`, the AZs the certification deployment spans.

    Left unset, it is today's single entry: the `az` and `cpi_id` keys, no
    network of its own, because the base cloud config supplies the subnet.
    Every output of a one-entry run is then what it was before the key existed.

    A two-entry list makes one deployment span two clusters. The first entry is
    the primary AZ the base cloud config already defines. The second must be
    z2, the name cloud-config-cpi2-ops.yml adds, and carries the subnet on the
    other cluster plus two optional overrides, `bridge` and `storage`, that let
    a run use names that differ from the first cluster's.
    """
    raw = section.get("azs")
    if raw is None or raw == []:
        return [{"az": primary_az, "cpi_id": primary_cpi_id, "network": None,
                 "bridge": "", "storage": ""}]
    if not isinstance(raw, list) or not all(isinstance(e, dict) for e in raw):
        sys.exit("config key `certification.azs` must be a list of mappings "
                 "(see ci/integration.yml.example)")
    if len(raw) > 2:
        sys.exit("certification.azs lists %d entries; the run spans one or two clusters" % len(raw))

    entries: list[dict] = []
    for i, item in enumerate(raw):
        where = f"certification.azs[{i}]"
        unknown = sorted(set(item) - _AZ_ENTRY_KEYS)
        if unknown:
            sys.exit(f"{where} has unknown keys: {', '.join(unknown)}")
        az = str(item.get("az") or "").strip()
        if not az:
            sys.exit(f"{where}.az is required")
        entries.append({
            "az": az,
            "cpi_id": str(item.get("cpi_id") or "").strip(),
            "network": item.get("network"),
            "bridge": str(item.get("bridge") or "").strip(),
            "storage": str(item.get("storage") or "").strip(),
        })

    first = entries[0]
    if section.get("az") and str(section["az"]) != first["az"]:
        sys.exit(f"certification.az {section['az']!r} disagrees with certification.azs[0].az "
                 f"{first['az']!r}; set only one of them")
    if section.get("cpi_id") and str(section["cpi_id"]).strip() != first["cpi_id"]:
        sys.exit(f"certification.cpi_id {section['cpi_id']!r} disagrees with certification.azs[0].cpi_id "
                 f"{first['cpi_id']!r}; set only one of them")
    for key in ("network", "bridge", "storage"):
        if first[key]:
            sys.exit(f"certification.azs[0].{key} is not supported: the first AZ comes from the "
                     "Director's base cloud config, which uses the job's bridge and storage")
    first["network"] = None
    if len(entries) == 1:
        return entries

    second = entries[1]
    if second["az"] != _spanning.SECONDARY_AZ:
        sys.exit(f"certification.azs[1].az must be {_spanning.SECONDARY_AZ}, the AZ "
                 "manifests/certification/cloud-config-cpi2-ops.yml adds")
    if second["az"] == first["az"]:
        sys.exit("certification.azs names the same AZ twice")
    if not first["cpi_id"] or not second["cpi_id"]:
        sys.exit("certification.azs needs a cpi_id on both entries: a Director with a cpi-config "
                 "rejects an AZ that names no entry")
    if first["cpi_id"] == second["cpi_id"]:
        sys.exit("certification.azs binds both AZs to one cpi-config entry; a spanning run needs two")
    second["network"] = _certification_network(second["network"])
    for key in ("bridge", "storage"):
        if second[key] and not _NAME_RE.match(second[key]):
            sys.exit(f"certification.azs[1].{key} {second[key]!r} is not a valid name")
    return entries


def _certification_network(raw: object) -> dict:
    """Validate the second entry's subnet and return it as cidr, gateway, reserved."""
    if not isinstance(raw, dict):
        sys.exit("certification.azs[1].network is required: a mapping with cidr, gateway, and reserved")
    unknown = sorted(set(raw) - _NETWORK_KEYS)
    if unknown:
        sys.exit(f"certification.azs[1].network has unknown keys: {', '.join(unknown)}")
    missing = sorted(k for k in _NETWORK_KEYS if not raw.get(k))
    if missing:
        sys.exit(f"missing required config key: certification.azs[1].network.{missing[0]}")
    try:
        network = ipaddress.ip_network(str(raw["cidr"]), strict=True)
        gateway = ipaddress.ip_address(str(raw["gateway"]))
    except ValueError as exc:
        sys.exit(f"certification.azs[1].network holds an invalid address: {exc}")
    if gateway not in network:
        sys.exit(f"certification.azs[1].network.gateway {gateway} is outside {network}")
    reserved = raw["reserved"]
    if not isinstance(reserved, list) or not all(isinstance(r, str) and r.strip() for r in reserved):
        sys.exit("certification.azs[1].network.reserved must be a list of addresses or ranges")
    return {"cidr": str(network), "gateway": str(gateway), "reserved": [r.strip() for r in reserved]}


def certification_config(cfg: dict, env_name: str, dry_run: bool) -> dict:
    """Resolve the `certification:` section of ci/integration.yml.

    Everything with a sensible lab-wide answer defaults from the active env
    bundle, matching how the `bats:` section behaves. Only cpi_id has no
    default: a Director with a cpi-config applied rejects an AZ that names no
    entry, and one without rejects an AZ that names one, so the operator must
    say which shape the lab is in.
    """
    section = cfg.get("certification") or {}
    if not isinstance(section, dict):
        sys.exit(
            "config key `certification` must be a mapping "
            "(see ci/integration.yml.example)"
        )

    def _env_default(key: str, vars_path: str) -> str:
        val = str(section.get(key, "") or "").strip()
        if val:
            return val
        if dry_run:
            return f"<dry-run:{vars_path}>"
        resolved = layered_var(env_name, vars_path)
        if not resolved:
            sys.exit(
                f"certification.{key} not set and {vars_path} not found in the "
                f"{env_name} env vars or manifests/bosh/vars.yml"
            )
        return resolved

    azs = certification_azs(
        section, str(section.get("az") or "z1"), str(section.get("cpi_id", "") or "").strip(),
    )
    return {
        "deployment_name": str(section.get("deployment_name") or "certification"),
        "release_name": str(section.get("release_name") or "certification"),
        "az": azs[0]["az"],
        "azs": azs,
        "network_name": str(section.get("network_name") or "default"),
        "disk_type": str(section.get("disk_type") or "default"),
        "network_bridge": _env_default("network_bridge", "/pve_network_bridge"),
        "cpi_id": azs[0]["cpi_id"],
        "vm_cores": int(section.get("vm_cores", 2)),
        "vm_memory_mib": int(section.get("vm_memory_mib", 2048)),
        "vm_disk_mib": int(section.get("vm_disk_mib", 8192)),
        "old_cpi_version": str(section.get("old_cpi_version") or "").strip(),
        "new_cpi_version": str(section.get("new_cpi_version") or "").strip(),
        "timeout_s": int(section.get("timeout_s", DEFAULT_TIMEOUT_S)),
    }


# --------------------------------------------------------------------------- #
# Release + stemcell resolution
# --------------------------------------------------------------------------- #

def resolve_cpi_release(spec: str, side: str, dry_run: bool) -> "tuple[Path, str]":
    """Resolve a CPI release spec to (tarball path, version string).

    A spec is one of:
      'dev'      build from the working tree via scripts/create-release dev
      a path     used as-is
      a version  'v0.1.1' or '0.1.1', resolved from releases/ when committed,
                 otherwise downloaded from the GitHub release and verified
                 against its published .sha256 asset
    """
    if dry_run:
        return Path(f"<dry-run:{side}-cpi:{spec}>"), spec

    if spec == "dev":
        proc = subprocess.run(
            [CREATE_RELEASE, "dev"], cwd=str(REPO_ROOT),
            capture_output=True, text=True,
        )
        if proc.returncode != 0:
            raise RuntimeError(f"scripts/create-release dev failed:\n{proc.stderr}")
        match = re.search(r"^RELEASE_TGZ=(.+)$", proc.stdout, re.M)
        if not match:
            raise RuntimeError("scripts/create-release dev printed no RELEASE_TGZ=")
        path = Path(match.group(1).strip())
        return path, f"dev ({path.name})"

    candidate = Path(spec).expanduser()
    if candidate.suffix == ".tgz" or candidate.exists():
        if not candidate.exists():
            raise RuntimeError(f"{side} CPI release tarball not found: {candidate}")
        return candidate, candidate.name

    if not _VERSION_RE.match(spec):
        raise RuntimeError(
            f"{side} CPI release spec {spec!r} is neither 'dev', a path to a "
            ".tgz, nor an X.Y.Z version"
        )
    version = spec.lstrip("v")
    # Releases v0.4.0 and earlier were published under the pre-rename name and
    # keep their bosh-pve-cpi-<version>.tgz asset filenames forever. Try the
    # current name first, then fall back to the legacy one, in both the local
    # releases/ trees and the GitHub release assets, so upgrade certification
    # against an old tag keeps working.
    names = [f"bosh-proxmox-cpi-{version}.tgz", f"bosh-pve-cpi-{version}.tgz"]
    for releases_dir in (RELEASES_DIR, LEGACY_RELEASES_DIR):
        for name in names:
            committed = releases_dir / name
            if committed.exists():
                return committed, version

    DEPS_CPI_RELEASES.mkdir(parents=True, exist_ok=True)
    tarball = None
    for name in names:
        cand = DEPS_CPI_RELEASES / name
        if cand.exists() and (DEPS_CPI_RELEASES / f"{name}.sha256").exists():
            tarball = cand
            break
    if tarball is None:
        if shutil.which("gh") is None:
            raise RuntimeError(
                f"CPI release {version} is not committed under releases/ and "
                "gh is not on PATH to download it from the GitHub release"
            )
        errors = []
        for name in names:
            proc = subprocess.run(
                ["gh", "release", "download", f"v{version}",
                 "--pattern", f"{name}*",
                 "--dir", str(DEPS_CPI_RELEASES), "--clobber"],
                cwd=str(REPO_ROOT), capture_output=True, text=True,
            )
            cand = DEPS_CPI_RELEASES / name
            if proc.returncode == 0 and cand.exists():
                tarball = cand
                break
            errors.append(f"{name}: {proc.stderr.strip()}")
        if tarball is None:
            detail = "\n".join(errors)
            raise RuntimeError(
                f"gh release download v{version} matched neither asset name:\n{detail}"
            )
    checksum = Path(f"{tarball}.sha256")
    if not tarball.exists():
        raise RuntimeError(f"download produced no {tarball}")
    if checksum.exists():
        want = checksum.read_text().split()[0].strip()
        got = sha256_file(tarball)
        if want != got:
            raise RuntimeError(
                f"sha256 mismatch for {tarball.name}: published {want}, got {got}"
            )
    return tarball, version


def resolve_bosh_release_ops(version: str, out_dir: Path, dry_run: bool) -> Path:
    """Download a bosh release from bosh.io and write an ops file pinning it.

    Mirrors the shape of manifests/bosh/bosh-release.yml, which is what the
    generated file overrides when layered after it.
    """
    ops = out_dir / f"bosh-release-{version}.yml"
    if dry_run:
        return ops
    DEPS_BOSH_RELEASES.mkdir(parents=True, exist_ok=True)
    tarball = DEPS_BOSH_RELEASES / f"bosh-{version}.tgz"
    url = BOSH_IO_RELEASE.format(version=version)
    if not tarball.exists():
        with urllib.request.urlopen(url, timeout=600) as resp:  # noqa: S310
            tmp = tarball.with_suffix(".tgz.part")
            with tmp.open("wb") as fh:
                shutil.copyfileobj(resp, fh)
            tmp.rename(tarball)
    digest = sha256_file(tarball)
    ops.write_text(yaml.safe_dump(
        [{
            "type": "replace",
            "path": "/releases/name=bosh",
            "value": {
                "name": "bosh",
                "version": version,
                "url": url,
                "sha1": f"sha256:{digest}",
            },
        }],
        default_flow_style=False, sort_keys=False,
    ))
    return ops


def resolve_stemcell(choice: str, env_name: str, dry_run: bool) -> "tuple[Path, str, str, str]":
    """Resolve a stemcell choice to (path, name, version, mode)."""
    if dry_run:
        return Path(f"<dry-run-stemcell:{choice}>"), "<dry-run>", "<dry-run>", choice
    if choice == "light":
        light = _ensure_light_stemcell(env_name)
        if light.create_env_tarball is None:
            raise RuntimeError("light stemcell build produced no tarball")
        path = Path(light.create_env_tarball)
        mode = f"light ({light.mode})"
    else:
        path = Path(choice).expanduser()
        if not path.exists():
            raise RuntimeError(f"stemcell tarball not found: {path}")
        mode = "tarball"
    mf = stemcell_manifest(path)
    name = str(mf.get("name", ""))
    version = str(mf.get("version", ""))
    if not name or not version:
        raise RuntimeError(f"stemcell.MF in {path} lacks name/version")
    return path, name, version, mode


def _ensure_light_stemcell(env_name: str) -> "_lightstemcell.LightStemcell":
    """Mirror scripts/bosh: derive the light stemcell from vars.yml with
    env-bundle layering, ensure the qcow2 is on PVE, build the tarball."""
    source_url = _bosh_int_opt(BOSH_VARS, "/stemcell_url")
    source_sha1 = _bosh_int_opt(BOSH_VARS, "/stemcell_sha1")
    if not source_url or not source_sha1:
        raise RuntimeError(
            "stemcell_url/stemcell_sha1 missing from manifests/bosh/vars.yml"
        )
    os_name, version = _lightstemcell.parse_os_version(source_url)
    mode = (layered_var(env_name, "/light_stemcell_mode") or "preuploaded").strip()
    fetch_url = (layered_var(env_name, "/stemcell_fetch_url") or "").strip()
    token = (layered_var(env_name, "/stemcell_fetch_token") or "").strip()

    def _reader(path: str) -> "str | None":
        return layered_var(env_name, path)

    cpi_cfg = _lightstemcell.pve_cfg_from_bosh_vars(BOSH_VARS, reader=_reader)
    print(
        f"    light stemcell ({mode}): ensuring {os_name} {version} "
        f"is available on PVE (host {cpi_cfg['host']})"
    )
    return _lightstemcell.ensure_light_stemcell(
        cpi_cfg=cpi_cfg,
        mode=mode,
        os_name=os_name,
        version=version,
        source_url=source_url,
        source_sha1=source_sha1,
        cache_dir=str(STEMCELL_CACHE),
        image_url=(fetch_url or None),
        token=(token or None),
        build_create_env_tarball=True,
    )


# --------------------------------------------------------------------------- #
# Deployment manifest ops
# --------------------------------------------------------------------------- #

def is_spanning(ccfg: dict) -> bool:
    """True when certification.azs lists two entries, so one deployment spans two clusters."""
    return len(ccfg.get("azs") or []) > 1


def build_deployment_ops(ccfg: dict) -> list:
    """Ops reshaping upstream's certification.yml for this lab.

    Upstream's manifest names three AZs and the `default` vm_type, and attaches
    no persistent disk. This lab has one AZ, its own certification vm_type, and
    we add a persistent disk deliberately: without one the recreate proves only
    that a VM can be built, while with one it proves the new CPI decodes and
    reattaches a disk CID the old CPI wrote. That is the single most valuable
    assertion in the whole scenario for a CPI whose disk CIDs are versioned
    envelopes.

    When certification.azs lists two entries, the `simple` group spans both AZs
    with one instance in each, and each instance keeps its own persistent disk.
    """
    if is_spanning(ccfg):
        azs = [entry["az"] for entry in ccfg["azs"]]
    else:
        azs = [ccfg["az"]]
    ops = [
        {"type": "replace",
         "path": "/instance_groups/name=simple/azs",
         "value": azs},
    ]
    if is_spanning(ccfg):
        ops.append({"type": "replace",
                    "path": "/instance_groups/name=simple/instances",
                    "value": len(azs)})
    ops += [
        {"type": "replace",
         "path": "/instance_groups/name=simple/vm_type",
         "value": "certification"},
        {"type": "replace",
         "path": "/instance_groups/name=simple/networks/name=default/name",
         "value": ccfg["network_name"]},
        {"type": "replace",
         "path": "/instance_groups/name=simple/persistent_disk_type?",
         "value": ccfg["disk_type"]},
    ]
    return ops


def build_probe_ops(ccfg: dict) -> list:
    """Ops for the throwaway deployment that proves the second AZ's network works.

    One diskless instance in the second AZ, built by the second cpi-config
    entry. It deploys only if its agent reaches the Director's NATS and pulls
    its job and packages from the blobstore, which are the two routes from the
    second network that a spanning deployment depends on.
    """
    return [
        {"type": "replace",
         "path": "/instance_groups/name=simple/azs",
         "value": [ccfg["azs"][1]["az"]]},
        {"type": "replace",
         "path": "/instance_groups/name=simple/vm_type",
         "value": "certification"},
        {"type": "replace",
         "path": "/instance_groups/name=simple/networks/name=default/name",
         "value": ccfg["network_name"]},
    ]


# --------------------------------------------------------------------------- #
# Report documents
# --------------------------------------------------------------------------- #

def write_run_doc(
    meta: dict,
    phases: "list[dict] | None" = None,
    steps: "list[dict] | None" = None,
) -> Path:
    """Write docs/certification/upgrade/runs/<date>-<hhmmss>.md and return its path."""
    pre_timings: list[str] = []
    pre_timings.append("## Version matrix")
    pre_timings.append("")
    pre_timings.append(
        f"Matrix source: {meta.get('matrix_source', 'unknown')}."
    )
    pre_timings.append("")
    pre_timings.append("| Leg | Before upgrade | After upgrade |")
    pre_timings.append("|---|---|---|")
    pre_timings.append(
        f"| CPI release | {_md_escape(meta['old_cpi'])} | {_md_escape(meta['new_cpi'])} |"
        f"\n| CPI artifact version | {_md_escape(str(meta.get('old_cpi_artifact_version', 'unresolved')))} | {_md_escape(str(meta.get('new_cpi_artifact_version', 'unresolved')))} |"
        f"\n| CPI SHA256 | {_md_escape(str(meta.get('old_cpi_sha256', 'unresolved')))} | {_md_escape(str(meta.get('new_cpi_sha256', 'unresolved')))} |"
    )
    pre_timings.append(
        f"| bosh release | {_md_escape(meta['old_bosh'])} | {_md_escape(meta['new_bosh'])} |"
    )
    pre_timings.append(
        f"| Stemcell | {_md_escape(meta['old_stemcell'])} | {_md_escape(meta['new_stemcell'])} |"
    )
    pre_timings.append("")

    extra: list[str] = []
    extra.append("## Upgrade invariants")
    extra.append("")
    extra.append(
        "These are what the run asserts beyond the two BOSH commands exiting "
        "zero. Each is a claim about what the new CPI had to understand about "
        "state the old CPI wrote."
    )
    extra.append("")
    extra.append(
        "The persistent disk marker row compares a per-run nonce and the "
        "sha256 of a block of random data written to the certification "
        "instance's persistent disk before the upgrade with what the run read "
        "back after it. The disk serial row names, for each persistent disk, "
        "the drive whose `serial=` carried the disk's `bpd-` stable id before "
        "and after."
    )
    extra.append("")
    extra.append("| Invariant | Before | After | Held |")
    extra.append("|---|---|---|---|")
    for inv in meta.get("invariants", []):
        held = "yes" if inv.get("held") else "NO"
        extra.append(
            f"| {_md_escape(inv['name'])} | {_md_escape(str(inv.get('before', '')))} | "
            f"{_md_escape(str(inv.get('after', '')))} | {held} |"
        )
    extra.append("")

    return _rundoc.write_run_doc(
        runs_dir=RUNS_DIR,
        meta=meta,
        meta_mark=RUN_META_MARK,
        title=f"Director Upgrade Run Report: {meta['date']}",
        provenance=(
            "`./scripts/certify` generated this report from a live run of the "
            "[BOSH CPI certification](https://github.com/cloudfoundry/bosh-cpi-certification) "
            "suite's Director Upgrade Test against a Proxmox VE lab. See "
            "[BOSH Director Upgrade Test](../../upgrade.md) for how we run it."
        ),
        verdict_lines=[
            f"**Result: {meta['verdict']}.** {meta['steps_passed']} steps passed, "
            f"{meta['steps_failed']} failed, and {meta['steps_skipped']} skipped.",
            "",
            "The verdict covers every step through verification. Tearing the lab "
            "back down happens after this report is written, so the console totals "
            "at the end of a run carry a few more steps and a longer wall clock "
            "than the numbers here.",
            "",
        ] + _rundoc.run_meta_bullets(meta),
        pre_timings=pre_timings,
        phases=phases,
        steps=steps,
        env_table=[
            ("Env bundle", "env"),
            ("Director slot", "director_slot"),
            ("BOSH director", "director_version"),
            ("Certification suite revision", "certification_ref"),
            ("Certification release", "certification_release"),
            ("Proxmox VE", "pve_version"),
        ],
        extra_sections=extra,
        artifacts_lines=[
            "Machine artifacts for this run live in the gitignored results "
            f"directory `{meta.get('run_dir', '')}`: `results.json`, "
            f"`{JUNIT_STEPS}`, `console.log`, the rendered deployment manifest, and "
            "the pre- and post-upgrade state captures, which include every "
            "drive's `serial=` and the persistent disk marker. This document is "
            "the committed record.",
            "",
        ],
    )


def write_summary_doc(headline_pass_fail_only: bool = False) -> Path:
    """Regenerate docs/certification/upgrade/README.md from the run history."""
    return _rundoc.write_summary_doc(
        docs_dir=DOCS_UPGRADE_DIR,
        runs_dir=RUNS_DIR,
        meta_mark=RUN_META_MARK,
        headline_pass_fail_only=headline_pass_fail_only,
        title="BOSH Director Upgrade Test",
        intro=(
            "The [BOSH CPI certification](https://github.com/cloudfoundry/bosh-cpi-certification) "
            "suite's Director Upgrade Test stands a Director up on one CPI release, "
            "deploys the upstream certification release under it, upgrades the "
            "Director onto a newer CPI release over the same state, and recreates "
            "the deployment through it. We run it against a Proxmox VE lab with "
            "`./scripts/certify`; [BOSH Director Upgrade Test](../upgrade.md) "
            "documents the setup and invocation."
        ),
        latest_headline=lambda latest: (
            f"**{latest['verdict']}** on {latest['date']}: "
            f"{latest.get('old_cpi', '?')} to {latest.get('new_cpi', '?')}, "
            f"{latest.get('steps_passed', '?')} steps passed, "
            f"{latest.get('steps_failed', '?')} failed, in "
            f"{latest.get('wall_hms', '?')}. "
            f"Full report: [runs/{latest['_doc']}](runs/{latest['_doc']})."
        ),
        latest_table=[
            ("CPI release before", "old_cpi"),
            ("CPI release after", "new_cpi"),
            ("bosh release", "new_bosh"),
            ("Stemcell", "new_stemcell"),
            ("BOSH director", "director_version"),
            ("Certification suite revision", "certification_ref"),
            ("Proxmox VE", "pve_version"),
        ],
        history_header=[
            "| Date | Result | CPI upgrade | Steps failed | Wall clock | Report |",
            "|---|---|---|---|---|---|",
        ],
        history_row=lambda meta: (
            f"| {meta['date']} | {meta['verdict']} | "
            f"{_md_escape(str(meta.get('old_cpi', '?')))} to "
            f"{_md_escape(str(meta.get('new_cpi', '?')))} | "
            f"{meta.get('steps_failed', '?')} | "
            f"{meta.get('wall_hms', '?')} | "
            f"[runs/{meta['_doc']}](runs/{meta['_doc']}) |"
        ),
    )


# --------------------------------------------------------------------------- #
# The runner
# --------------------------------------------------------------------------- #

class Certify:
    # True from the moment the throwaway probe deployment starts until it is
    # deleted, so teardown knows whether to look for it.
    probe_deployed = False

    def __init__(self, args: argparse.Namespace, rep: Reporter) -> None:
        self.args = args
        self.rep = rep
        self.dry_run = args.dry_run
        self.env_name = args.env

        # Keep in-process env reads (layered vars) and every child process on
        # the same env bundle. Must happen before load_config's passthrough.
        os.environ["BOSH_PVE_ENV"] = self.env_name
        # Pin the slot for every child (scripts/bosh, bosh via the director
        # env) as an absolute path, and have scripts/bosh and the in-process
        # director env refuse the default slot on their own as well, in case
        # anything here resolves it wrongly.
        self.slot = SLOT
        os.environ[_slot.REFUSE_DEFAULT_ENV] = "1"
        slot_env = {
            "BOSH_PVE_ENV": self.env_name,
            _slot.REFUSE_DEFAULT_ENV: "1",
        }
        if not SLOT.is_default:
            os.environ[_slot.ENV_VAR] = str(SLOT.dir)
            slot_env[_slot.ENV_VAR] = str(SLOT.dir)

        results_dir = Path(args.results_dir)
        if not results_dir.is_absolute():
            results_dir = REPO_ROOT / results_dir
        self.results_dir = results_dir
        self.run_dir = rep.run_dir(results_dir)

        # The output tail of the last _cleanup_step attempt.
        self.last_step_tail: "list[str]" = []
        self.console_fh: "IO[str] | None" = None
        self.console_log: "ScrubbedLog | None" = None
        if not self.dry_run:
            self.run_dir.mkdir(parents=True, exist_ok=True)
            self.console_fh = (self.run_dir / "console.log").open("w")
            self.console_log = ScrubbedLog(self.console_fh)

        self.runner = Runner(
            rep, slot_env, self.dry_run, REPO_ROOT,
            logfile=self.console_log,
        )

        self.cfg = _integration.load_config(args.config, dry_run=self.dry_run)
        self.ccfg = certification_config(self.cfg, self.env_name, self.dry_run)

        self.checkout: "Path | None" = None
        self.old_cpi_path: "Path | None" = None
        self.new_cpi_path: "Path | None" = None
        self.old_cpi_label = ""
        self.new_cpi_label = ""
        self.old_bosh_ops: "Path | None" = None
        self.new_bosh_ops: "Path | None" = None
        self.old_bosh_label = "held"
        self.new_bosh_label = "held"
        self.old_stemcell: "tuple[Path, str, str, str] | None" = None
        self.new_stemcell: "tuple[Path, str, str, str] | None" = None
        self.director_version = ""
        self.pve_version = ""
        self.certification_ref = ""
        self.certification_release = ""
        self.deployed = False
        self.director_up = False
        # Which CPI tarball the standing Director was last built with, so
        # teardown hands delete-env the same one.
        self.director_side: "str | None" = None
        self.pre: dict = {}
        self.post: dict = {}
        self.invariants: list[dict] = []
        self.marker_nonce = ""
        self.marker_written: "tuple[str, str] | None" = None
        self.marker_read: "tuple[str, str] | None" = None
        self.marker_problem = "the run never reached the marker write"
        # The spanning run's cpi-config facts, keyed by AZ, and the throwaway
        # probe deployment's state. Empty and False in a single-AZ run.
        self.az_facts: dict[str, dict] = {}

    # -- env helpers -------------------------------------------------------- #

    def _director_env(self) -> dict[str, str]:
        return _integration.director_env(self.cfg, dry_run=self.dry_run)

    def _record_inline(self, name: str, ok: bool, t0: float, detail: str = "",
                       tail: "list[str] | None" = None) -> bool:
        self.rep.record(name, PASS if ok else FAIL, time.monotonic() - t0,
                        detail, tail)
        return ok

    def _bosh(self, name: str, argv: list[str], *, timeout: int) -> tuple[bool, list[str]]:
        return self.runner.step(name, argv, env=self._director_env(), timeout=timeout)

    def _capture_json(self, argv: list[str], *, timeout: int = SHORT_TIMEOUT_S) -> "dict | None":
        ok, out = self.runner.capture(
            "-".join(argv[:3]), argv, env=self._director_env(), timeout=timeout,
        )
        if not ok or not out.strip():
            return None
        try:
            return json.loads(out)
        except json.JSONDecodeError:
            return None

    @staticmethod
    def _rows(payload: "dict | None") -> list[dict]:
        if not payload:
            return []
        tables = payload.get("Tables") or []
        if not tables:
            return []
        return tables[0].get("Rows") or []

    def _state(self) -> dict:
        if self.dry_run or not STATE.exists():
            return {}
        try:
            return json.loads(STATE.read_text())
        except (json.JSONDecodeError, OSError):
            return {}

    def _director_identity(self) -> dict:
        """The Director VM and disk identity `bosh create-env` records."""
        state = self._state()
        disks = state.get("disks") or []
        return {
            "vm_cid": str(state.get("current_vm_cid") or ""),
            "disk_cids": sorted(str(d.get("cid") or "") for d in disks if d.get("cid")),
        }

    def _director_standing(self) -> str:
        """What the slot's state says about a Director, read as keys only.

        Returns "" when the slot holds no Director state, meaning there is no
        state file or it names no current VM CID. Returns the VM CID when it
        names one. Returns "?" when the file exists but cannot be read or
        parsed, which proves nothing, so callers treat it as standing. The
        file's contents are never printed or logged.
        """
        if not STATE.exists():
            return ""
        try:
            state = json.loads(STATE.read_text())
        except (json.JSONDecodeError, OSError, UnicodeDecodeError):
            return "?"
        if not isinstance(state, dict):
            return "?"
        return str(state.get("current_vm_cid") or "")

    def _deployment_identity(self) -> dict:
        """VM and persistent-disk CIDs the Director holds for the deployment."""
        dep = self.ccfg["deployment_name"]
        rows = self._rows(self._capture_json(
            ["bosh", "-d", dep, "instances", "--details", "--json"],
        ))
        vm_cids: list[str] = []
        disk_cids: list[str] = []
        states: list[str] = []
        for row in rows:
            for key, value in row.items():
                lowered = key.lower()
                if not value:
                    continue
                if lowered in ("vm_cid", "vm cid"):
                    vm_cids.append(str(value))
                elif "disk_cid" in lowered or lowered in ("disk cids", "disk cid"):
                    disk_cids.extend(
                        part.strip() for part in str(value).split(",") if part.strip()
                    )
                elif lowered in ("process_state", "process state"):
                    states.append(str(value))
        return {
            "vm_cids": sorted(vm_cids),
            "disk_cids": sorted(disk_cids),
            "process_states": sorted(states),
        }

    def _orphaned_disk_count(self) -> int:
        return len(self._rows(self._capture_json(["bosh", "disks", "--orphaned", "--json"])))

    def _probe_director_version(self) -> str:
        """The Director's own version, for the environment tuple in the report.

        Both legs run the same bosh release, so one probe against the live
        Director is enough. A shape we do not recognise leaves the field empty
        and the report says `unknown` rather than guessing.
        """
        for row in self._rows(self._capture_json(["bosh", "env", "--json"])):
            for key, value in row.items():
                if key.lower() == "version" and value:
                    # bosh appends its own build stamp, which is a placeholder
                    # on a release build. Keep the version, drop the stamp.
                    return re.sub(r"\s*\(.*\)\s*$", "", str(value)).strip()
        return ""

    def _pve_cfg(self) -> dict:
        def _reader(path: str) -> "str | None":
            return self._layered(path)
        return _lightstemcell.pve_cfg_from_bosh_vars(BOSH_VARS, reader=_reader)

    # -- preflight ----------------------------------------------------------- #

    def preflight(self) -> bool:
        self.rep.section("preflight")
        if not self._preflight_slot_guard():
            return False
        ok = True

        for tool in ("uv", "bosh", "git"):
            present = shutil.which(tool) is not None
            self.rep.record(
                f"tool:{tool}", PASS if present else FAIL, 0.0,
                "on PATH" if present else "MISSING from PATH",
            )
            ok = ok and present

        gh_present = shutil.which("gh") is not None
        self.rep.record(
            "tool:gh", PASS if gh_present else FAIL, 0.0,
            "on PATH" if gh_present
            else "MISSING — needed to download released CPI tarballs",
        )
        ok = ok and gh_present

        cfg_file = Path(self.args.config)
        if not cfg_file.is_absolute():
            cfg_file = REPO_ROOT / cfg_file
        for label, path in (
            (self.args.config, cfg_file),
            ("manifests/bosh/vars.yml", BOSH_VARS),
            ("manifests/certification/cloud-config-ops.yml", CC_OPS),
            ("manifests/bosh/cloud-config.yml", CLOUD_CONFIG),
        ):
            present = path.exists() or self.dry_run
            self.rep.record(
                f"file:{label}", PASS if present else FAIL, 0.0,
                "present" if present else "MISSING",
            )
            ok = ok and present

        if is_spanning(self.ccfg):
            for label, path in (
                ("manifests/certification/cloud-config-cpi2-ops.yml", CC_CPI2_OPS),
                ("manifests/certification/cloud-config-cpi2-storage-ops.yml", CC_CPI2_STORAGE_OPS),
                ("manifests/cpi-config.yml", CPI_CONFIG),
            ):
                if path is CC_CPI2_STORAGE_OPS and not self.ccfg["azs"][1]["storage"]:
                    continue
                present = path.exists() or self.dry_run
                self.rep.record(
                    f"file:{label}", PASS if present else FAIL, 0.0,
                    "present" if present else "MISSING",
                )
                ok = ok and present
            ok = self._preflight_spanning() and ok

        if self.dry_run:
            env_var, _ = _checkouts.UPSTREAMS[CHECKOUT_NAME]
            override = os.environ.get(env_var, "").strip()
            where = override or str(_checkouts.DEPS_DIR / CHECKOUT_NAME)
            self.checkout = Path(where)
            self.rep.record(
                f"checkout:{CHECKOUT_NAME}", PASS, 0.0,
                f"{where} (dry-run: clone/refresh skipped)",
            )
        else:
            t0 = time.monotonic()
            try:
                self.checkout = _checkouts.checkout_dir(CHECKOUT_NAME)
                self.certification_ref = self._checkout_ref(self.checkout)
                self.rep.record(
                    f"checkout:{CHECKOUT_NAME}", PASS, time.monotonic() - t0,
                    f"{self.checkout} @ {self.certification_ref}",
                )
            except SystemExit as exc:
                self.rep.record(
                    f"checkout:{CHECKOUT_NAME}", FAIL, time.monotonic() - t0, str(exc),
                )
                ok = False

        if self.checkout is not None:
            rel_dir = self.checkout / CERT_RELEASE_SUBPATH
            present = rel_dir.is_dir() or self.dry_run
            self.rep.record(
                "checkout:certification-release", PASS if present else FAIL, 0.0,
                str(rel_dir) if present else f"MISSING {rel_dir}",
            )
            ok = ok and present

        if not ok:
            return False
        # The vars check is offline and takes seconds, so a stale vars file
        # fails here rather than after the lab has been touched.
        if not self._preflight_vars():
            self.rep.skip("director:slot-free", "the vars preflight failed")
            self.rep.skip("lab:reachable", "the vars preflight failed")
            return False
        ok = self._preflight_slot() and ok
        ok = self._preflight_lab() and ok
        return ok

    def _preflight_spanning(self) -> bool:
        """Read both cpi-config entries the run spans, offline.

        The placement check asserts each instance against its entry's host,
        VMID bands, and VM prefix, so a missing entry or band fails here, in
        seconds, rather than after the deployment is up. Only the entry's
        non-secret fields are read here. Each later entry's credential
        variables must resolve, so a missing one fails now and is named
        without its value. The credentials themselves are read later and
        never printed.
        """
        if self.dry_run:
            self.rep.record("spanning:cpi-config", PASS, 0.0, "dry-run")
            return True
        t0 = time.monotonic()

        def _reader(path: str) -> "str | None":
            return self._layered(path)

        facts: dict[str, dict] = {}
        try:
            for entry in self.ccfg["azs"]:
                facts[entry["az"]] = _spanning.cpi_entry_facts(CPI_CONFIG, entry["cpi_id"], _reader)
        except ValueError as exc:
            return self._record_inline("spanning:cpi-config", False, t0, str(exc))
        hosts = {f["host"] for f in facts.values()}
        if len(hosts) < len(facts):
            return self._record_inline(
                "spanning:cpi-config", False, t0,
                "both cpi-config entries name the same PVE host, so they are not two clusters",
            )
        self.az_facts = facts
        try:
            # The first entry reads the base variables that the vars preflight
            # already checks, so only the later entries are resolved here.
            for az in list(facts)[1:]:
                self._pve_creds_for(az)
        except ValueError as exc:
            return self._record_inline("spanning:cpi-config", False, t0, str(exc))
        return self._record_inline(
            "spanning:cpi-config", True, t0,
            "; ".join(
                f"{az} {f['cpi_id']} on {f['host']} (VMs {f['vm_range'][0]}-{f['vm_range'][1]}, "
                f"disks {f['disk_range'][0]}-{f['disk_range'][1]})"
                for az, f in facts.items()
            ),
        )

    def _layered(self, path: str) -> "str | None":
        """A vars key through the layers update-cpi-config applies.

        The base vars come first, then the env's, then the slot's slot.yml
        when the slot carries one, and the later layer wins.
        """
        slot_vars = Path(self.slot.config) if self.slot.vars_layer() else None
        return layered_var(self.env_name, path, slot_vars=slot_vars)

    def _pve_creds_for(self, az: str) -> dict:
        """The user and the password or token for one AZ's cluster.

        The first entry reads the base variables, the same ones _pve_cfg
        reads. Every other entry reads the credential values its own
        cpi-config entry names, either a ((variable)) looked up through the
        layered vars or a literal written in the entry, and the group always
        comes from that one entry so one cluster's user is never paired with
        another's token. Like the CPI, a group is valid with an api_token
        alone, which wins over a password, or with a user and a password.
        Raises ValueError naming the variables, never their values, when the
        group does not resolve.
        """
        if az == self.ccfg["azs"][0]["az"]:
            base = self._pve_cfg()
            return {k: base[k] for k in ("user", "password", "api_token") if k in base}
        facts = self.az_facts[az]
        names = facts["credential_vars"]
        literal_keys = facts.get("credential_literal_keys", [])

        def _get(key: str) -> str:
            name = names.get(key)
            if name:
                return self._layered("/" + name) or ""
            if key in literal_keys:
                # The value is read from the entry here and nowhere else, so
                # no facts dict or report row ever holds it.
                return _spanning.cpi_entry_literal(CPI_CONFIG, facts["cpi_id"], key)
            return ""

        def _source(key: str) -> str:
            if names.get(key):
                return f"{key} (variable {names[key]})"
            return f"{key} (a literal in the entry)" if key in literal_keys else f"{key} (not set in the entry)"

        user, password, token = _get("user"), _get("password"), _get("api_token")
        if not token and not (user and password):
            raise ValueError(
                f"cpi-config entry {facts['cpi_id']} needs an api_token, or a user and a password, "
                f"and these resolve to nothing: {', '.join(_source(k) for k in ('user', 'password', 'api_token') if not _get(k))}. "
                "Set the variables in the env vars file or manifests/bosh/vars.yml"
            )
        creds = {}
        if user:
            creds["user"] = user
        if token:
            creds["api_token"] = token
        else:
            creds["password"] = password
        return creds

    def _pve_cfg_for(self, az: str) -> dict:
        """The PVE API settings for one AZ's cluster.

        The host and port come from the AZ's own cpi-config entry. The user
        and the password or token come from the first entry's variables for
        the first AZ, and from that entry's own credential variables for any
        other, because each cluster has its own credentials.
        """
        facts = self.az_facts[az]
        cfg = dict(self._pve_cfg())
        for key in ("user", "password", "api_token"):
            cfg.pop(key, None)
        cfg.update(self._pve_creds_for(az))
        cfg["host"] = facts["host"]
        if "port" in facts:
            cfg["port"] = facts["port"]
        return cfg

    def _slot_refusal(self, action: str) -> str:
        """Why this run must not touch its slot's Director, or "".

        The run always needs BOSH_PROTECTED_DIRECTOR_CIDS, because it deletes
        and replaces the Director its slot's state records.
        """
        message = _slot.guard_repo(action, self.slot, REPO_ROOT,
                                   require_deny_list=True)
        if message:
            return message
        problem = _slot.config_problem(
            self.slot, _slot.env_facts(REPO_ROOT, self.env_name))
        return problem or ""

    def _preflight_slot_guard(self) -> bool:
        """Refuse the default slot before anything else runs.

        The run deletes and replaces the Director its state records, so it may
        only ever own a dedicated slot. This check reads local files only and
        runs in dry-run too, so a misconfigured slot shows up there first.
        """
        refusal = self._slot_refusal("run the upgrade test")
        if refusal:
            self.rep.record("director:slot-guard", FAIL, 0.0, refusal)
            return False
        self.rep.record(
            "director:slot-guard", PASS, 0.0,
            f"slot {self.slot.dir} (alias {self.slot.alias})",
        )
        return True

    def _guard_step(self, action: str, step: str) -> bool:
        """Re-check the slot right before a step that deletes or replaces a Director."""
        refusal = self._slot_refusal(action)
        if refusal:
            self.rep.record(step, FAIL, 0.0, refusal)
            return False
        return True

    def _cloud_config_args(self) -> list[str]:
        """The -o/-v flags the certification cloud-config upload layers on."""
        args = [
            "-o", str(CC_OPS),
            "-v", f"certification_vm_cores={self.ccfg['vm_cores']}",
            "-v", f"certification_vm_memory_mib={self.ccfg['vm_memory_mib']}",
            "-v", f"certification_vm_disk_mib={self.ccfg['vm_disk_mib']}",
        ]
        if self.ccfg["cpi_id"]:
            args += [
                "-o", str(CC_CPI_OPS),
                "-v", f"certification_cpi_id={self.ccfg['cpi_id']}",
            ]
        if is_spanning(self.ccfg):
            second = self.ccfg["azs"][1]
            network = second["network"]
            # JSON strings are YAML strings, so `bosh -v` never reads a name
            # such as "on" or "no" as a boolean.
            args += [
                "-o", str(CC_CPI2_OPS),
                "-v", f"certification_secondary_cpi_id={json.dumps(second['cpi_id'])}",
                "-v", f"certification_secondary_range={json.dumps(network['cidr'])}",
                "-v", f"certification_secondary_gateway={json.dumps(network['gateway'])}",
                "-v", f"certification_secondary_reserved={json.dumps(network['reserved'])}",
                "-v", "certification_secondary_bridge="
                      + json.dumps(second["bridge"] or self.ccfg["network_bridge"]),
            ]
            if second["storage"]:
                args += [
                    "-o", str(CC_CPI2_STORAGE_OPS),
                    "-v", f"certification_secondary_storage={json.dumps(second['storage'])}",
                ]
        return args

    def _preflight_vars(self) -> bool:
        """Interpolate every manifest the run applies against the slot's vars.

        scripts/bosh check-vars names each variable no vars file sets, leaving
        out the ones scripts/bosh passes itself and the ones create-env
        generates into creds.yml.
        """
        argv = [BOSH_SCRIPT, "check-vars", *self._cloud_config_args()]
        if self.ccfg["cpi_id"]:
            argv.append("--cpi-config")
        ok, _ = self.runner.step("preflight:vars", argv, timeout=SHORT_TIMEOUT_S)
        return ok

    @staticmethod
    def _checkout_ref(path: Path) -> str:
        proc = subprocess.run(
            ["git", "-C", str(path), "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True,
        )
        return proc.stdout.strip() if proc.returncode == 0 else "unknown"

    def _preflight_slot(self) -> bool:
        """The upgrade test takes over its Director slot.

        It deploys, upgrades, and deletes the Director recorded in the slot's
        state.json, on the slot's own Director IP. A standing
        Director is therefore not something the run can leave alone, and
        clobbering one silently would be the worst possible behavior — so
        refuse unless the operator says otherwise with --force.
        """
        if self.dry_run:
            self.rep.record("director:slot-free", PASS, 0.0, "dry-run")
            return True
        identity = self._director_identity()
        occupied = bool(identity["vm_cid"])
        if not occupied:
            self.rep.record("director:slot-free", PASS, 0.0, "no Director in state.json")
            return True
        if self.args.force:
            self.rep.record(
                "director:slot-free", PASS, 0.0,
                f"Director {identity['vm_cid']} present; --force will tear it down",
            )
            return True
        self.rep.record(
            "director:slot-free", FAIL, 0.0,
            f"Director {identity['vm_cid']} is live in {STATE}, and the upgrade "
            "test replaces it. Run `./scripts/bosh teardown` with the same "
            "BOSH_STATE_DIR first, or pass --force to tear it down as part of "
            "this run.",
        )
        return False

    def _preflight_lab(self) -> bool:
        """The PVE API must answer before we spend 20 minutes finding out."""
        if self.dry_run:
            self.rep.record("lab:reachable", PASS, 0.0, "dry-run")
            if is_spanning(self.ccfg):
                self.rep.record("lab:reachable-secondary", PASS, 0.0, "dry-run")
            return True
        t0 = time.monotonic()
        try:
            data = _integration.pve_api_get(self._pve_cfg(), "/version")
            self.pve_version = str((data or {}).get("version", "")) or "unknown"
        except (RuntimeError, OSError) as exc:
            return self._record_inline("lab:reachable", False, t0, str(exc))
        ok = self._record_inline(
            "lab:reachable", True, t0, f"PVE {self.pve_version}",
        )
        if is_spanning(self.ccfg):
            ok = self._preflight_lab_secondary() and ok
        return ok

    def _preflight_lab_secondary(self) -> bool:
        """The second cluster's PVE API must answer too, since the placement check reads it."""
        t0 = time.monotonic()
        az = self.ccfg["azs"][1]["az"]
        if az not in self.az_facts:
            return self._record_inline(
                "lab:reachable-secondary", False, t0,
                "the second cpi-config entry was not read, so its host is unknown",
            )
        try:
            data = _integration.pve_api_get(self._pve_cfg_for(az), "/version")
        except (RuntimeError, OSError, ValueError) as exc:
            return self._record_inline("lab:reachable-secondary", False, t0, str(exc))
        return self._record_inline(
            "lab:reachable-secondary", True, t0,
            f"PVE {str((data or {}).get('version', '')) or 'unknown'} on the {az} cluster",
        )

    # -- resolve ------------------------------------------------------------- #

    def resolve(self) -> bool:
        self.rep.section("resolve")
        ok = True

        for side, spec in (("old", self.args.old_cpi), ("new", self.args.new_cpi)):
            t0 = time.monotonic()
            try:
                path, label = resolve_cpi_release(spec, side, self.dry_run)
            except (RuntimeError, OSError) as exc:
                ok = self._record_inline(f"release:{side}-cpi", False, t0, str(exc)) and ok
                continue
            if side == "old":
                self.old_cpi_path, self.old_cpi_label = path, label
            else:
                self.new_cpi_path, self.new_cpi_label = path, label
            self._record_inline(f"release:{side}-cpi", True, t0, f"{label} -> {path}")

        for side, version in (("old", self.args.old_bosh_release),
                              ("new", self.args.new_bosh_release)):
            if not version:
                continue
            t0 = time.monotonic()
            try:
                ops = resolve_bosh_release_ops(version, self.run_dir, self.dry_run)
            except (OSError, RuntimeError) as exc:
                ok = self._record_inline(f"release:{side}-bosh", False, t0, str(exc)) and ok
                continue
            if side == "old":
                self.old_bosh_ops, self.old_bosh_label = ops, version
            else:
                self.new_bosh_ops, self.new_bosh_label = ops, version
            self._record_inline(f"release:{side}-bosh", True, t0, f"{version} -> {ops}")

        for side, choice in (("old", self.args.old_stemcell),
                             ("new", self.args.new_stemcell)):
            t0 = time.monotonic()
            try:
                resolved = resolve_stemcell(choice, self.env_name, self.dry_run)
            except (RuntimeError, OSError, ValueError) as exc:
                ok = self._record_inline(f"stemcell:{side}", False, t0, str(exc)) and ok
                continue
            if side == "old":
                self.old_stemcell = resolved
            else:
                self.new_stemcell = resolved
            self._record_inline(
                f"stemcell:{side}", True, t0,
                f"{resolved[1]}/{resolved[2]} ({resolved[3]})",
            )

        return ok

    # -- create-env legs ----------------------------------------------------- #

    def _create_env_argv(self, side: str) -> list[str]:
        """`scripts/bosh create-env` with this side's release and stemcell pins.

        scripts/bosh appends passthrough args after its own, and both bosh's
        `-o` and `-v` take the last value, so the extra ops and vars here
        override the repo defaults without forking the ops list.
        """
        argv = [BOSH_SCRIPT, "create-env"]
        ops = self.old_bosh_ops if side == "old" else self.new_bosh_ops
        if ops is not None:
            argv += ["-o", str(ops)]
        stemcell = self.old_stemcell if side == "old" else self.new_stemcell
        if stemcell is not None and getattr(self.args, f"{side}_stemcell") != "light":
            path = stemcell[0]
            digest = "<dry-run>" if self.dry_run else f"sha256:{sha256_file(path)}"
            argv += [
                "-v", f"stemcell_url=file://{path}",
                "-v", f"stemcell_sha1={digest}",
            ]
        return argv

    def _env_manages_sdn(self) -> bool:
        """True when this env bundle owns its network, so `net-up` applies.

        The turnkey isolated network is driven entirely by the env's
        `cpitest_sdn_*` keys (see docs/networks.md). An env whose network is
        provisioned outside this repo, like the nested pve-cpi clusters on
        their outer-host vnets, defines none of them, and running `net-up`
        against it would fail on the first missing key.
        """
        f = env_vars_file(self.env_name)
        if f is None:
            return False
        return bool(_bosh_int_opt(f, "/cpitest_sdn_vnet"))

    def _sdn_skip_reason(self) -> str:
        return (
            f"the {self.env_name} env defines no cpitest_sdn_* keys, so its "
            "network is provisioned outside this repo"
        )

    def _create_env_env(self, side: str) -> dict[str, str]:
        path = self.old_cpi_path if side == "old" else self.new_cpi_path
        assert path is not None
        return {"PVE_CPI_RELEASE_PATH": str(path)}

    def _teardown_env(self) -> "dict[str, str] | None":
        """The CPI tarball for delete-env, which needs the Director's CPI.

        Without PVE_CPI_RELEASE_PATH, scripts/bosh falls back to the newest
        dev release in the checkout and fails when there is none, which
        leaves the run's Director standing. When the run has no tarball to
        offer, scripts/bosh keeps choosing as before.
        """
        side = self.director_side or "old"
        path = self.new_cpi_path if side == "new" else self.old_cpi_path
        if path is None:
            return None
        return {"PVE_CPI_RELEASE_PATH": str(path)}

    def deploy_old(self) -> bool:
        self.rep.section("deploy-old")

        standing = not self.dry_run and bool(self._director_identity()["vm_cid"])
        if standing and self.args.force:
            if not self._guard_step("tear down the standing Director",
                                    "director:teardown-existing"):
                return False
            # A previous run may have died before its own cleanup. Prune what
            # it recorded first, while its Director can still clean up, then
            # again once the teardown has removed the Director and its VMs.
            self.cleanup_refs()
            ok, _ = self.runner.step(
                "director:teardown-existing", [BOSH_SCRIPT, "teardown"],
                timeout=CREATE_ENV_TIMEOUT_S,
            )
            if not ok:
                return False
            self.cleanup_refs()
        elif not standing and not self.dry_run:
            # A run that died after its Director was torn down leaves recorded
            # UUIDs and an empty slot, so the catch-up cannot depend on a VM.
            self.cleanup_refs()

        self._backup_state("pre-upgrade-test")

        if self._env_manages_sdn():
            ok, _ = self.runner.step(
                "net:up", [BOSH_SCRIPT, "net-up"], timeout=SHORT_TIMEOUT_S,
            )
            if not ok:
                return False
        else:
            self.rep.skip("net:up", self._sdn_skip_reason())

        if not self._guard_step("create-env", "director:create-env-old"):
            return False
        ok, _ = self.runner.step(
            "director:create-env-old", self._create_env_argv("old"),
            env=self._create_env_env("old"), timeout=CREATE_ENV_TIMEOUT_S,
        )
        if not ok:
            return False
        self.director_up = True
        self.director_side = "old"
        self._record_director_uuid()

        ok, _ = self.runner.step(
            "director:alias", [BOSH_SCRIPT, "alias-env"], timeout=SHORT_TIMEOUT_S,
        )
        if not ok:
            return False

        if self.ccfg["cpi_id"]:
            ok, _ = self.runner.step(
                "director:cpi-config", [BOSH_SCRIPT, "update-cpi-config"],
                timeout=DEPLOY_TIMEOUT_S,
            )
            if not ok:
                return False
        else:
            self.rep.skip("director:cpi-config", "certification.cpi_id not set")

        return self._upload_cloud_config()

    def _upload_cloud_config(self) -> bool:
        argv = [BOSH_SCRIPT, "ucc", *self._cloud_config_args()]
        ok, _ = self.runner.step(
            "director:cloud-config", argv, timeout=SHORT_TIMEOUT_S,
        )
        return ok

    def _backup_state(self, tag: str) -> None:
        """Copy the Director state, creds, and owner record into the run directory.

        The run overwrites all three. Keeping a copy alongside the console log
        is the difference between a recoverable failure and a lost Director.
        The owner record goes with the state, because the guard refuses a
        restored state whose owner record no longer matches it.
        """
        if self.dry_run:
            return
        for src in (STATE, CREDS, OWNER):
            if src.exists():
                shutil.copy2(src, self.run_dir / f"{src.name}.{tag}")

    # -- certification deployment -------------------------------------------- #

    def deploy_cert(self) -> bool:
        self.rep.section("deploy-cert")
        assert self.checkout is not None
        rel_dir = self.checkout / CERT_RELEASE_SUBPATH
        dep = self.ccfg["deployment_name"]
        rel = self.ccfg["release_name"]

        # Upstream's create-deployment.sh builds the release in place with
        # --force. That writes dev_releases/ and .dev_builds/ into the checkout
        # and deletes blobs/.gitkeep, which leaves the tree dirty and would
        # block the next fast-forward in _checkouts.py. Reset it to upstream
        # HEAD before building, so every run builds the same release from the
        # same source and the checkout stays reusable.
        if not self.dry_run:
            for path in ("dev_releases", ".dev_builds", ".final_builds"):
                shutil.rmtree(rel_dir / path, ignore_errors=True)
            subprocess.run(
                ["git", "-C", str(self.checkout), "checkout", "--", "."],
                capture_output=True, text=True,
            )

        ok, _ = self.runner.step(
            "cert:create-release",
            ["bosh", "-n", "create-release", "--force", "--name", rel],
            cwd=rel_dir, timeout=DEPLOY_TIMEOUT_S,
        )
        if not ok:
            return False

        ok, _ = self.runner.step(
            "cert:upload-release", ["bosh", "-n", "upload-release"],
            env=self._director_env(), cwd=rel_dir, timeout=DEPLOY_TIMEOUT_S,
        )
        if not ok:
            return False

        assert self.old_stemcell is not None
        ok, _ = self._bosh(
            "cert:upload-stemcell",
            ["bosh", "-n", "upload-stemcell", str(self.old_stemcell[0])],
            timeout=DEPLOY_TIMEOUT_S,
        )
        if not ok:
            return False

        if is_spanning(self.ccfg) and not self._probe_secondary_network():
            return False

        manifest = self._render_deployment_manifest()
        if manifest is None:
            return False

        if is_spanning(self.ccfg):
            # A deploy that fails partway can leave a VM and a disk on each
            # cluster, so teardown deletes the deployment either way.
            self.deployed = True
        ok, _ = self._bosh(
            "cert:deploy",
            ["bosh", "-n", "-d", dep, "deploy", str(manifest)],
            timeout=DEPLOY_TIMEOUT_S,
        )
        self.deployed = ok or self.deployed
        return ok

    def _probe_deployment_name(self) -> str:
        return f"{self.ccfg['deployment_name']}-z2-probe"

    def _probe_secondary_network(self) -> bool:
        """Prove the second AZ's network reaches the Director before the real deploy.

        Builds one throwaway instance in the second AZ through the second
        cpi-config entry. Its agent has to reach the Director's NATS to answer,
        and has to pull its job and packages from the Director's blobstore, so
        a deploy that succeeds proves both routes. A routing gap then fails
        here, under a name that says so, and does not read as a CPI failure in
        the deployment under test. The probe is deleted either way.
        """
        probe = self._probe_deployment_name()
        manifest = self._render_deployment_manifest(
            step="cert:probe-manifest", ops=build_probe_ops(self.ccfg),
            deployment_name=probe, stem="certification-probe",
        )
        if manifest is None:
            return False
        # Set before the deploy: a deploy that fails partway can still leave a VM.
        self.probe_deployed = True
        ok, tail = self._bosh(
            "precheck:z2-reachability",
            ["bosh", "-n", "-d", probe, "deploy", str(manifest)],
            timeout=DEPLOY_TIMEOUT_S,
        )
        if not ok:
            second = self.ccfg["azs"][1]
            kind = _spanning.classify_probe_failure(tail)
            self.rep.record(
                "precheck:z2-diagnosis", FAIL, 0.0,
                (f"the probe in {second['az']} ({second['cpi_id']}) looks like a routing gap: its agent "
                 "did not reach the Director's NATS or blobstore. Check the route from the "
                 "second network to the Director before blaming the CPI."
                 if kind == "routing" else
                 f"the probe in {second['az']} ({second['cpi_id']}) failed for a reason that does not "
                 "look like routing, so read the task output for the CPI's own error"),
                tail,
            )
        cleaned, _ = self._bosh(
            "precheck:z2-probe-delete",
            ["bosh", "-n", "-d", probe, "delete-deployment", "--force"],
            timeout=DEPLOY_TIMEOUT_S,
        )
        if cleaned:
            self.probe_deployed = False
        return ok and cleaned

    def _render_deployment_manifest(
        self, *, step: str = "cert:manifest", ops: "list | None" = None,
        deployment_name: "str | None" = None, stem: str = "certification",
    ) -> "Path | None":
        """Interpolate upstream's certification.yml for this lab.

        The keyword arguments render the probe deployment from the same
        source; the defaults render the deployment under test.
        """
        self.rep.begin(step)
        t0 = time.monotonic()
        assert self.checkout is not None
        assert self.old_stemcell is not None
        src = self.checkout / CERT_RELEASE_SUBPATH / "certification.yml"
        ops_file = self.run_dir / f"{stem}-ops.yml"
        out = self.run_dir / f"{stem}.yml"
        if self.dry_run:
            print(f"    DRY-RUN: bosh int {src} -o <generated ops> > {out}")
            self.rep.record(step, PASS, 0.0, "dry-run")
            return out
        try:
            ops_file.write_text(yaml.safe_dump(
                ops if ops is not None else build_deployment_ops(self.ccfg),
                default_flow_style=False, sort_keys=False,
            ))
            proc = subprocess.run(
                ["bosh", "int", str(src),
                 "-o", str(ops_file),
                 "-v", f"deployment_name={deployment_name or self.ccfg['deployment_name']}",
                 "-v", f"release_name={self.ccfg['release_name']}",
                 "-v", f"stemcell_name={self.old_stemcell[1]}"],
                capture_output=True, text=True, cwd=str(REPO_ROOT),
            )
            if proc.returncode != 0:
                self._record_inline(
                    step, False, t0, "bosh int failed",
                    proc.stderr.splitlines()[-20:],
                )
                return None
            out.write_text(proc.stdout)
        except OSError as exc:
            self._record_inline(step, False, t0, str(exc))
            return None
        self._record_inline(step, True, t0, str(out))
        return out

    # -- capture / upgrade / recreate ---------------------------------------- #

    def capture(self, when: str) -> bool:
        self.rep.section(f"capture-{when}")
        target = self.pre if when == "pre" else self.post
        self.rep.begin(f"capture:{when}")
        t0 = time.monotonic()
        if self.dry_run:
            self.rep.record(f"capture:{when}", PASS, 0.0, "dry-run")
            return True
        if not self.director_version:
            self.director_version = self._probe_director_version()
        target.update({
            "director": self._director_identity(),
            "deployment": self._deployment_identity(),
            "cpi_release": (
                self.old_cpi_label if when == "pre" else self.new_cpi_label
            ),
            "orphaned_disks": self._orphaned_disk_count(),
        })
        target["disks"] = self._disk_serials(target)
        if is_spanning(self.ccfg):
            target["placement"] = self._placement_observation()
            director_vm = target["director"]["vm_cid"]
            # The Director VM runs on the first AZ's cluster and nowhere else.
            target["placement"]["exempt_vmids"] = (
                {self.ccfg["azs"][0]["az"]: [_vmcid.as_path_id(director_vm)]} if director_vm else {}
            )
        (self.run_dir / f"capture-{when}.json").write_text(
            json.dumps(target, indent=2, sort_keys=True) + "\n"
        )
        return self._record_inline(
            f"capture:{when}", True, t0,
            f"director vm {target['director']['vm_cid'] or '?'}, "
            f"cpi {target['cpi_release'] or '?'}, "
            f"disks {len(target['deployment']['disk_cids'])}",
        )

    def _probe_director_uuid(self) -> str:
        """The Director's UUID, which the CPI turns into the owner tag on every VM it creates."""
        for row in self._rows(self._capture_json(["bosh", "env", "--json"])):
            for key, value in row.items():
                if key.lower() == "uuid" and value:
                    return str(value)
        return ""

    # -- Director UUID record and stemcell ref cleanup ----------------------- #

    def _record_director_uuid(self) -> bool:
        """Append the running Director's UUID to the slot's record.

        Called as soon as a create-env leg has the Director up, so a run that
        dies later still leaves the UUID for cleanup-refs. A dry run records
        nothing, and a Director that can't be probed is a warning, because the
        run itself doesn't depend on the record.
        """
        if self.dry_run:
            return True
        uuid = self._probe_director_uuid()
        if not uuid or not _directorrefs.is_uuid(uuid):
            print(self.rep.color.yellow(
                "    warning: could not read the Director's UUID, so its stemcell "
                "refs will not be cleaned up automatically"
            ), file=sys.stderr)
            return False
        try:
            if _directorrefs.add(self.slot.dir, uuid):
                print(f"    recorded Director {uuid} in {_directorrefs.record_path(self.slot.dir)}")
        except OSError as exc:
            print(self.rep.color.yellow(
                f"    warning: could not record Director {uuid} ({exc}), so its stemcell "
                "refs will not be cleaned up automatically"
            ), file=sys.stderr)
            return False
        return True

    def _cpi_binary(self) -> str:
        """The cpi binary for stemcell-refs, built from the checkout when absent.

        CPI_BIN wins, as it does for scripts/lifecycle. Otherwise it is bin/cpi
        in the checkout, which `make bin/cpi` builds.
        """
        path = os.environ.get("CPI_BIN") or str(REPO_ROOT / "bin" / "cpi")
        if not os.access(path, os.X_OK):
            built = self._cleanup_step("refs:build-cpi", ["make", "bin/cpi"], REFS_BUILD_TIMEOUT_S)
            if not built or not os.access(path, os.X_OK):
                raise RuntimeError(f"no executable cpi binary at {path}")
        return path

    def cleanup_refs(self) -> bool:
        """Clean up the stemcell refs of every Director the slot has recorded.

        A failed `bosh env` probe never proves a Director is gone. A recorded
        UUID is pruned only when the slot holds no Director state (no state
        file, or no current VM CID in it), or when a probe succeeds and the
        live Director reports a different UUID. While the state shows a VM and
        the probe fails, the record stays and the log says why. A prune goes
        through the CPI's `stemcell-refs prune --director <uuid> --apply`, and
        a successful one drops the UUID. The prune keeps its guards, so the UUID
        stays recorded when the prune refuses. It refuses while VMs that carry
        the Director's owner tag remain, and it refuses for every Director
        while any BOSH guest in the cluster carries no owner tag, or has a
        config the scan could not read, because the owned count is then
        unknown. `cpi stemcell-refs adopt-owners` stamps the missing tags, and
        `cpi stemcell-refs report` says how to deal with each such guest. A
        refused prune prints `cleanup-refs refusal: <uuid8>: <reason>` with the
        reason the CPI gave, so the workflow's warning can name it. The
        Directors that are gone are handled first, and `bosh clean-up --all` on
        the live Director runs last. One failure never stops the loop.
        """
        self.refs_failures: list[str] = []
        self.rep.section("cleanup-refs")
        refusal = self._slot_refusal("clean up stemcell refs")
        if refusal:
            self.rep.record("refs:slot-guard", FAIL, 0.0, refusal)
            self.refs_failures.append("slot-guard")
            return False
        uuids = _directorrefs.load(self.slot.dir)
        if not uuids:
            self.rep.skip("refs:none", f"no Director UUIDs recorded in {_directorrefs.record_path(self.slot.dir)}")
            return True
        if self.dry_run:
            for uuid in uuids:
                print(f"    PLAN {uuid}: if reachable, bosh -n clean-up --all and keep the record")
                print(f"    PLAN {uuid}: once gone, cpi stemcell-refs prune --director {uuid} --apply, "
                      "then drop it from the record")
            self.rep.skip("refs:dry-run", f"{len(uuids)} recorded Director(s); nothing was run")
            return True

        standing = self._director_standing()
        live = self._probe_director_uuid().lower() if standing else ""
        gone: list[str] = []
        live_uuids: list[str] = []
        for uuid in uuids:
            short = uuid[:8]
            if not standing:
                gone.append(uuid)
            elif live and live != uuid:
                gone.append(uuid)
            elif live:
                live_uuids.append(uuid)
            else:
                self.rep.skip(
                    f"refs:prune:{short}",
                    "the slot's state shows a Director VM and bosh env did not answer, so the "
                    "Director is not proven gone; the UUID stays recorded for the next run",
                )

        ok = True
        config_dir: "Path | None" = None
        cpi: "tuple[str, str] | None" = None
        cpi_error = ""
        try:
            for uuid in gone:
                short = uuid[:8]
                if cpi is None and not cpi_error:
                    try:
                        if config_dir is None:
                            config_dir = Path(tempfile.mkdtemp(prefix="certify-cpi-"))
                            config = config_dir / "cpi.json"
                            fd = os.open(config, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                                json.dump(_integration.build_cpi_config(self.cfg), fh)
                        cpi = (self._cpi_binary(), str(config_dir / "cpi.json"))
                    except (RuntimeError, ValueError, OSError, SystemExit) as exc:
                        cpi_error = f"no CPI config or binary: {exc}"
                if cpi is None:
                    self.rep.skip(f"refs:prune:{short}", cpi_error)
                    self.refs_failures.append(f"prune:{short}")
                    ok = False
                    continue
                self.last_step_tail = []
                pruned = self._cleanup_step(
                    f"refs:prune:{short}",
                    [cpi[0], "stemcell-refs", "prune", "--config", cpi[1],
                     "--director", uuid, "--apply"],
                    REFS_PRUNE_TIMEOUT_S,
                )
                if pruned:
                    try:
                        _directorrefs.remove(self.slot.dir, uuid)
                    except OSError as exc:
                        print(self.rep.color.yellow(
                            f"    warning: pruned {uuid} but could not drop it from the record ({exc}); "
                            "the next run prunes it again"
                        ), file=sys.stderr)
                else:
                    reason = prune_refusal_reason(self.last_step_tail)
                    if reason:
                        print(f"cleanup-refs refusal: {short}: {reason}")
                        detail = f"the prune refused ({reason}), so the UUID stays recorded for the next run"
                    else:
                        detail = "the prune failed, so the UUID stays recorded for the next run"
                    self.rep.skip(f"refs:kept:{short}", detail)
                    self.refs_failures.append(f"prune:{short}")
                    ok = False
            for uuid in live_uuids:
                short = uuid[:8]
                if not self._cleanup_step(
                    f"refs:clean-up:{short}", ["bosh", "-n", "clean-up", "--all"],
                    REFS_CLEANUP_TIMEOUT_S, env=self._director_env(), retries=1,
                ):
                    self.refs_failures.append(f"clean-up:{short}")
                    ok = False
                self.rep.skip(f"refs:prune:{short}",
                              "the Director is still running; tear it down, then run cleanup-refs again")
        finally:
            # Every path removes the rendered config, which holds the PVE
            # credentials: normal exit, a failed binary, and any exception.
            if config_dir is not None:
                shutil.rmtree(config_dir, ignore_errors=True)
        return ok

    def _placement_observation(self) -> dict:
        """Where the Director says each instance is, and what each cluster says it holds.

        Reads the instance table, then /cluster/resources?type=vm from the
        cluster each AZ names, then the NIC and drive keys of each instance's
        VM on its own cluster. A read error is kept under that cluster rather
        than raised, so the placement check can name it. The observation holds
        no credential: the API settings are used for the reads and not stored.
        """
        dep = self.ccfg["deployment_name"]
        instances = _spanning.parse_instances(self._rows(self._capture_json(
            ["bosh", "-d", dep, "instances", "--details", "--json"],
        )))
        clusters: dict[str, dict] = {}
        for entry in self.ccfg["azs"]:
            az = entry["az"]
            cluster: dict = {"resources": [], "configs": {}, "error": ""}
            try:
                cfg = self._pve_cfg_for(az)
                cluster["resources"] = _spanning.thin_resources(
                    _integration.pve_api_get(cfg, "/cluster/resources?type=vm"))
                node_of = {r["vmid"]: r["node"] for r in cluster["resources"]}
                for inst in instances:
                    if inst["az"] != az or not inst["vm_cid"]:
                        continue
                    vmid = _vmcid.as_path_id(inst["vm_cid"])
                    node = node_of.get(vmid)
                    if node:
                        cluster["configs"][vmid] = _spanning.thin_config(
                            _integration.pve_api_get(cfg, f"/nodes/{node}/qemu/{vmid}/config"))
            except (RuntimeError, OSError, KeyError, ValueError) as exc:
                cluster["error"] = f"PVE API read failed: {exc}"
            clusters[az] = cluster
        return {
            "director_uuid": self._probe_director_uuid(),
            "instances": instances,
            "clusters": clusters,
        }

    def _serial_clusters(self) -> "list[tuple[str, dict]]":
        """The clusters whose VMs _disk_serials reads, as (AZ, PVE API settings).

        A run on one cluster has one entry with an empty AZ and the settings
        the run already uses. A spanning run has one per AZ, in config order,
        so the first is the Director's cluster.
        """
        if is_spanning(self.ccfg):
            return [(entry["az"], self._pve_cfg_for(entry["az"])) for entry in self.ccfg["azs"]]
        return [("", self._pve_cfg())]

    def _disk_serials(self, target: dict) -> dict:
        """Each persistent disk's stable id and the drive carrying it as serial=.

        Reads every drive's serial= off the Director VM and the deployment's
        VMs through the PVE API, and decodes each disk CID's bpd- stable id
        from its envelope. A read error is kept in the capture rather than
        failing it, so verify:disk-serial-stable can say what went wrong.

        A spanning run reads /cluster/resources from every AZ's cluster. The
        Director VM is looked for on the first cluster only, and a deployment
        VM on whichever cluster lists it. Drive serials are keyed by
        "<az>:<vmid>" there, so a location names the cluster that holds the
        disk. A disk whose serial is on drives of more than one cluster is
        an error and has no location, because one disk cannot sit on two.
        """
        disk_cids = list(target["director"]["disk_cids"]) + list(
            target["deployment"]["disk_cids"]
        )
        director_cid = target["director"]["vm_cid"]
        vm_cids = [director_cid, *target["deployment"]["vm_cids"]]
        stable_ids = {cid: _pve_verify.disk_stable_id(cid) for cid in disk_cids}
        serials: dict[str, dict[str, str]] = {}
        errors: list[str] = []
        try:
            clusters = self._serial_clusters()
        except (RuntimeError, OSError, KeyError, ValueError) as exc:
            clusters = []
            errors.append(f"PVE API read failed: {exc}")
        spanning = len(clusters) > 1
        found_on: dict[str, set[str]] = {}
        for index, (az, cfg) in enumerate(clusters):
            try:
                nodes = {
                    str(row.get("vmid")): str(row.get("node"))
                    for row in (_integration.pve_api_get(cfg, "/cluster/resources?type=vm") or [])
                    if row.get("vmid") is not None and row.get("node")
                }
                for vm_cid in vm_cids:
                    if not vm_cid or (vm_cid == director_cid and index > 0):
                        continue
                    # The Director holds the CID create_vm returned, which can
                    # carry a cluster stamp and token. PVE knows only the VMID.
                    vmid = _vmcid.as_path_id(vm_cid)
                    node = nodes.get(vmid)
                    if node is None:
                        if not spanning:
                            errors.append(f"VM {vm_cid} is not in /cluster/resources")
                        continue
                    config = _integration.pve_api_get(cfg, f"/nodes/{node}/qemu/{vmid}/config")
                    key = f"{az}:{vmid}" if spanning else vmid
                    serials[key] = _upgrade_checks.drive_serials(config or {})
                    for serial in serials[key].values():
                        found_on.setdefault(serial, set()).add(az)
            except (RuntimeError, OSError, KeyError, ValueError) as exc:
                where = f" on the {az} cluster" if spanning else ""
                errors.append(f"PVE API read failed{where}: {exc}")
        if spanning:
            errors.extend(self._unplaced_serial_vms(vm_cids, serials))
        locations = _upgrade_checks.serial_locations(stable_ids, serials)
        for cid, sid in stable_ids.items():
            holders = sorted(found_on.get(sid, ())) if sid else []
            if len(holders) > 1:
                errors.append(f"disk {cid[:24]}... carries serial={sid} on drives of more than one "
                              f"cluster ({', '.join(holders)})")
                locations[cid] = ""
        return {
            "stable_ids": stable_ids,
            "drive_serials": serials,
            "locations": locations,
            "errors": errors,
        }

    @staticmethod
    def _unplaced_serial_vms(vm_cids: list, serials: dict) -> list:
        """A spanning run's VMs that no cluster listed, one error each."""
        read = {key.split(":", 1)[1] for key in serials}
        return [
            f"VM {vm_cid} is not in /cluster/resources on any cluster"
            for vm_cid in vm_cids
            if vm_cid and _vmcid.as_path_id(vm_cid) not in read
        ]

    # -- persistent-disk marker ---------------------------------------------- #

    def _marker_ssh(self, step: str, script: str) -> "tuple[bool, str]":
        """Run a marker script as root on the certification instance."""
        dep = self.ccfg["deployment_name"]
        ok, tail = self._bosh(
            step,
            ["bosh", "-n", "-d", dep, "ssh", CERT_INSTANCE,
             "-c", _upgrade_checks.remote_command(script)],
            timeout=SHORT_TIMEOUT_S,
        )
        return ok, "\n".join(tail)

    def write_marker(self) -> bool:
        """Write a nonce and checksummed random data to the persistent disk.

        Runs before the pre-upgrade capture. A failure here does not stop the
        run, since the other invariants still mean something, but it does fail
        verify:disk-data-survived.
        """
        self.rep.section("write-marker")
        self.marker_nonce = secrets.token_hex(16)
        if self.dry_run:
            self._marker_ssh("cert:write-marker",
                             _upgrade_checks.write_marker_script(self.marker_nonce))
            self.marker_written = (self.marker_nonce, "<dry-run>")
            return True
        ok, out = self._marker_ssh(
            "cert:write-marker", _upgrade_checks.write_marker_script(self.marker_nonce),
        )
        parsed = _upgrade_checks.parse_marker(out)
        if not ok or parsed is None:
            reason = _upgrade_checks.marker_error(out) or "bosh ssh printed no marker line"
            self.marker_problem = f"the marker write failed: {reason}"
            if ok:
                self.rep.record("cert:write-marker-parse", FAIL, 0.0, self.marker_problem)
            return False
        if parsed[0] != self.marker_nonce:
            self.marker_problem = "the marker write echoed a different nonce"
            self.rep.record("cert:write-marker-parse", FAIL, 0.0, self.marker_problem)
            return False
        self.marker_written = parsed
        self.marker_problem = ""
        if is_spanning(self.ccfg):
            self._record_marker_az()
        return True

    def _record_marker_az(self) -> None:
        """Say which AZ's disk the data proof covers.

        The marker goes to one instance. The other AZ's disk is covered by
        the serial and placement checks, which read every instance.
        """
        dep = self.ccfg["deployment_name"]
        index = CERT_INSTANCE.split("/", 1)[1]
        rows = _spanning.parse_instances(self._rows(self._capture_json(
            ["bosh", "-d", dep, "instances", "--details", "--json"],
        )))
        az = next((r["az"] for r in rows if r["index"] == index and r["az"]), "")
        cpi_ids = {entry["az"]: entry["cpi_id"] for entry in self.ccfg["azs"]}
        where = (f"AZ {az} ({cpi_ids.get(az, '?')})" if az else "an AZ the instance table did not name")
        self.rep.record(
            "cert:write-marker-az", PASS, 0.0,
            f"the marker is on {CERT_INSTANCE}, in {where}; the other AZ's disk is covered by "
            "the serial and placement checks",
        )

    def read_marker(self) -> bool:
        """Read the marker back after the upgrade and recreate."""
        self.rep.section("read-marker")
        if self.dry_run:
            self._marker_ssh("cert:read-marker", _upgrade_checks.read_marker_script())
            self.marker_read = self.marker_written
            return True
        if self.marker_written is None:
            self.rep.skip("cert:read-marker", self.marker_problem)
            return False
        ok, out = self._marker_ssh("cert:read-marker", _upgrade_checks.read_marker_script())
        parsed = _upgrade_checks.parse_marker(out)
        if not ok or parsed is None:
            reason = _upgrade_checks.marker_error(out) or "bosh ssh printed no marker line"
            self.marker_problem = f"the marker read failed: {reason}"
            if ok:
                self.rep.record("cert:read-marker-parse", FAIL, 0.0, self.marker_problem)
            return False
        self.marker_read = parsed
        return True

    def upgrade(self) -> bool:
        self.rep.section("upgrade")
        if not self._guard_step("create-env", "director:create-env-new"):
            return False
        # Set before the step, because a create-env that fails partway may
        # already have replaced the Director's VM with one on the new CPI.
        self.director_side = "new"
        ok, _ = self.runner.step(
            "director:create-env-new", self._create_env_argv("new"),
            env=self._create_env_env("new"), timeout=CREATE_ENV_TIMEOUT_S,
        )
        if ok:
            self._backup_state("post-upgrade")
            self._record_director_uuid()
        return ok

    def recreate(self) -> bool:
        self.rep.section("recreate")
        dep = self.ccfg["deployment_name"]
        ok, _ = self._bosh(
            "cert:recreate", ["bosh", "-n", "-d", dep, "recreate"],
            timeout=DEPLOY_TIMEOUT_S,
        )
        return ok

    # -- verify --------------------------------------------------------------- #

    def verify(self) -> bool:
        self.rep.section("verify")
        if self.dry_run:
            for name in ("verify:director-vm-replaced", "verify:director-disk-identity",
                         "verify:deployment-disk-identity", "verify:cpi-upgraded",
                         "verify:disk-data-survived", "verify:disk-serial-stable",
                         "verify:instance-running", "verify:no-new-orphans",
                         "verify:cloud-check"):
                self.rep.record(name, PASS, 0.0, "dry-run")
            if is_spanning(self.ccfg):
                self.rep.record("verify:placement", PASS, 0.0, "dry-run")
            return True

        ok = True
        pre_dir = self.pre.get("director", {})
        post_dir = self.post.get("director", {})
        pre_dep = self.pre.get("deployment", {})
        post_dep = self.post.get("deployment", {})

        ok = self._invariant(
            "verify:director-vm-replaced",
            "Director VM CID",
            pre_dir.get("vm_cid", ""), post_dir.get("vm_cid", ""),
            lambda a, b: bool(a) and bool(b) and a != b,
            "the new CPI built a replacement Director VM around the preserved disk",
        ) and ok

        ok = self._invariant(
            "verify:director-disk-identity",
            "Director persistent disk CIDs",
            ", ".join(pre_dir.get("disk_cids", [])),
            ", ".join(post_dir.get("disk_cids", [])),
            lambda a, b: bool(a) and a == b,
            "the new CPI decoded and kept the disk CID the old CPI wrote",
        ) and ok

        ok = self._invariant(
            "verify:deployment-disk-identity",
            "Certification persistent disk CIDs",
            ", ".join(pre_dep.get("disk_cids", [])),
            ", ".join(post_dep.get("disk_cids", [])),
            lambda a, b: bool(a) and a == b,
            "the recreated VM reattached the disk the old CPI created",
        ) and ok

        want_new = self.new_cpi_label.lstrip("v")
        ok = self._invariant(
            "verify:cpi-upgraded",
            "CPI release deployed by create-env",
            self.pre.get("cpi_release", ""), self.post.get("cpi_release", ""),
            lambda a, b: bool(a) and bool(b) and a != b,
            f"the second create-env deployed {want_new} over the first leg's "
            f"{self.old_cpi_label}",
        ) and ok

        ok = self._verify_disk_data() and ok
        ok = self._verify_disk_serials() and ok
        if is_spanning(self.ccfg):
            ok = self._verify_placement() and ok

        states = post_dep.get("process_states", [])
        running = bool(states) and all(s == "running" for s in states)
        self.rep.record(
            "verify:instance-running", PASS if running else FAIL, 0.0,
            ", ".join(states) or "no instances reported",
        )
        ok = ok and running

        pre_orphans = self.pre.get("orphaned_disks", 0)
        post_orphans = self.post.get("orphaned_disks", 0)
        no_new = post_orphans <= pre_orphans
        self.rep.record(
            "verify:no-new-orphans", PASS if no_new else FAIL, 0.0,
            f"{pre_orphans} before, {post_orphans} after",
        )
        self.invariants.append({
            "name": "Orphaned disks",
            "before": pre_orphans, "after": post_orphans, "held": no_new,
        })
        ok = ok and no_new

        dep = self.ccfg["deployment_name"]
        cc_ok, _ = self._bosh(
            "verify:cloud-check",
            ["bosh", "-n", "-d", dep, "cloud-check", "--report"],
            timeout=SHORT_TIMEOUT_S,
        )
        ok = ok and cc_ok

        return ok

    def _placement_entries(self) -> dict:
        """Each AZ's cpi-config facts plus its bridge and storage overrides."""
        return {
            entry["az"]: {**self.az_facts[entry["az"]],
                          "bridge": entry["bridge"], "storage": entry["storage"]}
            for entry in self.ccfg["azs"]
        }

    def _verify_placement(self) -> bool:
        """One deployment on two clusters: each instance sits where its AZ says.

        Judges the observation taken once the first release had deployed, where
        the VM CIDs may be bare, and the one taken after the recreate under the
        new release, where they must be stamped. Then it looks for the first
        release's VMs on both clusters, because the recreate has to delete them
        through the legacy path.
        """
        if not all(entry["az"] in self.az_facts for entry in self.ccfg["azs"]):
            self.rep.record("verify:placement", FAIL, 0.0,
                            "the cpi-config entries were not read, so there is nothing to judge against")
            return False
        entries = self._placement_entries()
        ok = True
        held: dict[str, int] = {}
        for when, expect_stamped in (("pre", False), ("post", True)):
            obs = (self.pre if when == "pre" else self.post).get("placement")
            if not obs:
                self.rep.record(f"verify:placement-{when}", FAIL, 0.0,
                                "no placement observation was captured")
                ok = False
                continue
            for finding in _spanning.check_placement(obs, entries, expect_stamped):
                self.rep.record(
                    "verify:" + finding.name.replace(":", f"-{when}-", 1),
                    PASS if finding.ok else FAIL, 0.0, finding.detail,
                )
                held[when] = held.get(when, 0) + (1 if finding.ok else 0)
                ok = ok and finding.ok
        pre_obs = self.pre.get("placement")
        post_obs = self.post.get("placement")
        if pre_obs and post_obs:
            gone = _spanning.check_old_vms_gone(pre_obs, post_obs)
            self.rep.record("verify:" + gone.name.replace(":", "-", 1),
                            PASS if gone.ok else FAIL, 0.0, gone.detail)
            ok = ok and gone.ok
        self.invariants.append({
            "name": "Placement across both clusters",
            "before": f"{held.get('pre', 0)} placement checks held after the first release",
            "after": f"{held.get('post', 0)} placement checks held after the recreate",
            "held": ok,
        })
        return ok

    def _verify_disk_data(self) -> bool:
        """The bytes written before the upgrade read back unchanged after it."""
        written = self.marker_written
        read = self.marker_read
        before = (
            f"nonce {written[0][:8]}, sha256 {written[1][:12]}" if written
            else "(not written)"
        )
        after = (
            f"nonce {read[0][:8]}, sha256 {read[1][:12]}" if read
            else "(not read)"
        )
        held = written is not None and read is not None and written == read
        if held:
            detail = "the data written before the upgrade read back byte for byte"
        elif written is None or read is None:
            detail = self.marker_problem or "the marker was not read back"
        elif written[0] != read[0]:
            detail = "the nonce on the disk is not this run's, so the disk is not the one written"
        else:
            detail = "the marker data's sha256 changed across the upgrade"
        self.rep.record(
            "verify:disk-data-survived", PASS if held else FAIL, 0.0, detail,
        )
        self.invariants.append({
            "name": "Persistent disk marker",
            "before": before, "after": after, "held": held,
        })
        return held

    def _verify_disk_serials(self) -> bool:
        """Every disk kept a drive whose serial= is its CID's bpd- stable id."""
        pre = self.pre.get("disks") or {}
        post = self.post.get("disks") or {}
        held, why = _upgrade_checks.serials_stable(pre, post)
        errors = list(pre.get("errors") or []) + list(post.get("errors") or [])
        if not held and errors:
            why = f"{why} ({'; '.join(errors)})"
        before = _upgrade_checks.describe_serials(
            pre.get("stable_ids") or {}, pre.get("locations") or {},
        )
        after = _upgrade_checks.describe_serials(
            post.get("stable_ids") or {}, post.get("locations") or {},
        )
        self.rep.record(
            "verify:disk-serial-stable", PASS if held else FAIL, 0.0,
            "every persistent disk's bpd- serial still matches its CID" if held else why,
        )
        self.invariants.append({
            "name": "Disk serials (bpd- stable id on a drive)",
            "before": before or "(none)", "after": after or "(none)", "held": held,
        })
        return held

    def _invariant(self, step: str, name: str, before: str, after: str,
                   holds, detail: str) -> bool:
        held = bool(holds(before, after))
        self.rep.record(
            step, PASS if held else FAIL, 0.0,
            detail if held else f"{name}: {before or '(none)'} -> {after or '(none)'}",
        )
        self.invariants.append(
            {"name": name, "before": before, "after": after, "held": held}
        )
        return held

    # -- finalize + teardown --------------------------------------------------- #

    def finalize(self, run_ok: bool) -> bool:
        self.rep.section("finalize")
        if self.args.skip_doc:
            self.rep.skip("doc:run-report", "--skip-doc")
            self.rep.skip("doc:summary", "--skip-doc")
            return True
        self.rep.begin("doc:run-report")
        t0 = time.monotonic()
        meta = self._run_meta(run_ok)
        if self.dry_run:
            self.rep.record("doc:run-report", PASS, 0.0, "dry-run")
            self.rep.record("doc:summary", PASS, 0.0, "dry-run")
            return True
        try:
            phases = [
                {"name": n, "seconds": s} for n, s in self.rep.sections_snapshot()
            ]
            steps = [
                {"name": r.name, "status": r.status, "seconds": r.seconds}
                for r in self.rep.results
            ]
            doc = write_run_doc(meta, phases, steps)
            self._record_inline("doc:run-report", True, t0, str(doc))
            t1 = time.monotonic()
            summary = write_summary_doc(self.args.headline_pass_fail_only)
            self._record_inline("doc:summary", True, t1, str(summary))
        except OSError as exc:
            return self._record_inline("doc:run-report", False, t0, str(exc))
        return True

    def _run_meta(self, run_ok: bool) -> dict:
        old_artifact = _release_artifact.report_identity(self.old_cpi_path)
        new_artifact = _release_artifact.report_identity(self.new_cpi_path)
        totals = {PASS: 0, FAIL: 0, "SKIP": 0}
        for r in self.rep.results:
            totals[r.status] = totals.get(r.status, 0) + 1
        started = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(self.rep.started))
        return {
            "date": time.strftime("%Y-%m-%d", time.localtime(self.rep.started)),
            "verdict": "PASSED" if run_ok else "FAILED",
            "command_line": self.rep.command,
            "exit_code": 0 if run_ok else 1,
            "env": self.env_name,
            "started": started,
            "finished": time.strftime("%Y-%m-%d %H:%M:%S"),
            "wall_hms": fmt_hms(time.time() - self.rep.started),
            "steps_passed": totals.get(PASS, 0),
            "steps_failed": totals.get(FAIL, 0),
            "steps_skipped": totals.get("SKIP", 0),
            "old_cpi": self.old_cpi_label or self.args.old_cpi,
            "new_cpi": self.new_cpi_label or self.args.new_cpi,
            "old_cpi_artifact_version": old_artifact["version"],
            "new_cpi_artifact_version": new_artifact["version"],
            "old_cpi_sha256": old_artifact["sha256"],
            "new_cpi_sha256": new_artifact["sha256"],
            "candidate_source_commit": os.environ.get("PVE_CPI_RELEASE_COMMIT", "unknown"),
            "matrix_source": (
                "N-1 to N of the published releases"
                if getattr(self.args, "auto_matrix", False) else "pinned"
            ),
            "old_bosh": self.old_bosh_label,
            "new_bosh": self.new_bosh_label,
            "old_stemcell": (
                f"{self.old_stemcell[1]}/{self.old_stemcell[2]}"
                if self.old_stemcell else "unresolved"
            ),
            "new_stemcell": (
                f"{self.new_stemcell[1]}/{self.new_stemcell[2]}"
                if self.new_stemcell else "unresolved"
            ),
            "director_version": self.director_version or "unknown",
            "certification_ref": self.certification_ref or "unknown",
            "certification_release": self.certification_release or self.ccfg["release_name"],
            "pve_version": self.pve_version or "unknown",
            "director_slot": self.slot.dir.name,
            "run_dir": str(self.run_dir.relative_to(REPO_ROOT))
            if self.run_dir.is_relative_to(REPO_ROOT) else str(self.run_dir),
            "invariants": self.invariants,
        }

    def teardown(self) -> None:
        if self.args.keep:
            self.rep.section("teardown")
            self.rep.skip("cert:delete-deployment", "--keep")
            self.rep.skip("director:delete-env", "--keep")
            if self.probe_deployed:
                self.rep.skip(
                    "cert:delete-probe",
                    f"--keep, but the probe deployment {self._probe_deployment_name()} is still on the "
                    "Director because its delete failed; delete it with `bosh -d "
                    f"{self._probe_deployment_name()} delete-deployment --force`",
                )
            print(self.rep.color.yellow(
                "    --keep: the upgraded Director and the certification "
                "deployment are still running. Tear them down with "
                f"`BOSH_STATE_DIR={self.slot.dir} ./scripts/bosh teardown` "
                "when you are done."
            ))
            return
        self.rep.section("teardown")
        refusal = self._slot_refusal("delete-env")
        if refusal:
            for name in ("cert:delete-deployment", "director:clean-up",
                         "director:delete-env"):
                self.rep.skip(name, refusal)
            return
        dep = self.ccfg["deployment_name"]
        if self.probe_deployed or (self.dry_run and is_spanning(self.ccfg)):
            self._cleanup_step(
                "cert:delete-probe",
                ["bosh", "-n", "-d", self._probe_deployment_name(), "delete-deployment", "--force"],
                DEPLOY_TIMEOUT_S, env=self._director_env(),
            )
        if self.deployed or self.dry_run:
            self._cleanup_step(
                "cert:delete-deployment",
                ["bosh", "-n", "-d", dep, "delete-deployment", "--force"],
                DEPLOY_TIMEOUT_S, env=self._director_env(),
            )
            self._cleanup_step(
                "director:clean-up", ["bosh", "-n", "clean-up", "--all"],
                DEPLOY_TIMEOUT_S, env=self._director_env(), retries=1,
            )
        if self.director_up or self.dry_run:
            self._cleanup_step(
                "director:delete-env", [BOSH_SCRIPT, "teardown"],
                CREATE_ENV_TIMEOUT_S, env=self._teardown_env(),
            )
            if self._env_manages_sdn():
                # The run's Director shares the env network with the main
                # Director, so the network stays up.
                self.rep.skip(
                    "net:down",
                    "the env network is shared with the default slot's Director",
                )
            else:
                self.rep.skip("net:down", self._sdn_skip_reason())

    def _cleanup_step(self, name: str, argv: list[str], timeout: int,
                      env: "dict[str, str] | None" = None, retries: int = 0) -> bool:
        """Run a teardown command whose failure must not fail the run.

        Teardown happens after every invariant has been checked, so an error
        here reflects on the lab or the Director, not on the CPI under test.
        One known case is the Director's own clean-up double-delete on
        stemcell rows. The step still appears in the report, as a skip
        carrying the exit code, so a failed sweep is never silent.

        With `retries` above zero, we re-run a failed command that many times
        before we give up. The Director's first `clean-up --all` always fails
        on a multi-CPI Director, and the second succeeds, so `director:clean-up`
        retries once. A pass after a failed attempt is recorded as a PASS whose
        detail names the failed attempt. A dry run never retries, so each
        command prints one DRY-RUN line.

        The output tail of the last attempt is kept in `last_step_tail`, so a
        caller can read the reason a command gave for failing.
        """
        self.rep.begin(name)
        merged = dict(self.runner.base_env)
        if env:
            merged.update(env)
        attempts = 1 if self.dry_run else 1 + max(retries, 0)
        first_rc = 0
        rc = 0
        for attempt in range(attempts):
            rc, tail = exec_stream(
                argv, env=merged, cwd=REPO_ROOT, timeout=timeout,
                dry_run=self.dry_run, logfile=self.runner.logfile,
            )
            self.last_step_tail = list(tail)
            if rc == 0:
                break
            if attempt == 0:
                first_rc = rc
        if rc == 0:
            if first_rc:
                self.rep.record(
                    name, PASS, 0.0,
                    detail=(f"first attempt exited {first_rc}; the retry passed "
                            "(the Director's multi-CPI stemcell double-delete)"),
                )
            else:
                self.rep.record(name, PASS, 0.0)
            return True
        self.rep.skip(name, f"best-effort cleanup exited {rc}; sweep the lab by hand")
        return False

    # -- dispatch -------------------------------------------------------------- #

    def dispatch(self) -> bool:
        ok = False
        try:
            if not self.preflight():
                return False
            if not self.resolve():
                return False
            if not self.deploy_old():
                return False
            if not self.deploy_cert():
                return False
            self.write_marker()
            if not self.capture("pre"):
                return False
            if not self.upgrade():
                return False
            if not self.recreate():
                return False
            if not self.capture("post"):
                return False
            self.read_marker()
            ok = self.verify()
        finally:
            # The report is the point of the run; write it even when a phase
            # blew up, then clean up regardless.
            try:
                self.finalize(ok)
            finally:
                self.teardown()
        return ok

    def close(self) -> None:
        if self.console_fh is not None:
            self.console_fh.close()


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #

def cmd_report(args: argparse.Namespace, color: Color) -> int:
    results_dir = Path(args.results_dir)
    if not results_dir.is_absolute():
        results_dir = REPO_ROOT / results_dir
    latest = results_dir / "latest.json"
    if not latest.exists():
        print(color.yellow(f"no results found at {latest}"), file=sys.stderr)
        return 2
    payload = json.loads(latest.read_text())
    print(color.bold(f"CERTIFY SUMMARY — command: {payload.get('command', '?')}"))
    for row in payload.get("results", []):
        status = row["status"]
        tag = {
            PASS: color.green(f"[{PASS}]"),
            FAIL: color.red(f"[{FAIL}]"),
        }.get(status, color.yellow(f"[{status}]"))
        detail = f"  {color.dim(row['detail'])}" if row.get("detail") else ""
        print(f"    {tag} {row['name']} {row['seconds']:.1f}s{detail}")
    totals = payload.get("totals", {})
    print(
        f"  {totals.get('pass', 0)} pass  {totals.get('fail', 0)} fail  "
        f"{totals.get('skip', 0)} skip   total {payload.get('total_hms', '?')}"
    )
    return int(payload.get("exit", 0))


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="scripts/certify",
        description="BOSH Director Upgrade Test against the configured PVE lab",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("command", nargs="?", default="upgrade",
                   choices=["upgrade", "run", "report", "record-director",
                            "cleanup-refs", "help"])
    p.add_argument("--config", default=DEFAULT_CONFIG)
    p.add_argument("--env", default=os.environ.get("BOSH_PVE_ENV") or "cpitest")
    p.add_argument("--old-cpi", default="")
    p.add_argument("--new-cpi", default="")
    p.add_argument("--old-bosh-release", default="")
    p.add_argument("--new-bosh-release", default="")
    p.add_argument("--old-stemcell", default="light")
    p.add_argument("--new-stemcell", default="light")
    p.add_argument("--force", action="store_true")
    p.add_argument("--keep", action="store_true")
    p.add_argument("--results-dir", default=DEFAULT_RESULTS_DIR)
    p.add_argument("--skip-doc", action="store_true")
    p.add_argument("--headline-pass-fail-only", action="store_true",
                   help="README headline tracks only PASS/FAIL runs; an "
                        "UNKNOWN run keeps its run doc without moving the "
                        "headline")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--no-color", action="store_true")
    return p


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    color = Color(not args.no_color and sys.stdout.isatty())

    if args.command == "help":
        print(__doc__)
        return 0
    if args.command == "report":
        return cmd_report(args, color)

    command = "./scripts/certify " + " ".join(argv or ["upgrade"])
    rep = Reporter(color, command, args.dry_run, label="CERTIFY")

    if args.command in ("cleanup-refs", "record-director"):
        # These touch the slot's Director record and nothing else, so they skip
        # the version matrix, which needs the network.
        runner = Certify(args, rep)
        try:
            if args.command == "record-director":
                if runner.dry_run:
                    print("    PLAN: read the Director's UUID with bosh env and append it to "
                          f"{_directorrefs.record_path(runner.slot.dir)}")
                ok = runner._record_director_uuid()
            else:
                ok = runner.cleanup_refs()
                if runner.refs_failures:
                    print("cleanup-refs failures: " + ", ".join(runner.refs_failures))
        finally:
            runner.close()
        rep.summary()
        return 0 if ok else 1

    # Resolve the version matrix before anything else: an explicit flag wins,
    # then ci/integration.yml, then the published releases (new = N,
    # old = N-1). Doing it here means the run banner and the report both name
    # concrete versions rather than "whatever was latest".
    probe = _integration.load_config(args.config, dry_run=args.dry_run)
    probe_ccfg = certification_config(probe, args.env, args.dry_run)
    old_spec = args.old_cpi or probe_ccfg["old_cpi_version"]
    new_spec = args.new_cpi or probe_ccfg["new_cpi_version"]
    if args.dry_run and not (old_spec and new_spec):
        old_spec, new_spec, auto = old_spec or "<dry-run:N-1>", new_spec or "<dry-run:N>", True
    else:
        try:
            old_spec, new_spec, auto = resolve_version_matrix(old_spec, new_spec)
        except RuntimeError as exc:
            print(color.red(f"version matrix: {exc}"), file=sys.stderr)
            return 2
    args.old_cpi, args.new_cpi, args.auto_matrix = old_spec, new_spec, auto
    print(color.bold(
        f"  CPI upgrade matrix: {old_spec} -> {new_spec}"
        + ("  (N-1 -> N from published releases)" if auto else "  (pinned)")
    ))

    runner = Certify(args, rep)
    try:
        ok = runner.dispatch()
    except KeyboardInterrupt:
        print(color.red("\ninterrupted"), file=sys.stderr)
        return 130
    finally:
        runner.close()
    rep.summary()
    rep.write_artifacts(runner.results_dir, junit_name=JUNIT_STEPS)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
